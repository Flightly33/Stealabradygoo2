		look = { scale = 1.12, head = 0.95, leg = 1.16, arm = 1.08, torso = 1.02, hair = "hair_shag", face = "Vintage", idle = "ArchiveLean", walk = "Strut" },
		unlockSlot = nil,
		unlockText = "GRAIL hunting + the Grail Vault",
		interaction = "Grail Vault crates",
