      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">FurnitureSystem</string>
          <string name="Source"><![CDATA[--[[
	FurnitureSystem
	Furniture / decoration / toy catalog and the grid placement rules.

	Placement format (saved in data.furniture.placed):
	    { id = "couch", x = -3, z = 2, r = 1 }
	x / z are GRID CELLS (Config.GridSize studs each) of the piece's minimum
	corner, r is the rotation in quarter turns. Because everything snaps to the
	same grid, validating a placement is a handful of rectangle checks that
	the server and client share.
]]

local Modules = script.Parent
local Config = require(Modules.Config)
local HouseSystem = require(Modules.HouseSystem)

local FurnitureSystem = {}

local rgb = Color3.fromRGB
local GRID = Config.GridSize

-- w / d are the footprint in studs (multiples of the grid size).
-- layer = "rug" pieces lie flat and other furniture may sit on top of them.
FurnitureSystem.List = {
	-- FURNITURE
	{ id = "couch", name = "Comfy Couch", category = "Furniture", price = 450, w = 6, d = 4, color = rgb(90, 140, 220), desc = "brady-sized. you can sit too, i guess." },
	{ id = "beanbag", name = "Bean Bag", category = "Furniture", price = 220, w = 4, d = 4, color = rgb(240, 110, 70), desc = "once he sits, he is not getting up." },
	{ id = "coffee_table", name = "Coffee Table", category = "Furniture", price = 180, w = 4, d = 2, color = rgb(150, 110, 70), desc = "for putting things on. revolutionary." },
	{ id = "bookshelf", name = "Bookshelf", category = "Furniture", price = 320, w = 4, d = 2, color = rgb(130, 90, 60), desc = "full of fashion magazines." },
	{ id = "tv_stand", name = "Big TV", category = "Furniture", price = 700, w = 6, d = 2, color = rgb(40, 40, 46), desc = "only plays runway shows." },
	{ id = "gaming_setup", name = "Gaming Setup", category = "Furniture", price = 1500, minAge = 13, w = 6, d = 4, color = rgb(50, 50, 60), desc = "RGB adds at least 30 FPS." },
	{ id = "clothing_rack", name = "Clothing Rack", category = "Furniture", price = 900, minAge = 10, w = 4, d = 2, color = rgb(200, 200, 205), desc = "the overflow rack. he has too many pieces." },
	{ id = "sneaker_wall", name = "Sneaker Wall", category = "Furniture", price = 2800, minAge = 16, w = 6, d = 2, color = rgb(240, 240, 240), desc = "every pair is deadstock. nobody may touch." },
	{ id = "mannequin", name = "Mannequin", category = "Furniture", price = 1200, minAge = 10, w = 2, d = 2, color = rgb(230, 225, 215), desc = "better dressed than most people." },
	{ id = "fishtank", name = "Goo Fish Tank", category = "Furniture", price = 1100, w = 4, d = 2, color = rgb(90, 200, 230), desc = "the fish are also dripped out." },
	{ id = "vinyl_player", name = "Vinyl Player", category = "Furniture", price = 2000, minAge = 16, w = 2, d = 2, color = rgb(120, 70, 40), desc = "sounds worse. costs more. he loves it." },
	{ id = "throne", name = "Golden Throne", category = "Furniture", price = 12000, minAge = 21, w = 4, d = 4, color = rgb(255, 205, 60), desc = "for the most archive person on roblox." },
	-- DECOR
	{ id = "rug_goo", name = "Goo Splat Rug", category = "Decor", price = 80, w = 4, d = 4, layer = "rug", color = rgb(126, 232, 74), desc = "it's supposed to look like that." },
	{ id = "rug_checker", name = "Checker Rug", category = "Decor", price = 250, w = 6, d = 6, layer = "rug", color = rgb(30, 30, 30), desc = "very skater. very cool." },
	{ id = "rug_red", name = "Red Carpet", category = "Decor", price = 400, minAge = 8, w = 2, d = 8, layer = "rug", color = rgb(190, 30, 40), desc = "he insists on entering every room this way." },
	{ id = "plant", name = "Leafy Plant", category = "Decor", price = 90, w = 2, d = 2, color = rgb(70, 170, 80), desc = "it's fake. he still waters it." },
	{ id = "lamp", name = "Floor Lamp", category = "Decor", price = 140, w = 2, d = 2, color = rgb(255, 230, 160), desc = "mood lighting for fit pics." },
	{ id = "lava_lamp", name = "Lava Lamp", category = "Decor", price = 350, w = 2, d = 2, color = rgb(255, 90, 160), desc = "hypnotising. he has been staring for an hour." },
	{ id = "speaker", name = "Big Speaker", category = "Decor", price = 500, w = 2, d = 2, color = rgb(40, 40, 46), desc = "the neighbours also get to enjoy it." },
	{ id = "neon_sign", name = "GOO Neon Sign", category = "Decor", price = 650, w = 4, d = 2, color = rgb(126, 232, 74), desc = "so everyone knows whose room this is." },
	{ id = "poster", name = "Fit Pic Poster", category = "Decor", price = 200, w = 2, d = 2, color = rgb(255, 200, 60), desc = "a poster of himself. obviously." },
	{ id = "arcade", name = "Arcade Cabinet", category = "Decor", price = 1300, minAge = 8, w = 2, d = 2, color = rgb(200, 50, 200), desc = "high score: BDY 999999." },
	{ id = "disco_ball", name = "Disco Ball", category = "Decor", price = 1800, minAge = 10, w = 2, d = 2, color = rgb(220, 220, 235), desc = "every night is a fashion show after-party." },
	{ id = "goo_fountain", name = "Goo Fountain", category = "Decor", price = 4500, minAge = 16, w = 4, d = 4, color = rgb(126, 232, 74), desc = "an indoor fountain of goo. classy." },
	{ id = "gold_statue", name = "Golden Brady Statue", category = "Decor", price = 8000, minAge = 18, w = 2, d = 2, color = rgb(255, 205, 60), desc = "humble." },
	{ id = "trophy_lamp", name = "Golden Trophy Lamp", category = "Decor", w = 2, d = 2, color = rgb(255, 205, 60), special = true, desc = "a daily login exclusive. flex responsibly." },
	-- VIP DECOR (needs the VIP Room Decorations gamepass - purely cosmetic)
	{ id = "vip_rope", name = "VIP Velvet Rope", category = "Decor", price = 500, vip = true, w = 4, d = 2, color = rgb(190, 30, 40), desc = "you're on the list." },
	{ id = "vip_hottub", name = "VIP Goo Hot Tub", category = "Decor", price = 3000, vip = true, w = 6, d = 6, color = rgb(126, 232, 74), desc = "warm goo. surprisingly relaxing." },
	{ id = "vip_dj", name = "VIP DJ Booth", category = "Decor", price = 2500, vip = true, w = 6, d = 4, color = rgb(60, 40, 120), desc = "DJ Goo on the ones and twos." },
	{ id = "vip_pillar", name = "VIP Gold Pillar", category = "Decor", price = 1200, vip = true, w = 2, d = 2, color = rgb(255, 205, 60), desc = "holds up nothing. looks rich." },
	-- TOYS (Brady can play with these in his room)
	{ id = "toy_blocks", name = "Goo Blocks", category = "Toys", price = 120, toy = true, w = 2, d = 2, color = rgb(240, 90, 90), desc = "he builds a tower. he destroys the tower." },
	{ id = "toy_ball", name = "Bouncy Ball", category = "Toys", price = 100, toy = true, w = 2, d = 2, color = rgb(255, 200, 60), desc = "boing." },
	{ id = "toy_dino", name = "Plush Dino", category = "Toys", price = 280, toy = true, w = 2, d = 2, color = rgb(90, 200, 120), desc = "his name is Gerald." },
	{ id = "toy_car", name = "Toy Race Car", category = "Toys", price = 450, toy = true, w = 4, d = 2, color = rgb(230, 50, 60), desc = "vroom. beep beep." },
	{ id = "toy_boombox", name = "Boombox", category = "Toys", price = 700, minAge = 5, toy = true, w = 2, d = 2, color = rgb(60, 60, 70), desc = "instant dance party." },
	{ id = "toy_trampoline", name = "Mini Trampoline", category = "Toys", price = 950, minAge = 5, toy = true, w = 4, d = 4, color = rgb(60, 120, 240), desc = "he has hit the ceiling twice." },
}

FurnitureSystem.ById = {}
for _, def in ipairs(FurnitureSystem.List) do
	FurnitureSystem.ById[def.id] = def
end

FurnitureSystem.Categories = { "Furniture", "Decor", "Toys" }

function FurnitureSystem.get(id)
	return FurnitureSystem.ById[id]
end

-- Footprint (studs) after rotation.
function FurnitureSystem.footprint(def, r)
	if r % 2 == 1 then
		return def.d, def.w
	end
	return def.w, def.d
end

-- Room-local rectangle a placement covers.
function FurnitureSystem.rectOf(placement)
	local def = FurnitureSystem.ById[placement.id]
	local w, d = FurnitureSystem.footprint(def, placement.r)
	local minX, minZ = placement.x * GRID, placement.z * GRID
	return HouseSystem.rect(minX, minX + w, minZ, minZ + d)
end

-- Room-local CFrame for the model (centre of the footprint, on the floor).
function FurnitureSystem.localCFrame(placement)
	local r = FurnitureSystem.rectOf(placement)
	local center = Vector3.new((r.minX + r.maxX) / 2, 0, (r.minZ + r.maxZ) / 2)
	return CFrame.new(center) * CFrame.Angles(0, math.rad(90 * placement.r), 0)
end

-- Converts a desired room-local centre point into snapped grid coordinates.
function FurnitureSystem.snap(id, localX, localZ, r)
	local def = FurnitureSystem.ById[id]
	local w, d = FurnitureSystem.footprint(def, r)
	local x = math.floor((localX - w / 2) / GRID + 0.5)
	local z = math.floor((localZ - d / 2) / GRID + 0.5)
	return x, z
end

local function isInt(value)
	return type(value) == "number" and value == value and value % 1 == 0 and math.abs(value) < 1000
end

-- The single source of truth for "is this placement allowed?".
-- `placed` is the list of existing placements, `ignoreIndex` skips one of them.
function FurnitureSystem.canPlace(placed, id, x, z, r, houseSize, ignoreIndex)
	local def = FurnitureSystem.ById[id]
	if not def then
		return false, "unknown furniture"
	end
	if not (isInt(x) and isInt(z) and isInt(r)) or r < 0 or r > 3 then
		return false, "bad position"
	end
	local candidate = { id = id, x = x, z = z, r = r }
	local area = FurnitureSystem.rectOf(candidate)
	local h = houseSize / 2
	if area.minX < -h or area.maxX > h or area.minZ < -h or area.maxZ > h then
		return false, "that's outside the room"
	end
	for _, blocked in ipairs(HouseSystem.blockedRects(houseSize)) do
		if HouseSystem.rectsOverlap(area, blocked) then
			return false, "something is already there"
		end
	end
	for index, other in ipairs(placed) do
		if index ~= ignoreIndex then
			local otherDef = FurnitureSystem.ById[other.id]
			-- Rugs only block other rugs; normal furniture ignores rugs.
			if otherDef and (otherDef.layer == "rug") == (def.layer == "rug") then
				if HouseSystem.rectsOverlap(area, FurnitureSystem.rectOf(other)) then
					return false, "overlaps other furniture"
				end
			end
		end
	end
	return true
end

-- How many copies of `id` are currently placed.
function FurnitureSystem.placedCount(placed, id)
	local n = 0
	for _, placement in ipairs(placed) do
		if placement.id == id then
			n += 1
		end
	end
	return n
end

return FurnitureSystem
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">GiftSystem</string>
          <string name="Source"><![CDATA[--[[
	GiftSystem
	As Brady grows up he gifts the PLAYER wearable pieces for their own avatar.
	These are purely cosmetic and are built out of parts by Builders/GiftBuilder
	(no catalog assets needed). One gift can be worn per slot.

	slot -> which avatar attachment it sits on:
	  Head = HatAttachment, Face = FaceFrontAttachment,
	  Neck = NeckAttachment, Back = BodyBackAttachment, Aura = BodyBackAttachment
]]

local GiftSystem = {}

local rgb = Color3.fromRGB

GiftSystem.Slots = { "Head", "Face", "Neck", "Back", "Aura" }

GiftSystem.List = {
	{ id = "gift_bucket", name = "Goo Bucket Hat", slot = "Head", age = 3, kind = "bucket", color = rgb(126, 232, 74), color2 = rgb(64, 168, 52),
		desc = "Little Brady made you match him." },
	{ id = "gift_backpack", name = "Kid Brady Backpack", slot = "Back", age = 5, kind = "backpack", color = rgb(70, 130, 230), color2 = rgb(126, 232, 74),
		desc = "he packed it with snacks. for himself." },
	{ id = "gift_chain", name = "Drippy Chain", slot = "Neck", age = 8, kind = "chain", color = rgb(215, 215, 220), color2 = rgb(126, 232, 74),
		desc = "your first chain. brady is proud." },
	{ id = "gift_shades", name = "Trendy Shades", slot = "Face", age = 10, kind = "shades", color = rgb(25, 25, 28), color2 = rgb(20, 20, 20),
		desc = "now you both can't see indoors." },
	{ id = "gift_headphones", name = "Teen Headphones", slot = "Head", age = 13, kind = "headphones", color = rgb(240, 240, 240), color2 = rgb(255, 90, 90),
		desc = "so you can ignore people together." },
	{ id = "gift_scarf", name = "Fashion Scarf", slot = "Neck", age = 16, kind = "scarf", color = rgb(150, 30, 40), color2 = rgb(236, 226, 200),
		desc = "it is not cold. it is fashion." },
	{ id = "gift_cape", name = "Archive Cape", slot = "Back", age = 18, kind = "cape", color = rgb(26, 26, 30), color2 = rgb(232, 66, 78),
		desc = "an original piece from brady's personal archive." },
	{ id = "gift_vintage_cap", name = "Vintage Goo Cap", slot = "Head", age = 21, kind = "cap", color = rgb(236, 226, 200), color2 = rgb(64, 168, 52),
		desc = "faded perfectly. smells like a thrift store." },
	{ id = "gift_crown", name = "Legendary Goo Crown", slot = "Head", age = 25, kind = "crown", color = rgb(255, 205, 60), color2 = rgb(126, 232, 74),
		desc = "you raised a legend. wear the proof." },
	{ id = "gift_aura", name = "Legendary Goo Aura", slot = "Aura", age = 25, kind = "aura", color = rgb(126, 232, 74), color2 = rgb(255, 205, 60),
		desc = "you are glowing. literally." },
}

GiftSystem.ById = {}
for _, gift in ipairs(GiftSystem.List) do
	GiftSystem.ById[gift.id] = gift
end

function GiftSystem.get(id)
	return GiftSystem.ById[id]
end

return GiftSystem
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">HouseSystem</string>
          <string name="Source"><![CDATA[--[[
	HouseSystem
	Shared layout maths for a player's room.

	The room is a square whose side grows with Brady's stage (24 -> 60 studs).
	Everything is expressed in ROOM-LOCAL studs: origin = centre of the floor,
	the front door is in the +Z wall. The server turns these into world space
	with the plot's CFrame, and the client uses the same numbers to validate
	furniture placement before asking the server.
]]

local HouseSystem = {}

HouseSystem.DoorWidth = 7
HouseSystem.FloorHeight = 1 -- floor top sits this many studs above the plot

-- Rectangles are { minX, maxX, minZ, maxZ } in room-local studs.
local function rect(minX, maxX, minZ, maxZ)
	return { minX = minX, maxX = maxX, minZ = minZ, maxZ = maxZ }
end

-- Fixed stations every room has. `rect` = floor area they block,
-- `stand` = where Brady stands to use it, `face` = direction he looks.
function HouseSystem.stations(size)
	local h = size / 2
	return {
		Bed = {
			rect = rect(-h + 0.5, -h + 6.5, -h + 0.5, -h + 8.5),
			center = Vector3.new(-h + 3.5, 0, -h + 4.5),
			stand = Vector3.new(-h + 3.5, 1.9, -h + 5.2), -- on top of the mattress
			face = Vector3.new(0, 0, 1),
		},
		Wardrobe = {
			rect = rect(-h + 8, -h + 12, -h, -h + 3),
			center = Vector3.new(-h + 10, 0, -h + 1.5),
			stand = Vector3.new(-h + 10, 0, -h + 5.5),
			face = Vector3.new(0, 0, 1),
		},
		Mirror = {
			rect = rect(-h + 13, -h + 17, -h, -h + 1.5),
			center = Vector3.new(-h + 15, 0, -h + 0.75),
			stand = Vector3.new(-h + 15, 0, -h + 5),
			face = Vector3.new(0, 0, 1),
		},
		Display = {
			rect = rect(h - 5.5, h - 0.5, -h, -h + 3.5),
			center = Vector3.new(h - 3, 0, -h + 1.75),
			stand = Vector3.new(h - 3, 0, -h + 6),
			face = Vector3.new(0, 0, -1),
		},
		Food = {
			rect = rect(h - 3.5, h - 0.5, -h + 6, -h + 12),
			center = Vector3.new(h - 2, 0, -h + 9),
			stand = Vector3.new(h - 6, 0, -h + 9),
			face = Vector3.new(1, 0, 0),
		},
		Trophy = {
			rect = rect(h - 2, h, h - 11, h - 7),
			center = Vector3.new(h - 1, 0, h - 9),
			stand = Vector3.new(h - 4, 0, h - 9),
			face = Vector3.new(1, 0, 0),
		},
		Podium = {
			rect = rect(h - 7, h - 1, h - 7, h - 1),
			center = Vector3.new(h - 4, 0, h - 4),
			stand = Vector3.new(h - 4, 1, h - 4), -- on top of the podium
			face = Vector3.new(-1, 0, -1),
		},
		Shower = {
			rect = rect(-h + 0.5, -h + 5.5, h - 5.5, h - 0.5),
			center = Vector3.new(-h + 3, 0, h - 3),
			stand = Vector3.new(-h + 3, 0.3, h - 3),
			face = Vector3.new(1, 0, -1),
		},
		Sink = {
			rect = rect(-h, -h + 3, h - 10, h - 7),
			center = Vector3.new(-h + 1.5, 0, h - 8.5),
			stand = Vector3.new(-h + 4.5, 0, h - 8.5),
			face = Vector3.new(-1, 0, 0),
		},
		ShoeMat = {
			rect = rect(-6.5, -3.5, h - 3, h - 1),
			center = Vector3.new(-5, 0, h - 2),
			stand = Vector3.new(-5, 0, h - 2),
			face = Vector3.new(0, 0, -1),
		},
	}
end

-- Floor areas furniture may not cover (stations + the doorway).
function HouseSystem.blockedRects(size)
	local h = size / 2
	local list = {}
	for _, station in pairs(HouseSystem.stations(size)) do
		table.insert(list, station.rect)
	end
	local doorHalf = HouseSystem.DoorWidth / 2
	table.insert(list, rect(-doorHalf, doorHalf, h - 4, h))
	return list
end

function HouseSystem.rectsOverlap(a, b)
	return a.minX < b.maxX and a.maxX > b.minX and a.minZ < b.maxZ and a.maxZ > b.minZ
end

function HouseSystem.pointInRect(x, z, r, margin)
	margin = margin or 0
	return x > r.minX - margin and x < r.maxX + margin and z > r.minZ - margin and z < r.maxZ + margin
end

-- Local CFrame (position + facing) Brady uses at a station.
function HouseSystem.standCFrame(size, stationName)
	local station = HouseSystem.stations(size)[stationName]
	local pos = station.stand
	return CFrame.lookAt(pos, pos + station.face)
end

-- Is a local point inside the room (used for "Brady must be home" checks)?
function HouseSystem.isInside(size, localPosition, margin)
	local h = size / 2 + (margin or 0)
	return math.abs(localPosition.X) <= h and math.abs(localPosition.Z) <= h
end

-- Spot just outside the front door (visitors and "Go Home" land here).
function HouseSystem.doorstep(size)
	local h = size / 2
	return CFrame.lookAt(Vector3.new(0, 0, h + 5), Vector3.new(0, 0, 0))
end

HouseSystem.rect = rect

return HouseSystem
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">InventorySystem</string>
          <string name="Source"><![CDATA[--[[
	InventorySystem
	Pure helper functions that read a player's data table.

	The SERVER uses these to validate every equip request. The CLIENT uses the
	exact same functions to decide what to grey out, so the UI and the rules
	can never disagree. Nothing in here mutates data on the client's behalf:
	changes only ever happen in ServerScriptService/Services/ClothingServer.
]]

local Modules = script.Parent
local AgeSystem = require(Modules.AgeSystem)
local ClothingSystem = require(Modules.ClothingSystem)

local InventorySystem = {}

function InventorySystem.owns(data, itemId)
	return data.inventory[itemId] == true
end

-- Can this player put this item on Brady right now?
function InventorySystem.canEquip(data, itemId)
	local item = ClothingSystem.get(itemId)
	if not item then
		return false, "that item does not exist"
	end
	if not InventorySystem.owns(data, itemId) then
		return false, "you don't own that"
	end
	if not AgeSystem.isSlotUnlocked(item.slot, data.age) then
		return false, ClothingSystem.SlotInfo[item.slot].plural .. " unlock at age " .. AgeSystem.slotUnlockAge(item.slot)
	end
	if data.age < item.age then
		return false, "Brady must be age " .. item.age
	end
	return true
end

function InventorySystem.isEquipped(data, itemId)
	local item = ClothingSystem.get(itemId)
	return item ~= nil and data.equipped[item.slot] == itemId
end

-- Owned items, optionally filtered to one slot, rarest first.
function InventorySystem.ownedItems(data, slot)
	local list = {}
	for itemId in pairs(data.inventory) do
		local item = ClothingSystem.get(itemId)
		if item and (slot == nil or item.slot == slot) then
			table.insert(list, item)
		end
	end
	return ClothingSystem.sortItems(list)
end

function InventorySystem.countOwned(data, predicate)
	local n = 0
	for itemId in pairs(data.inventory) do
		local item = ClothingSystem.get(itemId)
		if item and (predicate == nil or predicate(item)) then
			n += 1
		end
	end
	return n
end

function InventorySystem.countRarity(data, rarity)
	return InventorySystem.countOwned(data, function(item)
		return item.rarity == rarity
	end)
end

-- List of the item definitions Brady is currently wearing.
function InventorySystem.equippedItems(equipped)
	local list = {}
	for _, slot in ipairs(ClothingSystem.Slots) do
		local item = equipped[slot] and ClothingSystem.get(equipped[slot])
		if item then
			table.insert(list, item)
		end
	end
	return list
end

-- "Drip score": how fashionable the current fit is. Used for the fashion
-- show judges, event rewards and the "BRADY IS DRIPPED OUT!" popup.
function InventorySystem.dripScore(equipped)
	local score = 0
	for _, item in ipairs(InventorySystem.equippedItems(equipped)) do
		local points = ClothingSystem.Rarities[item.rarity].points
		if item.slot == "Outfit" then
			points *= 3 -- a full outfit covers several slots
		elseif item.slot == "Hair" then
			points *= 0.5
		end
		if item.fx then
			points += 2
		end
		score += points
	end
	return score
end

-- A fit is "bad" when Brady is missing basics. He gets embarrassed about it.
function InventorySystem.isBadFit(equipped)
	if equipped.Outfit then
		return false
	end
	return equipped.Shirt == nil or equipped.Pants == nil
end

-- Highest rarity currently worn (for nameplates / titles).
function InventorySystem.bestRarity(equipped)
	local best, bestOrder = nil, 0
	for _, item in ipairs(InventorySystem.equippedItems(equipped)) do
		local order = ClothingSystem.rarityOrder(item.rarity)
		if order > bestOrder then
			best, bestOrder = item.rarity, order
		end
	end
	return best
end

-- Walk / idle animation overrides + nameplate style from special pieces.
function InventorySystem.specials(equipped)
	local result = { walk = nil, idle = nil, nameplate = nil, spawn = false }
	local bestWalk, bestIdle = 0, 0
	for _, item in ipairs(InventorySystem.equippedItems(equipped)) do
		local order = ClothingSystem.rarityOrder(item.rarity)
		if item.walk and order > bestWalk then
			result.walk, bestWalk = item.walk, order
		end
		if item.idle and order > bestIdle then
			result.idle, bestIdle = item.idle, order
		end
		if item.nameplate then
			result.nameplate = item.nameplate
		end
		if item.spawn then
			result.spawn = true
		end
	end
	return result
end

-- Poses the player may use: stage poses + Grail item poses + pass poses.
function InventorySystem.unlockedPoses(data, passes)
	local stageIndex = AgeSystem.getStageIndex(data.age)
	local itemPoses = {}
	for itemId in pairs(data.inventory) do
		local item = ClothingSystem.get(itemId)
		if item and item.pose then
			itemPoses[item.pose] = true
		end
	end
	local list = {}
	for _, pose in ipairs(AgeSystem.Poses) do
		local unlocked
		if pose.stage then
			unlocked = stageIndex >= pose.stage
		elseif pose.item then
			unlocked = itemPoses[pose.id] == true
		elseif pose.pass then
			unlocked = passes ~= nil and passes[pose.pass] == true
		end
		if unlocked then
			table.insert(list, pose)
		end
	end
	return list
end

function InventorySystem.isPoseUnlocked(data, passes, poseId)
	for _, pose in ipairs(InventorySystem.unlockedPoses(data, passes)) do
		if pose.id == poseId then
			return true
		end
	end
	return false
end

return InventorySystem
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">MinigameSystem</string>
          <string name="Source"><![CDATA[--[[
	MinigameSystem
	Definitions for the "Play with Brady" mini-games and the reward formula.

	The mini-games themselves run on the client (they are UI games), so the
	server never trusts the reported score blindly: it clamps the score to
	maxScore, checks the round lasted a believable amount of time, charges
	energy up front and enforces a cooldown. See Services/MinigameServer.
]]

local MinigameSystem = {}

-- duration  seconds the client game runs for
-- minTime   fastest a real round could possibly finish
-- maxScore  best score the game can produce
-- coins/xp  reward for a perfect score (before age multiplier)
MinigameSystem.List = {
	{ id = "catch", name = "Catch the Ball", icon = "⚾", minAge = 1, duration = 20, minTime = 12, maxScore = 20, coins = 34, xp = 46,
		desc = "drag Brady left and right. catch balls. dodge the socks." },
	{ id = "target", name = "Click the Target", icon = "🎯", minAge = 1, duration = 20, minTime = 12, maxScore = 25, coins = 34, xp = 46,
		desc = "tap the targets before they vanish." },
	{ id = "reaction", name = "Reaction Test", icon = "⚡", minAge = 1, duration = 25, minTime = 6, maxScore = 100, coins = 28, xp = 40,
		desc = "wait for green. tap as fast as you can. 5 rounds." },
	{ id = "obby", name = "Goo Obby", icon = "🏃", minAge = 3, duration = 120, minTime = 9, maxScore = 100, coins = 60, xp = 80, world = true,
		desc = "run the obstacle course in the mini-game area." },
	{ id = "soccer", name = "Goo Soccer", icon = "⚽", minAge = 5, duration = 40, minTime = 8, maxScore = 5, coins = 40, xp = 55,
		desc = "5 penalty kicks against a very sweaty goalie." },
	{ id = "dance", name = "Dance Battle", icon = "🕺", minAge = 8, duration = 25, minTime = 15, maxScore = 30, coins = 46, xp = 64,
		desc = "hit the arrows on the beat." },
}

MinigameSystem.ById = {}
for _, def in ipairs(MinigameSystem.List) do
	MinigameSystem.ById[def.id] = def
end

function MinigameSystem.get(id)
	return MinigameSystem.ById[id]
end

-- Reward for a score. `multiplier` = age multiplier * arcade bonus etc.
-- Even a terrible round pays a little so playing never feels wasted.
function MinigameSystem.rewards(def, score, multiplier)
	local ratio = math.clamp(score / def.maxScore, 0, 1)
	local coins = math.floor(def.coins * (0.15 + 0.85 * ratio) * multiplier + 0.5)
	local xp = math.floor(def.xp * (0.25 + 0.75 * ratio) + 0.5)
	return coins, xp, ratio
end

return MinigameSystem
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">Monetization</string>
          <string name="Source"><![CDATA[--[[
	Monetization
	Optional, cosmetic / convenience-only gamepasses. Nothing here is needed to
	progress, there is no way to buy Goo Coins, and no pass affects fashion
	show judging.

	HOW TO TURN A PASS ON
	  1. Publish the game, open Creator Dashboard > your experience >
	     Monetization > Passes and create the pass.
	  2. Copy its numeric ID into the matching `id` below.
	A pass whose id is 0 is simply treated as "not for sale yet".
]]

local Monetization = {}

Monetization.Passes = {
	{ key = "ExtraOutfits", id = 0, name = "Extra Outfit Slots", icon = "👔",
		desc = "Save 8 outfits in the wardrobe instead of 3." },
	{ key = "VIPDecor", id = 0, name = "VIP Room Decorations", icon = "💎",
		desc = "Unlocks the VIP decoration set in the room shop." },
	{ key = "ExtraStorage", id = 0, name = "Extra Storage", icon = "📦",
		desc = "Place up to 100 pieces of furniture and stack 99 of each food." },
	{ key = "SpecialEmotes", id = 0, name = "Special Emotes", icon = "🕺",
		desc = "Three extra poses for Brady: T-Pose, Goo Shuffle and Dramatic Faint." },
	{ key = "FastDecorating", id = 0, name = "Faster Room Customizing", icon = "⚡",
		desc = "Keep placing the same furniture without reopening the menu." },
	{ key = "CosmeticEffects", id = 0, name = "Cosmetic Effects", icon = "🌈",
		desc = "Pick a sparkle, goo or rainbow trail aura for Brady. Looks only." },
}

Monetization.ByKey = {}
for _, pass in ipairs(Monetization.Passes) do
	Monetization.ByKey[pass.key] = pass
end

-- Auras the Cosmetic Effects pass lets you choose (fx keys from BradyBuilder).
Monetization.Auras = { "none", "sparkle", "goo", "rainbow", "stars" }

return Monetization
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--[[
	Remotes
	One place that declares every RemoteEvent / RemoteFunction in the game.

	The SERVER calls Remotes.setup() once at boot, which creates them all inside
	ReplicatedStorage.Remotes. The CLIENT just calls Remotes.event(name) /
	Remotes.func(name), which wait for the server-made instance.

	Declaring the full list up front means a typo in a remote name errors
	immediately instead of hanging forever on WaitForChild.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Remotes = {}

Remotes.Events = {
	-- server -> client
	"DataUpdate", -- ({ data = {...}, session = {...} }) replaces top-level keys
	"Notify", -- ({ text, sub, kind, sound, big })
	"AgeUp", -- ({ age, stage, stageChanged, coins, unlocks })
	"ItemGranted", -- ({ kind, id, name, rarity, isNew, refund, source })
	"EventUpdate", -- (eventState | nil)
	"FashionState", -- (state table)
	"Effect", -- (kind, payload) world effects such as confetti
	"OpenPanel", -- (panelName, arg) ask the client to open a UI panel
	"HiddenFound", -- (spotIndex)
	"ObbyState", -- ({ running, startedAt, result })

	-- client -> server
	"Care", -- (action, arg)
	"Equip", -- (itemId)
	"Unequip", -- (slot)
	"SaveOutfit", -- (index)
	"LoadOutfit", -- (index)
	"EquipGift", -- (giftId)
	"UnequipGift", -- (slot)
	"PlaceFurniture", -- (id, x, z, rot)
	"RemoveFurniture", -- (placedIndex)
	"EventAction", -- (action, arg)
	"Fashion", -- (action, arg)
	"ClaimDaily", -- ()
	"ClaimTask", -- (index)
	"ClaimCollection", -- (collectionId)
	"SetPose", -- (poseId)
	"Mirror", -- (enter: boolean)
	"Setting", -- (key, value)
	"Tutorial", -- (action)
	"Visit", -- (userId | "Home" | "Plaza" | "Runway")
	"Hype", -- (userId)
	"Rebirth", -- ()
}

Remotes.Functions = {
	"GetData", -- () -> { data, session }
	"Buy", -- (kind, id, quantity) -> { ok, reason }
	"OpenCrate", -- (crateId) -> { ok, reason, itemId, isNew, refund }
	"MinigameStart", -- (gameId) -> { ok, reason, token }
	"MinigameFinish", -- (token, score) -> { ok, coins, xp }
	"GetProfile", -- (userId) -> public profile table
}

local FOLDER_NAME = "Remotes"
local folder

local function getFolder()
	if folder then
		return folder
	end
	if RunService:IsServer() then
		folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = FOLDER_NAME
			folder.Parent = ReplicatedStorage
		end
	else
		folder = ReplicatedStorage:WaitForChild(FOLDER_NAME)
	end
	return folder
end

-- Server only: create every declared remote.
function Remotes.setup()
	assert(RunService:IsServer(), "Remotes.setup() must run on the server")
	local parent = getFolder()
	for _, name in ipairs(Remotes.Events) do
		if not parent:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = parent
		end
	end
	for _, name in ipairs(Remotes.Functions) do
		if not parent:FindFirstChild(name) then
			local remote = Instance.new("RemoteFunction")
			remote.Name = name
			remote.Parent = parent
		end
	end
end

function Remotes.event(name)
	assert(table.find(Remotes.Events, name), "Unknown RemoteEvent: " .. tostring(name))
	local parent = getFolder()
	if RunService:IsServer() then
		return parent:FindFirstChild(name)
	end
	return parent:WaitForChild(name)
end

function Remotes.func(name)
	assert(table.find(Remotes.Functions, name), "Unknown RemoteFunction: " .. tostring(name))
	local parent = getFolder()
	if RunService:IsServer() then
		return parent:FindFirstChild(name)
	end
	return parent:WaitForChild(name)
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">ShopSystem</string>
          <string name="Source"><![CDATA[--[[
	ShopSystem
	Crate ("haul") definitions and the weighted roll that picks what drops.

	Crates are bought with Goo Coins only. Goo Coins cannot be bought with
	Robux anywhere in this game, so crates are never a paid random item, and
	the odds are still shown to the player in the shop.
]]

local Modules = script.Parent
local Util = require(Modules.Util)
local ClothingSystem = require(Modules.ClothingSystem)

local ShopSystem = {}

local rgb = Color3.fromRGB

-- odds = relative weight per rarity. Grail is intentionally tiny.
ShopSystem.Crates = {
	{
		id = "thrift_bin", name = "Thrift Bin", icon = "🧺", price = 250, minAge = 1, color = rgb(120, 200, 120),
		desc = "dig through the bin. mostly basics. sometimes magic.",
		odds = { Common = 55, Uncommon = 32, Rare = 11, Epic = 2 },
	},
	{
		id = "designer_drop", name = "Designer Drop", icon = "🛍️", price = 1500, minAge = 10, color = rgb(90, 150, 255),
		desc = "limited release. he camped outside for it.",
		odds = { Uncommon = 34, Rare = 44, Epic = 18, Legendary = 3.7, Archive = 0.3 },
	},
	{
		id = "archive_vault", name = "Archive Vault", icon = "🗄️", price = 6000, minAge = 18, color = rgb(232, 66, 78),
		desc = "pieces from collections older than brady.",
		odds = { Rare = 30, Epic = 42, Legendary = 19, Archive = 8.6, Grail = 0.4 },
	},
	{
		id = "grail_vault", name = "Grail Vault", icon = "🏆", price = 20000, minAge = 21, color = rgb(255, 110, 225),
		desc = "the best odds anywhere. still brutal.",
		odds = { Epic = 40, Legendary = 36, Archive = 22, Grail = 2 },
	},
}

-- Loot table for the "BRADY FOUND A GRAIL" random event box (never bought).
ShopSystem.EventBox = { id = "event_box", name = "Mystery Box", odds = { Uncommon = 30, Rare = 40, Epic = 22, Legendary = 6.5, Archive = 1.3, Grail = 0.2 } }
-- Day 7 daily reward roll.
ShopSystem.DailyBox = { id = "daily_box", name = "Daily Fashion Item", odds = { Rare = 50, Epic = 36, Legendary = 12, Archive = 2 } }

ShopSystem.CrateById = {}
for _, crate in ipairs(ShopSystem.Crates) do
	ShopSystem.CrateById[crate.id] = crate
end

-- Droppable items grouped by rarity.
local pool = {}
for _, rarity in ipairs(ClothingSystem.RarityOrder) do
	pool[rarity] = {}
end
for _, item in ipairs(ClothingSystem.List) do
	if item.drop then
		table.insert(pool[item.rarity], item)
	end
end
ShopSystem.Pool = pool

-- Odds as percentages for the UI: { { rarity = "Common", percent = 55 }, ... }
function ShopSystem.oddsList(crate)
	local total = 0
	for _, weight in pairs(crate.odds) do
		total += weight
	end
	local list = {}
	for _, rarity in ipairs(ClothingSystem.RarityOrder) do
		local weight = crate.odds[rarity]
		if weight then
			table.insert(list, { rarity = rarity, percent = weight / total * 100 })
		end
	end
	return list
end

-- Rolls a crate. Returns an item definition (never nil for a valid crate).
-- `rng` is optional (a Random object) so tests can be deterministic.
function ShopSystem.roll(crate, rng)
	local entries = {}
	for rarity, weight in pairs(crate.odds) do
		if #pool[rarity] > 0 then
			table.insert(entries, { rarity = rarity, weight = weight })
		end
	end
	-- Sort so the roll does not depend on dictionary iteration order.
	table.sort(entries, function(a, b)
		return ClothingSystem.rarityOrder(a.rarity) < ClothingSystem.rarityOrder(b.rarity)
	end)
	local chosen = Util.weighted(entries, function(entry)
		return entry.weight
	end, rng)
	if not chosen then
		return nil
	end
	return Util.pick(pool[chosen.rarity], rng)
end

return ShopSystem
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">Sounds</string>
          <string name="Source"><![CDATA[--[[
	Sounds
	Central sound table. Every entry uses a sound file that ships inside the
	Roblox client (rbxasset://), so the game has audio without you uploading or
	licensing anything. `speed` re-pitches a sound, which is where most of the
	"funny" comes from.

	TO USE YOUR OWN AUDIO: replace an id with "rbxassetid://123456" for any
	audio asset your experience has permission to use. Set Sounds.Music to an
	asset id to get background music (it is empty by default).

	If a built-in file is ever missing on some client, that one sound simply
	stays silent - nothing breaks.
]]

local Sounds = {}

Sounds.Music = "" -- e.g. "rbxassetid://1234567890"
Sounds.MusicVolume = 0.25

Sounds.List = {
	click = { id = "rbxasset://sounds/button.wav", volume = 0.5 },
	tab = { id = "rbxasset://sounds/switch.wav", volume = 0.4 },
	open = { id = "rbxasset://sounds/pageturn.wav", volume = 0.5 },
	coin = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.5, speed = 1.3 },
	error = { id = "rbxasset://sounds/collide.wav", volume = 0.4, speed = 0.7 },
	notify = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.6 },
	ageUp = { id = "rbxasset://sounds/victory.wav", volume = 0.7 },
	ageUpGoofy = { id = "rbxasset://sounds/uuhhh.mp3", volume = 0.6, speed = 1.9 },
	item = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.6, speed = 0.8 },
	rare = { id = "rbxasset://sounds/victory.wav", volume = 0.6, speed = 1.3 },
	grail = { id = "rbxasset://sounds/victory.wav", volume = 0.9, speed = 0.7 },
	eat = { id = "rbxasset://sounds/snap.mp3", volume = 0.5, speed = 0.8 },
	splash = { id = "rbxasset://sounds/impact_water.mp3", volume = 0.5 },
	snore = { id = "rbxasset://sounds/uuhhh.mp3", volume = 0.3, speed = 0.45 },
	trip = { id = "rbxasset://sounds/uuhhh.mp3", volume = 0.5, speed = 1.5 },
	jump = { id = "rbxasset://sounds/action_jump.mp3", volume = 0.4 },
	place = { id = "rbxasset://sounds/Kerplunk.wav", volume = 0.5 },
	remove = { id = "rbxasset://sounds/swoosh.wav", volume = 0.5 },
	camera = { id = "rbxasset://sounds/flashbulb.wav", volume = 0.6 },
	good = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.5, speed = 1.6 },
	bad = { id = "rbxasset://sounds/splat.wav", volume = 0.4 },
	event = { id = "rbxasset://sounds/bass.wav", volume = 0.6, speed = 1.2 },
	crate = { id = "rbxasset://sounds/clickfast.wav", volume = 0.5 },
	hype = { id = "rbxasset://sounds/button.wav", volume = 0.5, speed = 1.5 },
}

return Sounds
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">Util</string>
          <string name="Source"><![CDATA[--[[
	Util
	Small pure-Luau helpers shared by the server and the client.
	Nothing in here touches Roblox services, so it is safe to require anywhere.
]]

local Util = {}

----------------------------------------------------------------------
-- Signal: a tiny event object (Connect / Fire) so modules can talk to
-- each other without creating BindableEvent instances.
----------------------------------------------------------------------
local Signal = {}
Signal.__index = Signal

function Signal.new()
	return setmetatable({ _handlers = {} }, Signal)
end

function Signal:Connect(fn)
	local handlers = self._handlers
	local entry = { fn = fn }
	table.insert(handlers, entry)
	local connection = { Connected = true }
	function connection.Disconnect()
		if not connection.Connected then
			return
		end
		connection.Connected = false
		local index = table.find(handlers, entry)
		if index then
			table.remove(handlers, index)
		end
	end
	return connection
end

function Signal:Fire(...)
	-- Copy first so handlers can disconnect themselves while we iterate.
	for _, entry in ipairs(table.clone(self._handlers)) do
		task.spawn(entry.fn, ...)
	end
end

Util.Signal = Signal

----------------------------------------------------------------------
-- Tables
----------------------------------------------------------------------
function Util.deepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in pairs(value) do
		copy[k] = Util.deepCopy(v)
	end
	return copy
end

function Util.count(dict)
	local n = 0
	for _ in pairs(dict) do
		n += 1
	end
	return n
end

function Util.keys(dict)
	local list = {}
	for k in pairs(dict) do
		table.insert(list, k)
	end
	return list
end

----------------------------------------------------------------------
-- Numbers
----------------------------------------------------------------------
-- True only for real, finite numbers (rejects NaN / inf sent by exploiters).
function Util.isNumber(value)
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

function Util.round(value)
	return math.floor(value + 0.5)
end

-- 1234567 -> "1,234,567"
function Util.commas(value)
	local text = tostring(math.floor(value))
	local formatted = text
	while true do
		local replaced
		formatted, replaced = string.gsub(formatted, "^(-?%d+)(%d%d%d)", "%1,%2")
		if replaced == 0 then
			break
		end
	end
	return formatted
end

-- 1234 -> "1,234"   1250000 -> "1.25M"
function Util.short(value)
	value = math.floor(value)
	if value < 100000 then
		return Util.commas(value)
	elseif value < 1000000 then
		return string.format("%.1fK", value / 1000)
	elseif value < 1000000000 then
		return string.format("%.2fM", value / 1000000)
	end
	return string.format("%.2fB", value / 1000000000)
end

-- 75 -> "1:15"
function Util.clock(seconds)
	seconds = math.max(0, math.floor(seconds))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

-- Day number in UTC. Used for daily rewards / daily tasks.
function Util.today()
	return os.time() // 86400
end

----------------------------------------------------------------------
-- Random
----------------------------------------------------------------------
-- Picks one entry from `list` where weightOf(entry) returns its weight.
function Util.weighted(list, weightOf, rng)
	local total = 0
	for _, entry in ipairs(list) do
		total += math.max(0, weightOf(entry))
	end
	if total <= 0 then
		return nil
	end
	local roll = (rng and rng:NextNumber() or math.random()) * total
	for _, entry in ipairs(list) do
		roll -= math.max(0, weightOf(entry))
		if roll <= 0 then
			return entry
		end
	end
	return list[#list]
end

function Util.pick(list, rng)
	if #list == 0 then
		return nil
	end
	local index = rng and rng:NextInteger(1, #list) or math.random(1, #list)
	return list[index]
end

return Util
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="35">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="36">
      <Properties>
        <string name="Name">Main</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--[[
	Main (server entry point)
	The one Script that boots the whole game.

	Every system lives in a ModuleScript under Services/. This script requires
	them in a fixed order, hands each one the shared `S` table (so services can
	call each other without circular requires), and runs the player lifecycle:

	    join  -> load data -> each service's playerAdded() -> mark ready
	    leave -> each service's playerRemoving() -> final save

	One script deciding the order avoids the race conditions you get when many
	separate Scripts all start at once and hope the others are ready.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Modules.Remotes)
Remotes.setup() -- create every RemoteEvent / RemoteFunction first

local Services = script.Parent.Services
local MapBuilder = require(script.Parent.World.MapBuilder)

-- Shared service table. S.Brady, S.Data ... are filled in below.
local S = {}
S.Map = MapBuilder.build()

local LOAD_ORDER = {
	{ "Data", "DataServer" },
	{ "Net", "Net" },
	{ "Currency", "CurrencyServer" },
	{ "Achievements", "AchievementServer" },
	{ "Daily", "DailyServer" },
	{ "Passes", "MonetizationServer" },
	{ "House", "HouseServer" },
	{ "Brady", "BradyServer" },
	{ "Clothing", "ClothingServer" },
	{ "Age", "AgeServer" },
	{ "Care", "CareServer" },
	{ "Gifts", "GiftServer" },
	{ "Minigames", "MinigameServer" },
	{ "Shop", "ShopServer" },
	{ "Events", "EventServer" },
	{ "Fashion", "FashionServer" },
	{ "Collection", "CollectionServer" },
	{ "Social", "SocialServer" },
}

local ordered = {}
for _, entry in ipairs(LOAD_ORDER) do
	local service = require(Services:WaitForChild(entry[2]))
	S[entry[1]] = service
	table.insert(ordered, { name = entry[1], service = service })
end

-- Runs fn and logs (instead of propagating) any error, with a traceback.
local function safe(label, fn, ...)
	local ok, err = xpcall(fn, debug.traceback, ...)
	if not ok then
		warn("[Main] " .. label .. " failed:\n" .. tostring(err))
	end
	return ok
end

for _, entry in ipairs(ordered) do
	if entry.service.init then
		safe(entry.name .. ".init", entry.service.init, S)
	end
end
for _, entry in ipairs(ordered) do
	if entry.service.start then
		safe(entry.name .. ".start", entry.service.start)
	end
end

----------------------------------------------------------------------
-- Player lifecycle
----------------------------------------------------------------------
local function onPlayerAdded(player)
	local data = S.Data.load(player) -- yields; kicks the player if loading fails
	if not data or not player.Parent then
		return
	end
	for _, entry in ipairs(ordered) do
		if entry.service.playerAdded then
			safe(entry.name .. ".playerAdded", entry.service.playerAdded, player, data)
		end
	end
	S.Data.markReady(player)
end

local function onPlayerRemoving(player)
	if not S.Data.get(player) then
		return
	end
	for index = #ordered, 1, -1 do
		local entry = ordered[index]
		if entry.service.playerRemoving then
			safe(entry.name .. ".playerRemoving", entry.service.playerRemoving, player)
		end
	end
	S.Data.release(player) -- final save + unlock
end

Players.PlayerAdded:Connect(function(player)
	safe("playerAdded", onPlayerAdded, player)
end)
Players.PlayerRemoving:Connect(function(player)
	safe("playerRemoving", onPlayerRemoving, player)
end)
-- Players who joined before this script finished starting (common in Studio).
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(safe, "playerAdded", onPlayerAdded, player)
end

-- Save everyone when the server shuts down.
game:BindToClose(function()
	S.Data.shutdown()
end)

----------------------------------------------------------------------
-- One shared 1-second heartbeat instead of a loop per system.
----------------------------------------------------------------------
task.spawn(function()
	while true do
		task.wait(1)
		for _, entry in ipairs(ordered) do
			if entry.service.tick then
				safe(entry.name .. ".tick", entry.service.tick)
			end
		end
	end
end)

print("[Raise Brady Goo] server ready")
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="37">
      <Properties>
        <string name="Name">Services</string>
      </Properties>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">AchievementServer</string>
          <string name="Source"><![CDATA[--[[
	AchievementServer
	Owns the stat counters (feeds, mini-games played, ...) and unlocks
	achievements when their condition is met. Each achievement can only ever
	pay out once because the flag is written before the coins are granted.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage.Modules
local AchievementSystem = require(Modules.AchievementSystem)

local AchievementServer = {}

local S

function AchievementServer.init(services)
	S = services
end

-- Checks every locked achievement for this player.
function AchievementServer.check(player)
	local data = S.Data.get(player)
	if not data then
		return
	end
	local unlocked = false
	for _, def in ipairs(AchievementSystem.List) do
		if not data.achievements[def.id] and AchievementSystem.isComplete(def, data) then
			data.achievements[def.id] = true -- flag first: no double payouts
			unlocked = true
			S.Net.notify(player, { text = "ACHIEVEMENT UNLOCKED!", sub = def.name .. "  +" .. def.coins .. " Goo Coins", kind = "good", sound = "rare" })
			S.Currency.add(player, def.coins, "achievement")
		end
	end
	if unlocked then
		S.Data.sync(player, "achievements")
	end
end

-- Adds to a stat counter, advances daily tasks and re-checks achievements.
function AchievementServer.bump(player, stat, amount)
	local data = S.Data.get(player)
	if not data then
		return
	end
	amount = amount or 1
	data.stats[stat] = (data.stats[stat] or 0) + amount
	S.Data.sync(player, "stats")
	S.Daily.progress(player, stat, amount)
	AchievementServer.check(player)
end

function AchievementServer.playerAdded(player)
	-- Catches achievements earned by rule changes while the player was away.
	AchievementServer.check(player)
end

return AchievementServer
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">AgeServer</string>
          <string name="Source"><![CDATA[--[[
	AgeServer
	Age XP, ageing up, stage rewards and rebirth. Server authoritative: the
	client only ever receives the results.

	When Brady ages up:
	  * Goo Coins are paid
	  * reaching a new STAGE also unlocks a clothing category, a hairstyle,
	    clothing, a room item, a pose, a gift for the player's own avatar and a
	    bigger house
	  * Brady celebrates and the client plays the "BRADY AGED UP!" sequence

	Stage item rewards are idempotent: data.stageRewards[stage] is set before
	anything is handed out, so they cannot be claimed twice.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage.Modules
local AgeSystem = require(Modules.AgeSystem)
local ClothingSystem = require(Modules.ClothingSystem)
local CurrencySystem = require(Modules.CurrencySystem)
local Dialogue = require(Modules.Dialogue)
local FurnitureSystem = require(Modules.FurnitureSystem)
local GiftSystem = require(Modules.GiftSystem)
local InventorySystem = require(Modules.InventorySystem)

local AgeServer = {}

local S

-- Hair ids that are the default look of some stage.
local stageHair = {}
for _, stage in ipairs(AgeSystem.Stages) do
	stageHair[stage.look.hair] = true
end

-- Hands out everything a stage unlocks. Returns a list of text lines for the UI.
local function grantStageRewards(player, data, stage)
	local lines = {}
	local rewards = stage.rewards
	local key = tostring(stage.index)
	local firstTime = not data.stageRewards[key]
	data.stageRewards[key] = true

	if rewards.coins then
		local coins = math.floor(rewards.coins * (1 + 0.25 * data.rebirths))
		S.Currency.add(player, coins, "stage")
		table.insert(lines, "+" .. coins .. " Goo Coins")
	end
	table.insert(lines, "Unlocked: " .. stage.unlockText)
	if stage.interaction then
		table.insert(lines, "New: " .. stage.interaction)
	end

	if firstTime then
		for _, itemId in ipairs(rewards.items or {}) do
			local item = ClothingSystem.get(itemId)
			if item and not data.inventory[itemId] then
				data.inventory[itemId] = true
				table.insert(lines, "New " .. item.rarity .. " item: " .. item.name)
			end
		end
		if rewards.furniture and FurnitureSystem.get(rewards.furniture) then
			local owned = data.furniture.owned
			owned[rewards.furniture] = (owned[rewards.furniture] or 0) + 1
			table.insert(lines, "New room item: " .. FurnitureSystem.get(rewards.furniture).name)
		end
		for _, giftId in ipairs({ rewards.gift, rewards.gift2 }) do
			local gift = GiftSystem.get(giftId)
			if gift and not data.gifts.owned[giftId] then
				data.gifts.owned[giftId] = true
				table.insert(lines, "Brady gifted YOU: " .. gift.name)
			end
		end
		if rewards.pose and AgeSystem.PoseById[rewards.pose] then
			table.insert(lines, "New pose: " .. AgeSystem.PoseById[rewards.pose].name)
		end
	end

	-- Switch to the new stage's hairstyle unless the player picked a custom one.
	local hair = data.equipped.Hair
	if hair == nil or stageHair[hair] then
		data.equipped.Hair = stage.look.hair
	end
	S.Data.sync(player, "inventory", "equipped", "furniture", "gifts", "stageRewards")
	return lines
end

local function onAgeUp(player, data, newAge)
	local oldStage = AgeSystem.getStageIndex(data.age)
	data.age = newAge
	local stage = AgeSystem.getStage(newAge)
	local stageChanged = stage.index ~= oldStage

	local coins = math.floor(CurrencySystem.ageUpReward(newAge) * (1 + 0.25 * data.rebirths))
	S.Currency.add(player, coins, "ageUp")

	local lines = { "+" .. coins .. " Goo Coins" }
	if stageChanged then
		for _, line in ipairs(grantStageRewards(player, data, stage)) do
			table.insert(lines, line)
		end
	end

	S.Data.sync(player, "age", "ageXP")
	S.Net.fire(player, "AgeUp", {
		age = newAge,
		stageChanged = stageChanged,
		stageName = stage.name,
		blurb = stage.blurb,
		lines = lines,
	})

	-- A bigger house for a bigger Brady, then the new look.
	if stageChanged then
		S.House.upgrade(player)
		S.Gifts.refresh(player)
	end
	S.Brady.rebuild(player)
	local rec = S.Brady.get(player)
	if rec then
		S.Brady.act(rec, "Celebrate", 3.5)
		S.Brady.say(rec, Dialogue.pick(stageChanged and "stageUp" or "ageUp"))
	end
	S.Net.fireAll("Effect", "Confetti", { userId = player.UserId })
	S.Achievements.bump(player, "ageUps", 1)
end

-- Gives Age XP. `opts.raw` skips the age / mood multipliers.
-- Returns the XP actually awarded.
function AgeServer.addXP(player, base, opts)
	local data = S.Data.get(player)
	if not data or base <= 0 then
		return 0
	end
	if data.age >= AgeSystem.MaxAge then
		return 0
	end
	local amount = base
	if not (opts and opts.raw) then
		amount *= AgeSystem.rewardMultiplier(data.age, data.rebirths) * AgeSystem.moodMultiplier(data.meters)
	end
	amount = math.max(1, math.floor(amount + 0.5))
	data.ageXP = math.min(AgeSystem.MaxXP, data.ageXP + amount)

	local newAge = AgeSystem.ageFromXP(data.ageXP)
	if newAge > data.age then
		for age = data.age + 1, newAge do
			onAgeUp(player, data, age)
		end
	else
		S.Data.sync(player, "ageXP")
	end
	return amount
end

-- Rebirth: back to Baby Brady with a permanent +25% coin / XP bonus.
-- The wardrobe, furniture, coins and collections are all kept.
local function rebirth(player, data)
	if data.age < AgeSystem.MaxAge then
		S.Net.toast(player, "Brady must be Legendary (age 25) to rebirth", "bad")
		return
	end
	data.rebirths += 1
	data.ageXP = 0
	data.age = 1
	-- Take off anything Baby Brady is too young to wear.
	for slot, itemId in pairs(data.equipped) do
		if not InventorySystem.canEquip(data, itemId) then
			data.equipped[slot] = nil
		end
	end
	data.equipped.Hair = AgeSystem.Stages[1].look.hair
	data.meters = { hunger = 70, clean = 80, energy = 100, fun = 70 }
	S.Data.sync(player, "rebirths", "ageXP", "age", "equipped", "meters")

	S.Care.wake(player, true)
	S.House.upgrade(player)
	S.Brady.rebuild(player)
	local rec = S.Brady.get(player)
	if rec then
		S.Brady.act(rec, "Celebrate", 3.5)
		S.Brady.say(rec, Dialogue.pick("rebirth"))
	end
	S.Net.notify(player, {
		text = "BRADY WAS REBORN!",
		sub = "Rebirth " .. data.rebirths .. "  •  +" .. (data.rebirths * 25) .. "% coins and XP forever",
		kind = "grail",
		sound = "grail",
		big = true,
	})
	S.Net.fireAll("Effect", "Confetti", { userId = player.UserId })
	S.Achievements.check(player)
end

function AgeServer.init(services)
	S = services
	S.Net.on("Rebirth", rebirth, 1)
end

return AgeServer
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">BradyServer</string>
          <string name="Source"><![CDATA[--[[
	BradyServer
	Owns every Brady model in the world: building / rebuilding it when his age
	or outfit changes, where he is, what he is doing, and his goofy idle life
	(wandering, tripping, posing, talking to himself).

	HOW MOVEMENT WORKS (cheap + smooth)
	The server never moves Brady every frame. To walk somewhere it writes four
	attributes on the model (WalkFrom, WalkTo, WalkStart, WalkDur) once; every
	client then slides him along that line locally in Client/BradyAnimator.
	The server can still ask "where is he right now?" with Brady.position(),
	which evaluates the same line. When the walk ends the real Root part is
	moved to the destination.

	HOW ANIMATION WORKS
	The server only sets a "State" attribute (Idle, Walk, Eat, Sleep, Dance,
	Trip, Pose...). Each client animates the joints for that state itself, so
	animation costs the server nothing and needs no uploaded animation assets.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Modules = ReplicatedStorage.Modules
local AgeSystem = require(Modules.AgeSystem)
local Config = require(Modules.Config)
local Dialogue = require(Modules.Dialogue)
local FashionSystem = require(Modules.FashionSystem)
local InventorySystem = require(Modules.InventorySystem)
local BradyBuilder = require(Modules.Builders.BradyBuilder)
local PartUtil = require(Modules.Builders.PartUtil)

local BradyServer = {}

local S
local recs = {} -- [player] = rec
local folder

local UP = Vector3.new(0, 1, 0)

local function flatUnit(v, fallback)
	local flat = Vector3.new(v.X, 0, v.Z)
	if flat.Magnitude < 0.01 then
		return fallback or Vector3.new(0, 0, -1)
	end
	return flat.Unit
end

local function newRec(owner)
	return {
		owner = owner,
		model = nil,
		root = nil,
		pos = Vector3.new(),
		look = Vector3.new(0, 0, -1),
		walk = nil,
		walkToken = 0,
		state = "Idle",
		persist = nil, -- { state, pose } for long-running states (Sleep, Mirror, Pose)
		token = 0,
		busyUntil = 0,
		nextWander = os.clock() + 4,
		following = false,
		inShow = false,
		saySeq = 0,
		noShoes = false,
		hairOverride = nil,
		hadSpawnFx = false,
	}
end

----------------------------------------------------------------------
-- Position / movement
----------------------------------------------------------------------
-- Where Brady is right now (evaluates the current walk line).
function BradyServer.position(rec)
	local walk = rec.walk
	if walk then
		local alpha = math.clamp((Workspace:GetServerTimeNow() - walk.t0) / walk.dur, 0, 1)
		return walk.from:Lerp(walk.to, alpha)
	end
	return rec.pos
end

function BradyServer.cframe(rec)
	local pos = BradyServer.position(rec)
	return CFrame.lookAt(pos, pos + rec.look, UP)
end

local function applyRoot(rec)
	if rec.root then
		rec.root.CFrame = CFrame.lookAt(rec.pos, rec.pos + rec.look, UP)
	end
	if rec.model then
		rec.model:SetAttribute("WalkDur", 0)
	end
end

local function setStateAttribute(rec, state, pose)
	rec.state = state
	if rec.model then
		rec.model:SetAttribute("Pose", pose or "")
		rec.model:SetAttribute("State", state)
	end
end

-- Stops a walk where he currently stands.
function BradyServer.stop(rec)
	if rec.walk then
		rec.pos = BradyServer.position(rec)
		rec.walk = nil
		rec.walkToken += 1
		applyRoot(rec)
		if rec.state == "Walk" then
			setStateAttribute(rec, "Idle")
		end
	end
end

-- Teleports Brady to a CFrame (position + facing).
function BradyServer.place(rec, cframe)
	rec.walk = nil
	rec.walkToken += 1
	rec.pos = cframe.Position
	rec.look = flatUnit(cframe.LookVector, rec.look)
	applyRoot(rec)
	if rec.state == "Walk" then
		setStateAttribute(rec, "Idle")
	end
end

-- Starts a straight-line walk. Returns how long it will take (seconds).
function BradyServer.walkTo(rec, target, speed)
	if not rec.model then
		return 0
	end
	local from = BradyServer.position(rec)
	local delta = target - from
	local distance = delta.Magnitude
	if distance < 0.3 then
		return 0
	end
	local duration = distance / (speed or Config.BradyWalkSpeed)
	rec.walkToken += 1
	local token = rec.walkToken
	rec.walk = { from = from, to = target, t0 = Workspace:GetServerTimeNow(), dur = duration }
	rec.look = flatUnit(delta, rec.look)

	local model = rec.model
	model:SetAttribute("WalkFrom", from)
	model:SetAttribute("WalkTo", target)
	model:SetAttribute("WalkStart", rec.walk.t0)
	model:SetAttribute("WalkDur", duration)
	if rec.state == "Idle" then
		setStateAttribute(rec, "Walk")
	end

	task.delay(duration, function()
		if rec.walkToken ~= token or not rec.walk then
			return
		end
		rec.pos = rec.walk.to
		rec.walk = nil
		applyRoot(rec)
		if rec.state == "Walk" then
			setStateAttribute(rec, "Idle")
		end
	end)
	return duration
end

----------------------------------------------------------------------
-- States
----------------------------------------------------------------------
function BradyServer.isBusy(rec)
	return os.clock() < rec.busyUntil
end

-- A long-running state that stays until changed (Sleep, Mirror, Pose...).
-- Pass "Idle" to clear it.
function BradyServer.setState(rec, state, pose)
	rec.token += 1
	rec.persist = state ~= "Idle" and { state = state, pose = pose } or nil
	if state ~= "Walk" then
		BradyServer.stop(rec)
	end
	setStateAttribute(rec, state, pose)
end

-- A timed action (Eat, Dance, Trip, Celebrate...). Afterwards he returns to
-- whatever long-running state he was in, or Idle.
-- `soft` actions are idle fluff (random poses, trips): they do NOT mark Brady
-- as busy, so the player can always interrupt them by feeding / cleaning him.
function BradyServer.act(rec, state, duration, pose, soft)
	if not rec.model then
		return
	end
	rec.token += 1
	local token = rec.token
	if not soft then
		rec.busyUntil = math.max(rec.busyUntil, os.clock() + duration)
	end
	BradyServer.stop(rec)
	setStateAttribute(rec, state, pose)
	task.delay(duration, function()
		if rec.token ~= token or not rec.model then
			return
		end
		if rec.persist then
			setStateAttribute(rec, rec.persist.state, rec.persist.pose)
		else
			setStateAttribute(rec, "Idle")
		end
	end)
end

-- Walks to a spot, then performs a state there.
-- persistent = true keeps the state (Sleep / Mirror) until setState("Idle").
function BradyServer.performAt(rec, cframe, state, duration, pose, persistent, soft)
	if not rec.model then
		return 0
	end
	rec.token += 1
	local token = rec.token
	rec.persist = nil
	if rec.state ~= "Idle" and rec.state ~= "Walk" then
		setStateAttribute(rec, "Idle")
	end
	local distance = (cframe.Position - BradyServer.position(rec)).Magnitude
	local travel = 0
	if distance > 45 then
		BradyServer.place(rec, cframe)
	else
		travel = BradyServer.walkTo(rec, cframe.Position, 14)
	end
	if not soft then
		rec.busyUntil = math.max(rec.busyUntil, os.clock() + travel + (duration or 0.5))
	end
	task.delay(travel, function()
		if rec.token ~= token or not rec.model then
			return
		end
		BradyServer.place(rec, cframe)
		if persistent then
			BradyServer.setState(rec, state, pose)
		else
			BradyServer.act(rec, state, duration, pose, soft)
		end
	end)
	return travel
end

-- Speech bubble. `idle` chatter can be muted by a client setting.
function BradyServer.say(rec, text, idle)
	if not rec.model or not text then
		return
	end
	rec.saySeq += 1
	rec.model:SetAttribute("SayIdle", idle == true)
	rec.model:SetAttribute("SayText", text)
	rec.model:SetAttribute("SaySeq", rec.saySeq)
end

----------------------------------------------------------------------
-- Building
----------------------------------------------------------------------
local function activeTitle(data)
	local title = data.title
	if title and title.name ~= "" and title.expires > os.time() then
		return { name = title.name, color = FashionSystem.TitleColors[title.name] }
	end
	return nil
end

BradyServer.activeTitle = activeTitle

local function attachModel(rec, model, promptText)
	local old = rec.model
	local cframe = BradyServer.cframe(rec)
	model:PivotTo(cframe)
	-- Carry the live state over to the new model so nothing visibly resets.
	model:SetAttribute("State", rec.state)
	model:SetAttribute("Pose", old and old:GetAttribute("Pose") or "")
	model:SetAttribute("SaySeq", rec.saySeq)
	if rec.walk then
		model:SetAttribute("WalkFrom", rec.walk.from)
		model:SetAttribute("WalkTo", rec.walk.to)
		model:SetAttribute("WalkStart", rec.walk.t0)
		model:SetAttribute("WalkDur", rec.walk.dur)
	else
		model:SetAttribute("WalkDur", 0)
	end
	if promptText then
		local prompt = PartUtil.prompt(model.PrimaryPart, "Check Fit", promptText, { distance = 8, name = "InspectPrompt" })
		prompt:SetAttribute("OwnerUserId", model:GetAttribute("OwnerUserId"))
	end
	rec.model = model
	rec.root = model.PrimaryPart
	model.Parent = folder
	if old then
		old:Destroy()
	end
end

-- Rebuilds a player's Brady from their current data (age + outfit).
function BradyServer.rebuild(player)
	local rec = recs[player]
	local data = S.Data.get(player)
	if not rec or not data then
		return
	end
	local aura = S.Passes.has(player, "CosmeticEffects") and data.settings.aura or nil
	local model = BradyBuilder.build({
		age = data.age,
		equipped = data.equipped,
		ownerName = player.DisplayName,
		ownerUserId = player.UserId,
		title = activeTitle(data),
		rebirths = data.rebirths,
		hairOverride = rec.hairOverride,
		noShoes = rec.noShoes,
		aura = aura,
	})
	attachModel(rec, model, player.DisplayName .. "'s Brady")

	-- Grail pieces get a special spawn animation the first time they go on.
	local hasSpawnFx = InventorySystem.specials(data.equipped).spawn
	if hasSpawnFx and not rec.hadSpawnFx and not BradyServer.isBusy(rec) and not rec.persist then
		BradyServer.act(rec, "GrailSpawn", 2.6)
	end
	rec.hadSpawnFx = hasSpawnFx
end

function BradyServer.get(player)
	return recs[player]
end

-- Fashion show bots: a Brady with no owner.
function BradyServer.spawnNPC(spec, cframe)
	local rec = newRec(nil)
	rec.npc = true
	rec.pos = cframe.Position
	rec.look = flatUnit(cframe.LookVector)
	spec.ownerUserId = 0
	attachModel(rec, BradyBuilder.build(spec), nil)
	return rec
end

function BradyServer.remove(rec)
	rec.walkToken += 1
	rec.token += 1
	if rec.model then
		rec.model:Destroy()
		rec.model = nil
		rec.root = nil
	end
end

----------------------------------------------------------------------
-- Following the player around the map
----------------------------------------------------------------------
function BradyServer.isHome(player)
	local rec = recs[player]
	return rec ~= nil and S.House.isInside(player, BradyServer.position(rec), 1)
end

function BradyServer.sendHome(player)
	local rec = recs[player]
	if not rec then
		return
	end
	rec.following = false
	local session = S.Data.session(player)
	if session then
		session.following = false
		S.Data.syncSession(player, "following")
	end
	BradyServer.place(rec, S.House.homeCFrame(player))
end

function BradyServer.setFollowing(player, following)
	local rec = recs[player]
	local session = S.Data.session(player)
	if not rec or not session then
		return
	end
	if following then
		rec.following = true
		session.following = true
		S.Data.syncSession(player, "following")
		BradyServer.say(rec, Dialogue.pick("follow"))
	else
		BradyServer.sendHome(player)
		BradyServer.say(rec, Dialogue.pick("home"))
	end
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function groundBelow(position, ignore)
	rayParams.FilterDescendantsInstances = ignore
	local result = Workspace:Raycast(position + Vector3.new(0, 6, 0), Vector3.new(0, -40, 0), rayParams)
	if result then
		return result.Position.Y
	end
	return nil
end

local function updateFollow(player, rec)
	if rec.inShow or rec.persist or BradyServer.isBusy(rec) then
		return
	end
	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return
	end
	local behind = hrp.Position - flatUnit(hrp.CFrame.LookVector) * 4.5 + flatUnit(hrp.CFrame.RightVector, Vector3.new(1, 0, 0)) * 2.5
	local groundY = groundBelow(behind, { folder, character }) or (hrp.Position.Y - 3)
	local target = Vector3.new(behind.X, groundY, behind.Z)
	local current = BradyServer.position(rec)
	local distance = (target - current).Magnitude
	if distance > 70 then
		BradyServer.place(rec, CFrame.lookAt(target, target + flatUnit(hrp.CFrame.LookVector), UP))
	elseif distance > 3 then
		BradyServer.walkTo(rec, target, Config.BradyFollowSpeed)
	end
end

----------------------------------------------------------------------
-- Idle life: wandering + random funny behaviour
----------------------------------------------------------------------
local function needLine(data)
	local m = data.meters
	if m.hunger < 25 then
		return Dialogue.pick("hungry")
	elseif m.energy < 20 then
		return Dialogue.pick("tired")
	elseif m.clean < 25 then
		return Dialogue.pick("dirty")
	elseif m.fun < 25 then
		return Dialogue.pick("bored")
	end
	return nil
end

local function idleBehaviour(player, rec, data)
	local roll = math.random()
	local stage = AgeSystem.getStage(data.age)
	if roll < 0.08 then
		-- Brady randomly trips
		BradyServer.act(rec, "Trip", 2.4, nil, true)
		BradyServer.say(rec, Dialogue.pick("trip"), true)
	elseif roll < 0.17 then
		-- Brady randomly poses for no reason
		local poses = InventorySystem.unlockedPoses(data, S.Data.session(player).passes)
		local pose = poses[math.random(1, #poses)]
		BradyServer.act(rec, "Pose", 2.6, pose.id, true)
		BradyServer.say(rec, Dialogue.pick("pose"), true)
	elseif roll < 0.24 then
		-- Brady checks himself out in the mirror
		BradyServer.performAt(rec, S.House.stationCFrame(player, "Mirror"), "Mirror", 3, nil, false, true)
		BradyServer.say(rec, Dialogue.pick("mirror"), true)
	elseif roll < 0.5 then
		BradyServer.say(rec, needLine(data) or Dialogue.pick(stage.id), true)
	else
		local spot = S.House.randomSpot(player)
		if spot then
			BradyServer.walkTo(rec, spot, Config.BradyWalkSpeed * (0.7 + stage.look.scale * 0.5))
		end
	end
	rec.nextWander = os.clock() + math.random(Config.WanderInterval[1], Config.WanderInterval[2])
end

-- Called once a second from Main.
function BradyServer.tick()
	local now = os.clock()
	for player, rec in pairs(recs) do
		if rec.model and rec.state == "Idle" and not rec.following and not rec.inShow and now >= rec.nextWander and not BradyServer.isBusy(rec) then
			local data = S.Data.get(player)
			if data then
				idleBehaviour(player, rec, data)
			end
		end
	end
end

----------------------------------------------------------------------
-- Lifecycle
----------------------------------------------------------------------
function BradyServer.init(services)
	S = services
	folder = Instance.new("Folder")
	folder.Name = "Bradys"
	folder.Parent = Workspace
	BradyServer.folder = folder
end

function BradyServer.start()
	-- Follow updates run a little faster than the main 1s tick.
	task.spawn(function()
		while true do
			task.wait(0.35)
			for player, rec in pairs(recs) do
				if rec.following and rec.model then
					local ok, err = pcall(updateFollow, player, rec)
					if not ok then
						warn("[BradyServer] follow error: " .. tostring(err))
					end
				end
			end
		end
	end)
end

function BradyServer.playerAdded(player)
	local rec = newRec(player)
	local home = S.House.homeCFrame(player)
	rec.pos = home.Position
	rec.look = flatUnit(home.LookVector)
	recs[player] = rec
	BradyServer.rebuild(player)
end

function BradyServer.playerRemoving(player)
	local rec = recs[player]
	if rec then
		recs[player] = nil
		BradyServer.remove(rec)
	end
end

function BradyServer.count()
	local n = 0
	for _ in pairs(recs) do
		n += 1
	end
	return n
end

-- (kept for services that want to iterate every live Brady)
function BradyServer.all()
	return recs
end

-- Only used for sanity checks.
function BradyServer.playerOf(model)
	local userId = model:GetAttribute("OwnerUserId")
	return userId and Players:GetPlayerByUserId(userId) or nil
end

return BradyServer
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">CareServer</string>
          <string name="Source"><![CDATA[--[[
	CareServer
	Taking care of Brady: feeding, cleaning, sleeping, toys, the mirror and
	follow mode, plus the slow decay of his four meters.

	Every action is checked here (does the player own the food, is the meter
	already full, is Brady asleep / busy, is the cooldown over) before any XP
	or Goo Coins are given, so spamming the remote earns nothing.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage.Modules
local Config = require(Modules.Config)
local CurrencySystem = require(Modules.CurrencySystem)
local Dialogue = require(Modules.Dialogue)
local FoodSystem = require(Modules.FoodSystem)
local InventorySystem = require(Modules.InventorySystem)

local CareServer = {}

local S
local cooldowns = {} -- [player][key] = os.clock() of last use
local lowWarned = {} -- [player][meter] = true once warned
local poseIndex = {} -- [player] = index into unlocked poses (fashion podium)
local meterClock, sleepClock = 0, 0

local function ready(player, key, seconds)
	local list = cooldowns[player]
	if not list then
		list = {}
		cooldowns[player] = list
	end
	local now = os.clock()
	if list[key] and now - list[key] < seconds then
		return false
	end
	list[key] = now
	return true
end

local function addMeter(data, key, amount)
	data.meters[key] = math.clamp(data.meters[key] + amount, 0, 100)
end

-- Pays XP + coins for an activity and shows the little reward popup.
local function reward(player, baseXP, baseCoins)
	local xp = S.Age.addXP(player, baseXP)
	local coins = baseCoins > 0 and S.Currency.add(player, S.Currency.scaled(player, baseCoins), "care") or 0
	S.Net.fire(player, "Effect", "Reward", { xp = xp, coins = coins })
	return xp, coins
end

-- Common "can Brady do something right now?" check.
local function available(player, allowAsleep)
	local rec = S.Brady.get(player)
	local session = S.Data.session(player)
	if not rec or not session or not rec.model then
		return nil
	end
	if rec.inShow then
		S.Net.toast(player, "Brady is on the runway right now", "bad")
		return nil
	end
	if session.sleeping and not allowAsleep then
		S.Net.toast(player, "shhh... Brady is asleep", "bad")
		return nil
	end
	if S.Brady.isBusy(rec) then
		S.Net.toast(player, "Brady is busy", "bad")
		return nil
	end
	return rec, session
end

----------------------------------------------------------------------
-- FEED
----------------------------------------------------------------------
local function feed(player, data, foodId)
	local food = type(foodId) == "string" and FoodSystem.get(foodId)
	if not food then
		return
	end
	local rec = available(player)
	if not rec then
		return
	end
	if data.age < (food.minAge or 1) then
		S.Net.toast(player, food.name .. " unlocks at age " .. food.minAge, "bad")
		return
	end
	if data.meters.hunger >= 97 then
		S.Brady.say(rec, Dialogue.pick("full"))
		S.Net.toast(player, "Brady is full!", "bad")
		return
	end
	if not food.free then
		if (data.food[foodId] or 0) <= 0 then
			S.Net.toast(player, "you're out of " .. food.name .. " - buy more in the Shop", "bad")
			return
		end
		data.food[foodId] -= 1
	end

	local xp = food.xp
	local line = Dialogue.pick("fed")
	if food.mystery then
		-- Goofy mystery food: could be amazing, could be a mistake.
		xp = math.random(5, 120)
		line = Dialogue.pick(xp >= 60 and "mysteryGood" or "mysteryBad")
	end
	addMeter(data, "hunger", food.hunger)
	rec.model:SetAttribute("EatIcon", food.icon)
	S.Brady.act(rec, "Eat", 3.2)
	S.Brady.say(rec, line)
	S.Data.sync(player, "food", "meters")
	reward(player, xp, CurrencySystem.Rewards.Feed)
	S.Achievements.bump(player, "feeds", 1)
	S.Events.hook(player, "feed")
end

----------------------------------------------------------------------
-- CLEAN
----------------------------------------------------------------------
local function shower(player, data)
	local rec = available(player)
	if not rec then
		return
	end
	if not S.Brady.isHome(player) then
		S.Net.toast(player, "Brady needs to be home to shower", "bad")
		return
	end
	if data.meters.clean >= 95 then
		S.Brady.say(rec, Dialogue.pick("alreadyClean"))
		S.Net.toast(player, "Brady is already clean", "bad")
		return
	end
	local travel = S.Brady.performAt(rec, S.House.stationCFrame(player, "Shower"), "Shower", 4)
	task.delay(travel, function()
		S.House.runShower(player, 4)
	end)
	addMeter(data, "clean", 65)
	S.Brady.say(rec, Dialogue.pick("clean"))
	S.Data.sync(player, "meters")
	reward(player, 30, CurrencySystem.Rewards.Shower)
	S.Achievements.bump(player, "cleans", 1)
end

local function brushHair(player, data, atSink)
	local rec = available(player)
	if not rec then
		return
	end
	if not ready(player, "brush", 15) then
		S.Net.toast(player, "his hair is still perfect", "bad")
		return
	end
	if atSink and S.Brady.isHome(player) then
		S.Brady.performAt(rec, S.House.stationCFrame(player, "Sink"), "Brush", 2.6)
	else
		S.Brady.act(rec, "Brush", 2.6)
	end
	addMeter(data, "clean", 18)
	S.Brady.say(rec, Dialogue.pick("brushed"))
	S.Data.sync(player, "meters")
	reward(player, 14, CurrencySystem.Rewards.BrushHair)
	S.Achievements.bump(player, "cleans", 1)
	S.Events.hook(player, "brush")
end

local function cleanShoes(player, data, atMat)
	local rec = available(player)
	if not rec then
		return
	end
	if not data.equipped.Shoes and not data.equipped.Outfit then
		S.Net.toast(player, "he isn't wearing shoes??", "bad")
		return
	end
	if not ready(player, "shoes", 15) then
		S.Net.toast(player, "his shoes are already spotless", "bad")
		return
	end
	if atMat and S.Brady.isHome(player) then
		S.Brady.performAt(rec, S.House.stationCFrame(player, "ShoeMat"), "ShoeClean", 2.6)
	else
		S.Brady.act(rec, "ShoeClean", 2.6)
	end
	addMeter(data, "clean", 14)
	S.Brady.say(rec, Dialogue.pick("shoes"))
	S.Data.sync(player, "meters")
	reward(player, 12, CurrencySystem.Rewards.CleanShoes)
	S.Achievements.bump(player, "cleans", 1)
end

-- Changing his clothes also freshens him up a little (with a cooldown).
function CareServer.onClothesChanged(player)
	local data = S.Data.get(player)
	if not data or not ready(player, "clothes", 45) then
		return
	end
	addMeter(data, "clean", 6)
	S.Data.sync(player, "meters")
	reward(player, 8, CurrencySystem.Rewards.ChangeClothes)
	S.Achievements.bump(player, "cleans", 1)
end

----------------------------------------------------------------------
-- SLEEP
----------------------------------------------------------------------
function CareServer.wake(player, silent)
	local rec = S.Brady.get(player)
	local session = S.Data.session(player)
	if not rec or not session or not session.sleeping then
		return
	end
	session.sleeping = false
	S.Data.syncSession(player, "sleeping")
	S.Brady.setState(rec, "Idle")
	-- Hop off the bed onto the floor next to it.
	local h = S.House.size(player) / 2
	S.Brady.place(rec, S.House.origin(player) * CFrame.lookAt(Vector3.new(-h + 8.5, 0, -h + 5.2), Vector3.new(0, 0, 0)))
	if not silent then
		S.Brady.say(rec, Dialogue.pick("wake"))
	end
end

local function sleep(player, data)
	local rec, session = available(player)
	if not rec then
		return
	end
	if not S.Brady.isHome(player) then
		S.Net.toast(player, "Brady needs to be home to sleep", "bad")
		return
	end
	if data.meters.energy >= 92 then
		S.Brady.say(rec, Dialogue.pick("notTired"))
		S.Net.toast(player, "Brady isn't tired", "bad")
		return
	end
	rec.following = false
	session.following = false
	session.sleeping = true
	S.Data.syncSession(player, "sleeping", "following")
	S.Brady.performAt(rec, S.House.stationCFrame(player, "Bed"), "Sleep", nil, nil, true)
	S.Brady.say(rec, Dialogue.pick("sleep"))
	S.Achievements.bump(player, "sleeps", 1)
end

function CareServer.toggleSleep(player)
	local data = S.Data.get(player)
	local session = S.Data.session(player)
	if not data or not session then
		return
	end
	if session.sleeping then
		CareServer.wake(player)
	else
		sleep(player, data)
	end
end

----------------------------------------------------------------------
-- TOYS / POSES / MIRROR / FOLLOW
----------------------------------------------------------------------
function CareServer.playToy(player, _furnitureId)
	local data = S.Data.get(player)
	local rec = available(player)
	if not rec or not data then
		return
	end
	if data.meters.energy < 5 then
		S.Brady.say(rec, Dialogue.pick("tired"))
		S.Net.toast(player, "Brady is too tired to play", "bad")
		return
	end
	if not ready(player, "toy", 25) then
		S.Net.toast(player, "give him a second!", "bad")
		return
	end
	addMeter(data, "fun", 22)
	addMeter(data, "energy", -4)
	S.Brady.act(rec, "Play", 3)
	S.Brady.say(rec, Dialogue.pick("play"))
	S.Data.sync(player, "meters")
	reward(player, 16, CurrencySystem.Rewards.PlayToy)
end

-- Mirror mode: Brady stands at the mirror and holds poses.
function CareServer.mirror(player, enter)
	local session = S.Data.session(player)
	if not session then
		return
	end
	if enter then
		local rec = available(player)
		if not rec then
			return
		end
		session.mirror = true
		local spot = S.House.stationCFrame(player, "Mirror")
		S.Brady.performAt(rec, spot, "Mirror", nil, nil, true)
		S.Brady.say(rec, Dialogue.pick("mirror"))
		S.Net.fire(player, "OpenPanel", "Mirror", spot)
	else
		local rec = S.Brady.get(player)
		if session.mirror and rec then
			session.mirror = false
			if rec.persist and not session.sleeping then
				S.Brady.setState(rec, "Idle")
			end
		end
	end
end

local function setPose(player, data, poseId)
	local session = S.Data.session(player)
	local rec = S.Brady.get(player)
	if type(poseId) ~= "string" or not session or not rec or session.sleeping or rec.inShow then
		return
	end
	if not InventorySystem.isPoseUnlocked(data, session.passes, poseId) then
		S.Net.toast(player, "that pose is locked", "bad")
		return
	end
	if session.mirror then
		S.Brady.setState(rec, "Pose", poseId) -- holds until another pose / exit
	elseif not S.Brady.isBusy(rec) then
		S.Brady.act(rec, "Pose", 3.5, poseId)
	end
	if ready(player, "poseFun", 20) then
		addMeter(data, "fun", 4)
		S.Data.sync(player, "meters")
	end
end

-- The fashion display podium cycles through unlocked poses.
function CareServer.podiumPose(player)
	local data = S.Data.get(player)
	local rec, session = available(player)
	if not rec or not data then
		return
	end
	local poses = InventorySystem.unlockedPoses(data, session.passes)
	local index = (poseIndex[player] or 0) % #poses + 1
	poseIndex[player] = index
	S.Brady.performAt(rec, S.House.stationCFrame(player, "Podium"), "Pose", 5, poses[index].id)
	S.Brady.say(rec, Dialogue.pick("pose"))
end

local function follow(player, data, enabled)
	local rec, session = available(player)
	if not rec then
		return
	end
	if enabled == true then
		if data.age < Config.FollowMinAge then
			S.Net.toast(player, "Brady can go outside at age " .. Config.FollowMinAge, "bad")
			return
		end
		S.Brady.setFollowing(player, true)
	elseif session.following then
		S.Brady.setFollowing(player, false)
	end
end

-- Teleport a following Brady right next to the player.
local function call(player)
	local rec, session = available(player)
	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not rec or not hrp then
		return
	end
	if not session.following then
		S.Net.toast(player, "turn on 'Follow me' first", "bad")
		return
	end
	local spot = hrp.CFrame * CFrame.new(3, -3, 0)
	S.Brady.place(rec, CFrame.lookAt(spot.Position, spot.Position + hrp.CFrame.LookVector))
end

-- Entry point used by the station prompts in the house.
function CareServer.perform(player, action, arg)
	local data = S.Data.get(player)
	if not data then
		return
	end
	if action == "Feed" then
		feed(player, data, arg)
	elseif action == "Shower" then
		shower(player, data)
	elseif action == "BrushHair" then
		brushHair(player, data, true)
	elseif action == "CleanShoes" then
		cleanShoes(player, data, true)
	end
end

----------------------------------------------------------------------
-- Remote + ticking
----------------------------------------------------------------------
local function onCare(player, data, action, arg)
	if action == "Feed" then
		feed(player, data, arg)
	elseif action == "Shower" then
		shower(player, data)
	elseif action == "BrushHair" then
		brushHair(player, data, true)
	elseif action == "CleanShoes" then
		cleanShoes(player, data, true)
	elseif action == "Sleep" then
		if not S.Data.session(player).sleeping then
			sleep(player, data)
		end
	elseif action == "Wake" then
		CareServer.wake(player)
	elseif action == "Follow" then
		follow(player, data, arg)
	elseif action == "Call" then
		call(player)
	end
end

local function warnLow(player, data, rec)
	local warned = lowWarned[player]
	if not warned then
		warned = {}
		lowWarned[player] = warned
	end
	local lines = { hunger = "hungry", clean = "dirty", energy = "tired", fun = "bored" }
	for meter, key in pairs(lines) do
		local value = data.meters[meter]
		if value < 20 and not warned[meter] then
			warned[meter] = true
			S.Net.toast(player, "Brady is " .. (meter == "fun" and "bored" or key) .. "!", "bad")
			if rec and rec.state == "Idle" then
				S.Brady.say(rec, Dialogue.pick(key))
			end
		elseif value > 40 then
			warned[meter] = nil
		end
	end
end

-- Called once a second from Main.
function CareServer.tick()
	meterClock += 1
	sleepClock += 1
	local doMeters = meterClock >= Config.MeterTick
	local doSleep = sleepClock >= Config.SleepTick
	if doMeters then
		meterClock = 0
	end
	if doSleep then
		sleepClock = 0
	end
	if not doMeters and not doSleep then
		return
	end
	for player, data, session in S.Data.each() do
		local rec = S.Brady.get(player)
		if doSleep and session.sleeping then
			addMeter(data, "energy", Config.SleepEnergyPerTick)
			S.Age.addXP(player, Config.SleepXPPerTick)
			S.Data.sync(player, "meters")
			if data.meters.energy >= 100 then
				CareServer.wake(player)
				S.Net.toast(player, "Brady woke up fully rested!", "good")
			end
		end
		if doMeters then
			local seconds = Config.MeterTick
			local factor = session.sleeping and 0.4 or 1
			addMeter(data, "hunger", -Config.MeterDecay.hunger * seconds * factor)
			addMeter(data, "clean", -Config.MeterDecay.clean * seconds * factor)
			addMeter(data, "fun", -Config.MeterDecay.fun * seconds * factor)
			if not session.sleeping then
				addMeter(data, "energy", -Config.MeterDecay.energy * seconds)
			end
			S.Data.sync(player, "meters")
			warnLow(player, data, rec)
		end
	end
end

function CareServer.init(services)
	S = services
	S.Net.on("Care", onCare, 6)
	S.Net.on("SetPose", setPose, 5)
	S.Net.on("Mirror", function(player, _data, enter)
		CareServer.mirror(player, enter == true)
	end, 4)
end

function CareServer.playerRemoving(player)
	cooldowns[player] = nil
	lowWarned[player] = nil
	poseIndex[player] = nil
end

-- Exposed so mini-games can use / refill meters.
CareServer.addMeter = addMeter

return CareServer
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="42">
        <Properties>
          <string name="Name">ClothingServer</string>
          <string name="Source"><![CDATA[--[[
	ClothingServer
	Item ownership and what Brady is wearing. The client sends "please equip
	X"; this service checks ownership, the age requirement and whether the
	category is unlocked before anything changes. Players can only ever touch
	their own inventory - there is no trading or stealing.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage.Modules
local Config = require(Modules.Config)
local ClothingSystem = require(Modules.ClothingSystem)
local CurrencySystem = require(Modules.CurrencySystem)
local Dialogue = require(Modules.Dialogue)
local InventorySystem = require(Modules.InventorySystem)

local ClothingServer = {}

local S
local lastDripPopup = {} -- [player] = os.clock()

-- Gives a clothing item. Duplicates are converted into Goo Coins.
-- Returns { isNew, refund, item } or nil for an unknown id.
function ClothingServer.grant(player, itemId, source, silent)
	local data = S.Data.get(player)
	local item = ClothingSystem.get(itemId)
	if not data or not item then
		return nil
	end
	if data.inventory[itemId] then
		local refund = CurrencySystem.sellValue(item.rarity)
		S.Currency.add(player, refund, "duplicate")
		if not silent then
			S.Net.fire(player, "ItemGranted", { kind = "clothing", id = itemId, isNew = false, refund = refund, source = source })
		end
		return { isNew = false, refund = refund, item = item }
	end

	data.inventory[itemId] = true
	S.Data.sync(player, "inventory")
	if not silent then
		S.Net.fire(player, "ItemGranted", { kind = "clothing", id = itemId, isNew = true, source = source })
	end

	-- Brady reacts: he dances for anything Rare or better.
	local rec = S.Brady.get(player)
	if rec then
		local order = ClothingSystem.rarityOrder(item.rarity)
		if item.rarity == "Grail" then
			S.Brady.say(rec, Dialogue.pick("grailItem"))
		elseif item.rarity == "Archive" then
			S.Brady.say(rec, Dialogue.pick("archiveItem"))
		elseif order >= 3 then
			S.Brady.say(rec, Dialogue.pick("rareItem"))
		else
			S.Brady.say(rec, Dialogue.pick("newItem"))
		end
		if order >= 3 and not S.Brady.isBusy(rec) and not S.Data.session(player).sleeping then
			S.Brady.act(rec, "Dance", 3.5)
		end
	end
	S.Achievements.check(player)
	return { isNew = true, refund = 0, item = item }
end

-- Runs after any change to data.equipped.
local function afterFitChange(player, data)
	S.Data.sync(player, "equipped")
	S.Brady.rebuild(player)
	S.Events.hook(player, "equip")
	S.Care.onClothesChanged(player)

	local rec = S.Brady.get(player)
	if not rec or S.Brady.isBusy(rec) or S.Data.session(player).sleeping then
		return
	end
	if InventorySystem.isBadFit(data.equipped) then
		-- Brady gets embarrassed when the fit is missing the basics.
		S.Brady.act(rec, "Embarrassed", 3)
		S.Brady.say(rec, Dialogue.pick("badFit"))
		return
	end
	local drip = InventorySystem.dripScore(data.equipped)
	local now = os.clock()
	if drip >= 24 and now - (lastDripPopup[player] or -1000) > 90 then
		lastDripPopup[player] = now
		S.Net.notify(player, { text = "BRADY IS DRIPPED OUT!", sub = "drip score " .. math.floor(drip), kind = "rare", sound = "good" })
		S.Brady.say(rec, Dialogue.pick("goodFit"))
		S.Brady.act(rec, "Pose", 2.5, "Flex")
	end
end

local function equip(player, data, itemId)
	if type(itemId) ~= "string" then
		return
	end
	local ok, reason = InventorySystem.canEquip(data, itemId)
	if not ok then
		S.Net.toast(player, reason, "bad")
		return
	end
	local item = ClothingSystem.get(itemId)
	if data.equipped[item.slot] == itemId then
		return
	end
	data.equipped[item.slot] = itemId
	afterFitChange(player, data)
end

local function unequip(player, data, slot)
	if type(slot) ~= "string" or not ClothingSystem.SlotInfo[slot] then
		return
	end
	if data.equipped[slot] == nil then
		return
	end
	data.equipped[slot] = nil
	afterFitChange(player, data)
end

local function outfitSlots(player)
	return S.Passes.has(player, "ExtraOutfits") and Config.OutfitSlotsWithPass or Config.OutfitSlots
end

local function validIndex(player, index)
	return type(index) == "number" and index % 1 == 0 and index >= 1 and index <= outfitSlots(player)
end

local function saveOutfit(player, data, index)
	if not validIndex(player, index) then
		S.Net.toast(player, "that outfit slot is locked", "bad")
		return
	end
	local copy = {}
	for slot, itemId in pairs(data.equipped) do
		copy[slot] = itemId
	end
	data.outfits[tostring(index)] = copy
	S.Data.sync(player, "outfits")
	S.Net.toast(player, "Outfit " .. index .. " saved!", "good")
end

local function loadOutfit(player, data, index)
	if not validIndex(player, index) then
		return
	end
	local outfit = data.outfits[tostring(index)]
	if not outfit then
		S.Net.toast(player, "that outfit slot is empty", "bad")
		return
	end
	local equipped = {}
	for slot, itemId in pairs(outfit) do
		-- Re-validated on load: the item must still be owned and wearable.
		local item = ClothingSystem.get(itemId)
		if item and item.slot == slot and InventorySystem.canEquip(data, itemId) then
			equipped[slot] = itemId
		end
	end
	data.equipped = equipped
	afterFitChange(player, data)
	S.Net.toast(player, "Outfit " .. index .. " equipped!", "good")
end

function ClothingServer.init(services)
	S = services
	S.Net.on("Equip", equip, 10)
	S.Net.on("Unequip", unequip, 10)
	S.Net.on("SaveOutfit", saveOutfit, 4)
	S.Net.on("LoadOutfit", loadOutfit, 4)
end

function ClothingServer.playerRemoving(player)
	lastDripPopup[player] = nil
end

return ClothingServer
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">CollectionServer</string>
          <string name="Source"><![CDATA[--[[
	CollectionServer
	Hidden collectibles + collection book rewards.

	  * Hidden goo blobs: fixed spots around the map. Each player can collect
	    every blob once per day for Goo Coins and XP. Collecting is per-player,
	    so nobody can "steal" a blob from someone else.
	  * Secret items: every few minutes the server may spawn one extremely rare
	    cosmetic somewhere hard to reach. Anyone who touches it while it exists
	    gets it (once).
	  * The Mystery Jacket permanently waits in the secret Goo Cave.
	  * Finishing a collection lets you claim its reward exactly once.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Modules = ReplicatedStorage.Modules
local ClothingSystem = require(Modules.ClothingSystem)
local CollectionSystem = require(Modules.CollectionSystem)
local Config = require(Modules.Config)
local Util = require(Modules.Util)
local PartUtil = require(Modules.Builders.PartUtil)

local CollectionServer = {}

local S
local folder
local secretClock = 0
local activeSecret -- { model, itemId, expires }
local touchDebounce = {} -- [player] = os.clock()

local rgb = Color3.fromRGB

-- Rarer secrets have a smaller weight.
local SECRET_WEIGHTS = {
	giant_goo_chain = 5,
	invisible_shoes = 4,
	ancient_goo_hat = 4,
	golden_shopping_bag = 3,
	golden_goo = 1,
}

local function playerFromHit(hit)
	local character = hit and hit.Parent
	return character and Players:GetPlayerFromCharacter(character) or nil
end

local function debounce(player, seconds)
	local now = os.clock()
	if touchDebounce[player] and now - touchDebounce[player] < seconds then
		return false
	end
	touchDebounce[player] = now
	return true
end

----------------------------------------------------------------------
-- Hidden goo blobs
----------------------------------------------------------------------
local function resetHiddenIfNewDay(data)
	local today = Util.today()
	if data.daily.hiddenDay ~= today then
		data.daily.hiddenDay = today
		data.daily.hidden = {}
		return true
	end
	return false
end

local function collectHidden(player, index)
	local data = S.Data.get(player)
	if not data then
		return
	end
	resetHiddenIfNewDay(data)
	local key = tostring(index)
	if data.daily.hidden[key] then
		return
	end
	data.daily.hidden[key] = true
	S.Data.sync(player, "daily")
	local coins = S.Currency.add(player, S.Currency.scaled(player, math.random(Config.HiddenCoins[1], Config.HiddenCoins[2])), "hidden")
	local xp = S.Age.addXP(player, 20)
	S.Achievements.bump(player, "hidden", 1)
	S.Net.fire(player, "HiddenFound", index)
	S.Net.fire(player, "Effect", "Reward", { xp = xp, coins = coins, text = "HIDDEN GOO!" })
end

local function buildHidden()
	for index, cframe in ipairs(S.Map.hiddenSpots) do
		local blob = PartUtil.block(folder, {
			name = "HiddenGoo",
			size = Vector3.new(1.5, 1.5, 1.5),
			cframe = cframe * CFrame.new(0, 1, 0),
			color = rgb(126, 232, 74),
			material = "Neon",
			shape = "Ball",
			collide = false,
		})
		blob.CanTouch = true
		blob:SetAttribute("Index", index)
		CollectionService:AddTag(blob, "HiddenGoo")
		blob.Touched:Connect(function(hit)
			local player = playerFromHit(hit)
			if player then
				collectHidden(player, index)
			end
		end)
	end
end

----------------------------------------------------------------------
-- Secret items
----------------------------------------------------------------------
local function buildPickup(name, cframe, color, itemId)
	local model = Instance.new("Model")
	model.Name = name
	local core = PartUtil.block(model, {
		name = "Core",
		size = Vector3.new(2, 2, 2),
		cframe = cframe * CFrame.new(0, 2, 0) * CFrame.Angles(math.rad(45), math.rad(45), 0),
		color = color,
		material = "Neon",
		collide = false,
	})
	core.CanTouch = true
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 14
	light.Brightness = 2
	light.Shadows = false
	light.Parent = core
	local sparkles = Instance.new("ParticleEmitter")
	sparkles.Rate = 14
	sparkles.Lifetime = NumberRange.new(1, 1.6)
	sparkles.Speed = NumberRange.new(1, 3)
	sparkles.SpreadAngle = Vector2.new(180, 180)
	sparkles.Size = NumberSequence.new(0.5, 0)
	sparkles.Color = ColorSequence.new(color)
	sparkles.LightEmission = 1
	sparkles.Parent = core
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(5, 1.2)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 2.4, 0)
	gui.MaxDistance = 45
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color
	label.TextStrokeTransparency = 0.2
	label.Text = "???"
	label.Parent = gui
	gui.Parent = core

	core.Touched:Connect(function(hit)
		local player = playerFromHit(hit)
		local data = player and S.Data.get(player)
		if not data or not debounce(player, 2) then
			return
		end
		if data.inventory[itemId] then
			S.Net.toast(player, "you already found this secret", "info")
			return
		end
		S.Clothing.grant(player, itemId, "secret")
		S.House.refreshDisplays(player)
	end)
	model.Parent = folder
	return model
end

local function spawnSecret()
	local options = {}
	for itemId, weight in pairs(SECRET_WEIGHTS) do
		table.insert(options, { id = itemId, weight = weight })
	end
	table.sort(options, function(a, b)
		return a.id < b.id
	end)
	local pick = Util.weighted(options, function(entry)
		return entry.weight
	end)
	local item = pick and ClothingSystem.get(pick.id)
	local spot = Util.pick(S.Map.secretSpots)
	if not item or not spot then
		return
	end
	activeSecret = {
		model = buildPickup("SecretItem", spot, ClothingSystem.rarityColor(item.rarity), item.id),
		itemId = item.id,
		expires = os.clock() + Config.SecretLifetime,
	}
	S.Net.fireAll("Notify", { text = "something rare is glowing somewhere on the map...", toast = true, kind = "rare" })
end

-- Called once a second from Main.
function CollectionServer.tick()
	if activeSecret and os.clock() >= activeSecret.expires then
		activeSecret.model:Destroy()
		activeSecret = nil
	end
	secretClock += 1
	if secretClock >= Config.SecretSpawnInterval then
		secretClock = 0
		if not activeSecret and #Players:GetPlayers() > 0 and math.random() < Config.SecretSpawnChance then
			spawnSecret()
		end
	end
end

----------------------------------------------------------------------
-- Collection book rewards
----------------------------------------------------------------------
local function claim(player, data, collectionId)
	local collection = type(collectionId) == "string" and CollectionSystem.ById[collectionId]
	if not collection then
		return
	end
	if data.collectionsClaimed[collectionId] then
		S.Net.toast(player, "already claimed", "bad")
		return
	end
	if not CollectionSystem.isComplete(data, collection) then
		S.Net.toast(player, "that collection isn't finished yet", "bad")
		return
	end
	data.collectionsClaimed[collectionId] = true -- flag first: no double claims
	S.Data.sync(player, "collectionsClaimed")
	local coins = S.Currency.add(player, collection.coins, "collection")
	local sub = "+" .. coins .. " Goo Coins"
	if collection.title then
		data.title = { name = collection.title, expires = os.time() + 7 * 86400 }
		S.Data.sync(player, "title")
		S.Brady.rebuild(player)
		S.Social.refreshTitle(player)
		sub ..= "  •  title: " .. collection.title
	end
	S.Net.notify(player, { text = string.upper(collection.name) .. " COMPLETE!", sub = sub, kind = "grail", sound = "grail", big = true })
	S.Net.fireAll("Effect", "Confetti", { userId = player.UserId })
end

function CollectionServer.init(services)
	S = services
	folder = Instance.new("Folder")
	folder.Name = "Collectibles"
	folder.Parent = Workspace
	S.Net.on("ClaimCollection", claim, 3)
end

function CollectionServer.start()
	buildHidden()
	-- The Mystery Jacket is always waiting in the secret cave.
	local jacket = ClothingSystem.get("mystery_jacket")
	buildPickup("MysteryJacket", S.Map.cavePedestal, ClothingSystem.rarityColor(jacket.rarity), jacket.id)
end

function CollectionServer.playerAdded(player, data)
	if resetHiddenIfNewDay(data) then
		S.Data.sync(player, "daily")
	end
end

function CollectionServer.playerRemoving(player)
	touchDebounce[player] = nil
end

-- Test helper.
function CollectionServer.forceSecret()
	if activeSecret then
		activeSecret.model:Destroy()
		activeSecret = nil
	end
	spawnSecret()
	return activeSecret
end

return CollectionServer
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="44">
        <Properties>
          <string name="Name">CurrencyServer</string>
          <string name="Source"><![CDATA[--[[
	CurrencyServer
	The ONLY place Goo Coins are added or removed. Every other service calls
	Currency.add / Currency.spend, so the client can never set its own balance.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage.Modules
local AgeSystem = require(Modules.AgeSystem)
local Util = require(Modules.Util)

local CurrencyServer = {}

local S
local MAX_COINS = 1e12

function CurrencyServer.init(services)
	S = services
end

-- Gives coins. Returns the amount actually added.
function CurrencyServer.add(player, amount, _reason)
	local data = S.Data.get(player)
	if not data or not Util.isNumber(amount) then
		return 0
	end
	amount = math.floor(amount)
	if amount <= 0 then
		return 0
	end
	data.coins = math.min(MAX_COINS, data.coins + amount)
	S.Data.sync(player, "coins")
	S.Achievements.bump(player, "coinsEarned", amount)
	return amount
end

-- Takes coins if the player can afford it. Returns true on success.
function CurrencyServer.spend(player, amount)
	local data = S.Data.get(player)
	if not data or not Util.isNumber(amount) then
		return false
	end
	amount = math.floor(amount)
	if amount < 0 or data.coins < amount then
		return false
	end
	data.coins -= amount
	S.Data.sync(player, "coins")
	return true
end

-- Scales a base reward by Brady's age and the player's rebirths.
function CurrencyServer.scaled(player, base)
	local data = S.Data.get(player)
	if not data then
		return 0
	end
	return math.max(1, Util.round(base * AgeSystem.rewardMultiplier(data.age, data.rebirths)))
end

return CurrencyServer
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="45">
        <Properties>
          <string name="Name">DailyServer</string>
          <string name="Source"><![CDATA[--[[
	DailyServer
	Daily login rewards (a 7 day track that gets better every day) and three
	daily tasks. The day number always comes from the server clock (UTC), and
	lastClaimDay is written before the reward is handed out, so a reward can
	never be claimed twice in one day.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage.Modules
local ClothingSystem = require(Modules.ClothingSystem)
local DailySystem = require(Modules.DailySystem)
local FoodSystem = require(Modules.FoodSystem)
local FurnitureSystem = require(Modules.FurnitureSystem)
local ShopSystem = require(Modules.ShopSystem)
local Util = require(Modules.Util)

local DailyServer = {}

local S
local clock = 0

-- Makes sure the player has today's three tasks.
local function ensureTasks(player, data)
	local today = Util.today()
	if data.daily.taskDay ~= today or #data.daily.tasks == 0 then
		data.daily.taskDay = today
		data.daily.tasks = DailySystem.pickTasks(player.UserId, today, data.age)
		return true
	end
	return false
end

-- Random unowned clothing of a rarity (optionally limited to some slots).
local function randomUnowned(data, rarity, slots)
	local options = {}
	for _, item in ipairs(ClothingSystem.ByRarity[rarity]) do
		if item.drop and not data.inventory[item.id] and (slots == nil or table.find(slots, item.slot)) then
			table.insert(options, item)
		end
	end
	return Util.pick(options)
end

local function claimDaily(player, data)
	local today = Util.today()
	local daily = data.daily
	if not DailySystem.canClaim(daily, today) then
		S.Net.toast(player, "come back tomorrow for the next reward!", "bad")
		return
	end
	local index = DailySystem.nextIndex(daily, today)
	local continued = daily.lastClaimDay == today - 1
	daily.streak = continued and daily.streak + 1 or 1
	daily.lastClaimDay = today -- written before granting anything
	local reward = DailySystem.Rewards[index]
	local multiplier = DailySystem.weekMultiplier(daily.streak - 1)
	local text

	if reward.kind == "coins" then
		local coins = S.Currency.add(player, math.floor(reward.amount * multiplier), "daily")
		text = "+" .. coins .. " Goo Coins"
	elseif reward.kind == "food" then
		local food = FoodSystem.get(reward.id)
		data.food[reward.id] = math.min(99, (data.food[reward.id] or 0) + reward.amount)
		S.Data.sync(player, "food")
		text = reward.amount .. "x " .. food.name
	elseif reward.kind == "clothing" then
		local item = randomUnowned(data, reward.rarity, reward.slots)
		if item then
			S.Clothing.grant(player, item.id, "daily")
			text = item.name
		else
			local coins = S.Currency.add(player, math.floor(reward.fallback * multiplier), "daily")
			text = "you own them all! +" .. coins .. " Goo Coins instead"
		end
	elseif reward.kind == "furniture" then
		local def = FurnitureSystem.get(reward.id)
		data.furniture.owned[reward.id] = (data.furniture.owned[reward.id] or 0) + 1
		S.Data.sync(player, "furniture")
		text = def.name
	elseif reward.kind == "box" then
		local item = ShopSystem.roll(ShopSystem.DailyBox)
		if item then
			local result = S.Clothing.grant(player, item.id, "daily")
			text = item.name .. (result.isNew and "" or " (duplicate: +" .. result.refund .. " coins)")
		else
			local coins = S.Currency.add(player, reward.fallback, "daily")
			text = "+" .. coins .. " Goo Coins"
		end
	end

	S.Data.sync(player, "daily")
	S.Net.notify(player, { text = "DAY " .. index .. " REWARD!", sub = (text or "") .. "  •  streak: " .. daily.streak, kind = "good", sound = "rare" })
	S.Achievements.check(player)
end

local function claimTask(player, data, index)
	if type(index) ~= "number" then
		return
	end
	local task_ = data.daily.tasks[index]
	local def = task_ and DailySystem.TaskById[task_.id]
	if not def or task_.claimed or task_.progress < def.goal then
		return
	end
	task_.claimed = true -- flag first
	S.Data.sync(player, "daily")
	local coins = S.Currency.add(player, S.Currency.scaled(player, def.coins), "task")
	local xp = S.Age.addXP(player, 40)
	S.Net.fire(player, "Effect", "Reward", { xp = xp, coins = coins, text = "TASK DONE!" })
end

-- Called by AchievementServer.bump whenever a stat counter increases.
function DailyServer.progress(player, stat, amount)
	local data = S.Data.get(player)
	if not data then
		return
	end
	local changed = false
	for _, task_ in ipairs(data.daily.tasks) do
		local def = DailySystem.TaskById[task_.id]
		if def and def.stat == stat and not task_.claimed and task_.progress < def.goal then
			task_.progress = math.min(def.goal, task_.progress + amount)
			changed = true
			if task_.progress >= def.goal then
				S.Net.toast(player, "Daily task complete: " .. DailySystem.taskText(def), "good")
			end
		end
	end
	if changed then
		S.Data.sync(player, "daily")
	end
end

-- Called once a second from Main: handles midnight (UTC) rolling over.
function DailyServer.tick()
	clock += 1
	if clock < 30 then
		return
	end
	clock = 0
	local today = Util.today()
	for player, data, session in S.Data.each() do
		if session.day ~= today then
			session.day = today
			ensureTasks(player, data)
			S.Data.syncSession(player, "day")
			S.Data.sync(player, "daily")
		end
	end
end

function DailyServer.init(services)
	S = services
	S.Net.on("ClaimDaily", claimDaily, 2)
	S.Net.on("ClaimTask", claimTask, 4)
end

function DailyServer.playerAdded(player, data)
	local session = S.Data.session(player)
	session.day = Util.today()
	ensureTasks(player, data)
end

return DailyServer
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="46">
        <Properties>
          <string name="Name">DataServer</string>
          <string name="Source"><![CDATA[--[[
	DataServer
	Loads, saves and replicates every player's profile. Server only.

	RELIABILITY FEATURES
	  * Session locking. When a profile is loaded the DataStore record is
	    stamped with this server's id. Another server that sees a fresh lock
	    waits and retries instead of loading stale data. This is what stops
	    item / coin duplication when someone hops servers faster than the old
	    server can save.
	  * UpdateAsync everywhere (never a blind SetAsync) so a save can refuse to
	    overwrite a record that a newer session has taken over.
	  * Loaded data always goes through DataManager.reconcile(), which repairs
	    missing / corrupt fields. A record that is not even a table is backed
	    up under a "Corrupt_" key before a fresh profile is created.
	  * If loading FAILS (DataStore outage) the player is kicked rather than
	    given a blank profile that would overwrite their real one.
	  * Autosave on an interval, save on leave, save everyone on shutdown.

	STUDIO NOTE: if "Enable Studio Access to API Services" is off (or the place
	is unpublished) DataStores are unavailable. In Studio only, the game then
	runs with temporary in-memory profiles and prints a warning.
]]

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Modules = ReplicatedStorage.Modules
local Config = require(Modules.Config)
local DataManager = require(Modules.DataManager)
local Remotes = require(Modules.Remotes)
local Util = require(Modules.Util)

local DataServer = {}

local S
local store -- the DataStore, or nil when running in memory-only mode
local memoryOnly = false
local jobId = game.JobId ~= "" and game.JobId or ("studio-" .. HttpService:GenerateGUID(false))

-- [player] = { data, session, key, ready, lastSave, saving }
local profiles = {}

local function keyFor(userId)
	return "Player_" .. tostring(userId)
end

----------------------------------------------------------------------
-- DataStore access
----------------------------------------------------------------------
local function openStore()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok and result then
		store = result
		return
	end
	if RunService:IsStudio() then
		memoryOnly = true
		warn("[DataServer] DataStores are unavailable in this Studio session - progress will NOT be saved. "
			.. "Publish the place and enable Game Settings > Security > 'Enable Studio Access to API Services'.")
	else
		warn("[DataServer] Could not open the DataStore: " .. tostring(result))
	end
end

-- Returns: rawData (may be nil for a new player), success
local function loadRecord(userId)
	if memoryOnly then
		return nil, true
	end
	if not store then
		return nil, false
	end
	local key = keyFor(userId)
	for attempt = 1, 6 do
		local record, lockedElsewhere
		local ok, err = pcall(function()
			store:UpdateAsync(key, function(stored)
				-- NOTE: this callback must never yield.
				if type(stored) ~= "table" then
					stored = { data = stored }
				end
				local lock = stored.lock
				if type(lock) == "table" and lock.job ~= jobId and os.time() - (tonumber(lock.t) or 0) < Config.SessionLockTimeout then
					lockedElsewhere = true
					record = nil
					return nil -- cancel: another server still owns this profile
				end
				lockedElsewhere = false
				stored.lock = { job = jobId, t = os.time() }
				record = stored
				return stored
			end)
		end)
		if ok and record then
			return record.data, true
		end
		if not ok then
			warn(string.format("[DataServer] load attempt %d failed for %d: %s", attempt, userId, tostring(err)))
		end
		-- Locked elsewhere usually means the previous server is still saving.
		task.wait(lockedElsewhere and 5 or math.min(2 ^ attempt, 12))
	end
	return nil, false
end

-- Writes a profile. `release` clears the session lock (player is leaving).
local function saveRecord(profile, release)
	if memoryOnly or not store then
		return true
	end
	local payload = Util.deepCopy(profile.data)
	payload.lastSeen = os.time()
	for attempt = 1, 3 do
		local takenOver = false
		local ok, err = pcall(function()
			store:UpdateAsync(profile.key, function(stored)
				if type(stored) ~= "table" then
					stored = {}
				end
				local lock = stored.lock
				if type(lock) == "table" and lock.job ~= jobId then
					-- Our lock expired and a newer session owns the record.
					-- Never overwrite its data.
					takenOver = true
					return nil
				end
				stored.data = payload
				stored.saved = os.time()
				stored.lock = (not release) and { job = jobId, t = os.time() } or nil
				return stored
			end)
		end)
		if ok then
			if takenOver then
				warn("[DataServer] save skipped - profile is owned by a newer session: " .. profile.key)
			end
			return not takenOver
		end
		warn(string.format("[DataServer] save attempt %d failed for %s: %s", attempt, profile.key, tostring(err)))
		task.wait(2 * attempt)
	end
	return false
end

local function backupCorrupt(userId, raw)
	if memoryOnly or not store then
		return
	end
	pcall(function()
		store:SetAsync("Corrupt_" .. tostring(userId) .. "_" .. tostring(os.time()), { raw = tostring(raw) })
	end)
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------
function DataServer.init(services)
	S = services
	openStore()

	-- The client asks for its profile once; wait until it is ready.
	Remotes.func("GetData").OnServerInvoke = function(player)
		local deadline = os.clock() + 45
		while os.clock() < deadline and player.Parent do
			local profile = profiles[player]
			if profile and profile.ready then
				return { data = profile.data, session = profile.session }
			end
			task.wait(0.25)
		end
		return nil
	end
end

function DataServer.isMemoryOnly()
	return memoryOnly
end

-- Loads a player's profile (yields). Returns data, or nil if the player was kicked.
function DataServer.load(player)
	local raw, ok = loadRecord(player.UserId)
	if not player.Parent then
		-- Left while loading: release the lock we may have just taken.
		if ok and not memoryOnly and store then
			pcall(function()
				store:UpdateAsync(keyFor(player.UserId), function(stored)
					if type(stored) == "table" and type(stored.lock) == "table" and stored.lock.job == jobId then
						stored.lock = nil
						return stored
					end
					return nil
				end)
			end)
		end
		return nil
	end
	if not ok then
		player:Kick("Raise Brady Goo could not load your save data. Your progress is safe - please rejoin in a minute.")
		return nil
	end
	if raw ~= nil and type(raw) ~= "table" then
		backupCorrupt(player.UserId, raw)
		raw = nil
	end
	local data = DataManager.reconcile(raw)
	local profile = {
		data = data,
		session = { passes = {}, sleeping = false, following = false, day = Util.today(), isNew = raw == nil },
		key = keyFor(player.UserId),
		ready = false,
		lastSave = os.clock() + math.random() * 20, -- staggers autosaves
	}
	profiles[player] = profile

	-- Leaderboard (the Roblox player list shows these).
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local age = Instance.new("IntValue")
	age.Name = "Age"
	age.Value = data.age
	age.Parent = leaderstats
	local coins = Instance.new("IntValue")
	coins.Name = "Goo Coins"
	coins.Value = data.coins
	coins.Parent = leaderstats
	leaderstats.Parent = player
	profile.leaderAge, profile.leaderCoins = age, coins

	return data
end

-- Called by Main once every service has finished setting the player up.
function DataServer.markReady(player)
	local profile = profiles[player]
	if profile then
		profile.ready = true
	end
end

function DataServer.get(player)
	local profile = profiles[player]
	return profile and profile.data or nil
end

function DataServer.session(player)
	local profile = profiles[player]
	return profile and profile.session or nil
end

-- Iterate loaded players: for player, data, session in DataServer.each() do
function DataServer.each()
	local list = {}
	for player, profile in pairs(profiles) do
		table.insert(list, { player, profile.data, profile.session })
	end
	local index = 0
	return function()
		index += 1
		local entry = list[index]
		if entry then
			return entry[1], entry[2], entry[3]
		end
		return nil
	end
end

-- Send changed top-level keys of the saved data to the owning client.
function DataServer.sync(player, ...)
	local profile = profiles[player]
	if not profile then
		return
	end
	local changes = {}
	for _, key in ipairs({ ... }) do
		changes[key] = profile.data[key]
		if key == "coins" and profile.leaderCoins then
			profile.leaderCoins.Value = profile.data.coins
		elseif key == "age" and profile.leaderAge then
			profile.leaderAge.Value = profile.data.age
		end
	end
	if profile.ready then
		S.Net.fire(player, "DataUpdate", { data = changes })
	end
end

-- Same, for the non-saved session table (passes, sleeping, following...).
function DataServer.syncSession(player, ...)
	local profile = profiles[player]
	if not profile then
		return
	end
	local changes = {}
	for _, key in ipairs({ ... }) do
		local value = profile.session[key]
		changes[key] = value == nil and false or value
	end
	if profile.ready then
		S.Net.fire(player, "DataUpdate", { session = changes })
	end
end

function DataServer.save(player, release)
	local profile = profiles[player]
	if not profile or profile.saving then
		return false
	end
	profile.saving = true
	local ok = saveRecord(profile, release)
	profile.saving = false
	profile.lastSave = os.clock()
	return ok
end

-- Final save when a player leaves, then forget the profile.
function DataServer.release(player)
	local profile = profiles[player]
	if not profile then
		return
	end
	-- Wait for an autosave that is mid-flight so the final save is not skipped.
	local deadline = os.clock() + 10
	while profile.saving and os.clock() < deadline do
		task.wait(0.1)
	end
	profile.saving = true
	saveRecord(profile, true)
	profiles[player] = nil
end

-- Autosave check, called once a second from Main.
function DataServer.tick()
	local now = os.clock()
	for player, profile in pairs(profiles) do
		if profile.ready and not profile.saving and now - profile.lastSave >= Config.AutosaveInterval then
			profile.lastSave = now
			task.spawn(DataServer.save, player, false)
		end
	end
end

-- Server shutdown: save everybody in parallel and wait for them.
function DataServer.shutdown()
	local pending = 0
	for player in pairs(profiles) do
		pending += 1
		task.spawn(function()
			DataServer.release(player)
			pending -= 1
		end)
	end
	local deadline = os.clock() + 25
	while pending > 0 and os.clock() < deadline do
		task.wait(0.1)
	end
end

function DataServer.playerCount()
	return #Players:GetPlayers()
end

return DataServer
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="47">
        <Properties>
          <string name="Name">EventServer</string>
          <string name="Source"><![CDATA[--[[
	EventServer
	Random events: every few minutes each player gets a short interactive task
	("BRADY LOST HIS SHOES", "BRADY IS HUNGRY", ...). The server decides when
	an event starts, tracks progress through hooks from the other services and
	pays the reward itself - the client only draws the banner.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Modules = ReplicatedStorage.Modules
local ClothingSystem = require(Modules.ClothingSystem)
local Config = require(Modules.Config)
local Dialogue = require(Modules.Dialogue)
local EventSystem = require(Modules.EventSystem)
local InventorySystem = require(Modules.InventorySystem)
local ShopSystem = require(Modules.ShopSystem)
local Util = require(Modules.Util)
local PartUtil = require(Modules.Builders.PartUtil)

local EventServer = {}

local S
local active = {} -- [player] = { def, endsAt, progress, goal, props, ... }
local nextAt = {} -- [player] = os.clock() time of the next event
local folder

local rgb = Color3.fromRGB

local function schedule(player, range)
	nextAt[player] = os.clock() + math.random(range[1], range[2])
end

local function send(player)
	local event = active[player]
	if not event then
		S.Net.fire(player, "EventUpdate", nil)
		return
	end
	S.Net.fire(player, "EventUpdate", {
		id = event.def.id,
		title = event.def.title,
		desc = event.desc or event.def.desc,
		task = event.def.task,
		endsAt = event.endsAtServer,
		progress = event.progress,
		goal = event.goal,
		choice = event.choice,
	})
end

local function cleanup(player, event)
	for _, prop in ipairs(event.props) do
		prop:Destroy()
	end
	local rec = S.Brady.get(player)
	if rec then
		local changed = false
		if rec.noShoes then
			rec.noShoes = false
			changed = true
		end
		if rec.hairOverride then
			rec.hairOverride = nil
			changed = true
		end
		if changed then
			S.Brady.rebuild(player)
		end
	end
end

local function finish(player, success, extraCoins)
	local event = active[player]
	if not event then
		return
	end
	active[player] = nil
	cleanup(player, event)
	schedule(player, Config.EventDelay)
	S.Net.fire(player, "EventUpdate", nil)
	local rec = S.Brady.get(player)
	if success then
		local coins = S.Currency.add(player, S.Currency.scaled(player, event.def.coins) + (extraCoins or 0), "event")
		local xp = S.Age.addXP(player, event.def.xp)
		S.Achievements.bump(player, "events", 1)
		S.Net.notify(player, { text = event.def.win .. "!", sub = "+" .. coins .. " Goo Coins   +" .. xp .. " Age XP", kind = "good", sound = "good" })
		if rec and not S.Brady.isBusy(rec) and not rec.persist then
			S.Brady.act(rec, "Celebrate", 2.5)
		end
	else
		S.Net.toast(player, "event missed... brady is disappointed", "bad")
	end
end

-- A grabbable prop with a prompt that only the owner can use.
local function spawnProp(player, event, name, position, color, actionText, onGrab)
	local model = Instance.new("Model")
	model.Name = name
	local core = PartUtil.block(model, { name = "Core", size = Vector3.new(1.6, 1.6, 1.6), cframe = CFrame.new(position + Vector3.new(0, 1.2, 0)), color = color, material = "Neon", collide = false })
	PartUtil.block(model, { name = "Glow", size = Vector3.new(0.2, 3, 3), cframe = CFrame.new(position + Vector3.new(0, 0.12, 0)) * PartUtil.UP, color = color, material = "Neon", shape = "Cylinder", transparency = 0.5, collide = false })
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 12
	light.Brightness = 1.5
	light.Shadows = false
	light.Parent = core
	local sparkles = Instance.new("ParticleEmitter")
	sparkles.Rate = 12
	sparkles.Lifetime = NumberRange.new(0.8, 1.4)
	sparkles.Speed = NumberRange.new(1, 3)
	sparkles.SpreadAngle = Vector2.new(180, 180)
	sparkles.Size = NumberSequence.new(0.4, 0)
	sparkles.Color = ColorSequence.new(color)
	sparkles.LightEmission = 1
	sparkles.Parent = core
	local prompt = PartUtil.prompt(core, actionText, name, { distance = 10, name = "EventPrompt" })
	prompt:SetAttribute("OwnerUserId", player.UserId)
	CollectionService:AddTag(prompt, "OwnerPrompt")
	prompt.Triggered:Connect(function(who)
		if who == player and active[player] == event then
			onGrab()
		end
	end)
	model.Parent = folder
	table.insert(event.props, model)
	return model
end

----------------------------------------------------------------------
-- Starting events
----------------------------------------------------------------------
local starters = {}

function starters.LostShoes(player, data, event)
	local rec = S.Brady.get(player)
	rec.noShoes = true
	S.Brady.rebuild(player)
	-- Hide the shoes inside the room or out in the front yard.
	local origin = S.House.origin(player)
	local h = S.House.size(player) / 2
	local spot
	if math.random() < 0.5 then
		spot = S.House.randomSpot(player)
	end
	if not spot then
		local side = math.random() < 0.5 and -1 or 1
		spot = (origin * CFrame.new(side * math.random(6, math.floor(h)), -1, h + math.random(5, 9))).Position
	end
	spawnProp(player, event, "Brady's Shoes", spot, rgb(255, 255, 255), "Grab Shoes", function()
		finish(player, true)
	end)
end

function starters.Hungry(player, data)
	data.meters.hunger = math.min(data.meters.hunger, 12)
	S.Data.sync(player, "meters")
end

function starters.FoundGrail(player, _data, event)
	local spot = S.House.randomSpot(player) or S.House.homeCFrame(player).Position
	spawnProp(player, event, "Mystery Box", spot, rgb(255, 110, 225), "Open", function()
		local item = ShopSystem.roll(ShopSystem.EventBox)
		if item then
			S.Clothing.grant(player, item.id, "event")
		end
		finish(player, true)
	end)
end

function starters.GoOutside(player)
	S.Brady.setFollowing(player, true)
end

function starters.InsaneFit(player)
	local rec = S.Brady.get(player)
	S.Brady.act(rec, "Dance", 6)
end

function starters.NewHaircut(player, data, event)
	local rec = S.Brady.get(player)
	local current = data.equipped.Hair
	local options = {}
	for _, item in ipairs(ClothingSystem.BySlot.Hair) do
		if item.id ~= current and item.id ~= "hair_baby" then
			table.insert(options, item)
		end
	end
	local pick = Util.pick(options)
	event.hair = pick.id
	event.desc = "he got '" .. pick.name .. "'. KEEP it or FIX it?"
	rec.hairOverride = pick.id
	S.Brady.rebuild(player)
end

function starters.FashionCrisis(player)
	local rec = S.Brady.get(player)
	S.Brady.act(rec, "Embarrassed", 5)
end

local function canStart(player, data, def)
	if def.id == "LostShoes" then
		return data.equipped.Shoes ~= nil or data.equipped.Outfit ~= nil
	elseif def.id == "FashionCrisis" then
		return InventorySystem.countOwned(data) >= 4
	elseif def.id == "Hungry" then
		return data.meters.hunger < 80
	end
	return true
end

local function start(player, data, def)
	local event = {
		def = def,
		endsAt = os.clock() + def.duration,
		endsAtServer = Workspace:GetServerTimeNow() + def.duration,
		progress = 0,
		goal = def.goal or 1,
		props = {},
	}
	active[player] = event
	local rec = S.Brady.get(player)
	if rec then
		S.Brady.say(rec, def.say)
	end
	local starter = starters[def.id]
	if starter then
		starter(player, data, event)
	end
	S.Net.notify(player, { text = def.title, sub = event.desc or def.desc, kind = "event", sound = "event", big = true })
	send(player)
end

----------------------------------------------------------------------
-- Hooks from other services + the EventAction remote
----------------------------------------------------------------------
function EventServer.hook(player, name)
	local event = active[player]
	if not event then
		return
	end
	local id = event.def.id
	if name == "feed" and id == "Hungry" then
		finish(player, true)
	elseif name == "equip" and id == "FashionCrisis" then
		event.progress += 1
		if event.progress >= event.goal then
			finish(player, true)
		else
			send(player)
		end
	elseif name == "brush" and id == "NewHaircut" and event.choice == "fix" then
		finish(player, true)
	end
end

local function onAction(player, data, action)
	local event = active[player]
	if not event or type(action) ~= "string" then
		return
	end
	local id = event.def.id
	if id == "InsaneFit" and action == "Hype" then
		event.progress += 1
		if event.progress >= event.goal then
			-- Better fits earn a bigger hype bonus.
			finish(player, true, math.floor(InventorySystem.dripScore(data.equipped) * 3))
		elseif event.progress % 3 == 0 then
			send(player)
		end
	elseif id == "NewHaircut" and event.choice == nil then
		if action == "Keep" then
			local hairId = event.hair
			local owned = data.inventory[hairId]
			if not owned and math.random() < 0.3 then
				S.Clothing.grant(player, hairId, "event")
				owned = true
			end
			if owned and InventorySystem.canEquip(data, hairId) then
				data.equipped.Hair = hairId
				S.Data.sync(player, "equipped")
				S.Net.toast(player, "the new cut is here to stay!", "good")
			else
				S.Net.toast(player, "...it grew back overnight. classic.", "info")
			end
			finish(player, true)
		elseif action == "Fix" then
			event.choice = "fix"
			event.desc = "brush his hair to fix it! (Brady menu > Clean, or the sink)"
			send(player)
		end
	end
end

-- Called once a second from Main.
function EventServer.tick()
	local now = os.clock()
	for player, data, session in S.Data.each() do
		local event = active[player]
		if event then
			if now >= event.endsAt then
				finish(player, false)
			elseif event.def.id == "GoOutside" then
				local rec = S.Brady.get(player)
				local character = player.Character
				local hrp = character and character:FindFirstChild("HumanoidRootPart")
				local park = S.Map.park
				if rec and hrp and (hrp.Position - park.center).Magnitude <= park.radius and (S.Brady.position(rec) - hrp.Position).Magnitude < 30 then
					S.Brady.say(rec, Dialogue.pick("outside"))
					S.Care.addMeter(data, "fun", 20)
					S.Data.sync(player, "meters")
					finish(player, true)
				end
			end
		elseif nextAt[player] and now >= nextAt[player] then
			local rec = S.Brady.get(player)
			local busy = not data.tutorialDone or session.sleeping or session.mirror or not rec or rec.inShow or S.Brady.isBusy(rec)
			if busy then
				nextAt[player] = now + 20 -- try again shortly
			else
				local options = {}
				for _, def in ipairs(EventSystem.eligible(data.age)) do
					if canStart(player, data, def) then
						table.insert(options, def)
					end
				end
				local def = Util.weighted(options, function(entry)
					return entry.weight
				end)
				if def then
					start(player, data, def)
				else
					schedule(player, Config.EventDelay)
				end
			end
		end
	end
end

function EventServer.init(services)
	S = services
	folder = Instance.new("Folder")
	folder.Name = "EventProps"
	folder.Parent = Workspace
	S.Net.on("EventAction", onAction, 20)
end

function EventServer.playerAdded(player)
	schedule(player, Config.EventFirstDelay)
end

function EventServer.playerRemoving(player)
	local event = active[player]
	if event then
		for _, prop in ipairs(event.props) do
			prop:Destroy()
		end
	end
	active[player] = nil
	nextAt[player] = nil
end

-- Test / admin helper: start a specific event right now.
function EventServer.force(player, eventId)
	local data = S.Data.get(player)
	local def = EventSystem.get(eventId)
	if data and def and not active[player] then
		start(player, data, def)
		return true
	end
	return false
end

function EventServer.current(player)
	return active[player]
end

return EventServer
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="48">
        <Properties>
          <string name="Name">FashionServer</string>
          <string name="Source"><![CDATA[--[[
	FashionServer
	Runs the fashion show on a loop for the whole server:

	    Idle -> Signup -> Runway (each Brady walks) -> Voting -> Results

	Scoring = judges (FashionSystem.judgeScore, based on the category) plus a
	big bonus for every real player vote. Bot contestants fill empty slots so
	a show is still fun when you are the only one online. Players can never
	vote for their own Brady and get exactly one vote.

	The winner earns Goo Coins and a temporary title shown on nameplates.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Modules = ReplicatedStorage.Modules
local ClothingSystem = require(Modules.ClothingSystem)
local Config = require(Modules.Config)
local Dialogue = require(Modules.Dialogue)
local FashionSystem = require(Modules.FashionSystem)
local InventorySystem = require(Modules.InventorySystem)
local Util = require(Modules.Util)

local FashionServer = {}

local S
local MAX_CONTESTANTS = 8
local BOT_NAMES = { "Rival Brady", "Thrift Lord", "Drip Goblin", "Archive Andy", "Brady Clone #2", "Lil Hanger", "Sock Sandal Steve" }

local state = {
	phase = "Idle",
	category = nil,
	endsAt = 0, -- server time the current phase ends
	nextAt = 0, -- server time the next show starts
	contestants = {},
	current = 0,
	results = nil,
}
local contestants = {} -- full records (the broadcast only gets a summary)
local votes = {} -- [voter Player] = contestant id
local nextId = 0

local function now()
	return Workspace:GetServerTimeNow()
end

local function summary()
	local list = {}
	for _, c in ipairs(contestants) do
		table.insert(list, { id = c.id, name = c.name, isBot = c.isBot, userId = c.player and c.player.UserId or 0 })
	end
	return {
		phase = state.phase,
		category = state.category,
		endsAt = state.endsAt,
		nextAt = state.nextAt,
		contestants = list,
		current = state.current,
		results = state.results,
	}
end

local function broadcast()
	S.Net.fireAll("FashionState", summary())
end

local function setPhase(phase, duration)
	state.phase = phase
	state.endsAt = now() + (duration or 0)
	broadcast()
end

local function findContestant(player)
	for index, c in ipairs(contestants) do
		if c.player == player then
			return c, index
		end
	end
	return nil
end

----------------------------------------------------------------------
-- Joining / leaving
----------------------------------------------------------------------
local function join(player)
	local data = S.Data.get(player)
	local session = S.Data.session(player)
	local rec = S.Brady.get(player)
	if not data or not session or not rec then
		return
	end
	if state.phase ~= "Signup" then
		S.Net.toast(player, "sign-ups open when the next show is announced", "bad")
		return
	end
	if findContestant(player) then
		return
	end
	if data.age < Config.FashionMinAge then
		S.Net.toast(player, "Brady can enter fashion shows at age " .. Config.FashionMinAge, "bad")
		return
	end
	if session.sleeping then
		S.Net.toast(player, "wake Brady up first!", "bad")
		return
	end
	if #contestants >= MAX_CONTESTANTS then
		S.Net.toast(player, "this show is full", "bad")
		return
	end
	nextId += 1
	local c = { id = "c" .. nextId, name = player.DisplayName, player = player, rec = rec, isBot = false, votes = 0, judge = 0 }
	table.insert(contestants, c)

	-- Brady heads backstage, the player gets a front-row spot.
	S.Care.mirror(player, false)
	rec.following = false
	session.following = false
	S.Data.syncSession(player, "following")
	rec.inShow = true
	S.Brady.setState(rec, "Idle")
	S.Brady.place(rec, S.Map.runway.backstage[#contestants])
	S.Brady.say(rec, Dialogue.pick("runway"))
	S.House.teleportTo(player, S.Map.runway.audience)
	S.Achievements.bump(player, "showsJoined", 1)
	S.Net.toast(player, "Brady is entered! Category: " .. state.category.name, "good")
	broadcast()
end

local function releaseContestant(c)
	if c.isBot then
		S.Brady.remove(c.rec)
	elseif c.player and c.player.Parent and S.Brady.get(c.player) == c.rec then
		c.rec.inShow = false
		S.Brady.setState(c.rec, "Idle")
		S.Brady.sendHome(c.player)
	end
end

local function leave(player)
	local c, index = findContestant(player)
	if not c or state.phase ~= "Signup" then
		return
	end
	table.remove(contestants, index)
	releaseContestant(c)
	broadcast()
end

local function vote(player, contestantId)
	if state.phase ~= "Voting" or type(contestantId) ~= "string" then
		return
	end
	for _, c in ipairs(contestants) do
		if c.id == contestantId then
			if c.player == player then
				S.Net.toast(player, "you can't vote for your own Brady!", "bad")
				return
			end
			votes[player] = contestantId
			S.Net.toast(player, "voted for " .. c.name, "good")
			return
		end
	end
end

----------------------------------------------------------------------
-- Bots
----------------------------------------------------------------------
local function botOutfit(age)
	local equipped = {}
	for _, slot in ipairs({ "Shirt", "Pants", "Shoes", "Jacket", "Hat", "Glasses", "Accessory" }) do
		local chance = (slot == "Shirt" or slot == "Pants" or slot == "Shoes") and 1 or 0.55
		if math.random() < chance then
			local options = {}
			for _, item in ipairs(ClothingSystem.BySlot[slot]) do
				if item.age <= age and not item.secret and item.rarity ~= "Grail" and (item.rarity ~= "Archive" or math.random() < 0.15) then
					table.insert(options, item)
				end
			end
			local pick = Util.pick(options)
			if pick then
				equipped[slot] = pick.id
			end
		end
	end
	return equipped
end

local function addBots()
	local totalAge, humans = 0, 0
	for _, c in ipairs(contestants) do
		local data = c.player and S.Data.get(c.player)
		if data then
			totalAge += data.age
			humans += 1
		end
	end
	local botAge = math.max(Config.FashionMinAge, math.floor(totalAge / math.max(1, humans)))
	local names = table.clone(BOT_NAMES)
	while #contestants < 3 do
		nextId += 1
		local name = table.remove(names, math.random(1, #names))
		local equipped = botOutfit(botAge)
		local rec = S.Brady.spawnNPC({ age = botAge, equipped = equipped, ownerName = name }, S.Map.runway.backstage[#contestants + 1])
		rec.inShow = true
		table.insert(contestants, { id = "c" .. nextId, name = name, rec = rec, isBot = true, equipped = equipped, votes = 0, judge = 0 })
	end
end

----------------------------------------------------------------------
-- The show
----------------------------------------------------------------------
local function alive(c)
	return c.isBot or (c.player and c.player.Parent ~= nil and S.Brady.get(c.player) == c.rec)
end

local function equippedOf(c)
	if c.isBot then
		return c.equipped
	end
	local data = S.Data.get(c.player)
	return data and data.equipped or {}
end

local function runwayWalk(index, c)
	local runway = S.Map.runway
	local rec = c.rec
	S.Brady.setState(rec, "Idle")
	S.Brady.place(rec, runway.stageStart)
	local out = S.Brady.walkTo(rec, runway.runwayEnd, 9)
	task.wait(out + 0.2)
	if not alive(c) then
		return
	end
	-- Strike a pose at the end of the runway.
	local pose = "Peace"
	if not c.isBot then
		local data = S.Data.get(c.player)
		local session = S.Data.session(c.player)
		if data and session then
			local poses = InventorySystem.unlockedPoses(data, session.passes)
			pose = poses[#poses].id
		end
	end
	S.Brady.act(rec, "Pose", 2.2, pose)
	task.wait(2.4)
	if not alive(c) then
		return
	end
	local back = S.Brady.walkTo(rec, runway.stageStart.Position, 11)
	task.wait(back + 0.2)
	if alive(c) then
		S.Brady.place(rec, runway.lineup[index])
	end
end

local function runShow()
	local category = Util.pick(FashionSystem.Categories)
	state.category = { id = category.id, name = category.name, hint = category.hint, title = category.title }
	state.results = nil
	state.current = 0
	contestants = {}
	votes = {}
	setPhase("Signup", Config.FashionSignup)
	S.Net.fireAll("Notify", { text = "FASHION SHOW STARTING!", sub = category.name .. "  •  open the Fashion Show menu to enter", kind = "event", sound = "event" })
	task.wait(Config.FashionSignup)

	-- Drop anyone who left during sign-up.
	for index = #contestants, 1, -1 do
		if not alive(contestants[index]) then
			table.remove(contestants, index)
		end
	end
	if #contestants == 0 then
		state.phase = "Idle"
		return -- nobody entered: skip this one
	end
	addBots()

	-- RUNWAY
	setPhase("Runway", #contestants * Config.FashionWalkTime)
	for index, c in ipairs(contestants) do
		if alive(c) then
			state.current = index
			state.endsAt = now() + (#contestants - index + 1) * Config.FashionWalkTime
			broadcast()
			runwayWalk(index, c)
		end
	end
	state.current = 0

	-- VOTING
	setPhase("Voting", Config.FashionVoting)
	task.wait(Config.FashionVoting)

	-- RESULTS
	for voter, contestantId in pairs(votes) do
		if voter.Parent then
			for _, c in ipairs(contestants) do
				if c.id == contestantId then
					c.votes += 1
				end
			end
		end
	end
	local best = 1
	for _, c in ipairs(contestants) do
		c.judge = alive(c) and FashionSystem.judgeScore(category.id, equippedOf(c)) or 0
		best = math.max(best, c.judge)
	end
	for _, c in ipairs(contestants) do
		c.score = alive(c) and FashionSystem.finalScore(c.judge, c.votes, best) or -1
	end
	table.sort(contestants, function(a, b)
		return a.score > b.score
	end)
	local results = {}
	for place, c in ipairs(contestants) do
		table.insert(results, { id = c.id, name = c.name, isBot = c.isBot, votes = c.votes, score = math.floor(c.score), place = place })
	end
	state.results = results

	local winner = contestants[1]
	for place, c in ipairs(contestants) do
		if not c.isBot and alive(c) then
			local player = c.player
			local data = S.Data.get(player)
			if place == 1 then
				local coins = S.Currency.add(player, S.Currency.scaled(player, Config.FashionWinCoins), "fashion")
				local xp = S.Age.addXP(player, 150)
				data.title = { name = category.title, expires = os.time() + Config.TitleDuration }
				S.Data.sync(player, "title")
				S.Achievements.bump(player, "showsWon", 1)
				S.Net.notify(player, { text = "YOU WON " .. string.upper(category.name) .. "!", sub = "+" .. coins .. " Goo Coins  +" .. xp .. " XP  •  title: " .. category.title, kind = "grail", sound = "grail", big = true })
				S.Brady.rebuild(player) -- shows the new title on his nameplate
				S.Social.refreshTitle(player)
				S.Brady.act(c.rec, "Celebrate", 4)
				S.Brady.say(c.rec, Dialogue.pick("showWin"))
				S.Net.fireAll("Effect", "Confetti", { userId = player.UserId })
			else
				local coins = S.Currency.add(player, S.Currency.scaled(player, Config.FashionJoinCoins), "fashion")
				local xp = S.Age.addXP(player, 60)
				S.Net.notify(player, { text = "PLACE #" .. place, sub = "+" .. coins .. " Goo Coins  +" .. xp .. " XP  •  " .. winner.name .. " won", kind = "info", sound = "notify" })
				S.Brady.say(c.rec, Dialogue.pick("showLose"))
			end
		end
	end
	if winner.isBot then
		S.Brady.act(winner.rec, "Celebrate", 4)
	end
	setPhase("Results", Config.FashionResults)
	task.wait(Config.FashionResults)

	for _, c in ipairs(contestants) do
		releaseContestant(c)
	end
	contestants = {}
	votes = {}
end

function FashionServer.start()
	task.spawn(function()
		while true do
			state.phase = "Idle"
			state.nextAt = now() + Config.FashionInterval
			state.contestants = {}
			broadcast()
			task.wait(Config.FashionInterval)
			if #Players:GetPlayers() > 0 then
				local ok, err = pcall(runShow)
				if not ok then
					warn("[FashionServer] show error: " .. tostring(err))
					for _, c in ipairs(contestants) do
						pcall(releaseContestant, c)
					end
					contestants = {}
					votes = {}
				end
			end
		end
	end)

	-- The physical sign-up kiosk next to the runway.
	local signup = S.Map.runway.signup
	if signup then
		signup.Triggered:Connect(function(player)
			if S.Data.get(player) then
				if state.phase == "Signup" then
					join(player)
				else
					S.Net.fire(player, "OpenPanel", "Fashion")
				end
			end
		end)
	end
end

function FashionServer.init(services)
	S = services
	S.Net.on("Fashion", function(player, _data, action, arg)
		if action == "Join" then
			join(player)
		elseif action == "Leave" then
			leave(player)
		elseif action == "Vote" then
			vote(player, arg)
		elseif action == "Sync" then
			-- a client that just finished loading asks for the current state
			S.Net.fire(player, "FashionState", summary())
		end
	end, 5)
end

function FashionServer.playerAdded(player)
	S.Net.fire(player, "FashionState", summary())
end

function FashionServer.playerRemoving(player)
	votes[player] = nil
	local _, index = findContestant(player)
	if index and state.phase == "Signup" then
		table.remove(contestants, index)
	end
	-- During the show the contestant is skipped by alive() instead.
end

function FashionServer.phase()
	return state.phase
end

return FashionServer
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="49">
        <Properties>
          <string name="Name">GiftServer</string>
          <string name="Source"><![CDATA[--[[
	GiftServer  (S.Gifts)
	The wearable pieces Brady gifts to the PLAYER as he grows up. The player
	chooses which ones to wear (one per slot); this service validates the
	choice and attaches the accessories to their avatar on every respawn.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage.Modules
local GiftSystem = require(Modules.GiftSystem)
local GiftBuilder = require(Modules.Builders.GiftBuilder)

local GiftServer = {}

local S
local connections = {}

-- Re-applies the equipped gifts to the player's current character.
function GiftServer.refresh(player)
	local data = S.Data.get(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not data or not humanoid then
		return
	end
	for _, child in ipairs(character:GetChildren()) do
		if child:IsA("Accessory") and string.sub(child.Name, 1, #GiftBuilder.Prefix) == GiftBuilder.Prefix then
			child:Destroy()
		end
	end
	for _, giftId in pairs(data.gifts.equipped) do
		local accessory = GiftBuilder.build(giftId)
		if accessory then
			humanoid:AddAccessory(accessory)
		end
	end
end

local function equip(player, data, giftId)
	local gift = type(giftId) == "string" and GiftSystem.get(giftId)
	if not gift or not data.gifts.owned[giftId] then
		return
	end
	data.gifts.equipped[gift.slot] = giftId
	S.Data.sync(player, "gifts")
	GiftServer.refresh(player)
end

local function unequip(player, data, slot)
	if type(slot) ~= "string" or data.gifts.equipped[slot] == nil then
		return
	end
	data.gifts.equipped[slot] = nil
	S.Data.sync(player, "gifts")
	GiftServer.refresh(player)
end

function GiftServer.init(services)
	S = services
	S.Net.on("EquipGift", equip, 6)
	S.Net.on("UnequipGift", unequip, 6)
end

function GiftServer.playerAdded(player)
	connections[player] = player.CharacterAdded:Connect(function(character)
		-- Wait for the avatar to finish loading before attaching anything.
		character:WaitForChild("Humanoid", 10)
		task.wait(0.5)
		if character.Parent then
			GiftServer.refresh(player)
			S.Social.refreshTitle(player)
		end
	end)
	if player.Character then
		GiftServer.refresh(player)
	end
end

function GiftServer.playerRemoving(player)
	if connections[player] then
		connections[player]:Disconnect()
		connections[player] = nil
	end
end

return GiftServer
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="50">
        <Properties>
          <string name="Name">HouseServer</string>
          <string name="Source"><![CDATA[--[[
	HouseServer
	Gives every player a plot, builds their house (and rebuilds it bigger when
	Brady reaches a new stage), wires up the room's stations, and runs the
	grid-based furniture placement.

	Furniture placement is validated here with the same FurnitureSystem rules
	the client used for its preview: the player must own a spare copy, the
	footprint must be inside the room and may not overlap stations, the
	doorway or other furniture.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Modules = ReplicatedStorage.Modules
local AgeSystem = require(Modules.AgeSystem)
local Config = require(Modules.Config)
local FurnitureSystem = require(Modules.FurnitureSystem)
local HouseSystem = require(Modules.HouseSystem)
local InventorySystem = require(Modules.InventorySystem)
local Util = require(Modules.Util)
local FurnitureBuilder = require(Modules.Builders.FurnitureBuilder)
local PartUtil = require(Modules.Builders.PartUtil)
local HouseBuilder = require(script.Parent.Parent.World.HouseBuilder)

local HouseServer = {}

local S
local plots = {} -- [index] = { index, cframe, owner, model, info }
local byPlayer = {}
local folder

local function plotCFrame(index)
	local list = S.Map.plots
	if list[index] then
		return list[index]
	end
	-- More players than pre-built plots: keep extending the street.
	return S.Map.plotCFrame(index)
end

function HouseServer.get(player)
	return byPlayer[player]
end

-- Room-local origin (centre of the floor) in world space.
function HouseServer.origin(player)
	local plot = byPlayer[player]
	return plot and plot.info and plot.info.origin or CFrame.new(0, 5, 0)
end

function HouseServer.size(player)
	local plot = byPlayer[player]
	return plot and plot.info and plot.info.size or 24
end

-- Where Brady stands to use a station (world CFrame).
function HouseServer.stationCFrame(player, station)
	return HouseServer.origin(player) * HouseSystem.standCFrame(HouseServer.size(player), station)
end

-- Middle of the room, facing the front door.
function HouseServer.homeCFrame(player)
	return HouseServer.origin(player) * CFrame.lookAt(Vector3.new(0, 0, 1), Vector3.new(0, 0, 4))
end

function HouseServer.doorstep(player)
	return HouseServer.origin(player) * HouseSystem.doorstep(HouseServer.size(player))
end

function HouseServer.isInside(player, worldPosition, margin)
	local plot = byPlayer[player]
	if not plot or not plot.info then
		return false
	end
	local localPosition = plot.info.origin:PointToObjectSpace(worldPosition)
	return localPosition.Y > -4 and localPosition.Y < 30 and HouseSystem.isInside(plot.info.size, localPosition, margin)
end

-- A random free floor spot for Brady to wander to (world position).
function HouseServer.randomSpot(player)
	local plot = byPlayer[player]
	local data = S.Data.get(player)
	if not plot or not plot.info or not data then
		return nil
	end
	local size = plot.info.size
	local h = size / 2 - 2.5
	local blocked = HouseSystem.blockedRects(size)
	for _ = 1, 10 do
		local x, z = (math.random() * 2 - 1) * h, (math.random() * 2 - 1) * h
		local free = true
		for _, rect in ipairs(blocked) do
			if HouseSystem.pointInRect(x, z, rect, 1) then
				free = false
				break
			end
		end
		if free then
			for _, placement in ipairs(data.furniture.placed) do
				local def = FurnitureSystem.get(placement.id)
				if def and def.layer ~= "rug" and HouseSystem.pointInRect(x, z, FurnitureSystem.rectOf(placement), 1) then
					free = false
					break
				end
			end
		end
		if free then
			return (plot.info.origin * CFrame.new(x, 0, z)).Position
		end
	end
	return nil
end

----------------------------------------------------------------------
-- Furniture
----------------------------------------------------------------------
local function spawnFurniture(player, plot, placement)
	local def = FurnitureSystem.get(placement.id)
	local model = FurnitureBuilder.build(placement.id)
	if not model or not def then
		return
	end
	model:PivotTo(plot.info.origin * FurnitureSystem.localCFrame(placement))
	model:SetAttribute("OwnerUserId", player.UserId)
	if def.toy then
		-- Toys can be played with (owner only).
		local prompt = PartUtil.prompt(model.PrimaryPart, "Play", def.name, { distance = 8, name = "ToyPrompt" })
		prompt:SetAttribute("OwnerUserId", player.UserId)
		CollectionService:AddTag(prompt, HouseBuilder.OwnerPromptTag)
		prompt.Triggered:Connect(function(who)
			if who == player then
				S.Care.playToy(player, placement.id)
			end
		end)
	end
	model.Parent = plot.info.furniture
end

-- Destroys and respawns every furniture model, dropping any placement that
-- is no longer valid (for example after the room layout changed).
local function refreshFurniture(player)
	local plot = byPlayer[player]
	local data = S.Data.get(player)
	if not plot or not plot.info or not data then
		return
	end
	plot.info.furniture:ClearAllChildren()
	local valid, removed = {}, 0
	for _, placement in ipairs(data.furniture.placed) do
		if FurnitureSystem.canPlace(valid, placement.id, placement.x, placement.z, placement.r, plot.info.size) then
			table.insert(valid, placement)
		else
			removed += 1
		end
	end
	data.furniture.placed = valid
	for _, placement in ipairs(valid) do
		spawnFurniture(player, plot, placement)
	end
	if removed > 0 then
		S.Data.sync(player, "furniture")
		S.Net.toast(player, removed .. " furniture item(s) went back into storage", "info")
	end
end

local function maxPlaced(player)
	return S.Passes.has(player, "ExtraStorage") and Config.MaxPlacedFurnitureWithPass or Config.MaxPlacedFurniture
end

local function placeFurniture(player, data, id, x, z, r)
	local plot = byPlayer[player]
	if type(id) ~= "string" or not plot or not plot.info then
		return
	end
	local def = FurnitureSystem.get(id)
	if not def then
		return
	end
	local placed = data.furniture.placed
	if (data.furniture.owned[id] or 0) - FurnitureSystem.placedCount(placed, id) <= 0 then
		S.Net.toast(player, "you don't have a spare " .. def.name, "bad")
		return
	end
	if def.vip and not S.Passes.has(player, "VIPDecor") then
		S.Net.toast(player, "that needs the VIP Room Decorations pass", "bad")
		return
	end
	if #placed >= maxPlaced(player) then
		S.Net.toast(player, "your room is full!", "bad")
		return
	end
	local ok, reason = FurnitureSystem.canPlace(placed, id, x, z, r, plot.info.size)
	if not ok then
		S.Net.toast(player, reason, "bad")
		return
	end
	local placement = { id = id, x = x, z = z, r = r }
	table.insert(placed, placement)
	spawnFurniture(player, plot, placement)
	S.Data.sync(player, "furniture")
	S.Achievements.bump(player, "placed", 1)
	S.Net.fire(player, "Effect", "Sound", { name = "place" })
end

local function removeFurniture(player, data, index)
	local placed = data.furniture.placed
	if type(index) ~= "number" or index % 1 ~= 0 or not placed[index] then
		return
	end
	table.remove(placed, index)
	refreshFurniture(player)
	S.Data.sync(player, "furniture")
	S.Net.fire(player, "Effect", "Sound", { name = "remove" })
end

----------------------------------------------------------------------
-- Stations
----------------------------------------------------------------------
local function connectStations(player, plot)
	for station, prompt in pairs(plot.info.prompts) do
		prompt.Triggered:Connect(function(who)
			local isOwner = who == player
			if station == "Display" then
				if isOwner then
					S.Net.fire(who, "OpenPanel", "Inventory")
				else
					S.Net.fire(who, "OpenPanel", "Inspect", player.UserId)
				end
				return
			elseif station == "Trophy" then
				if isOwner then
					S.Net.fire(who, "OpenPanel", "Collection")
				else
					S.Net.fire(who, "OpenPanel", "Inspect", player.UserId)
				end
				return
			end
			if not isOwner then
				return -- visitors can look, not touch
			end
			if station == "Bed" then
				S.Care.toggleSleep(player)
			elseif station == "Wardrobe" then
				S.Net.fire(player, "OpenPanel", "Wardrobe")
			elseif station == "Mirror" then
				S.Care.mirror(player, true)
			elseif station == "Food" then
				S.Net.fire(player, "OpenPanel", "Feed")
			elseif station == "Podium" then
				S.Care.podiumPose(player)
			elseif station == "Shower" then
				S.Care.perform(player, "Shower")
			elseif station == "Sink" then
				S.Care.perform(player, "BrushHair")
			elseif station == "ShoeMat" then
				S.Care.perform(player, "CleanShoes")
			end
		end)
	end
end

----------------------------------------------------------------------
-- Building
----------------------------------------------------------------------
local function showcaseItems(data)
	local owned = InventorySystem.ownedItems(data) -- rarest first
	return { owned[1], owned[2], owned[3] }
end

local function build(player)
	local plot = byPlayer[player]
	local data = S.Data.get(player)
	if not plot or not data then
		return
	end
	if plot.model then
		plot.model:Destroy()
	end
	local model, info = HouseBuilder.build(folder, plot.cframe, {
		age = data.age,
		ownerName = player.DisplayName,
		ownerUserId = player.UserId,
		showcase = showcaseItems(data),
		trophies = { achievements = Util.count(data.achievements), wins = data.stats.showsWon },
	})
	plot.model, plot.info = model, info
	connectStations(player, plot)
	refreshFurniture(player)
end

-- Rebuild after a stage change (bigger room), keeping Brady inside it.
function HouseServer.upgrade(player)
	build(player)
	local rec = S.Brady.get(player)
	local session = S.Data.session(player)
	if rec and session and not rec.following and not rec.inShow then
		if session.sleeping then
			S.Brady.place(rec, HouseServer.stationCFrame(player, "Bed"))
		else
			S.Brady.place(rec, HouseServer.homeCFrame(player))
		end
	end
end

-- Refreshes the clothing display + trophy shelf. They are part of the house
-- model, so this rebuilds it in place (same size, Brady is not moved). It
-- only happens on rare events: a new Legendary+ item or a secret find.
function HouseServer.refreshDisplays(player)
	build(player)
end

-- Turns the shower water on for a few seconds.
function HouseServer.runShower(player, seconds)
	local plot = byPlayer[player]
	local emitter = plot and plot.info and plot.info.showerEmitter
	if not emitter then
		return
	end
	emitter.Enabled = true
	task.delay(seconds, function()
		if emitter.Parent then
			emitter.Enabled = false
		end
	end)
end

function HouseServer.teleportTo(player, cframe)
	local character = player.Character
	if character and character.PrimaryPart then
		character:PivotTo(cframe * CFrame.new(0, 4, 0))
		return true
	end
	return false
end

----------------------------------------------------------------------
-- Lifecycle
----------------------------------------------------------------------
function HouseServer.init(services)
	S = services
	folder = Instance.new("Folder")
	folder.Name = "Houses"
	folder.Parent = Workspace
	for index = 1, Config.PlotCount do
		plots[index] = { index = index, cframe = plotCFrame(index) }
	end
	S.Net.on("PlaceFurniture", placeFurniture, 6)
	S.Net.on("RemoveFurniture", removeFurniture, 6)
end

function HouseServer.playerAdded(player)
	local chosen
	for _, plot in ipairs(plots) do
		if not plot.owner then
			chosen = plot
			break
		end
	end
	if not chosen then
		local index = #plots + 1
		chosen = { index = index, cframe = plotCFrame(index) }
		plots[index] = chosen
	end
	chosen.owner = player
	byPlayer[player] = chosen
	local session = S.Data.session(player)
	if session then
		session.plot = chosen.index
	end
	build(player)

	-- New arrivals start on their own doorstep.
	local function sendHome(character)
		task.defer(function()
			if byPlayer[player] and character.Parent then
				local primary = character:WaitForChild("HumanoidRootPart", 10)
				if primary then
					character:PivotTo(HouseServer.doorstep(player) * CFrame.new(0, 4, 0))
				end
			end
		end)
	end
	if player.Character then
		sendHome(player.Character)
	end
	chosen.spawnConnection = player.CharacterAdded:Connect(sendHome)
end

function HouseServer.playerRemoving(player)
	local plot = byPlayer[player]
	if not plot then
		return
	end
	if plot.spawnConnection then
		plot.spawnConnection:Disconnect()
	end
	if plot.model then
		plot.model:Destroy()
	end
	plot.model, plot.info, plot.owner, plot.spawnConnection = nil, nil, nil, nil
	byPlayer[player] = nil
end

function HouseServer.ownerOf(index)
	local plot = plots[index]
	return plot and plot.owner or nil
end

function HouseServer.count()
	return #Players:GetPlayers()
end

return HouseServer
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="51">
        <Properties>
          <string name="Name">MinigameServer</string>
          <string name="Source"><![CDATA[--[[
	MinigameServer
	"Play with Brady". The UI mini-games run on the client, so the server
	treats the reported score as a claim to verify:

	  * a round must be STARTED through the server (energy is charged, a
	    one-time token is issued, a cooldown applies)
	  * the finish call must present that token, the round must have lasted a
	    believable time, and the score is clamped to the game's maximum
	  * rewards are computed here from the clamped score

	The Goo Obby is fully server-side: the server sees the start pad, every
	checkpoint in order and the finish pad being touched.
]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Modules = ReplicatedStorage.Modules
local AgeSystem = require(Modules.AgeSystem)
local Config = require(Modules.Config)
local Dialogue = require(Modules.Dialogue)
local MinigameSystem = require(Modules.MinigameSystem)

local MinigameServer = {}

local S
local sessions = {} -- [player] = { def, token, startedAt, bonus }
local lastFinish = {} -- [player] = os.clock()
local obbyRuns = {} -- [player] = { startedAt, checkpoint, serverStart }

local function nearArcade(player)
	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	local arcade = S.Map.arcade
	return hrp ~= nil and (hrp.Position - arcade.center).Magnitude <= arcade.radius
end

-- Shared "is Brady able to play right now?" check. Returns a reason on failure.
local function canPlay(player, data, def)
	local session = S.Data.session(player)
	local rec = S.Brady.get(player)
	if not session or not rec then
		return "still loading..."
	end
	if data.age < def.minAge then
		return def.name .. " unlocks at age " .. def.minAge
	end
	if session.sleeping then
		return "Brady is asleep"
	end
	if rec.inShow then
		return "Brady is in a fashion show"
	end
	if data.meters.energy < Config.MinigameEnergyCost then
		return "Brady is too tired - put him to bed!"
	end
	if os.clock() - (lastFinish[player] or -100) < Config.MinigameCooldown then
		return "catch your breath for a second"
	end
	return nil
end

-- Pays out a finished round. Returns coins, xp, ratio.
local function payout(player, data, def, score, bonus)
	score = math.clamp(math.floor(score), 0, def.maxScore)
	local multiplier = AgeSystem.rewardMultiplier(data.age, data.rebirths) * bonus
	local coins, xp, ratio = MinigameSystem.rewards(def, score, multiplier)
	S.Care.addMeter(data, "fun", 25)
	S.Data.sync(player, "meters")
	coins = S.Currency.add(player, coins, "minigame")
	xp = S.Age.addXP(player, xp * bonus)
	S.Achievements.bump(player, "minigames", 1)
	if ratio >= 0.95 then
		S.Achievements.bump(player, "perfectGames", 1)
	end
	local rec = S.Brady.get(player)
	if rec then
		rec.busyUntil = 0
		if ratio >= 0.6 then
			S.Brady.act(rec, "Celebrate", 2.5)
			S.Brady.say(rec, Dialogue.pick("win"))
		else
			S.Brady.act(rec, "Idle", 0.1)
			S.Brady.say(rec, Dialogue.pick("lose"))
		end
	end
	lastFinish[player] = os.clock()
	return coins, xp, ratio
end

----------------------------------------------------------------------
-- UI mini-games
----------------------------------------------------------------------
local function start(player, data, gameId)
	local def = type(gameId) == "string" and MinigameSystem.get(gameId)
	if not def or def.world then
		return { ok = false, reason = "unknown game" }
	end
	if sessions[player] then
		sessions[player] = nil -- abandoning a round forfeits it
	end
	local reason = canPlay(player, data, def)
	if reason then
		return { ok = false, reason = reason }
	end
	S.Care.addMeter(data, "energy", -Config.MinigameEnergyCost)
	S.Data.sync(player, "meters")
	local bonus = nearArcade(player) and Config.ArcadeBonus or 1
	local token = HttpService:GenerateGUID(false)
	sessions[player] = { def = def, token = token, startedAt = os.clock(), bonus = bonus }
	local rec = S.Brady.get(player)
	if rec then
		S.Brady.act(rec, "Play", def.duration + 3)
		S.Brady.say(rec, Dialogue.pick("play"))
	end
	return { ok = true, token = token, bonus = bonus, duration = def.duration }
end

local function finish(player, data, token, score)
	local session = sessions[player]
	if not session or type(token) ~= "string" or token ~= session.token then
		return { ok = false, reason = "that round already ended" }
	end
	sessions[player] = nil
	local def = session.def
	if type(score) ~= "number" or score ~= score then
		score = 0
	end
	local elapsed = os.clock() - session.startedAt
	if elapsed < def.minTime then
		-- Finished impossibly fast (or quit early): only the minimum reward.
		score = 0
	elseif elapsed > def.duration + 45 then
		return { ok = false, reason = "that round timed out" }
	end
	local coins, xp, ratio = payout(player, data, def, score, session.bonus)
	return { ok = true, coins = coins, xp = xp, ratio = ratio, bonus = session.bonus }
end

----------------------------------------------------------------------
-- Goo Obby (world mini-game)
----------------------------------------------------------------------
local function playerFromHit(hit)
	local character = hit and hit.Parent
	return character and Players:GetPlayerFromCharacter(character) or nil
end

local function obbyTeleport(player, cframe)
	local character = player.Character
	if character and character.PrimaryPart then
		character:PivotTo(cframe * CFrame.new(0, 4, 0))
	end
end

local function setupObby()
	local obby = S.Map.obby
	local def = MinigameSystem.get("obby")
	local total = #obby.checkpoints

	obby.start.Touched:Connect(function(hit)
		local player = playerFromHit(hit)
		local data = player and S.Data.get(player)
		if not data or obbyRuns[player] then
			return
		end
		local reason = canPlay(player, data, def)
		if reason then
			if os.clock() - (lastFinish[player] or -100) >= Config.MinigameCooldown then
				lastFinish[player] = os.clock() - Config.MinigameCooldown + 2 -- throttle the message
				S.Net.toast(player, reason, "bad")
			end
			return
		end
		S.Care.addMeter(data, "energy", -Config.MinigameEnergyCost)
		S.Data.sync(player, "meters")
		obbyRuns[player] = { startedAt = os.clock(), checkpoint = 0 }
		S.Net.fire(player, "ObbyState", { running = true, startedAt = Workspace:GetServerTimeNow(), total = total })
	end)

	for index, checkpoint in ipairs(obby.checkpoints) do
		checkpoint.Touched:Connect(function(hit)
			local player = playerFromHit(hit)
			local run = player and obbyRuns[player]
			if run and run.checkpoint == index - 1 then
				run.checkpoint = index
				S.Net.fire(player, "ObbyState", { running = true, checkpoint = index, total = total })
			end
		end)
	end

	-- Falling into the goo sends you back to your last checkpoint (no dying).
	for _, kill in ipairs(obby.kill) do
		kill.Touched:Connect(function(hit)
			local player = playerFromHit(hit)
			if not player then
				return
			end
			local run = obbyRuns[player]
			if run and run.checkpoint > 0 then
				obbyTeleport(player, obby.checkpoints[run.checkpoint].CFrame)
			else
				obbyTeleport(player, obby.respawn)
			end
		end)
	end

	obby.finish.Touched:Connect(function(hit)
		local player = playerFromHit(hit)
		local run = player and obbyRuns[player]
		local data = player and S.Data.get(player)
		if not run or not data or run.checkpoint < total then
			return
		end
		local elapsed = os.clock() - run.startedAt
		if elapsed < def.minTime then
			return -- nobody is that fast
		end
		obbyRuns[player] = nil
		-- 100 points at 20s or faster, sliding down to 20 points at 90s+.
		local score = math.clamp(100 - (elapsed - 20) * (80 / 70), 20, 100)
		local coins, xp = payout(player, data, def, score, 1)
		S.Net.fire(player, "ObbyState", { running = false, result = { time = elapsed, coins = coins, xp = xp } })
	end)
end

function MinigameServer.tick()
	local def = MinigameSystem.get("obby")
	for player, run in pairs(obbyRuns) do
		if os.clock() - run.startedAt > def.duration then
			obbyRuns[player] = nil
			S.Net.fire(player, "ObbyState", { running = false, timeout = true })
		end
	end
end

function MinigameServer.init(services)
	S = services
	S.Net.handle("MinigameStart", start, 3)
	S.Net.handle("MinigameFinish", finish, 3)
end

function MinigameServer.start()
	setupObby()
end

function MinigameServer.playerRemoving(player)
	sessions[player] = nil
	lastFinish[player] = nil
	obbyRuns[player] = nil
end

return MinigameServer
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="52">
        <Properties>
          <string name="Name">MonetizationServer</string>
          <string name="Source"><![CDATA[--[[
	MonetizationServer  (S.Passes)
	Checks which optional gamepasses a player owns. Ownership is always asked
	of Roblox on the SERVER (MarketplaceService), never taken from the client.

	Every pass is cosmetic or convenience only. With all pass ids left at 0
	(the default) nothing is for sale and the whole game still works.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Modules = ReplicatedStorage.Modules
local Config = require(Modules.Config)
local Monetization = require(Modules.Monetization)

local MonetizationServer = {}

local S

function MonetizationServer.has(player, key)
	local session = S.Data.session(player)
	return session ~= nil and session.passes[key] == true
end

local function refresh(player)
	local session = S.Data.session(player)
	if not session then
		return
	end
	local studioAll = Config.StudioOwnsAllPasses and RunService:IsStudio()
	for _, pass in ipairs(Monetization.Passes) do
		local owned = studioAll
		if not owned and pass.id > 0 then
			local ok, result = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.id)
			end)
			owned = ok and result == true
		end
		session.passes[pass.key] = owned or nil
	end
	S.Data.syncSession(player, "passes")
end

function MonetizationServer.init(services)
	S = services
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		local session = S.Data.session(player)
		if not session then
			return
		end
		for _, pass in ipairs(Monetization.Passes) do
			if pass.id == passId then
				session.passes[pass.key] = true
				S.Data.syncSession(player, "passes")
				S.Net.notify(player, { text = "PASS UNLOCKED!", sub = pass.name, kind = "good", sound = "rare" })
				S.Brady.rebuild(player)
			end
		end
	end)
end

function MonetizationServer.playerAdded(player)
	-- Ownership checks are web calls, so do not hold up the join for them.
	task.spawn(function()
		refresh(player)
		if S.Data.get(player) then
			S.Brady.rebuild(player)
		end
	end)
end

return MonetizationServer
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="53">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--[[
	Net (server)
	Thin wrapper around the RemoteEvents / RemoteFunctions so every handler
	gets the same protection for free:

	  * the player's data must be loaded (handlers receive `data`)
	  * per-player rate limiting (stops remote spam / macro exploits)
	  * errors in one handler are caught and logged instead of breaking others

	Handlers still validate their own arguments - a client can send anything.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Modules.Remotes)

local Net = {}

local dataService -- set by Net.init
local buckets = {} -- [player][remoteName] = { count, windowStart }

function Net.init(S)
	dataService = S.Data
	Players.PlayerRemoving:Connect(function(player)
		buckets[player] = nil
	end)
end

-- Returns true when the call is allowed. `limit` = max calls per second.
local function allow(player, name, limit)
	local playerBuckets = buckets[player]
	if not playerBuckets then
		playerBuckets = {}
		buckets[player] = playerBuckets
	end
	local bucket = playerBuckets[name]
	local now = os.clock()
	if not bucket or now - bucket.start >= 1 then
		playerBuckets[name] = { count = 1, start = now }
		return true
	end
	bucket.count += 1
	return bucket.count <= limit
end

-- Listen to a client -> server RemoteEvent.
-- handler(player, data, ...) only runs when the player's data is loaded.
function Net.on(name, handler, limit)
	limit = limit or 8
	Remotes.event(name).OnServerEvent:Connect(function(player, ...)
		if not allow(player, name, limit) then
			return
		end
		local data = dataService.get(player)
		if not data then
			return
		end
		local ok, err = pcall(handler, player, data, ...)
		if not ok then
			warn(string.format("[Net] %s handler error for %s: %s", name, player.Name, tostring(err)))
		end
	end)
end

-- Answer a RemoteFunction. Always returns a table so the client never hangs.
function Net.handle(name, handler, limit)
	limit = limit or 6
	Remotes.func(name).OnServerInvoke = function(player, ...)
		if not allow(player, name, limit) then
			return { ok = false, reason = "slow down!" }
		end
		local data = dataService.get(player)
		if not data then
			return { ok = false, reason = "still loading..." }
		end
		local ok, result = pcall(handler, player, data, ...)
		if not ok then
			warn(string.format("[Net] %s handler error for %s: %s", name, player.Name, tostring(result)))
			return { ok = false, reason = "something went wrong" }
		end
		return result
	end
end

function Net.fire(player, name, ...)
	if player and player.Parent then
		Remotes.event(name):FireClient(player, ...)
	end
end

function Net.fireAll(name, ...)
	Remotes.event(name):FireAllClients(...)
end

-- Big centre-screen announcement.
-- payload = { text, sub, kind = "good"|"bad"|"rare"|"archive"|"grail"|"event", sound, big }
function Net.notify(player, payload)
	Net.fire(player, "Notify", payload)
end

-- Small message at the bottom of the screen.
function Net.toast(player, text, kind)
	Net.fire(player, "Notify", { text = text, toast = true, kind = kind or "info" })
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="54">
        <Properties>
          <string name="Name">ShopServer</string>
          <string name="Source"><![CDATA[--[[
	ShopServer
	Everything bought with Goo Coins: clothing, hairstyles, food, furniture /
	decorations / toys, and crates. Prices come from the shared catalogs, never
	from the client, and the coins are taken before anything is granted.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage.Modules
local ClothingSystem = require(Modules.ClothingSystem)
local Config = require(Modules.Config)
local FoodSystem = require(Modules.FoodSystem)
local FurnitureSystem = require(Modules.FurnitureSystem)
local ShopSystem = require(Modules.ShopSystem)

local ShopServer = {}

local S

local function fail(reason)
	return { ok = false, reason = reason }
end

local function buyClothing(player, data, id)
	local item = ClothingSystem.get(id)
	if not item or not item.price then
		return fail("that isn't for sale")
	end
	if data.inventory[id] then
		return fail("you already own that")
	end
	if data.age < item.age then
		return fail("Brady must be age " .. item.age)
	end
	if not S.Currency.spend(player, item.price) then
		return fail("not enough Goo Coins")
	end
	S.Clothing.grant(player, id, "shop")
	return { ok = true }
end

local function buyFood(player, data, id, quantity)
	local food = FoodSystem.get(id)
	if not food or food.free then
		return fail("that isn't for sale")
	end
	if type(quantity) ~= "number" or quantity % 1 ~= 0 or quantity < 1 or quantity > 10 then
		return fail("bad amount")
	end
	if data.age < (food.minAge or 1) then
		return fail("unlocks at age " .. food.minAge)
	end
	local cap = S.Passes.has(player, "ExtraStorage") and Config.MaxFoodStackWithPass or Config.MaxFoodStack
	local have = data.food[id] or 0
	if have + quantity > cap then
		return fail("your pantry only fits " .. cap .. " of each food")
	end
	if not S.Currency.spend(player, food.price * quantity) then
		return fail("not enough Goo Coins")
	end
	data.food[id] = have + quantity
	S.Data.sync(player, "food")
	return { ok = true }
end

local function buyFurniture(player, data, id)
	local def = FurnitureSystem.get(id)
	if not def or not def.price or def.special then
		return fail("that isn't for sale")
	end
	if def.vip and not S.Passes.has(player, "VIPDecor") then
		return fail("needs the VIP Room Decorations pass")
	end
	if data.age < (def.minAge or 1) then
		return fail("unlocks at age " .. def.minAge)
	end
	if (data.furniture.owned[id] or 0) >= 20 then
		return fail("you own plenty of those already")
	end
	if not S.Currency.spend(player, def.price) then
		return fail("not enough Goo Coins")
	end
	data.furniture.owned[id] = (data.furniture.owned[id] or 0) + 1
	S.Data.sync(player, "furniture")
	S.Net.fire(player, "ItemGranted", { kind = "furniture", id = id, isNew = true, source = "shop" })
	S.Achievements.check(player)
	return { ok = true }
end

local function buy(player, data, kind, id, quantity)
	if type(kind) ~= "string" or type(id) ~= "string" then
		return fail("bad request")
	end
	if kind == "clothing" then
		return buyClothing(player, data, id)
	elseif kind == "food" then
		return buyFood(player, data, id, quantity or 1)
	elseif kind == "furniture" then
		return buyFurniture(player, data, id)
	end
	return fail("bad request")
end

local function openCrate(player, data, crateId)
	local crate = type(crateId) == "string" and ShopSystem.CrateById[crateId]
	if not crate then
		return fail("unknown crate")
	end
	if data.age < crate.minAge then
		return fail("unlocks at age " .. crate.minAge)
	end
	if not S.Currency.spend(player, crate.price) then
		return fail("not enough Goo Coins")
	end
	local item = ShopSystem.roll(crate)
	if not item then
		S.Currency.add(player, crate.price, "refund")
		return fail("the crate was empty?? (refunded)")
	end
	-- Granted silently: the client plays the crate reveal, then announces it.
	local result = S.Clothing.grant(player, item.id, "crate", true)
	S.Achievements.bump(player, "crates", 1)
	if result.isNew and ClothingSystem.rarityOrder(item.rarity) >= 5 then
		S.House.refreshDisplays(player)
	end
	return { ok = true, itemId = item.id, isNew = result.isNew, refund = result.refund }
end

function ShopServer.init(services)
	S = services
	S.Net.handle("Buy", buy, 6)
	S.Net.handle("OpenCrate", openCrate, 3)
end

return ShopServer
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="55">
        <Properties>
          <string name="Name">SocialServer</string>
          <string name="Source"><![CDATA[--[[
	SocialServer
	Multiplayer features that only READ other players' progress:
	  * GetProfile  - inspect another player's Brady, outfit and collection
	  * Visit       - teleport to someone's house or a map location
	  * Hype        - give another Brady's fit some hype
	Plus small per-player things: settings, tutorial completion, the title over
	the player's head.

	Nothing here can change another player's items or coins.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage.Modules
local AgeSystem = require(Modules.AgeSystem)
local CollectionSystem = require(Modules.CollectionSystem)
local CurrencySystem = require(Modules.CurrencySystem)
local DataManager = require(Modules.DataManager)
local Dialogue = require(Modules.Dialogue)
local FashionSystem = require(Modules.FashionSystem)
local InventorySystem = require(Modules.InventorySystem)
local Monetization = require(Modules.Monetization)

local SocialServer = {}

local S
local hypeCooldown = {} -- [player][targetUserId] = os.clock()
local photoCooldown = {}

-- Public summary of a player's progress (safe to show anyone).
local function getProfile(_player, _data, userId)
	local target = type(userId) == "number" and Players:GetPlayerByUserId(userId)
	local data = target and S.Data.get(target)
	if not data then
		return { ok = false, reason = "that player left" }
	end
	local stage = AgeSystem.getStage(data.age)
	local title = S.Brady.activeTitle(data)
	return {
		ok = true,
		userId = userId,
		name = target.DisplayName,
		age = data.age,
		stageName = stage.name,
		rebirths = data.rebirths,
		equipped = data.equipped,
		drip = math.floor(InventorySystem.dripScore(data.equipped)),
		items = InventorySystem.countOwned(data),
		archive = InventorySystem.countRarity(data, "Archive"),
		grail = InventorySystem.countRarity(data, "Grail"),
		collection = CollectionSystem.totalPercent(data),
		title = title and title.name or nil,
		hypes = data.stats.hypes,
		wins = data.stats.showsWon,
	}
end

local function visit(player, _data, target)
	local map = S.Map
	local destination
	if target == "Home" then
		destination = S.House.doorstep(player)
	elseif target == "Plaza" then
		destination = map.spawn
	elseif target == "Runway" then
		destination = map.runway.audience
	elseif target == "Shop" then
		destination = map.store.entrance
	elseif target == "Arcade" then
		destination = map.arcade.entrance
	elseif target == "Park" then
		destination = map.park.entrance
	elseif target == "Food" then
		destination = map.food.entrance
	elseif type(target) == "number" then
		local other = Players:GetPlayerByUserId(target)
		if other and S.House.get(other) then
			destination = S.House.doorstep(other)
		else
			S.Net.toast(player, "that player left", "bad")
			return
		end
	end
	if destination then
		S.House.teleportTo(player, destination)
	end
end

local function hype(player, _data, userId)
	local target = type(userId) == "number" and Players:GetPlayerByUserId(userId)
	if not target or target == player or not S.Data.get(target) then
		return
	end
	local list = hypeCooldown[player]
	if not list then
		list = {}
		hypeCooldown[player] = list
	end
	local now = os.clock()
	if list[userId] and now - list[userId] < 300 then
		S.Net.toast(player, "you already hyped that fit - try again later", "bad")
		return
	end
	list[userId] = now
	S.Achievements.bump(target, "hypes", 1)
	S.Net.toast(target, player.DisplayName .. " hyped Brady's fit!", "good")
	S.Net.toast(player, "hype sent!", "good")
	local rec = S.Brady.get(target)
	if rec and not S.Brady.isBusy(rec) and not rec.persist and not rec.inShow then
		S.Brady.act(rec, "Celebrate", 2)
		S.Brady.say(rec, Dialogue.pick("goodFit"))
	end
end

local function setting(player, data, key, value)
	if type(key) ~= "string" then
		return
	end
	local default = DataManager.SettingDefaults[key]
	if default == nil or type(value) ~= type(default) then
		return
	end
	if key == "aura" then
		if not table.find(Monetization.Auras, value) then
			return
		end
		if value ~= "none" and not S.Passes.has(player, "CosmeticEffects") then
			S.Net.toast(player, "auras need the Cosmetic Effects pass", "bad")
			return
		end
	end
	data.settings[key] = value
	S.Data.sync(player, "settings")
	if key == "aura" then
		S.Brady.rebuild(player)
	end
end

local function tutorial(player, data, action)
	if action == "Done" and not data.tutorialDone then
		data.tutorialDone = true -- flag first: the bonus is one-time
		S.Data.sync(player, "tutorialDone")
		local coins = S.Currency.add(player, CurrencySystem.Rewards.TutorialDone, "tutorial")
		S.Net.notify(player, { text = "TUTORIAL COMPLETE!", sub = "+" .. coins .. " Goo Coins. now go raise brady.", kind = "good", sound = "rare" })
	elseif action == "Replay" then
		data.tutorialDone = false
		S.Data.sync(player, "tutorialDone")
	elseif action == "Photo" then
		-- mirror screenshot taken (only counts once every 30s)
		local now = os.clock()
		if now - (photoCooldown[player] or -100) >= 30 then
			photoCooldown[player] = now
			S.Achievements.bump(player, "photos", 1)
		end
	end
end

-- Title floating over the PLAYER's head (Brady has his own nameplate).
function SocialServer.refreshTitle(player)
	local data = S.Data.get(player)
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	if not data or not head then
		return
	end
	local existing = head:FindFirstChild("BradyTitle")
	if existing then
		existing:Destroy()
	end
	local title = S.Brady.activeTitle(data)
	local stars = string.rep("★", math.min(data.rebirths, 5))
	if not title and stars == "" then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "BradyTitle"
	gui.Size = UDim2.fromScale(7, 1)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 2.6, 0)
	gui.MaxDistance = 60
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextStrokeTransparency = 0.25
	label.TextColor3 = title and (FashionSystem.TitleColors[title.name] or Color3.fromRGB(255, 205, 60)) or Color3.fromRGB(255, 205, 60)
	label.Text = (stars ~= "" and stars .. " " or "") .. (title and title.name or "")
	label.Parent = gui
	gui.Parent = head
end

function SocialServer.init(services)
	S = services
	S.Net.handle("GetProfile", getProfile, 4)
	S.Net.on("Visit", visit, 2)
	S.Net.on("Hype", hype, 2)
	S.Net.on("Setting", setting, 6)
	S.Net.on("Tutorial", tutorial, 4)
end

function SocialServer.playerAdded(player)
	SocialServer.refreshTitle(player)
end

function SocialServer.playerRemoving(player)
	hypeCooldown[player] = nil
	photoCooldown[player] = nil
end

return SocialServer
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="56">
      <Properties>
        <string name="Name">World</string>
      </Properties>
      <Item class="ModuleScript" referent="57">
        <Properties>
          <string name="Name">HouseBuilder</string>
          <string name="Source"><![CDATA[--[[
	HouseBuilder
	Builds a player's house out of parts. The house is fully parametric:
	  * its SIZE comes from Brady's stage (24 studs -> 60 studs)
	  * its STYLE (materials / colours / wall height) changes every 2 stages
	so every stage-up visibly upgrades the home.

	Layout numbers come from HouseSystem so the furniture rules, Brady's
	wander area and the physical stations always line up.

	Everything is positioned in room-local space (origin = centre of the
	floor, +Z = front door) and converted with the plot CFrame.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage.Modules
local AgeSystem = require(Modules.AgeSystem)
local ClothingSystem = require(Modules.ClothingSystem)
local HouseSystem = require(Modules.HouseSystem)
local PartUtil = require(Modules.Builders.PartUtil)

local HouseBuilder = {}

local rgb = Color3.fromRGB
local v3 = Vector3.new
local rad = math.rad
local UP = PartUtil.UP

local WHITE = rgb(245, 245, 245)
local GOLD = rgb(255, 205, 60)
local GOO = rgb(126, 232, 74)
local DARK = rgb(34, 34, 40)

HouseBuilder.RoofTag = "HouseRoof"
HouseBuilder.OwnerPromptTag = "OwnerPrompt"

local STYLES = {
	{ wall = rgb(150, 110, 70), wallMat = "WoodPlanks", floor = rgb(196, 164, 120), floorMat = "WoodPlanks", trim = rgb(104, 74, 46), roof = rgb(124, 62, 50), height = 11, accent = GOO },
	{ wall = rgb(188, 92, 72), wallMat = "Brick", floor = rgb(216, 192, 152), floorMat = "WoodPlanks", trim = WHITE, roof = rgb(88, 90, 100), height = 12, accent = rgb(255, 200, 80) },
	{ wall = rgb(236, 236, 238), wallMat = "Concrete", floor = rgb(204, 206, 212), floorMat = "SmoothPlastic", trim = rgb(60, 190, 190), roof = rgb(58, 70, 92), height = 13, accent = rgb(60, 190, 190) },
	{ wall = rgb(62, 64, 72), wallMat = "Slate", floor = rgb(44, 44, 50), floorMat = "Marble", trim = rgb(232, 66, 78), roof = rgb(28, 28, 32), height = 15, accent = rgb(232, 66, 78) },
	{ wall = rgb(246, 241, 232), wallMat = "Marble", floor = rgb(250, 250, 250), floorMat = "Marble", trim = GOLD, roof = rgb(40, 40, 52), height = 17, accent = GOLD },
}

-- opts = { age, ownerName, ownerUserId, showcase = { item, ... }, trophies = { achievements, wins } }
-- Returns model, info
function HouseBuilder.build(parent, plotCFrame, opts)
	local size = AgeSystem.houseSize(opts.age)
	local tier = AgeSystem.houseTier(opts.age)
	local style = STYLES[tier]
	local h = size / 2
	local H = style.height
	local origin = plotCFrame * CFrame.new(0, HouseSystem.FloorHeight, 0)
	local stations = HouseSystem.stations(size)

	local model = Instance.new("Model")
	model.Name = "House_" .. tostring(opts.ownerUserId)
	model:SetAttribute("OwnerUserId", opts.ownerUserId)
	model:SetAttribute("Size", size)

	local function p(name, partSize, position, color, o)
		o = o or {}
		local cframe = origin * CFrame.new(position)
		if o.rot then
			cframe = cframe * o.rot
		end
		return PartUtil.block(o.parent or model, {
			name = name,
			size = partSize,
			cframe = cframe,
			color = color,
			material = o.material,
			shape = o.shape,
			transparency = o.transparency,
			reflectance = o.reflectance,
			collide = o.collide,
			shadow = o.shadow,
		})
	end

	local prompts = {}
	local function prompt(part, station, actionText, objectText, ownerOnly)
		local pr = PartUtil.prompt(part, actionText, objectText, { distance = 10, name = "StationPrompt" })
		pr:SetAttribute("Station", station)
		pr:SetAttribute("OwnerUserId", opts.ownerUserId)
		if ownerOnly then
			CollectionService:AddTag(pr, HouseBuilder.OwnerPromptTag)
		end
		prompts[station] = pr
		return pr
	end

	-- FLOOR ------------------------------------------------------------
	local floor = p("Floor", v3(size + 2, 1, size + 2), v3(0, -0.5, 0), style.floor, { material = style.floorMat })
	floor:SetAttribute("IsFloor", true)
	p("Step", v3(HouseSystem.DoorWidth + 1, 0.5, 2.5), v3(0, -0.75, h + 2.2), style.trim, { material = "Concrete" })

	-- WALLS (with a door gap and windows) -------------------------------
	local function wall(alongX, fixed, length, openings)
		local cursor = -length / 2
		local function seg(name, c0, c1, y0, y1, color, o)
			if c1 - c0 < 0.05 or y1 - y0 < 0.05 then
				return
			end
			local mid, midY = (c0 + c1) / 2, (y0 + y1) / 2
			local partSize = alongX and v3(c1 - c0, y1 - y0, 1) or v3(1, y1 - y0, c1 - c0)
			local position = alongX and v3(mid, midY, fixed) or v3(fixed, midY, mid)
			p(name, partSize, position, color, o)
		end
		local wallOpts = { material = style.wallMat }
		for _, opening in ipairs(openings) do
			local c0, c1 = opening.center - opening.width / 2, opening.center + opening.width / 2
			seg("Wall", cursor, c0, -1, H, style.wall, wallOpts)
			seg("Wall", c0, c1, opening.top, H, style.wall, wallOpts)
			seg("Wall", c0, c1, -1, opening.bottom, style.wall, wallOpts)
			if opening.glass then
				seg("Window", c0, c1, opening.bottom, opening.top, rgb(170, 220, 255), { material = "Glass", transparency = 0.6, shadow = false })
			end
			cursor = c1
		end
		seg("Wall", cursor, length / 2, -1, H, style.wall, wallOpts)
	end

	local sideWindows
	if size >= 36 then
		sideWindows = {
			{ center = -size / 4, width = 6, bottom = 3.5, top = 8.5, glass = true },
			{ center = size / 4, width = 6, bottom = 3.5, top = 8.5, glass = true },
		}
	else
		sideWindows = { { center = 0, width = 6, bottom = 3.5, top = 8.5, glass = true } }
	end
	wall(true, h + 0.5, size + 2, { { center = 0, width = HouseSystem.DoorWidth, bottom = 0, top = 9 } }) -- front
	wall(true, -h - 0.5, size + 2, {}) -- back
	wall(false, -h - 0.5, size, sideWindows) -- left
	wall(false, h + 0.5, size, sideWindows) -- right

	-- Trim along the top of the walls + corner posts.
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			p("Post", v3(1.4, H + 1.4, 1.4), v3(sx * (h + 0.5), (H - 1) / 2 + 0.2, sz * (h + 0.5)), style.trim, { material = tier >= 5 and "Marble" or nil })
		end
	end
	p("DoorFrame", v3(HouseSystem.DoorWidth + 1.2, 0.6, 1.3), v3(0, 9.3, h + 0.5), style.trim)

	-- ROOF: no collisions, so it never traps the camera. Clients hide it
	-- locally while you are inside (see WorldClient).
	local roof = p("Roof", v3(size + 5, 1, size + 5), v3(0, H + 0.5, 0), style.roof, { collide = false, material = tier <= 2 and "Slate" or nil })
	CollectionService:AddTag(roof, HouseBuilder.RoofTag)
	local roofTrim = p("RoofTrim", v3(size + 5.6, 0.5, size + 5.6), v3(0, H - 0.1, 0), style.trim, { collide = false })
	CollectionService:AddTag(roofTrim, HouseBuilder.RoofTag)
	if tier >= 5 then
		-- mansion pillars + glow
		for _, x in ipairs({ -6.5, 6.5 }) do
			p("Pillar", v3(H, 1.6, 1.6), v3(x, H / 2 - 0.5, h + 2.6), WHITE, { shape = "Cylinder", rot = UP, material = "Marble" })
			p("PillarCap", v3(2.4, 0.6, 2.4), v3(x, H - 0.4, h + 2.6), GOLD, { material = "Glass", reflectance = 0.3 })
		end
		-- a thin glowing gold edge around the roof (not a whole glowing slab)
		local edge = size / 2 + 2.7
		for _, side in ipairs({ -1, 1 }) do
			local stripA = p("RoofGlow", v3(size + 5.8, 0.3, 0.5), v3(0, H + 1.1, side * edge), GOLD, { material = "Neon", collide = false, shadow = false })
			local stripB = p("RoofGlow", v3(0.5, 0.3, size + 5.8), v3(side * edge, H + 1.1, 0), GOLD, { material = "Neon", collide = false, shadow = false })
			CollectionService:AddTag(stripA, HouseBuilder.RoofTag)
			CollectionService:AddTag(stripB, HouseBuilder.RoofTag)
		end
	end

	-- Sign over the door.
	local sign = p("Sign", v3(math.min(16, size * 0.5), 2.2, 0.4), v3(0, 10.9, h + 1.1), DARK, { collide = false })
	PartUtil.label(sign, (opts.ownerName or "?") .. "'s " .. AgeSystem.HouseNames[tier], { face = Enum.NormalId.Back, color = style.accent })
	-- Ceiling light.
	local lamp = p("CeilingLight", v3(0.5, 3, 3), v3(0, H - 0.4, 0), rgb(255, 244, 214), { shape = "Cylinder", rot = UP, material = "Neon", collide = false, shadow = false })
	local light = Instance.new("PointLight")
	light.Range = math.min(60, size + 8)
	light.Brightness = 1.1
	light.Color = rgb(255, 244, 214)
	light.Shadows = false
	light.Parent = lamp

	----------------------------------------------------------------------
	-- STATIONS
	----------------------------------------------------------------------
	local accent = style.accent

	-- BED
	do
		local c = stations.Bed.center
		p("BedFrame", v3(6, 1, 8), v3(c.X, 0.5, c.Z), style.trim, { material = "Wood" })
		local mattress = p("Mattress", v3(5.6, 0.8, 7.6), v3(c.X, 1.4, c.Z), WHITE, { material = "Fabric" })
		p("Pillow", v3(4, 0.6, 1.6), v3(c.X, 2.05, c.Z - 2.9), rgb(250, 250, 255), { material = "Fabric", collide = false })
		p("Blanket", v3(5.7, 0.3, 4.4), v3(c.X, 1.92, c.Z + 1.5), accent, { material = "Fabric", collide = false })
		p("Headboard", v3(6, 3.6, 0.5), v3(c.X, 1.8, c.Z - 3.75), style.trim, { material = "Wood" })
		prompt(mattress, "Bed", "Bedtime", "Brady's Bed", true)
	end

	-- WARDROBE
	do
		local c = stations.Wardrobe.center
		local cabinet = p("Wardrobe", v3(4, 7.4, 2.4), v3(c.X, 3.7, c.Z - 0.2), rgb(120, 84, 56), { material = "Wood" })
		p("DoorL", v3(1.9, 6.6, 0.2), v3(c.X - 0.98, 3.7, c.Z + 1.05), rgb(150, 108, 72), { material = "Wood", collide = false })
		p("DoorR", v3(1.9, 6.6, 0.2), v3(c.X + 0.98, 3.7, c.Z + 1.05), rgb(150, 108, 72), { material = "Wood", collide = false })
		p("KnobL", v3(0.3, 0.3, 0.3), v3(c.X - 0.25, 3.7, c.Z + 1.25), GOLD, { shape = "Ball", collide = false })
		p("KnobR", v3(0.3, 0.3, 0.3), v3(c.X + 0.25, 3.7, c.Z + 1.25), GOLD, { shape = "Ball", collide = false })
		prompt(cabinet, "Wardrobe", "Open Wardrobe", "Brady's Closet", true)
	end

	-- MIRROR
	do
		local c = stations.Mirror.center
		p("MirrorFrame", v3(4, 7.2, 0.5), v3(c.X, 3.7, c.Z - 0.35), accent)
		local glass = p("MirrorGlass", v3(3.4, 6.6, 0.2), v3(c.X, 3.7, c.Z - 0.05), rgb(200, 230, 255), { material = "Glass", reflectance = 0.65, collide = false })
		prompt(glass, "Mirror", "Use Mirror", "Fit Check", true)
	end

	-- CLOTHING DISPLAY: shows off the three rarest pieces the player owns.
	do
		local c = stations.Display.center
		local back = p("DisplayBack", v3(5, 6, 0.4), v3(c.X, 3, c.Z - 1.4), DARK)
		for i = 1, 3 do
			local x = c.X - 1.6 + (i - 1) * 1.6
			p("Pedestal", v3(1.2, 1.4, 1.2), v3(x, 0.7, c.Z), WHITE, { material = "Marble" })
			local item = opts.showcase and opts.showcase[i]
			if item then
				local color = ClothingSystem.rarityColor(item.rarity)
				local piece = p("Showcase", v3(0.9, 1.1, 0.5), v3(x, 2.3, c.Z), ClothingSystem.swatch(item), { material = "Fabric", collide = false })
				p("ShowcaseGlow", v3(1.3, 0.12, 1.3), v3(x, 1.46, c.Z), color, { material = "Neon", collide = false, shadow = false })
				local gui = Instance.new("BillboardGui")
				gui.Size = UDim2.fromScale(3.2, 0.9)
				gui.StudsOffsetWorldSpace = v3(0, 1.3, 0)
				gui.MaxDistance = 40
				gui.LightInfluence = 0
				local label = Instance.new("TextLabel")
				label.BackgroundTransparency = 1
				label.Size = UDim2.fromScale(1, 1)
				label.Font = Enum.Font.FredokaOne
				label.TextScaled = true
				label.TextColor3 = color
				label.TextStrokeTransparency = 0.3
				label.Text = item.name
				label.Parent = gui
				gui.Parent = piece
			end
		end
		prompt(back, "Display", "View Collection", "Clothing Display", false)
	end

	-- FOOD STATION
	do
		local c = stations.Food.center
		local counter = p("Counter", v3(3, 3, 4), v3(c.X, 1.5, c.Z - 1), rgb(230, 230, 235), { material = "Marble" })
		p("CounterTop", v3(3.2, 0.3, 4.2), v3(c.X, 3.1, c.Z - 1), accent, { collide = false })
		p("Fridge", v3(2.8, 6.4, 2), v3(c.X + 0.1, 3.2, c.Z + 2), rgb(210, 215, 222), { material = "Metal" })
		p("FridgeHandle", v3(0.2, 2, 0.2), v3(c.X - 1.4, 3.6, c.Z + 1.4), DARK, { collide = false })
		p("Bowl", v3(0.6, 1.2, 1.2), v3(c.X - 0.3, 3.55, c.Z - 1.4), rgb(255, 120, 90), { shape = "Cylinder", rot = UP, collide = false })
		p("Cereal", v3(0.2, 1, 1), v3(c.X - 0.3, 3.8, c.Z - 1.4), rgb(240, 220, 150), { shape = "Cylinder", rot = UP, collide = false })
		prompt(counter, "Food", "Feed Brady", "Kitchen", true)
	end

	-- TROPHY SHELF
	do
		local c = stations.Trophy.center
		local trophies = opts.trophies or {}
		local shelf = p("TrophyShelf", v3(1.4, 0.3, 4), v3(c.X + 0.2, 4, c.Z), style.trim, { material = "Wood" })
		p("TrophyShelf2", v3(1.4, 0.3, 4), v3(c.X + 0.2, 6.2, c.Z), style.trim, { material = "Wood", collide = false })
		local cups = math.clamp(math.floor((trophies.achievements or 0) / 3), 0, 4)
		for i = 1, cups do
			local z = c.Z - 1.5 + (i - 1) * 1
			p("Cup", v3(0.7, 0.6, 0.6), v3(c.X + 0.2, 4.7, z), GOLD, { shape = "Cylinder", rot = UP, material = "Glass", reflectance = 0.35, collide = false })
			p("CupBase", v3(0.5, 0.2, 0.5), v3(c.X + 0.2, 4.25, z), DARK, { collide = false })
		end
		local wins = math.clamp(trophies.wins or 0, 0, 4)
		for i = 1, wins do
			local z = c.Z - 1.5 + (i - 1) * 1
			p("Star", v3(0.6, 0.6, 0.2), v3(c.X + 0.2, 6.9, z), rgb(255, 110, 225), { material = "Neon", rot = CFrame.Angles(0, rad(90), rad(45)), collide = false })
		end
		local plaque = p("Plaque", v3(0.2, 1.3, 3.6), v3(c.X + 0.75, 2.4, c.Z), DARK, { collide = false })
		PartUtil.label(plaque, "🏆 " .. (trophies.achievements or 0) .. " achievements\n⭐ " .. (trophies.wins or 0) .. " show wins", { face = Enum.NormalId.Left, color = GOLD })
		prompt(shelf, "Trophy", "View Trophies", "Trophy Shelf", false)
	end

	-- FASHION DISPLAY PODIUM
	do
		local c = stations.Podium.center
		local podium = p("Podium", v3(1, 6, 6), v3(c.X, 0.5, c.Z), WHITE, { shape = "Cylinder", rot = UP, material = "Marble" })
		p("PodiumRing", v3(0.2, 6.3, 6.3), v3(c.X, 0.12, c.Z), accent, { shape = "Cylinder", rot = UP, material = "Neon", collide = false, shadow = false })
		p("BackdropA", v3(6, 8, 0.3), v3(c.X, 4, h - 0.3), accent, { material = "Fabric", collide = false })
		p("BackdropB", v3(0.3, 8, 6), v3(h - 0.3, 4, c.Z), accent, { material = "Fabric", collide = false })
		local spot = p("SpotHolder", v3(0.8, 0.8, 0.8), v3(c.X - 2.5, H - 1.2, c.Z - 2.5), DARK, { collide = false })
		local spotLight = Instance.new("SpotLight")
		spotLight.Face = Enum.NormalId.Bottom
		spotLight.Angle = 50
		spotLight.Range = 26
		spotLight.Brightness = 3
		spotLight.Color = rgb(255, 240, 220)
		spotLight.Shadows = false
		spotLight.Parent = spot
		prompt(podium, "Podium", "Strike a Pose", "Fashion Display", true)
	end

	-- BATHROOM: shower
	local showerEmitter
	do
		local c = stations.Shower.center
		local tray = p("ShowerTray", v3(5, 0.3, 5), v3(c.X, 0.15, c.Z), rgb(225, 235, 240), { material = "Marble" })
		p("ShowerGlassA", v3(0.2, 7.5, 5), v3(c.X + 2.4, 3.75, c.Z), rgb(190, 230, 255), { material = "Glass", transparency = 0.65, collide = false, shadow = false })
		p("ShowerPipe", v3(0.3, 8, 0.3), v3(c.X - 2.1, 4, c.Z + 2.1), rgb(200, 200, 205), { material = "Metal", collide = false })
		local head = p("ShowerHead", v3(0.3, 1.4, 1.4), v3(c.X - 1, 7.8, c.Z + 1), rgb(200, 200, 205), { shape = "Cylinder", rot = UP, material = "Metal", collide = false })
		p("Duck", v3(0.6, 0.6, 0.6), v3(c.X + 1.6, 0.6, c.Z + 1.6), rgb(255, 220, 60), { shape = "Ball", collide = false })
		showerEmitter = Instance.new("ParticleEmitter")
		showerEmitter.Name = "Water"
		showerEmitter.Enabled = false
		showerEmitter.Rate = 60
		showerEmitter.Lifetime = NumberRange.new(0.5, 0.7)
		showerEmitter.Speed = NumberRange.new(12, 15)
		showerEmitter.SpreadAngle = Vector2.new(14, 14)
		showerEmitter.EmissionDirection = Enum.NormalId.Left -- the head is a Cylinder stood upright
		showerEmitter.Color = ColorSequence.new(rgb(160, 220, 255))
		showerEmitter.Size = NumberSequence.new(0.25, 0.1)
		showerEmitter.Transparency = NumberSequence.new(0.3, 0.8)
		showerEmitter.Parent = head
		prompt(tray, "Shower", "Shower Brady", "Bathroom", true)
	end

	-- BATHROOM: sink (brush hair)
	do
		local c = stations.Sink.center
		local sink = p("SinkCabinet", v3(2.4, 3, 3), v3(c.X - 0.2, 1.5, c.Z), WHITE, { material = "Marble" })
		p("Basin", v3(0.4, 1.8, 1.8), v3(c.X - 0.1, 3.05, c.Z), rgb(190, 225, 245), { shape = "Cylinder", rot = UP, collide = false })
		p("Faucet", v3(0.25, 0.8, 0.25), v3(c.X - 1, 3.5, c.Z), rgb(200, 200, 205), { material = "Metal", collide = false })
		p("SinkMirror", v3(0.2, 2.6, 2.4), v3(c.X - 1.3, 6, c.Z), rgb(200, 230, 255), { material = "Glass", reflectance = 0.6, collide = false })
		p("Brush", v3(0.25, 0.25, 1), v3(c.X + 0.5, 3.15, c.Z + 0.9), rgb(255, 110, 225), { collide = false })
		prompt(sink, "Sink", "Brush Hair", "Sink", true)
	end

	-- SHOE MAT (clean shoes)
	do
		local c = stations.ShoeMat.center
		local mat = p("ShoeMat", v3(3, 0.15, 2), v3(c.X, 0.08, c.Z), rgb(90, 70, 50), { material = "Fabric", collide = false })
		p("ShoeBrush", v3(0.9, 0.4, 0.4), v3(c.X + 0.8, 0.35, c.Z), rgb(240, 200, 80), { collide = false })
		prompt(mat, "ShoeMat", "Clean Shoes", "Shoe Mat", true)
	end

	local furniture = Instance.new("Folder")
	furniture.Name = "Furniture"
	furniture.Parent = model

	model.Parent = parent
	return model, {
		size = size,
		tier = tier,
		origin = origin,
		height = H,
		prompts = prompts,
		showerEmitter = showerEmitter,
		furniture = furniture,
	}
end

return HouseBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="58">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[--[[
	MapBuilder
	Builds the whole world out of parts when the server starts: the central
	plaza, clothing store, fashion runway, mini-game arcade + obby, park, food
	court, the street of player plots and the secret Goo Cave.

	Building the map in code keeps the project 100% text (no binary place
	file to merge) and guarantees gameplay positions - runway path, obby
	checkpoints, hidden spots - always match the scenery. If you would rather
	hand-edit the map in Studio: press Play, copy Workspace.Map out of the
	running game, paste it into Edit mode, and delete the MapBuilder call in
	Main (keep the MapInfo positions it returns).

	build() returns a MapInfo table the services use for positions.
]]

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Modules = ReplicatedStorage.Modules
local Config = require(Modules.Config)
local MinigameSystem = require(Modules.MinigameSystem)
local ShopSystem = require(Modules.ShopSystem)
local PartUtil = require(Modules.Builders.PartUtil)

local MapBuilder = {}

local rgb = Color3.fromRGB
local v3 = Vector3.new
local rad = math.rad
local UP = PartUtil.UP

local GOO = rgb(126, 232, 74)
local WHITE = rgb(245, 245, 245)
local DARK = rgb(34, 34, 40)
local GOLD = rgb(255, 205, 60)
local PATH = rgb(214, 202, 178)
local WOOD = rgb(140, 100, 64)

-- World position / facing of plot number `index` (1-based).
-- Plots line both sides of the street that runs south from the plaza.
function MapBuilder.plotCFrame(index)
	local row = math.floor((index - 1) / 2)
	local left = (index - 1) % 2 == 0
	local x = left and -50 or 50
	local z = 110 + row * 80
	-- Local +Z of a plot (its front door) always points at the street.
	return CFrame.new(x, 0, z) * CFrame.Angles(0, rad(left and 90 or -90), 0)
end

function MapBuilder.build()
	local map = Instance.new("Folder")
	map.Name = "Map"

	local function B(name, size, position, color, o)
		o = o or {}
		local cframe = typeof(position) == "CFrame" and position or CFrame.new(position)
		if o.rot then
			cframe = cframe * o.rot
		end
		return PartUtil.block(o.parent or map, {
			name = name,
			size = size,
			cframe = cframe,
			color = color,
			material = o.material,
			shape = o.shape,
			transparency = o.transparency,
			reflectance = o.reflectance,
			collide = o.collide,
			shadow = o.shadow,
			class = o.class,
		})
	end

	-- A prompt that simply opens a UI panel on the client (see WorldClient).
	local function uiPrompt(part, action, object, panel, arg)
		local prompt = PartUtil.prompt(part, action, object, { distance = 11, name = "PanelPrompt" })
		prompt:SetAttribute("Panel", panel)
		if arg then
			prompt:SetAttribute("PanelArg", arg)
		end
		return prompt
	end

	local function sign(text, size, cframe, color, textColor, face)
		local board = B("Sign", size, cframe, color or DARK, { collide = false })
		PartUtil.label(board, text, { color = textColor or WHITE, face = face or Enum.NormalId.Back })
		return board
	end

	local function tree(x, z, scale)
		scale = scale or 1
		B("Trunk", v3(7 * scale, 1.6 * scale, 1.6 * scale), v3(x, 3.5 * scale, z), rgb(110, 78, 50), { shape = "Cylinder", rot = UP, material = "Wood" })
		B("Leaves", v3(8, 8, 8) * scale, v3(x, 9 * scale, z), rgb(70, 170, 80), { shape = "Ball", material = "Grass", collide = false })
		B("Leaves", v3(5.5, 5.5, 5.5) * scale, v3(x + 2.4 * scale, 7 * scale, z + 1.5 * scale), rgb(90, 190, 90), { shape = "Ball", material = "Grass", collide = false })
		B("Leaves", v3(5, 5, 5) * scale, v3(x - 2.2 * scale, 7.4 * scale, z - 1.6 * scale), rgb(60, 150, 70), { shape = "Ball", material = "Grass", collide = false })
	end

	local function bench(x, z, yaw)
		local cf = CFrame.new(x, 0, z) * CFrame.Angles(0, rad(yaw), 0)
		B("BenchSeat", v3(6, 0.4, 1.8), cf * CFrame.new(0, 1.5, 0), WOOD, { material = "Wood" })
		B("BenchBack", v3(6, 1.6, 0.4), cf * CFrame.new(0, 2.5, 0.8), WOOD, { material = "Wood" })
		B("BenchLeg", v3(0.4, 1.4, 1.6), cf * CFrame.new(-2.5, 0.7, 0), DARK)
		B("BenchLeg", v3(0.4, 1.4, 1.6), cf * CFrame.new(2.5, 0.7, 0), DARK)
	end

	local function lampPost(x, z)
		B("LampPost", v3(11, 0.5, 0.5), v3(x, 5.5, z), DARK, { shape = "Cylinder", rot = UP, material = "Metal" })
		B("LampBulb", v3(1.4, 1.4, 1.4), v3(x, 11.4, z), rgb(255, 244, 200), { shape = "Ball", material = "Neon", collide = false, shadow = false })
	end

	----------------------------------------------------------------------
	-- GROUND + LIGHTING
	----------------------------------------------------------------------
	B("Ground", v3(700, 4, 960), v3(0, -2, 150), rgb(104, 196, 96), { material = "Grass" })

	Lighting.ClockTime = 14
	Lighting.Brightness = 2.4
	Lighting.Ambient = rgb(96, 96, 108)
	Lighting.OutdoorAmbient = rgb(150, 150, 160)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.4
	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.26
	atmosphere.Haze = 0.8
	atmosphere.Color = rgb(210, 230, 255)
	atmosphere.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.25
	bloom.Size = 18
	bloom.Threshold = 1.7
	bloom.Parent = Lighting
	local grade = Instance.new("ColorCorrectionEffect")
	grade.Saturation = 0.14
	grade.Contrast = 0.05
	grade.Parent = Lighting

	----------------------------------------------------------------------
	-- CENTRAL PLAZA
	----------------------------------------------------------------------
	B("Plaza", v3(0.5, 116, 116), v3(0, 0.1, 0), rgb(232, 222, 200), { shape = "Cylinder", rot = UP, material = "Concrete" })
	B("PlazaRing", v3(0.55, 122, 122), v3(0, 0.05, 0), GOO, { shape = "Cylinder", rot = UP, collide = false })
	-- Goo fountain
	B("FountainBasin", v3(2.4, 24, 24), v3(0, 1.2, 0), rgb(200, 200, 208), { shape = "Cylinder", rot = UP, material = "Marble" })
	B("FountainGoo", v3(0.5, 21, 21), v3(0, 2.3, 0), GOO, { shape = "Cylinder", rot = UP, material = "Neon", collide = false, shadow = false })
	B("FountainPillar", v3(9, 3.4, 3.4), v3(0, 5.5, 0), rgb(200, 200, 208), { shape = "Cylinder", rot = UP, material = "Marble" })
	local fountainTop = B("FountainTop", v3(5, 5, 5), v3(0, 11.5, 0), GOO, { shape = "Ball", material = "Neon", collide = false })
	local spray = Instance.new("ParticleEmitter")
	spray.Rate = 14
	spray.Lifetime = NumberRange.new(1, 1.5)
	spray.Speed = NumberRange.new(6, 9)
	spray.SpreadAngle = Vector2.new(40, 40)
	spray.Acceleration = v3(0, -18, 0)
	spray.Color = ColorSequence.new(GOO)
	spray.Size = NumberSequence.new(0.7, 0.2)
	spray.EmissionDirection = Enum.NormalId.Top
	spray.Parent = fountainTop

	-- Welcome arch on the south side (towards the houses)
	B("ArchL", v3(16, 2, 2), v3(-13, 8, 52), GOO, { shape = "Cylinder", rot = UP })
	B("ArchR", v3(16, 2, 2), v3(13, 8, 52), GOO, { shape = "Cylinder", rot = UP })
	sign("RAISE BRADY GOO", v3(30, 5, 1.2), CFrame.new(0, 18, 52), DARK, GOO, Enum.NormalId.Front)
	sign("RAISE BRADY GOO", v3(30, 5, 1.2), CFrame.new(0, 18, 52.1), DARK, GOO, Enum.NormalId.Back)

	-- Spawn pads
	for i = 0, 3 do
		local angle = rad(45 + i * 90)
		local spawnPad = Instance.new("SpawnLocation")
		spawnPad.Name = "Spawn"
		spawnPad.Size = v3(8, 0.6, 8)
		spawnPad.Anchored = true
		spawnPad.Neutral = true
		spawnPad.Duration = 0
		spawnPad.Color = GOLD
		spawnPad.Material = Enum.Material.Neon
		spawnPad.Transparency = 0.4
		spawnPad.TopSurface = Enum.SurfaceType.Smooth
		spawnPad.CFrame = CFrame.new(math.cos(angle) * 32, 0.5, math.sin(angle) * 32)
		spawnPad.Parent = map
	end
	for i = 0, 7 do
		local angle = rad(22.5 + i * 45)
		if i % 2 == 0 then
			bench(math.cos(angle) * 46, math.sin(angle) * 46, math.deg(math.atan2(math.cos(angle), math.sin(angle))) + 180)
		else
			lampPost(math.cos(angle) * 52, math.sin(angle) * 52)
		end
	end

	-- Paths to every area
	B("PathNorth", v3(16, 0.3, 50), v3(0, 0.15, -78), PATH, { material = "Concrete" })
	B("PathEast", v3(46, 0.3, 16), v3(77, 0.15, 0), PATH, { material = "Concrete" })
	B("PathWest", v3(50, 0.3, 16), v3(-80, 0.15, 0), PATH, { material = "Concrete" })
	B("PathNE", v3(14, 0.3, 46), CFrame.new(57, 0.15, -57) * CFrame.Angles(0, rad(-45), 0), PATH, { material = "Concrete" })
	B("PathNW", v3(14, 0.3, 46), CFrame.new(-57, 0.15, -57) * CFrame.Angles(0, rad(45), 0), PATH, { material = "Concrete" })

	local function directionSign(text, x, z, yaw)
		local cf = CFrame.new(x, 0, z) * CFrame.Angles(0, rad(yaw), 0)
		B("SignPost", v3(0.6, 6, 0.6), cf * CFrame.new(0, 3, 0), WOOD, { material = "Wood" })
		sign(text, v3(9, 2.2, 0.4), cf * CFrame.new(0, 6.6, 0), DARK, GOLD, Enum.NormalId.Front)
		sign(text, v3(9, 2.2, 0.4), cf * CFrame.new(0, 6.6, 0.05), DARK, GOLD, Enum.NormalId.Back)
	end
	directionSign("👕 CLOTHING STORE", 12, -56, 0)
	directionSign("🌟 FASHION RUNWAY", 56, -12, 90)
	directionSign("🎮 MINI-GAMES", -56, 12, 90)
	directionSign("🏠 HOUSES", -12, 56, 0)
	directionSign("🌳 PARK", 46, -34, -45)
	directionSign("🍔 FOOD COURT", -46, -34, 45)

	----------------------------------------------------------------------
	-- CLOTHING STORE (north)
	----------------------------------------------------------------------
	local store = Instance.new("Folder")
	store.Name = "Store"
	store.Parent = map
	local so = { parent = store }
	B("StoreFloor", v3(60, 0.6, 44), v3(0, 0.3, -126), rgb(236, 232, 224), { parent = store, material = "Marble" })
	B("StoreBack", v3(60, 20, 1.5), v3(0, 10, -147.2), rgb(40, 40, 48), so)
	B("StoreWallL", v3(1.5, 20, 44), v3(-29.2, 10, -126), rgb(40, 40, 48), so)
	B("StoreWallR", v3(1.5, 20, 44), v3(29.2, 10, -126), rgb(40, 40, 48), so)
	local storeRoof = B("StoreRoof", v3(64, 1.5, 48), v3(0, 20.7, -126), rgb(232, 66, 78), { parent = store, collide = false })
	CollectionService:AddTag(storeRoof, "HouseRoof")
	sign("GOO THRIFT & ARCHIVE", v3(44, 6, 1), CFrame.new(0, 25, -103.5), DARK, rgb(232, 66, 78))
	B("StoreStripe", v3(60, 0.8, 0.6), v3(0, 19.6, -104.2), GOO, { parent = store, material = "Neon", collide = false })

	-- Clothing racks along the left wall
	local rackColors = { rgb(232, 66, 78), rgb(72, 150, 255), GOO, GOLD, rgb(178, 92, 255), WHITE, DARK }
	for rack = 0, 2 do
		local z = -114 - rack * 11
		B("RackBar", v3(0.3, 0.3, 8), v3(-24, 6, z), rgb(200, 200, 205), { parent = store, material = "Metal", collide = false })
		B("RackPole", v3(0.3, 6, 0.3), v3(-24, 3, z - 4), rgb(200, 200, 205), { parent = store, material = "Metal" })
		B("RackPole", v3(0.3, 6, 0.3), v3(-24, 3, z + 4), rgb(200, 200, 205), { parent = store, material = "Metal" })
		for i = 0, 6 do
			B("Garment", v3(1.8, 3, 0.4), v3(-24, 4.3, z - 3.3 + i * 1.1), rackColors[(i + rack) % #rackColors + 1], { parent = store, material = "Fabric", collide = false })
		end
	end
	-- Counter + shopkeeper
	local counter = B("StoreCounter", v3(12, 3.4, 3), v3(0, 2.3, -140), rgb(120, 84, 56), { parent = store, material = "Wood" })
	B("Keeper", v3(2, 2.2, 1), v3(0, 5.3, -143), rgb(232, 66, 78), so)
	B("KeeperHead", v3(1.6, 1.6, 1.6), v3(0, 7.2, -143), rgb(255, 214, 92), so)
	B("KeeperShades", v3(1.5, 0.35, 0.2), v3(0, 7.35, -142.2), DARK, { parent = store, collide = false })
	uiPrompt(counter, "Shop", "Goo Thrift", "Shop", "Clothing")
	-- Hair chair
	local chair = B("SalonChair", v3(3, 1, 3), v3(-10, 1.6, -141), rgb(255, 110, 225), { parent = store, material = "Fabric" })
	B("SalonChairBack", v3(3, 3.4, 0.6), v3(-10, 3.6, -142.4), rgb(255, 110, 225), { parent = store, material = "Fabric" })
	sign("HAIR", v3(5, 1.8, 0.3), CFrame.new(-10, 8, -146.2), DARK, rgb(255, 110, 225))
	uiPrompt(chair, "Hairstyles", "Goo Salon", "Shop", "Hair")
	-- Furniture corner
	local sofa = B("DisplaySofa", v3(7, 1.6, 3), v3(13, 1.4, -141), rgb(90, 140, 220), { parent = store, material = "Fabric" })
	B("DisplaySofaBack", v3(7, 2.4, 0.8), v3(13, 2.8, -142.6), rgb(80, 124, 200), { parent = store, material = "Fabric" })
	sign("HOME", v3(5, 1.8, 0.3), CFrame.new(13, 8, -146.2), DARK, rgb(90, 190, 255))
	uiPrompt(sofa, "Furniture", "Room Shop", "Shop", "Furniture")
	-- Crate machines along the right wall
	for i, crate in ipairs(ShopSystem.Crates) do
		local z = -110 - (i - 1) * 9
		local machine = B("CrateMachine", v3(4, 8, 5), v3(25, 4.6, z), crate.color, so)
		B("CrateWindow", v3(0.3, 3.4, 3.6), v3(22.9, 6, z), rgb(200, 235, 255), { parent = store, material = "Glass", transparency = 0.4, collide = false })
		B("CrateGlow", v3(0.3, 0.6, 5), v3(22.9, 1.2, z), WHITE, { parent = store, material = "Neon", collide = false })
		sign(crate.icon .. " " .. crate.name, v3(0.3, 1.6, 5), CFrame.new(22.8, 9.4, z), DARK, crate.color, Enum.NormalId.Left)
		uiPrompt(machine, "Open Crates", crate.name, "Shop", "Crates")
	end
	-- Crates stacked behind the store: a staircase up to a hidden ledge
	for step = 1, 5 do
		B("BackCrate", v3(6, 4, 6), v3(-30 + step * 6, step * 4 - 2, -152), rgb(150 + step * 8, 110, 70), { parent = store, material = "WoodPlanks" })
	end
	B("SecretLedge", v3(22, 1, 7), v3(11, 20.5, -152.5), rgb(60, 60, 68), so)

	----------------------------------------------------------------------
	-- FASHION RUNWAY (east)
	----------------------------------------------------------------------
	local runwayFolder = Instance.new("Folder")
	runwayFolder.Name = "Runway"
	runwayFolder.Parent = map
	local ro = { parent = runwayFolder }
	B("Stage", v3(34, 3, 44), v3(165, 1.5, 0), rgb(40, 40, 48), ro)
	B("Catwalk", v3(50, 3, 10), v3(123, 1.5, 0), WHITE, { parent = runwayFolder, material = "Marble" })
	B("CatwalkGlowL", v3(50, 0.3, 0.5), v3(123, 3.1, -4.8), rgb(255, 110, 225), { parent = runwayFolder, material = "Neon", collide = false, shadow = false })
	B("CatwalkGlowR", v3(50, 0.3, 0.5), v3(123, 3.1, 4.8), rgb(255, 110, 225), { parent = runwayFolder, material = "Neon", collide = false, shadow = false })
	B("Backdrop", v3(1.5, 24, 44), v3(182.8, 12, 0), rgb(26, 26, 34), ro)
	sign("GOO FASHION WEEK", v3(0.5, 7, 34), CFrame.new(181.8, 17, 0), DARK, rgb(255, 110, 225), Enum.NormalId.Left)
	B("Curtain", v3(1, 14, 12), v3(181, 10, 0), rgb(150, 30, 60), { parent = runwayFolder, material = "Fabric", collide = false })
	-- Stairs up to the catwalk for curious players
	for step = 1, 3 do
		B("StageStep", v3(3, step, 10), v3(96.5 - (3 - step) * 3 + 3, step / 2, 0), rgb(200, 200, 208), ro)
	end
	-- Light rig
	B("RigL", v3(0.8, 22, 0.8), v3(148, 11, -21), DARK, ro)
	B("RigR", v3(0.8, 22, 0.8), v3(148, 11, 21), DARK, ro)
	B("RigTop", v3(0.8, 0.8, 43), v3(148, 22, 0), DARK, ro)
	for _, z in ipairs({ -12, 0, 12 }) do
		local can = B("SpotCan", v3(1.6, 1.6, 1.6), v3(148, 21, z), rgb(60, 60, 70), { parent = runwayFolder, collide = false })
		local spot = Instance.new("SpotLight")
		spot.Face = Enum.NormalId.Bottom
		spot.Angle = 60
		spot.Range = 40
		spot.Brightness = 2.5
		spot.Color = rgb(255, 220, 240)
		spot.Shadows = false
		spot.Parent = can
	end
	-- Audience seating on both sides
	for _, side in ipairs({ -1, 1 }) do
		for row = 0, 1 do
			for seat = 0, 5 do
				local x = 104 + seat * 7.5
				local z = side * (11 + row * 5)
				B("Seat", v3(5, 0.5, 2.4), v3(x, 1.4 + row * 1.2, z), rgb(232, 66, 78), { parent = runwayFolder, material = "Fabric" })
				B("SeatBase", v3(5, 1.2 + row * 1.2, 2.4), v3(x, (1.2 + row * 1.2) / 2, z), DARK, ro)
			end
		end
	end
	-- Sign-up kiosk (FashionServer connects to this prompt)
	B("KioskPost", v3(0.8, 5, 0.8), v3(92, 2.5, 14), DARK, ro)
	local kiosk = sign("🌟 ENTER SHOW", v3(8, 3, 0.6), CFrame.new(92, 6.4, 14) * CFrame.Angles(0, rad(90), 0), rgb(255, 110, 225), WHITE, Enum.NormalId.Front)
	local signup = PartUtil.prompt(kiosk, "Fashion Show", "Runway Sign-Up", { distance = 12, name = "RunwayPrompt" })

	local lineup, backstage = {}, {}
	for i = 1, 8 do
		local z = -15.75 + (i - 1) * 4.5
		lineup[i] = CFrame.lookAt(v3(160, 3, z), v3(100, 3, z))
		backstage[i] = CFrame.lookAt(v3(176, 3, z), v3(100, 3, z))
	end

	----------------------------------------------------------------------
	-- MINI-GAME ARCADE (west) + GOO OBBY
	----------------------------------------------------------------------
	local arcade = Instance.new("Folder")
	arcade.Name = "Arcade"
	arcade.Parent = map
	local ao = { parent = arcade }
	B("ArcadeFloor", v3(54, 0.6, 48), v3(-132, 0.3, 0), rgb(48, 40, 80), ao)
	for _, x in ipairs({ -157, -107 }) do
		for _, z in ipairs({ -22, 22 }) do
			B("ArcadePillar", v3(17, 2, 2), v3(x, 8.5, z), rgb(200, 50, 200), { parent = arcade, shape = "Cylinder", rot = UP })
		end
	end
	local arcadeRoof = B("ArcadeRoof", v3(58, 1.2, 52), v3(-132, 17.6, 0), rgb(34, 28, 60), { parent = arcade, collide = false })
	CollectionService:AddTag(arcadeRoof, "HouseRoof")
	sign("GOO ARCADE", v3(1, 5, 30), CFrame.new(-104.5, 21, 0), DARK, rgb(120, 255, 200), Enum.NormalId.Right)
	B("ArcadeNeon", v3(0.5, 0.5, 48), v3(-105.5, 17, 0), rgb(255, 110, 225), { parent = arcade, material = "Neon", collide = false, shadow = false })
	sign("+25% rewards here!", v3(0.6, 2, 16), CFrame.new(-104.8, 13, 0), DARK, GOLD, Enum.NormalId.Right)

	local machineColors = { rgb(232, 66, 78), rgb(72, 150, 255), GOLD, GOO, rgb(178, 92, 255) }
	local machineIndex = 0
	for _, def in ipairs(MinigameSystem.List) do
		if not def.world then
			machineIndex += 1
			local z = -18 + (machineIndex - 1) * 9
			local color = machineColors[(machineIndex - 1) % #machineColors + 1]
			local cabinet = B("ArcadeMachine", v3(4, 8, 5), v3(-153, 4.6, z), color, ao)
			B("ArcadeScreen", v3(0.2, 3, 3.8), v3(-150.9, 6.4, z), rgb(120, 255, 200), { parent = arcade, material = "Neon", collide = false })
			B("ArcadePanel", v3(1.6, 0.4, 4.4), v3(-150.4, 3.9, z), DARK, { parent = arcade, collide = false })
			sign(def.icon .. " " .. def.name, v3(0.3, 1.4, 5), CFrame.new(-150.8, 9.6, z), DARK, color, Enum.NormalId.Right)
			uiPrompt(cabinet, "Play", def.name, "Minigame", def.id)
		end
	end

	-- OBBY: floating platforms over a pool of goo, south-west of the arcade
	-- (well away from the food court and the houses).
	local obbyFolder = Instance.new("Folder")
	obbyFolder.Name = "Obby"
	obbyFolder.Parent = map
	local oo = { parent = obbyFolder }
	local function touchable(part)
		part.CanTouch = true
		return part
	end
	sign("🏃 GOO OBBY - step on START", v3(18, 3, 0.6), CFrame.new(-132, 8, 33), DARK, GOO, Enum.NormalId.Front)
	B("ObbyPostL", v3(0.8, 8, 0.8), v3(-140, 4, 33), DARK, oo)
	B("ObbyPostR", v3(0.8, 8, 0.8), v3(-124, 4, 33), DARK, oo)
	local obbyStart = touchable(B("ObbyStart", v3(10, 0.6, 8), v3(-132, 0.3, 42), GOO, { parent = obbyFolder, material = "Neon" }))
	local pool = touchable(B("GooPool", v3(76, 0.8, 96), v3(-156, 0.4, 96), rgb(96, 210, 60), { parent = obbyFolder, material = "Neon", transparency = 0.15 }))
	B("PoolRim", v3(80, 0.5, 100), v3(-156, 0.2, 96), rgb(60, 60, 68), { parent = obbyFolder, collide = false })

	-- Path: 6 platforms south, 5 west, 3 south. Each one a bit higher.
	local steps = {}
	local px, pz = -132, 42
	local function addSteps(count, dx, dz)
		for _ = 1, count do
			px += dx
			pz += dz
			table.insert(steps, v3(px, 0, pz))
		end
	end
	addSteps(6, 0, 9)
	addSteps(5, -9, 0)
	addSteps(3, 0, 9)
	local checkpoints, obbyHidden = {}, {}
	local obbyFinish
	for index, step in ipairs(steps) do
		local y = 2 + index * 0.75
		if index == #steps then
			obbyFinish = touchable(B("ObbyFinish", v3(12, 1, 12), v3(step.X, y, step.Z + 3), GOLD, { parent = obbyFolder, material = "Neon" }))
			sign("FINISH", v3(8, 2.4, 0.5), CFrame.new(step.X, y + 6, step.Z + 9), DARK, GOLD, Enum.NormalId.Front)
			obbyHidden.finish = CFrame.new(step.X + 4, y + 0.6, step.Z + 7)
			obbyHidden.finishFar = CFrame.new(step.X - 4.5, y + 0.6, step.Z + 7.5)
		elseif index == 5 or index == 10 then
			local checkpoint = touchable(B("ObbyCheckpoint", v3(8, 1, 8), v3(step.X, y, step.Z), rgb(255, 230, 90), { parent = obbyFolder, material = "Neon" }))
			table.insert(checkpoints, checkpoint)
			if index == 5 then
				obbyHidden.checkpoint = CFrame.new(step.X + 2.8, y + 0.6, step.Z + 2.8)
			end
		else
			local small = index % 3 == 0
			B("ObbyStep", small and v3(4, 1, 4) or v3(5.5, 1, 5.5), v3(step.X, y, step.Z), small and rgb(255, 110, 225) or rgb(90, 190, 255), oo)
		end
	end

	----------------------------------------------------------------------
	-- PARK (north-east)
	----------------------------------------------------------------------
	local parkCenter = v3(108, 0, -108)
	B("ParkLawn", v3(0.4, 100, 100), v3(parkCenter.X, 0.12, parkCenter.Z), rgb(86, 178, 80), { shape = "Cylinder", rot = UP, material = "Grass" })
	B("Pond", v3(0.5, 32, 32), v3(118, 0.3, -118), rgb(80, 170, 235), { shape = "Cylinder", rot = UP, material = "Glass", transparency = 0.25, collide = false })
	B("PondIsland", v3(1.2, 9, 9), v3(118, 0.6, -118), rgb(214, 196, 140), { shape = "Cylinder", rot = UP, material = "Sand" })
	tree(120, -120, 0.7)
	for _, t in ipairs({ { 82, -140 }, { 96, -150 }, { 140, -142 }, { 150, -116 }, { 146, -88 }, { 128, -70 }, { 84, -96 }, { 70, -118 }, { 132, -150 } }) do
		tree(t[1], t[2], 0.9 + ((t[1] + t[2]) % 3) * 0.12)
	end
	bench(96, -92, 135)
	bench(100, -128, 45)
	bench(134, -100, -90)
	local flowerColors = { rgb(255, 110, 180), rgb(255, 220, 80), rgb(170, 110, 255), WHITE }
	for i = 0, 15 do
		local angle = i / 16 * math.pi * 2
		local r = 30 + (i % 3) * 6
		B("Flower", v3(0.6, 1.4, 1.4), v3(parkCenter.X + math.cos(angle) * r, 0.6, parkCenter.Z + math.sin(angle) * r), flowerColors[i % 4 + 1], { shape = "Cylinder", rot = UP, collide = false })
	end
	-- Swing set (decor)
	B("SwingBar", v3(12, 0.5, 0.5), v3(90, 9, -112), DARK, { material = "Metal" })
	for _, x in ipairs({ 84.5, 95.5 }) do
		B("SwingLeg", v3(0.5, 9, 0.5), v3(x, 4.5, -112), DARK, { material = "Metal" })
	end
	for _, x in ipairs({ 87.5, 92.5 }) do
		B("SwingRope", v3(0.15, 5.5, 0.15), v3(x, 6, -112), rgb(200, 200, 205), { collide = false })
		B("SwingSeat", v3(2, 0.3, 1), v3(x, 3.2, -112), rgb(232, 66, 78), {})
	end
	sign("🌳 GOO PARK", v3(12, 3, 0.6), CFrame.new(74, 7, -74) * CFrame.Angles(0, rad(-45), 0), DARK, rgb(120, 255, 140), Enum.NormalId.Back)
	sign("psst... the rocks behind the park feel kinda soft", v3(9, 2.6, 0.4), CFrame.new(150, 3, -146) * CFrame.Angles(0, rad(-45), 0), WOOD, WHITE, Enum.NormalId.Back)

	----------------------------------------------------------------------
	-- FOOD COURT (north-west)
	----------------------------------------------------------------------
	local foodFolder = Instance.new("Folder")
	foodFolder.Name = "FoodCourt"
	foodFolder.Parent = map
	local fo = { parent = foodFolder }
	B("FoodFloor", v3(66, 0.4, 66), v3(-108, 0.2, -108), rgb(240, 226, 196), { parent = foodFolder, material = "Concrete" })
	local stalls = {
		{ name = "🍕 PIZZA", color = rgb(232, 66, 78), x = -128 },
		{ name = "🍔 BURGERS", color = rgb(255, 170, 60), x = -108 },
		{ name = "🧪 MYSTERY", color = rgb(178, 92, 255), x = -88 },
	}
	for _, stall in ipairs(stalls) do
		local stallCounter = B("StallCounter", v3(14, 3.6, 4), v3(stall.x, 2.2, -134), WHITE, fo)
		B("StallBack", v3(14, 11, 1), v3(stall.x, 5.9, -138.5), stall.color, fo)
		B("StallAwning", v3(15, 0.6, 8), CFrame.new(stall.x, 10.6, -134) * CFrame.Angles(rad(-10), 0, 0), stall.color, { parent = foodFolder, material = "Fabric", collide = false })
		B("StallStripe", v3(15.1, 0.62, 2), CFrame.new(stall.x, 10.3, -131.3) * CFrame.Angles(rad(-10), 0, 0), WHITE, { parent = foodFolder, material = "Fabric", collide = false })
		sign(stall.name, v3(11, 2.4, 0.4), CFrame.new(stall.x, 13.4, -134), DARK, stall.color)
		uiPrompt(stallCounter, "Buy Food", "Food Stall", "Shop", "Food")
	end
	for _, t in ipairs({ { -124, -112 }, { -92, -112 }, { -124, -92 }, { -92, -92 } }) do
		B("Table", v3(0.4, 7, 7), v3(t[1], 2.6, t[2]), rgb(232, 66, 78), { parent = foodFolder, shape = "Cylinder", rot = UP })
		B("TableLeg", v3(2.6, 0.8, 0.8), v3(t[1], 1.3, t[2]), DARK, { parent = foodFolder, shape = "Cylinder", rot = UP })
		B("Umbrella", v3(0.5, 11, 11), v3(t[1], 9.5, t[2]), rgb(255, 220, 80), { parent = foodFolder, shape = "Cylinder", rot = UP, collide = false })
		B("UmbrellaPole", v3(7, 0.4, 0.4), v3(t[1], 6, t[2]), WHITE, { parent = foodFolder, shape = "Cylinder", rot = UP, collide = false })
	end
	-- Giant burger sculpture
	local burger = { { rgb(220, 160, 90), 3.2, 16 }, { rgb(110, 70, 40), 2, 15 }, { rgb(255, 210, 70), 0.6, 16.5 }, { rgb(110, 200, 90), 0.8, 17 }, { rgb(230, 70, 60), 0.8, 15 }, { rgb(220, 160, 90), 4.2, 16 } }
	local burgerY = 0.4
	for _, layer in ipairs(burger) do
		B("BurgerLayer", v3(layer[2], layer[3], layer[3]), v3(-108, burgerY + layer[2] / 2, -102), layer[1], { parent = foodFolder, shape = "Cylinder", rot = UP })
		burgerY += layer[2]
	end
	sign("🍔 GOO FOOD COURT", v3(14, 3, 0.6), CFrame.new(-74, 7, -74) * CFrame.Angles(0, rad(45), 0), DARK, rgb(255, 170, 60), Enum.NormalId.Back)

	----------------------------------------------------------------------
	-- HOUSES (south): street + one plot pad per player
	----------------------------------------------------------------------
	local rows = math.ceil(Config.PlotCount / 2)
	local streetLength = rows * 80 + 30
	B("Street", v3(16, 0.3, streetLength), v3(0, 0.15, 58 + streetLength / 2), rgb(70, 72, 80), { material = "Concrete" })
	B("StreetLine", v3(0.6, 0.32, streetLength - 6), v3(0, 0.16, 58 + streetLength / 2), GOLD, { collide = false })
	local plots = {}
	for index = 1, Config.PlotCount do
		local cf = MapBuilder.plotCFrame(index)
		plots[index] = cf
		B("PlotLawn", v3(Config.PlotSize, 0.2, Config.PlotSize), cf * CFrame.new(0, 0.1, 0), rgb(120, 206, 110), { material = "Grass" })
		B("PlotWalk", v3(6, 0.24, 30), cf * CFrame.new(0, 0.12, 27), PATH, { material = "Concrete" })
		local mailbox = cf * CFrame.new(6, 0, 40)
		B("MailboxPost", v3(0.5, 3.4, 0.5), mailbox * CFrame.new(0, 1.7, 0), WOOD, { material = "Wood" })
		B("Mailbox", v3(1.4, 1.2, 2.2), mailbox * CFrame.new(0, 3.8, 0), rgb(232, 66, 78), {})
		local lamp = cf * CFrame.new(-8, 0, 40)
		lampPost(lamp.Position.X, lamp.Position.Z)
	end
	sign("HOME SWEET GOO", v3(22, 4, 1), CFrame.new(0, 17, 66), DARK, GOLD, Enum.NormalId.Front)
	B("StreetArchL", v3(15, 1.6, 1.6), v3(-11, 7.5, 66), DARK, { shape = "Cylinder", rot = UP })
	B("StreetArchR", v3(15, 1.6, 1.6), v3(11, 7.5, 66), DARK, { shape = "Cylinder", rot = UP })

	----------------------------------------------------------------------
	-- SECRET GOO CAVE (hidden behind the park)
	----------------------------------------------------------------------
	local cave = Instance.new("Folder")
	cave.Name = "GooCave"
	cave.Parent = map
	local rock = rgb(84, 80, 92)
	local caveCF = CFrame.new(188, 0, -188) * CFrame.Angles(0, rad(-45), 0) -- local +Z faces the park
	local function C(name, size, offset, color, o)
		o = o or {}
		o.parent = cave
		return B(name, size, caveCF * (typeof(offset) == "CFrame" and offset or CFrame.new(offset)), color, o)
	end
	C("CaveFloor", v3(34, 1, 34), v3(0, 0.5, 0), rgb(50, 46, 60), { material = "Slate" })
	C("CaveBack", v3(36, 18, 3), v3(0, 9, -17), rock, { material = "Slate" })
	C("CaveL", v3(3, 18, 36), v3(-17, 9, 0), rock, { material = "Slate" })
	C("CaveR", v3(3, 18, 36), v3(17, 9, 0), rock, { material = "Slate" })
	C("CaveFrontL", v3(13, 18, 3), v3(-11.5, 9, 17), rock, { material = "Slate" })
	C("CaveFrontR", v3(13, 18, 3), v3(11.5, 9, 17), rock, { material = "Slate" })
	C("CaveFrontTop", v3(10, 8, 3), v3(0, 14, 17), rock, { material = "Slate" })
	-- The "soft rock": looks solid, but you can walk straight through it.
	C("FakeRock", v3(10, 10, 3), v3(0, 5, 17), rock, { material = "Slate", collide = false })
	local caveRoof = C("CaveRoof", v3(38, 3, 38), v3(0, 19.5, 0), rock, { material = "Slate", collide = false })
	CollectionService:AddTag(caveRoof, "HouseRoof")
	for _, boulder in ipairs({ { -20, 4, 22, 12 }, { 21, 3, 20, 10 }, { 24, 5, -6, 14 }, { -24, 4, -8, 13 }, { 0, 6, -24, 16 } }) do
		C("Boulder", v3(boulder[4], boulder[4], boulder[4]), v3(boulder[1], boulder[2], boulder[3]), PartUtil.shade(rock, 0.92), { shape = "Ball", material = "Slate" })
	end
	C("GooPuddle", v3(0.3, 10, 10), CFrame.new(-8, 1.1, -6) * UP, GOO, { shape = "Cylinder", material = "Neon", collide = false })
	C("GooPuddle", v3(0.3, 7, 7), CFrame.new(9, 1.1, 5) * UP, GOO, { shape = "Cylinder", material = "Neon", collide = false })
	for _, m in ipairs({ { -12, -12 }, { 12, -10 }, { -11, 9 }, { 6, -13 }, { 13, 12 } }) do
		C("Mushroom", v3(2, 0.6, 0.6), CFrame.new(m[1], 2, m[2]) * UP, WHITE, { shape = "Cylinder", collide = false })
		C("MushroomCap", v3(2, 2, 2), v3(m[1], 3.2, m[2]), rgb(170, 90, 255), { shape = "Ball", material = "Neon", collide = false })
	end
	local pedestal = C("Pedestal", v3(3, 4, 4), CFrame.new(0, 2.5, -6) * UP, rgb(30, 26, 44), { shape = "Cylinder", material = "Marble" })
	local caveLight = Instance.new("PointLight")
	caveLight.Color = rgb(170, 90, 255)
	caveLight.Range = 40
	caveLight.Brightness = 1.6
	caveLight.Shadows = false
	caveLight.Parent = pedestal

	----------------------------------------------------------------------
	-- HIDDEN SPOTS
	----------------------------------------------------------------------
	local function spot(x, y, z)
		return CFrame.new(x, y, z)
	end
	local hiddenSpots = {
		spot(15, 0.3, -7), spot(-40, 0.3, 38), -- plaza
		spot(-25, 0.7, -143), spot(26, 0.3, -154), spot(4, 21, -152.5), -- store
		spot(177, 3.1, 18), spot(140, 0.3, 26), spot(188, 0.3, -24), -- runway
		spot(-155, 0.7, 21), spot(-108, 0.7, -21), obbyHidden.checkpoint, obbyHidden.finish, -- arcade + obby
		spot(132, 0.3, -146), spot(116, 1.3, -116), spot(78, 0.3, -130), spot(146, 0.3, -80), -- park
		spot(-132, 0.3, -141), spot(-82, 0.5, -136), spot(-108, 0.5, -112), -- food court
		spot(4, 0.4, 300), spot(-90, 0.3, 150), spot(90, 0.3, 390), spot(-4, 0.4, 58 + streetLength - 4), -- houses
		(caveCF * CFrame.new(11, 1.1, -11)), -- cave
	}
	local secretSpots = {
		spot(16, 21, -152.5), -- store ledge
		spot(189, 0.3, 12), -- behind the runway backdrop
		obbyHidden.finishFar, -- top of the obby
		spot(120.5, 1.3, -114.5), -- pond island
		spot(-108, 0.5, -117), -- behind the giant burger
		spot(5, 0.4, 58 + streetLength - 2), -- end of the street
		spot(-164, 0.9, -19), -- tucked behind the arcade machines
		spot(-300, 0.3, 380), -- far corner of the map
	}

	map.Parent = Workspace

	return {
		folder = map,
		spawn = CFrame.lookAt(v3(0, 0.6, 34), v3(0, 0.6, 0)),
		plots = plots,
		plotCFrame = MapBuilder.plotCFrame,
		park = { center = parkCenter, radius = 50, entrance = CFrame.lookAt(v3(74, 0.5, -78), parkCenter) },
		store = { entrance = CFrame.lookAt(v3(0, 0.7, -100), v3(0, 0.7, -140)) },
		food = { entrance = CFrame.lookAt(v3(-78, 0.5, -78), v3(-108, 0.5, -108)) },
		arcade = { center = v3(-132, 3, 0), radius = 36, entrance = CFrame.lookAt(v3(-100, 0.7, 0), v3(-150, 0.7, 0)) },
		runway = {
			stageStart = CFrame.lookAt(v3(172, 3, 0), v3(100, 3, 0)),
			runwayEnd = v3(102, 3, 0),
			lineup = lineup,
			backstage = backstage,
			audience = CFrame.lookAt(v3(118, 0.5, 26), v3(125, 3, 0)),
			signup = signup,
		},
		obby = {
			start = obbyStart,
			finish = obbyFinish,
			checkpoints = checkpoints,
			kill = { pool },
			respawn = CFrame.new(-132, 0.6, 36),
		},
		hiddenSpots = hiddenSpots,
		secretSpots = secretSpots,
		cavePedestal = caveCF * CFrame.new(0, 4.6, -6),
	}
end

return MapBuilder
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="59">
    <Properties>
      <string name="Name">SoundService</string>
