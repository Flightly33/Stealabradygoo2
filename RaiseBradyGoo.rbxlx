<roblox version="4">
  <Item class="Lighting" referent="0">
    <Properties>
      <string name="Name">Lighting</string>
      <float name="Brightness">2.5</float>
      <float name="ClockTime">14</float>
      <bool name="GlobalShadows">true</bool>
    </Properties>
  </Item>
  <Item class="ReplicatedStorage" referent="1">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="2">
      <Properties>
        <string name="Name">Client</string>
      </Properties>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">BradyAnimator</string>
          <string name="Source"><![CDATA[--[[
	BradyAnimator (client)
	Animates every Brady in the world procedurally - no uploaded animation
	assets. The server only replicates a few attributes on each model:

	    State / Pose               what he is doing
	    IdleStyle / WalkStyle      which idle + walk he uses (changes with age
	                               and with special Archive / Grail pieces)
	    WalkFrom/To/Start/Dur      the straight line he is walking

	Each frame this module turns those into joint rotations. An animation is
	just a function that fills in six joint offsets:

	    W  waist (whole body)   N  neck
	    LS / RS  shoulders      LH / RH  hips

	Offsets are blended over time, so switching animations is always smooth.

	Angle cheat-sheet (Brady faces -Z):
	    arm / leg  +X = swing forward      head  +X = look up
	    right arm  +Z = raise outwards     left arm  -Z = raise outwards
	    waist      -X = lean forward       +Y = turn to his left

	PERFORMANCE: one RenderStepped connection for all Bradys, nothing is
	allocated per joint per frame beyond CFrames, and Bradys far from the
	camera are skipped entirely.
]]

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local BradyAnimator = {}

local TAG = "BradyGoo"
local JOINTS = { W = "Waist", N = "Neck", LS = "LeftShoulder", RS = "RightShoulder", LH = "LeftHip", RH = "RightHip" }
local KEYS = { "W", "N", "LS", "RS", "LH", "RH" }
local IDENTITY = CFrame.new()

local rad, sin, cos, abs, min, max = math.rad, math.sin, math.cos, math.abs, math.min, math.max

local function A(x, y, z)
	return CFrame.Angles(rad(x or 0), rad(y or 0), rad(z or 0))
end

local function T(x, y, z)
	return CFrame.new(x or 0, y or 0, z or 0)
end

local entries = {} -- [model] = entry
local maxDistance = 140
local lowGraphics = false

-- Fired as (model, newState, oldState, entry) so BradyClient can add effects.
local stateListeners = {}
function BradyAnimator.onStateChanged(fn)
	table.insert(stateListeners, fn)
end

----------------------------------------------------------------------
-- IDLE STYLES            fn(o, t, T, e)   t = time in state, T = global time
----------------------------------------------------------------------
local IDLE = {}

-- Baby Brady sits on the floor and wobbles.
function IDLE.BabyWobble(o, _t, g, e)
	o.W = T(0, -(e.hip - 0.42 * e.S), 0) * A(sin(g * 2) * 6, 0, sin(g * 1.3) * 8)
	o.LH = A(84, 0, -14)
	o.RH = A(84, 0, 14)
	o.LS = A(20 + sin(g * 3.1) * 32, 0, -34)
	o.RS = A(20 + sin(g * 2.6 + 1) * 32, 0, 34)
	o.N = A(sin(g * 2.2) * 8, sin(g * 1.1) * 16, sin(g * 1.7) * 6)
end

function IDLE.Bouncy(o, _t, g, e)
	local bounce = abs(sin(g * 3.6))
	o.W = T(0, bounce * 0.16 * e.S, 0) * A(0, sin(g * 0.8) * 8, 0)
	o.LS = A(sin(g * 3.6) * 14, 0, -10 - bounce * 10)
	o.RS = A(-sin(g * 3.6) * 14, 0, 10 + bounce * 10)
	o.N = A(sin(g * 1.4) * 5, sin(g * 0.9) * 22, 0)
end

function IDLE.Cool(o, _t, g, e)
	o.W = T(sin(g * 1.2) * 0.05 * e.S, 0, 0) * A(2, sin(g * 0.6) * 5, sin(g * 1.2) * 3)
	o.LS = A(4, 0, -9)
	o.RS = A(4, 0, 9)
	o.LH = A(0, 0, -3)
	o.RH = A(0, 0, 3)
	o.N = A(sin(g * 4.2) * 5, sin(g * 0.5) * 14, 0) -- nodding to a beat only he can hear
end

-- Teen Brady stares at an invisible phone.
function IDLE.Slouch(o, _t, g)
	o.W = A(-9, 0, sin(g * 0.7) * 2)
	o.LH = A(9, 0, -2)
	o.RH = A(9, 0, 2)
	o.LS = A(58, 0, 22)
	o.RS = A(58 + sin(g * 6) * 3, 0, -22)
	o.N = A(-20 + sin(g * 0.8) * 3, sin(g * 0.4) * 10, 0)
end

function IDLE.Model(o, _t, g, e)
	o.W = T(0.06 * e.S, 0, 0) * A(4, sin(g * 0.6) * 7, -4)
	o.LH = A(14, 0, -3)
	o.RH = A(-4, 0, 5)
	o.LS = A(6, 0, -8)
	o.RS = A(-6, 0, 34)
	o.N = A(5, sin(g * 0.5) * 24, 3)
end

-- Almost motionless. Hands "in pockets". Every so often he checks his sleeve.
function IDLE.ArchiveLean(o, _t, g)
	local look = (g % 7) > 5.6 and 1 or 0
	o.W = A(6, 0, -2)
	o.LH = A(-6, 0, -4)
	o.RH = A(4, 0, 4)
	o.LS = A(10 + look * 70, 0, -12 + look * 30)
	o.RS = A(10, 0, 12)
	o.N = A(-12 - look * 10, sin(g * 0.3) * 12 + look * 25, 0)
end

-- Legendary Brady Goo hovers with his arms crossed.
function IDLE.Legend(o, _t, g, e)
	o.W = T(0, (0.28 + sin(g * 1.6) * 0.1) * e.S, 0) * A(3, sin(g * 0.4) * 8, 0)
	o.LS = A(72, 0, 46)
	o.RS = A(72, 0, -46)
	o.LH = A(-8, 0, -3)
	o.RH = A(-14, 0, 3)
	o.N = A(6, sin(g * 0.5) * 12, 0)
end

----------------------------------------------------------------------
-- WALK STYLES
----------------------------------------------------------------------
local WALK = {}

function WALK.Crawl(o, _t, g, e)
	local w = g * 9
	o.W = T(0, -(e.hip - 0.6 * e.S), 0) * A(-78, sin(w) * 5, 0)
	o.N = A(68, 0, 0)
	o.LS = A(82 + sin(w) * 30, 0, -8)
	o.RS = A(82 - sin(w) * 30, 0, 8)
	o.LH = A(66 - sin(w) * 26, 0, -6)
	o.RH = A(66 + sin(w) * 26, 0, 6)
end

function WALK.Waddle(o, _t, g, e)
	local w = g * 10
	o.W = T(0, abs(sin(w)) * 0.1 * e.S, 0) * A(0, 0, sin(w) * 11)
	o.LH = A(sin(w) * 26, 0, 0)
	o.RH = A(-sin(w) * 26, 0, 0)
	o.LS = A(0, 0, -48 + sin(w) * 12)
	o.RS = A(0, 0, 48 + sin(w) * 12)
	o.N = A(0, 0, -sin(w) * 8)
end

function WALK.Run(o, _t, g, e)
	local w = g * 13
	o.W = T(0, abs(sin(w)) * 0.22 * e.S, 0) * A(-12, sin(w) * 6, 0)
	o.LH = A(sin(w) * 48 + 10, 0, 0)
	o.RH = A(-sin(w) * 48 + 10, 0, 0)
	o.LS = A(-sin(w) * 58, 0, -8)
	o.RS = A(sin(w) * 58, 0, 8)
	o.N = A(8, 0, 0)
end

function WALK.Bop(o, _t, g, e)
	local w = g * 9
	o.W = T(0, abs(sin(w)) * 0.12 * e.S, 0) * A(-4, sin(w) * 9, sin(w) * 4)
	o.LH = A(sin(w) * 32 + 4, 0, 0)
	o.RH = A(-sin(w) * 32 + 4, 0, 0)
	o.LS = A(-sin(w) * 26, 0, -10)
	o.RS = A(sin(w) * 26, 0, 10)
	o.N = A(sin(w * 2) * 5, -sin(w) * 6, 0)
end

function WALK.Slouch(o, _t, g, e)
	local w = g * 7.5
	o.W = T(0, abs(sin(w)) * 0.05 * e.S, 0) * A(-13, 0, sin(w) * 2)
	o.LH = A(sin(w) * 26 + 13, 0, 0)
	o.RH = A(-sin(w) * 26 + 13, 0, 0)
	o.LS = A(14 - sin(w) * 8, 0, -4)
	o.RS = A(14 + sin(w) * 8, 0, 4)
	o.N = A(-18, 0, 0)
end

function WALK.Strut(o, _t, g, e)
	local w = g * 8
	o.W = T(sin(w) * 0.08 * e.S, abs(sin(w)) * 0.08 * e.S, 0) * A(3, sin(w) * 11, -sin(w) * 6)
	o.LH = A(sin(w) * 34 - 3, 0, 3)
	o.RH = A(-sin(w) * 34 - 3, 0, -3)
	o.LS = A(-sin(w) * 18, 0, -12)
	o.RS = A(sin(w) * 18, 0, 12)
	o.N = A(6, -sin(w) * 8, 0)
end

-- Slow, long strides, hands in pockets, head down. Very serious.
function WALK.ArchiveWalk(o, _t, g, e)
	local w = g * 5.5
	o.W = T(0, abs(sin(w)) * 0.05 * e.S, 0) * A(6, sin(w) * 4, 0)
	o.LH = A(sin(w) * 24 - 6, 0, 0)
	o.RH = A(-sin(w) * 24 - 6, 0, 0)
	o.LS = A(12, 0, -12)
	o.RS = A(12, 0, 12)
	o.N = A(-14, sin(w * 0.5) * 6, 0)
end

-- He does not walk. He glides.
function WALK.LegendWalk(o, _t, g, e)
	o.W = T(0, (0.4 + sin(g * 3) * 0.08) * e.S, 0) * A(-10, 0, sin(g * 2) * 3)
	o.LS = A(72, 0, 46)
	o.RS = A(72, 0, -46)
	o.LH = A(-16, 0, -2)
	o.RH = A(-26, 0, 2)
	o.N = A(12, 0, 0)
end

----------------------------------------------------------------------
-- POSES (mirror, fashion display, runway, random idle poses)
----------------------------------------------------------------------
local POSE = {}

function POSE.Wave(o, _t, g)
	o.W = A(0, 0, -3)
	o.RS = A(0, 0, 150 + sin(g * 9) * 18)
	o.LS = A(0, 0, -8)
	o.N = A(4, 0, 8)
end

function POSE.Peace(o, _t, g)
	o.W = A(0, -8, 5)
	o.RS = A(10, 0, 138 + sin(g * 2) * 3)
	o.LS = A(0, 0, -28)
	o.LH = A(0, 0, -6)
	o.N = A(4, 0, -12)
end

function POSE.Dab(o)
	o.W = A(-10, 10, -12)
	o.LS = A(128, 0, 62)
	o.RS = A(10, 0, 118)
	o.N = A(-34, 26, 0)
	o.LH = A(8, 0, -8)
	o.RH = A(8, 0, 8)
end

function POSE.HandsOnHips(o, _t, g)
	o.W = A(6 + sin(g * 1.5) * 1, 0, 0)
	o.LS = A(-12, 0, -40)
	o.RS = A(-12, 0, 40)
	o.LH = A(-6, 0, -9)
	o.RH = A(-6, 0, 9)
	o.N = A(8, 0, 0)
end

function POSE.Flex(o, _t, g)
	local pump = sin(g * 5) * 6
	o.W = A(4, 0, 0)
	o.LS = A(0, 0, -118 - pump)
	o.RS = A(0, 0, 118 + pump)
	o.LH = A(0, 0, -8)
	o.RH = A(0, 0, 8)
	o.N = A(10, 0, 0)
end

function POSE.Thinker(o, _t, g)
	o.W = A(-4, 0, 3)
	o.RS = A(118, 0, -40)
	o.LS = A(42, 0, 36)
	o.LH = A(8, 0, -2)
	o.N = A(-12 + sin(g * 1.2) * 2, 16, 0)
end

function POSE.ModelPose(o, _t, g)
	o.W = A(8, -16, -5)
	o.RS = A(-22, 0, 28)
	o.LS = A(10, 0, -32)
	o.LH = A(20, 0, -2)
	o.RH = A(-8, 0, 4)
	o.N = A(5, 30 + sin(g * 0.8) * 4, 0)
end

function POSE.ArchiveStance(o)
	o.W = A(-10, 0, 0)
	o.LS = A(14, 0, -12)
	o.RS = A(14, 0, 12)
	o.LH = A(10, 0, -9)
	o.RH = A(10, 0, 9)
	o.N = A(-18, 0, 0)
end

function POSE.Salute(o)
	o.W = A(3, 0, 0)
	o.RS = A(150, 0, -30)
	o.LS = A(0, 0, -4)
	o.N = A(6, 0, 0)
end

function POSE.LegendPose(o, _t, g, e)
	o.W = T(0, (0.6 + sin(g * 2) * 0.14) * e.S, 0) * A(4, 0, 0)
	o.LS = A(72, 0, 46)
	o.RS = A(72, 0, -46)
	o.LH = A(-10, 0, -3)
	o.RH = A(-18, 0, 3)
	o.N = A(10, 0, 0)
end

function POSE.GrailFloat(o, _t, g, e)
	o.W = T(0, (1.3 + sin(g * 1.8) * 0.2) * e.S, 0) * A(0, g * 40, 0)
	o.LH = A(72, 0, 36)
	o.RH = A(72, 0, -36)
	o.LS = A(0, 0, -62)
	o.RS = A(0, 0, 62)
	o.N = A(8, 0, 0)
end

function POSE.TPose(o)
	o.LS = A(0, 0, -90)
	o.RS = A(0, 0, 90)
end

function POSE.Griddy(o, _t, g, e)
	local w = g * 11
	o.W = T(0, abs(sin(w)) * 0.2 * e.S, 0) * A(-14, sin(w) * 8, 0)
	o.LH = A(max(0, sin(w)) * 70, 0, 0)
	o.RH = A(max(0, -sin(w)) * 70, 0, 0)
	o.LS = A(-30 + sin(w * 2) * 34, 0, -18)
	o.RS = A(-30 + sin(w * 2) * 34, 0, 18)
	o.N = A(10, 0, sin(w) * 6)
end

function POSE.Faint(o, t, g, e)
	if t < 0.9 then
		o.W = A(14, 0, 0)
		o.RS = A(150, 0, -34) -- back of the hand to the forehead
		o.N = A(22, 0, 0)
	else
		o.W = T(0, -(e.hip - 0.5 * e.S), 0) * A(90, 0, 0)
		o.LS = A(0, 0, -80)
		o.RS = A(0, 0, 80)
		o.LH = A(sin(g * 9) * 6, 0, -10)
		o.RH = A(0, 0, 10)
	end
end

----------------------------------------------------------------------
-- STATES
----------------------------------------------------------------------
local STATE = {}

function STATE.Pose(o, t, g, e)
	local pose = POSE[e.pose] or POSE.Peace
	pose(o, t, g, e)
end

-- Funny eating: an excited hop, then shovelling food into his face.
function STATE.Eat(o, t, g, e)
	if t < 0.55 then
		o.W = T(0, abs(sin(t * 11)) * 0.5 * e.S, 0)
		o.LS = A(0, 0, -150)
		o.RS = A(0, 0, 150)
		o.N = A(14, 0, 0)
	else
		local chew = sin(t * 13)
		o.W = A(-6, 0, chew * 2)
		o.RS = A(104 + chew * 22, 0, -26)
		o.LS = A(96 - chew * 22, 0, 26)
		o.N = A(-6 + chew * 7, 0, 0)
	end
end

-- Funny sleeping: flat on his back, one arm flopped out, a leg twitching.
function STATE.Sleep(o, _t, g, e)
	local breathe = sin(g * 1.6)
	o.W = T(0, -(e.hip - 0.5 * e.S) + breathe * 0.03 * e.S, 0) * A(90, 0, 0)
	o.LS = A(0, 0, -84)
	o.RS = A(38 + breathe * 4, 0, -24)
	o.LH = A(0, 0, -14)
	o.RH = A((g % 5) > 4.4 and sin(g * 30) * 16 or 0, 0, 12)
	o.N = A(0, 22, 0)
end

function STATE.Shower(o, t, g, e)
	local scrub = sin(t * 12)
	o.W = T(0, abs(sin(t * 5)) * 0.1 * e.S, 0) * A(0, t * 140, 0)
	o.LS = A(152, 0, -18 + scrub * 16)
	o.RS = A(152, 0, 18 - scrub * 16)
	o.N = A(8, 0, scrub * 5)
end

function STATE.Brush(o, t)
	local stroke = sin(t * 14)
	o.W = A(0, 0, -4)
	o.RS = A(162 + stroke * 12, 0, 12)
	o.LS = A(0, 0, -10)
	o.N = A(-4, 0, -12)
end

-- Bends over to scrub his shoes.
function STATE.ShoeClean(o, t)
	local scrub = sin(t * 12)
	o.W = A(-58, 0, 0)
	o.LH = A(58, 0, -6)
	o.RH = A(58, 0, 6)
	o.LS = A(76 + scrub * 14, 0, 8)
	o.RS = A(76 - scrub * 14, 0, -8)
	o.N = A(30, 0, 0)
end

function STATE.Play(o, t, _g, e)
	local w = t * 9
	o.W = T(0, abs(sin(w)) * 0.55 * e.S, 0) * A(0, sin(w * 0.5) * 20, 0)
	o.LS = A(sin(w) * 60, 0, -46)
	o.RS = A(-sin(w) * 60, 0, 46)
	o.LH = A(max(0, sin(w)) * 40, 0, -6)
	o.RH = A(max(0, -sin(w)) * 40, 0, 6)
	o.N = A(10, 0, sin(w) * 8)
end

function STATE.Dance(o, t, _g, e)
	local w = t * 8
	o.W = T(sin(w) * 0.28 * e.S, abs(sin(w)) * 0.24 * e.S, 0) * A(0, sin(w * 0.5) * 24, sin(w) * 9)
	o.LS = A(0, 0, -70 - sin(w) * 60)
	o.RS = A(0, 0, 70 - sin(w) * 60)
	o.LH = A(max(0, sin(w)) * 34, 0, -8)
	o.RH = A(max(0, -sin(w)) * 34, 0, 8)
	o.N = A(6, -sin(w * 0.5) * 16, sin(w) * 10)
end

-- Celebration: jumps with both arms up and spins once.
function STATE.Celebrate(o, t, _g, e)
	local spin = min(t, 1.1) / 1.1 * 360
	o.W = T(0, abs(sin(t * 6.5)) * 1.1 * e.S, 0) * A(0, spin, 0)
	o.LS = A(0, 0, -162 + sin(t * 18) * 14)
	o.RS = A(0, 0, 162 - sin(t * 18) * 14)
	o.LH = A(0, 0, -12)
	o.RH = A(0, 0, 12)
	o.N = A(16, 0, 0)
end

function STATE.Excited(o, t, _g, e)
	o.W = T(0, abs(sin(t * 12)) * 0.45 * e.S, 0)
	o.LS = A(0, 0, -140 + sin(t * 24) * 16)
	o.RS = A(0, 0, 140 - sin(t * 24) * 16)
	o.N = A(10, 0, 0)
end

-- Covers his face and shakes his head.
function STATE.Embarrassed(o, t)
	local shake = sin(t * 17) * 7
	o.W = A(-13, shake, 0)
	o.LH = A(13, 0, 6)
	o.RH = A(13, 0, -6)
	o.LS = A(128, 0, 28)
	o.RS = A(128, 0, -28)
	o.N = A(-24, shake, 0)
end

-- Admiring himself: turning side to side, hand on chin.
function STATE.Mirror(o, t)
	o.W = A(2, sin(t * 1.6) * 26, 0)
	o.RS = A(112, 0, -36)
	o.LS = A(-8, 0, -30)
	o.N = A(4, sin(t * 1.6) * 10, sin(t * 3.2) * 6)
end

-- Trip: stumble, face-plant, flail, get up, dust off.
function STATE.Trip(o, t, _g, e)
	if t < 0.22 then
		o.W = A(-34, 0, 0)
		o.LS = A(110, 0, -30)
		o.RS = A(110, 0, 30)
		o.LH = A(-30, 0, 0)
	elseif t < 1.35 then
		local flail = sin(t * 22)
		o.W = T(0, -(e.hip - 0.5 * e.S), 0) * A(-90, 0, 0)
		o.LS = A(172, 0, -24)
		o.RS = A(172, 0, 24)
		o.LH = A(-18 - flail * 22, 0, -8)
		o.RH = A(-18 + flail * 22, 0, 8)
		o.N = A(30, 0, 0)
	elseif t < 1.9 then
		o.W = T(0, -(e.hip * 0.45), 0) * A(-40, 0, 0)
		o.LS = A(70, 0, -10)
		o.RS = A(70, 0, 10)
		o.LH = A(70, 0, 0)
		o.RH = A(20, 0, 0)
	else
		local dust = sin(t * 20) * 14
		o.LS = A(30 + dust, 0, 24)
		o.RS = A(30 - dust, 0, -24)
		o.N = A(-10, sin(t * 6) * 18, 0)
	end
end

-- Special Grail spawn: drops in from the sky spinning, lands, strikes a pose.
function STATE.GrailSpawn(o, t, _g, e)
	if t < 1.5 then
		local height = (1.5 - t) / 1.5
		o.W = T(0, height * height * 22 * e.S, 0) * A(0, t * 720, 0)
		o.LS = A(0, 0, -90)
		o.RS = A(0, 0, 90)
		o.LH = A(0, 0, -10)
		o.RH = A(0, 0, 10)
	elseif t < 1.85 then
		o.W = T(0, -0.5 * e.S, 0) * A(-16, 0, 0) -- landing squat
		o.LS = A(0, 0, -50)
		o.RS = A(0, 0, 50)
		o.LH = A(34, 0, -14)
		o.RH = A(34, 0, 14)
	else
		o.W = A(6, 0, 0)
		o.LS = A(0, 0, -138)
		o.RS = A(0, 0, 138)
		o.N = A(14, 0, 0)
	end
end

BradyAnimator.Poses = POSE

----------------------------------------------------------------------
-- Entries
----------------------------------------------------------------------
local function register(model)
	if entries[model] then
		return
	end
	local root = model.PrimaryPart or model:FindFirstChild("Root")
	local torso = model:FindFirstChild("Torso")
	if not root or not torso then
		return
	end
	local entry = {
		model = model,
		root = root,
		motors = {},
		base = {},
		current = {},
		target = {},
		S = model:GetAttribute("Scale") or 1,
		hip = model:GetAttribute("HipHeight") or 2,
		state = nil,
		stateStart = os.clock(),
		phase = math.random() * 10,
		pos = root.CFrame.Position,
		wasWalking = false,
		blinkAt = os.clock() + 2 + math.random() * 3,
		face = nil,
	}
	local waist = root:FindFirstChild("Waist")
	local sources = { W = waist }
	for key, name in pairs(JOINTS) do
		local motor = sources[key] or torso:FindFirstChild(name)
		if not motor then
			return -- model is still replicating; a later frame will retry
		end
		entry.motors[key] = motor
		entry.base[key] = motor.C0
		entry.current[key] = IDENTITY
		entry.target[key] = IDENTITY
	end
	-- Face pieces (drawn with a SurfaceGui) for blinking / chewing.
	local head = model:FindFirstChild("Head")
	local faceGui = head and head:FindFirstChild("Face")
	if faceGui then
		local face = { eyes = {}, eyeSizes = {}, blush = {} }
		for _, name in ipairs({ "EyeL", "EyeR" }) do
			local eye = faceGui:FindFirstChild(name)
			if eye then
				table.insert(face.eyes, eye)
				table.insert(face.eyeSizes, eye.Size)
			end
		end
		face.mouth = faceGui:FindFirstChild("Mouth")
		face.mouthSize = face.mouth and face.mouth.Size
		for _, name in ipairs({ "BlushL", "BlushR" }) do
			local blush = faceGui:FindFirstChild(name)
			if blush then
				table.insert(face.blush, blush)
			end
		end
		entry.face = face
	end
	entries[model] = entry
end

local function unregister(model)
	entries[model] = nil
end

local function setEyes(face, openness)
	for index, eye in ipairs(face.eyes) do
		local size = face.eyeSizes[index]
		eye.Size = UDim2.new(size.X.Scale, 0, size.Y.Scale * openness, 0)
	end
end

local function updateFace(entry, state, t, now)
	local face = entry.face
	if not face then
		return
	end
	-- eyes
	if state == "Sleep" or (state == "Pose" and entry.pose == "Faint" and t > 0.9) then
		setEyes(face, 0.12)
	elseif state == "Celebrate" or state == "Excited" or state == "GrailSpawn" then
		setEyes(face, 1.25)
	else
		local sinceBlink = now - entry.blinkAt
		if sinceBlink >= 0 and sinceBlink < 0.13 then
			setEyes(face, 0.1)
		else
			setEyes(face, 1)
			if sinceBlink >= 0.13 then
				entry.blinkAt = now + 2.2 + math.random() * 3.5
			end
		end
	end
	-- mouth
	if face.mouth then
		local size = face.mouthSize
		local stretch = 1
		if state == "Eat" and t > 0.55 then
			stretch = 1 + abs(sin(t * 13)) * 1.6
		elseif state == "Celebrate" or state == "Excited" or state == "Play" or state == "Dance" then
			stretch = 2.2
		elseif state == "Sleep" then
			stretch = 1 + abs(sin(now * 1.6)) * 1.2 -- snoring
		end
		face.mouth.Size = UDim2.new(size.X.Scale, 0, size.Y.Scale * stretch, 0)
	end
	-- blush
	local embarrassed = state == "Embarrassed"
	for _, blush in ipairs(face.blush) do
		blush.Visible = embarrassed or blush:GetAttribute("Default") == true
	end
end

local scratch = {}

local function animate(entry, dt, now, serverNow)
	local model = entry.model
	local state = model:GetAttribute("State") or "Idle"
	entry.pose = model:GetAttribute("Pose")

	-- MOVEMENT along the walk line the server published ------------------
	local walking = false
	local duration = model:GetAttribute("WalkDur") or 0
	if duration > 0 then
		local from, to = model:GetAttribute("WalkFrom"), model:GetAttribute("WalkTo")
		local start = model:GetAttribute("WalkStart")
		if from and to and start then
			local alpha = (serverNow - start) / duration
			if alpha < 1 then
				walking = true
				local goal = from:Lerp(to, math.clamp(alpha, 0, 1))
				-- ease towards the goal so small network hiccups stay smooth
				if (goal - entry.pos).Magnitude > 12 then
					entry.pos = goal
				else
					entry.pos = entry.pos:Lerp(goal, 1 - math.exp(-16 * dt))
				end
				local direction = Vector3.new(to.X - from.X, 0, to.Z - from.Z)
				local rootCFrame = entry.root.CFrame
				if direction.Magnitude > 0.05 then
					-- turn smoothly towards the walking direction
					rootCFrame = rootCFrame:Lerp(CFrame.lookAt(entry.pos, entry.pos + direction), 1 - math.exp(-12 * dt))
				end
				entry.root.CFrame = rootCFrame - rootCFrame.Position + entry.pos
			end
		end
	end
	if not walking then
		entry.pos = entry.root.CFrame.Position
	end
	entry.wasWalking = walking

	-- STATE bookkeeping --------------------------------------------------
	if state ~= entry.state then
		local old = entry.state
		entry.state = state
		entry.stateStart = now
		for _, listener in ipairs(stateListeners) do
			task.spawn(listener, model, state, old, entry)
		end
	end
	local t = now - entry.stateStart
	local g = now + entry.phase

	-- TARGET offsets -----------------------------------------------------
	local o = scratch
	for _, key in ipairs(KEYS) do
		o[key] = IDENTITY
	end
	local fn
	if state == "Idle" or state == "Walk" then
		if walking then
			fn = WALK[model:GetAttribute("WalkStyle")] or WALK.Bop
		else
			fn = IDLE[model:GetAttribute("IdleStyle")] or IDLE.Bouncy
		end
	else
		fn = STATE[state]
		if not fn then
			fn = walking and WALK.Bop or IDLE.Bouncy
		end
	end
	fn(o, t, g, entry)

	-- BLEND + APPLY ------------------------------------------------------
	local blend = 1 - math.exp(-((state == "Trip" or state == "GrailSpawn") and 22 or 13) * dt)
	for _, key in ipairs(KEYS) do
		local current = entry.current[key]:Lerp(o[key], blend)
		entry.current[key] = current
		entry.motors[key].C0 = entry.base[key] * current
	end

	if not lowGraphics then
		updateFace(entry, state, t, now)
	end
end

local frame = 0

local function step(dt)
	frame += 1
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local cameraPosition = camera.CFrame.Position
	local now = os.clock()
	local serverNow = Workspace:GetServerTimeNow()
	dt = math.min(dt, 0.1)
	for model, entry in pairs(entries) do
		if not model.Parent then
			entries[model] = nil
		else
			local distance = (entry.root.CFrame.Position - cameraPosition).Magnitude
			-- Far Bradys are skipped; mid-distance ones update every other frame.
			if distance <= maxDistance and (distance < 70 or frame % 2 == 0) then
				animate(entry, distance < 70 and dt or dt * 2, now, serverNow)
			end
		end
	end
end

function BradyAnimator.setLowGraphics(enabled)
	lowGraphics = enabled
	maxDistance = enabled and 70 or 140
end

function BradyAnimator.get(model)
	return entries[model]
end

local started = false

function BradyAnimator.start()
	if started then
		return
	end
	started = true
	for _, model in ipairs(CollectionService:GetTagged(TAG)) do
		register(model)
	end
	CollectionService:GetInstanceAddedSignal(TAG):Connect(function(model)
		-- give the model's children a moment to replicate
		task.defer(register, model)
	end)
	CollectionService:GetInstanceRemovedSignal(TAG):Connect(unregister)
	-- Safety net: pick up any Brady that was not ready when it was tagged.
	task.spawn(function()
		while true do
			task.wait(1)
			for _, model in ipairs(CollectionService:GetTagged(TAG)) do
				if not entries[model] and model.Parent then
					register(model)
				end
			end
		end
	end)
	RunService.RenderStepped:Connect(step)
end

-- Exposed for tests.
BradyAnimator._step = step
BradyAnimator._register = register
BradyAnimator.Idle, BradyAnimator.Walk, BradyAnimator.State = IDLE, WALK, STATE

return BradyAnimator
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">ClientState</string>
          <string name="Source"><![CDATA[--[[
	ClientState
	The client's read-only copy of the player's profile plus a tiny message
	bus the separate UI scripts use to talk to each other.

	Every LocalScript requires this same module, so they all share one state:

	    local State = require(ReplicatedStorage.Client.ClientState)
	    local data = State.wait()              -- yields until the profile arrives
	    State.on("coins", function(coins) end) -- runs now and on every change
	    State.open("Shop", "Food")             -- ask the Shop window to open

	The data here is only for DISPLAY. Changing it does nothing: the server
	owns the real profile and re-sends any key that changes.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local Remotes = require(Modules:WaitForChild("Remotes"))
local Sounds = require(Modules:WaitForChild("Sounds"))
local Util = require(Modules:WaitForChild("Util"))

local ClientState = {}

ClientState.data = nil -- the saved profile (coins, age, inventory...)
ClientState.session = {} -- non-saved state (passes, sleeping, following, day)
ClientState.fashion = nil -- latest fashion show state
ClientState.event = nil -- active random event (or nil)
ClientState.current = nil -- name of the open window
ClientState.currentArg = nil

ClientState.changed = Util.Signal.new() -- (key, value) for profile keys
ClientState.sessionChanged = Util.Signal.new() -- (key, value)
ClientState.panelChanged = Util.Signal.new() -- (name | nil, arg)
ClientState.notified = Util.Signal.new() -- (payload) centre-screen messages
ClientState.fashionChanged = Util.Signal.new() -- (state)
ClientState.eventChanged = Util.Signal.new() -- (event | nil)
ClientState.loaded = Util.Signal.new()

local started = false
local sounds = {}

local function start()
	if started then
		return
	end
	started = true

	Remotes.event("DataUpdate").OnClientEvent:Connect(function(update)
		if not ClientState.data then
			return -- the initial snapshot will include it
		end
		if update.data then
			for key, value in pairs(update.data) do
				ClientState.data[key] = value
				ClientState.changed:Fire(key, value)
			end
		end
		if update.session then
			for key, value in pairs(update.session) do
				ClientState.session[key] = value
				ClientState.sessionChanged:Fire(key, value)
			end
		end
	end)
	Remotes.event("Notify").OnClientEvent:Connect(function(payload)
		ClientState.notified:Fire(payload)
	end)
	Remotes.event("FashionState").OnClientEvent:Connect(function(state)
		ClientState.fashion = state
		ClientState.fashionChanged:Fire(state)
	end)
	Remotes.event("EventUpdate").OnClientEvent:Connect(function(event)
		ClientState.event = event
		ClientState.eventChanged:Fire(event)
	end)
	Remotes.event("OpenPanel").OnClientEvent:Connect(function(name, arg)
		ClientState.open(name, arg)
	end)

	task.spawn(function()
		local getData = Remotes.func("GetData")
		local snapshot
		repeat
			local ok, result = pcall(function()
				return getData:InvokeServer()
			end)
			snapshot = ok and result or nil
			if not snapshot then
				task.wait(1)
			end
		until snapshot
		ClientState.data = snapshot.data
		ClientState.session = snapshot.session or {}
		ClientState.loaded:Fire(ClientState.data)
		-- ask for the fashion show state now that we are listening
		Remotes.event("Fashion"):FireServer("Sync")
	end)
end

-- Yields until the profile has arrived, then returns it.
function ClientState.wait()
	start()
	while not ClientState.data do
		task.wait(0.1)
	end
	return ClientState.data
end

-- Run fn(value) now (once loaded) and again whenever that profile key changes.
function ClientState.on(key, fn)
	local connection = ClientState.changed:Connect(function(changedKey, value)
		if changedKey == key then
			fn(value)
		end
	end)
	task.spawn(function()
		ClientState.wait()
		fn(ClientState.data[key])
	end)
	return connection
end

function ClientState.onSession(key, fn)
	local connection = ClientState.sessionChanged:Connect(function(changedKey, value)
		if changedKey == key then
			fn(value)
		end
	end)
	task.spawn(function()
		ClientState.wait()
		fn(ClientState.session[key])
	end)
	return connection
end

-- Window management: only one window is open at a time.
function ClientState.open(name, arg)
	ClientState.current = name
	ClientState.currentArg = arg
	ClientState.panelChanged:Fire(name, arg)
end

function ClientState.close()
	if ClientState.current ~= nil then
		ClientState.open(nil)
	end
end

function ClientState.toggle(name, arg)
	if ClientState.current == name then
		ClientState.close()
	else
		ClientState.open(name, arg)
	end
end

-- Small message at the bottom of the screen.
function ClientState.toast(text, kind)
	ClientState.notified:Fire({ text = text, toast = true, kind = kind or "info" })
end

-- Big centre-screen message.
function ClientState.announce(payload)
	ClientState.notified:Fire(payload)
end

function ClientState.passes()
	return ClientState.session.passes or {}
end

function ClientState.hasPass(key)
	return ClientState.passes()[key] == true
end

-- The local player's own Brady model (or nil while it is being rebuilt).
function ClientState.myBrady()
	local userId = Players.LocalPlayer.UserId
	for _, model in ipairs(CollectionService:GetTagged("BradyGoo")) do
		if model:GetAttribute("OwnerUserId") == userId and model.Parent then
			return model
		end
	end
	return nil
end

function ClientState.setting(key)
	local data = ClientState.data
	return data and data.settings and data.settings[key]
end

-- Plays a UI sound from Modules/Sounds (respects the SFX setting).
function ClientState.sound(name)
	if ClientState.setting("sfx") == false then
		return
	end
	local def = Sounds.List[name]
	if not def then
		return
	end
	local sound = sounds[name]
	if not sound then
		sound = Instance.new("Sound")
		sound.Name = "Sfx_" .. name
		sound.SoundId = def.id
		sound.Volume = def.volume or 0.5
		sound.PlaybackSpeed = def.speed or 1
		sound.Parent = SoundService
		sounds[name] = sound
	end
	sound:Play()
end

-- Convenience wrappers so UI scripts do not all need the Remotes module.
function ClientState.send(remoteName, ...)
	Remotes.event(remoteName):FireServer(...)
end

function ClientState.invoke(remoteName, ...)
	local args = table.pack(...)
	local ok, result = pcall(function()
		return Remotes.func(remoteName):InvokeServer(table.unpack(args, 1, args.n))
	end)
	if ok and type(result) == "table" then
		return result
	end
	return { ok = false, reason = "no response from the server" }
end

function ClientState.listen(remoteName, fn)
	return Remotes.event(remoteName).OnClientEvent:Connect(fn)
end

return ClientState
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Preview</string>
          <string name="Source"><![CDATA[--[[
	Preview
	A little 3D Brady inside a ViewportFrame, used by the Brady panel, the
	wardrobe and the inspect window. It is built with the same BradyBuilder
	the server uses, so what you see in the preview is what everyone sees.

	    local preview = Preview.new(parentFrame, { Size = ... })
	    preview.set({ age = 13, equipped = data.equipped })
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local BradyBuilder = require(Modules:WaitForChild("Builders"):WaitForChild("BradyBuilder"))

local Preview = {}

local active = {} -- previews that are currently spinning
local connection

local function ensureLoop()
	if connection then
		return
	end
	-- One shared loop turns every visible preview slowly.
	connection = RunService.RenderStepped:Connect(function(dt)
		for preview in pairs(active) do
			local frame = preview.frame
			if not frame.Parent then
				active[preview] = nil
			elseif preview.model and preview.isVisible() then
				preview.angle += dt * 0.6
				preview.aim()
			end
		end
	end)
end

function Preview.new(parent, props)
	props = props or {}
	local frame = Instance.new("ViewportFrame")
	frame.Name = props.Name or "BradyPreview"
	frame.Size = props.Size or UDim2.fromScale(1, 1)
	frame.Position = props.Position or UDim2.new()
	frame.AnchorPoint = props.AnchorPoint or Vector2.new()
	frame.BackgroundColor3 = props.Color or Color3.fromRGB(46, 42, 72)
	frame.BackgroundTransparency = props.Transparency or 0
	frame.BorderSizePixel = 0
	frame.Ambient = Color3.fromRGB(190, 190, 200)
	frame.LightColor = Color3.fromRGB(255, 255, 255)
	frame.LightDirection = Vector3.new(-1, -1.5, 1)
	frame.LayoutOrder = props.LayoutOrder or 0
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 14)
	corner.Parent = frame

	local camera = Instance.new("Camera")
	camera.FieldOfView = 35
	camera.Parent = frame
	frame.CurrentCamera = camera
	frame.Parent = parent

	local preview = { frame = frame, camera = camera, model = nil, angle = props.Angle or 0.5, height = 4 }

	-- Is the preview (and every ancestor) actually on screen?
	function preview.isVisible()
		local node = frame
		while node and node:IsA("GuiObject") do
			if not node.Visible then
				return false
			end
			node = node.Parent
		end
		return true
	end

	-- Orbit the camera around Brady (he faces -Z).
	function preview.aim()
		local h = preview.height
		local distance = h * 1.9 + 3
		local target = Vector3.new(0, h * 0.5, 0)
		local offset = Vector3.new(math.sin(preview.angle) * distance, h * 0.15, -math.cos(preview.angle) * distance)
		camera.CFrame = CFrame.lookAt(target + offset, target)
	end

	-- spec = { age, equipped, hairOverride }
	function preview.set(spec)
		if preview.model then
			preview.model:Destroy()
			preview.model = nil
		end
		local model = BradyBuilder.build({
			age = spec.age,
			equipped = spec.equipped,
			hairOverride = spec.hairOverride,
			preview = true,
		})
		preview.height = model:GetAttribute("Height") or 4
		model.Parent = frame
		preview.model = model
		preview.aim()
	end

	function preview.destroy()
		active[preview] = nil
		frame:Destroy()
	end

	if props.Spin ~= false then
		active[preview] = true
		ensureLoop()
	end
	return preview
end

return Preview
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">UI</string>
          <string name="Source"><![CDATA[--[[
	UI kit
	Shared look + building blocks for every screen, so the whole game has one
	consistent chunky, colourful style and each UI script stays short.

	Everything is built in code (no image assets): rounded frames, thick
	outlines, emoji icons. Layout is authored against a reference screen and
	scaled with UIScale, which keeps buttons big and readable on phones,
	tablets and PC alike.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local ClothingSystem = require(Modules:WaitForChild("ClothingSystem"))
local State = require(script.Parent:WaitForChild("ClientState"))

local UI = {}

local rgb = Color3.fromRGB

UI.Colors = {
	bg = rgb(30, 27, 48),
	panel = rgb(46, 42, 72),
	panel2 = rgb(62, 57, 96),
	dark = rgb(18, 16, 30),
	text = rgb(255, 255, 255),
	sub = rgb(198, 198, 222),
	goo = rgb(126, 232, 74),
	gooDark = rgb(64, 168, 52),
	gold = rgb(255, 205, 60),
	red = rgb(232, 66, 78),
	blue = rgb(72, 150, 255),
	pink = rgb(255, 110, 225),
	purple = rgb(178, 92, 255),
	grey = rgb(110, 108, 132),
}

UI.TitleFont = Enum.Font.FredokaOne
UI.BodyFont = Enum.Font.GothamBold
UI.LoudFont = Enum.Font.LuckiestGuy

----------------------------------------------------------------------
-- Basics
----------------------------------------------------------------------
-- UI.new("Frame", { Size = ..., Parent = x }, { child, child })
function UI.new(className, props, children)
	local instance = Instance.new(className)
	local parent
	if props then
		for key, value in pairs(props) do
			if key == "Parent" then
				parent = value
			else
				instance[key] = value
			end
		end
	end
	if children then
		for _, child in ipairs(children) do
			child.Parent = instance
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function UI.corner(parent, radius)
	return UI.new("UICorner", { CornerRadius = UDim.new(0, radius or 12), Parent = parent })
end

function UI.stroke(parent, thickness, color, transparency)
	return UI.new("UIStroke", {
		Thickness = thickness or 2,
		Color = color or UI.Colors.dark,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

function UI.pad(parent, left, top, right, bottom)
	top = top or left
	right = right or left
	bottom = bottom or top
	return UI.new("UIPadding", {
		PaddingLeft = UDim.new(0, left),
		PaddingTop = UDim.new(0, top),
		PaddingRight = UDim.new(0, right),
		PaddingBottom = UDim.new(0, bottom),
		Parent = parent,
	})
end

-- opts: horizontal (bool), pad, alignX, alignY, wraps
function UI.list(parent, opts)
	opts = opts or {}
	return UI.new("UIListLayout", {
		FillDirection = opts.horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, opts.pad or 6),
		HorizontalAlignment = opts.alignX or Enum.HorizontalAlignment.Left,
		VerticalAlignment = opts.alignY or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Wraps = opts.wraps == true,
		Parent = parent,
	})
end

function UI.grid(parent, cellWidth, cellHeight, pad)
	return UI.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(cellWidth, cellHeight),
		CellPadding = UDim2.fromOffset(pad or 8, pad or 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = parent,
	})
end

function UI.frame(parent, props)
	props = props or {}
	local frame = UI.new("Frame", {
		Name = props.Name or "Frame",
		Size = props.Size or UDim2.fromScale(1, 1),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(),
		BackgroundColor3 = props.Color or UI.Colors.panel,
		BackgroundTransparency = props.Transparency or 0,
		BorderSizePixel = 0,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Visible = props.Visible ~= false,
		ClipsDescendants = props.Clips == true,
		Parent = parent,
	})
	if props.Corner ~= false then
		UI.corner(frame, props.Corner or 12)
	end
	if props.Stroke then
		UI.stroke(frame, props.Stroke, props.StrokeColor)
	end
	return frame
end

-- A transparent container.
function UI.box(parent, props)
	props = props or {}
	props.Transparency = 1
	props.Corner = false
	return UI.frame(parent, props)
end

function UI.label(parent, text, props)
	props = props or {}
	local label = UI.new("TextLabel", {
		Name = props.Name or "Label",
		Size = props.Size or UDim2.fromScale(1, 1),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(),
		BackgroundTransparency = 1,
		Font = props.Font or UI.TitleFont,
		Text = text or "",
		TextSize = props.TextSize or 18,
		TextColor3 = props.Color or UI.Colors.text,
		TextXAlignment = props.AlignX or Enum.TextXAlignment.Center,
		TextYAlignment = props.AlignY or Enum.TextYAlignment.Center,
		TextWrapped = props.Wrapped ~= false,
		TextScaled = props.Scaled == true,
		TextTransparency = props.TextTransparency or 0,
		RichText = props.Rich == true,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Parent = parent,
	})
	if props.Outline then
		-- chunky cartoon outline around the text
		UI.new("UIStroke", { Thickness = props.Outline, Color = props.OutlineColor or UI.Colors.dark, Parent = label })
	end
	return label
end

function UI.tween(instance, seconds, goals, style, direction)
	local tween = TweenService:Create(instance, TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), goals)
	tween:Play()
	return tween
end

-- Squash-and-pop used when things appear.
-- A GuiObject should only ever have ONE UIScale, so this reuses the object's
-- existing scale (auto-scale or button press scale) when it has one and
-- animates back to that scale's resting value.
function UI.pop(guiObject, from)
	local scale = guiObject:FindFirstChildOfClass("UIScale")
	if not scale then
		scale = UI.new("UIScale", { Name = "PopScale", Parent = guiObject })
	end
	local rest = scale:GetAttribute("Rest") or 1
	scale.Scale = rest * (from or 0.7)
	UI.tween(scale, 0.25, { Scale = rest }, Enum.EasingStyle.Back)
end

-- A chunky button. props: Size, Position, AnchorPoint, Color, TextColor,
-- TextSize, LayoutOrder, Name, Corner, Silent (no click sound)
function UI.button(parent, text, props, onClick)
	props = props or {}
	local color = props.Color or UI.Colors.goo
	local button = UI.new("TextButton", {
		Name = props.Name or "Button",
		Size = props.Size or UDim2.fromOffset(140, 44),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Font = props.Font or UI.TitleFont,
		Text = text or "",
		TextSize = props.TextSize or 20,
		TextColor3 = props.TextColor or UI.Colors.dark,
		TextWrapped = true,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Parent = parent,
	})
	UI.corner(button, props.Corner or 12)
	UI.stroke(button, 3, UI.Colors.dark)
	local press = UI.new("UIScale", { Name = "Press", Parent = button })
	button.MouseButton1Down:Connect(function()
		UI.tween(press, 0.06, { Scale = 0.93 })
	end)
	button.MouseButton1Up:Connect(function()
		UI.tween(press, 0.12, { Scale = 1 }, Enum.EasingStyle.Back)
	end)
	button.MouseLeave:Connect(function()
		UI.tween(press, 0.12, { Scale = 1 })
	end)
	if onClick then
		button.Activated:Connect(function()
			if not props.Silent then
				State.sound("click")
			end
			onClick(button)
		end)
	end
	return button
end

-- Greys a button out (it still fires, the caller decides what to do).
function UI.setEnabled(button, enabled, color)
	button.BackgroundColor3 = enabled and (color or UI.Colors.goo) or UI.Colors.grey
	button.TextTransparency = enabled and 0 or 0.35
	button:SetAttribute("Disabled", not enabled)
end

function UI.scroll(parent, props)
	props = props or {}
	return UI.new("ScrollingFrame", {
		Name = props.Name or "Scroll",
		Size = props.Size or UDim2.fromScale(1, 1),
		Position = props.Position or UDim2.new(),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = UI.Colors.goo,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = parent,
	})
end

-- Removes every child except layout / padding objects.
function UI.clear(parent)
	for _, child in ipairs(parent:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

-- Progress bar. Returns { frame, fill, label, set(ratio, text) }
function UI.bar(parent, props)
	props = props or {}
	local frame = UI.frame(parent, {
		Name = props.Name or "Bar",
		Size = props.Size or UDim2.new(1, 0, 0, 20),
		Position = props.Position,
		AnchorPoint = props.AnchorPoint,
		Color = UI.Colors.dark,
		Corner = props.Corner or 8,
		LayoutOrder = props.LayoutOrder,
	})
	local fill = UI.frame(frame, { Name = "Fill", Size = UDim2.fromScale(0, 1), Color = props.Color or UI.Colors.goo, Corner = props.Corner or 8 })
	local label = UI.label(frame, "", { Name = "Text", TextSize = props.TextSize or 13, Font = UI.BodyFont, ZIndex = 2 })
	local bar = { frame = frame, fill = fill, label = label }
	function bar.set(ratio, text, color)
		ratio = math.clamp(ratio or 0, 0, 1)
		UI.tween(fill, 0.25, { Size = UDim2.fromScale(ratio, 1) })
		if text then
			label.Text = text
		end
		if color then
			fill.BackgroundColor3 = color
		end
	end
	return bar
end

----------------------------------------------------------------------
-- Scaling for every screen size
----------------------------------------------------------------------
-- kind "window": big centred panels (nearly fill a phone screen)
-- kind "hud":    always-visible clusters at the screen edges
function UI.autoScale(guiObject, kind)
	local scale = UI.new("UIScale", { Name = "AutoScale", Parent = guiObject })
	local function update()
		local camera = Workspace.CurrentCamera
		local size = camera and camera.ViewportSize or Vector2.new(1280, 720)
		local value
		if kind == "window" then
			value = math.clamp(math.min(size.X / 820, size.Y / 500), 0.55, 1.35)
		else
			value = math.clamp(math.min(size.X / 1100, size.Y / 640), 0.62, 1.25)
		end
		scale:SetAttribute("Rest", value) -- UI.pop animates back to this
		scale.Scale = value
	end
	update()
	local camera = Workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(update)
	end
	return scale
end

----------------------------------------------------------------------
-- Windows
----------------------------------------------------------------------
-- A centred window bound to a panel name. It shows itself when
-- State.open(name) is called and hides when any other window opens.
-- opts: name, title, width, height
-- Returns { root, body, title, visible, onShow(fn), onHide(fn), setTitle }
function UI.window(screenGui, opts)
	local window = { visible = false }
	local showHandlers, hideHandlers = {}, {}

	local root = UI.frame(screenGui, {
		Name = opts.name .. "Window",
		Size = UDim2.fromOffset(opts.width or 760, opts.height or 460),
		Position = UDim2.fromScale(0.5, 0.52),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Color = UI.Colors.bg,
		Corner = 20,
		Visible = false,
	})
	UI.stroke(root, 4, UI.Colors.goo)
	UI.autoScale(root, "window")
	-- swallow clicks so the world behind the window is not tapped through
	root.Active = true

	local header = UI.frame(root, { Name = "Header", Size = UDim2.new(1, 0, 0, 54), Color = UI.Colors.panel, Corner = 20 })
	local title = UI.label(header, opts.title or opts.name, {
		Name = "Title",
		Size = UDim2.new(1, -90, 1, 0),
		Position = UDim2.fromOffset(20, 0),
		TextSize = 28,
		AlignX = Enum.TextXAlignment.Left,
		Outline = 2,
	})
	UI.button(header, "X", {
		Name = "Close",
		Size = UDim2.fromOffset(44, 40),
		Position = UDim2.new(1, -8, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		Color = UI.Colors.red,
		TextColor = UI.Colors.text,
		TextSize = 22,
	}, function()
		State.close()
	end)

	local body = UI.box(root, { Name = "Body", Size = UDim2.new(1, -24, 1, -70), Position = UDim2.fromOffset(12, 60) })

	window.root, window.body, window.title = root, body, title

	function window.onShow(fn)
		table.insert(showHandlers, fn)
	end
	function window.onHide(fn)
		table.insert(hideHandlers, fn)
	end
	function window.setTitle(text)
		title.Text = text
	end

	State.panelChanged:Connect(function(name, arg)
		if name == opts.name then
			local wasVisible = window.visible
			window.visible = true
			root.Visible = true
			if not wasVisible then
				UI.pop(root, 0.85)
				State.sound("open")
			end
			for _, fn in ipairs(showHandlers) do
				task.spawn(fn, arg)
			end
		elseif window.visible then
			window.visible = false
			root.Visible = false
			for _, fn in ipairs(hideHandlers) do
				task.spawn(fn)
			end
		end
	end)
	return window
end

-- A row of tab buttons. items = { { id = "x", text = "X" }, ... }
-- Returns { select(id), current }
function UI.tabs(parent, items, onSelect, props)
	props = props or {}
	local holder = UI.box(parent, { Name = "Tabs", Size = props.Size or UDim2.new(1, 0, 0, 40), Position = props.Position })
	UI.list(holder, { horizontal = true, pad = 6, alignY = Enum.VerticalAlignment.Center })
	local tabs = { current = nil, buttons = {} }
	local width = props.TabWidth or math.floor((props.Width or 720) / #items) - 6
	function tabs.select(id, silent)
		tabs.current = id
		for tabId, button in pairs(tabs.buttons) do
			button.BackgroundColor3 = tabId == id and UI.Colors.goo or UI.Colors.panel2
			button.TextColor3 = tabId == id and UI.Colors.dark or UI.Colors.text
		end
		if not silent then
			onSelect(id)
		end
	end
	for index, item in ipairs(items) do
		local button = UI.button(holder, item.text, {
			Name = "Tab_" .. item.id,
			Size = UDim2.fromOffset(width, props.TabHeight or 36),
			Color = UI.Colors.panel2,
			TextColor = UI.Colors.text,
			TextSize = props.TextSize or 15,
			LayoutOrder = index,
			Silent = true,
		}, function()
			State.sound("tab")
			tabs.select(item.id)
		end)
		tabs.buttons[item.id] = button
	end
	return tabs
end

----------------------------------------------------------------------
-- Clothing cards (inventory / wardrobe / shop / inspect)
----------------------------------------------------------------------
function UI.rarityColor(rarity)
	return ClothingSystem.rarityColor(rarity)
end

-- A square card for a clothing item with its rarity colour.
-- opts: Size (UDim2), footer (text under the name), equipped, locked
function UI.itemCard(parent, item, opts, onClick)
	opts = opts or {}
	local rarityColor = ClothingSystem.rarityColor(item.rarity)
	local order = ClothingSystem.rarityOrder(item.rarity)
	local card = UI.new("TextButton", {
		Name = "Item_" .. item.id,
		Size = opts.Size or UDim2.fromOffset(104, 122),
		BackgroundColor3 = UI.Colors.panel,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = opts.LayoutOrder or 0,
		Parent = parent,
	})
	UI.corner(card, 12)
	local stroke = UI.stroke(card, 3, rarityColor)
	-- colour swatch + slot icon stand in for a thumbnail
	local swatch = UI.frame(card, { Name = "Swatch", Size = UDim2.new(1, -16, 0, 56), Position = UDim2.fromOffset(8, 8), Color = ClothingSystem.swatch(item), Corner = 8 })
	UI.label(swatch, ClothingSystem.SlotInfo[item.slot].icon, { TextSize = 32 })
	UI.label(card, item.name, { Name = "ItemName", Size = UDim2.new(1, -8, 0, 30), Position = UDim2.fromOffset(4, 66), TextSize = 12, Font = UI.BodyFont })
	UI.label(card, opts.footer or item.rarity, { Name = "Footer", Size = UDim2.new(1, -8, 0, 16), Position = UDim2.new(0, 4, 1, -20), TextSize = 12, Color = rarityColor })
	if opts.equipped then
		local badge = UI.frame(card, { Name = "Equipped", Size = UDim2.fromOffset(24, 24), Position = UDim2.new(1, -4, 0, 4), AnchorPoint = Vector2.new(1, 0), Color = UI.Colors.goo, Corner = 12, ZIndex = 3 })
		UI.label(badge, "✓", { TextSize = 16, Color = UI.Colors.dark, ZIndex = 4 })
	end
	if opts.locked then
		local shade = UI.frame(card, { Name = "Locked", Color = UI.Colors.dark, Transparency = 0.45, Corner = 12, ZIndex = 3 })
		UI.label(shade, "🔒\n" .. tostring(opts.locked), { TextSize = 14, ZIndex = 4 })
	end
	-- Legendary and better pieces glow in the inventory.
	if order >= 5 and not opts.locked then
		task.spawn(function()
			while card.Parent do
				UI.tween(stroke, 0.7, { Thickness = 5, Transparency = 0.35 }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
				task.wait(0.7)
				if not card.Parent then
					break
				end
				UI.tween(stroke, 0.7, { Thickness = 3, Transparency = 0 }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
				task.wait(0.7)
			end
		end)
	end
	if onClick then
		card.Activated:Connect(function()
			State.sound("click")
			onClick(card)
		end)
	end
	return card
end

-- A simple text row card (shop entries, tasks, achievements).
function UI.row(parent, props)
	props = props or {}
	local row = UI.frame(parent, {
		Name = props.Name or "Row",
		Size = props.Size or UDim2.new(1, -10, 0, 64),
		Color = props.Color or UI.Colors.panel,
		Corner = 12,
		LayoutOrder = props.LayoutOrder,
	})
	if props.StrokeColor then
		UI.stroke(row, 2, props.StrokeColor)
	end
	return row
end

return UI
]]></string>
        </Properties>
      </Item>
