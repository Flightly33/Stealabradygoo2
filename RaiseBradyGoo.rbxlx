  </Item>
  <Item class="StarterGui" referent="60">
    <Properties>
      <string name="Name">StarterGui</string>
    </Properties>
    <Item class="ScreenGui" referent="61">
      <Properties>
        <string name="Name">AgeUI</string>
        <int name="DisplayOrder">12</int>
        <bool name="ResetOnSpawn">false</bool>
        <token name="ZIndexBehavior">1</token>
      </Properties>
      <Item class="LocalScript" referent="62">
        <Properties>
          <string name="Name">AgeUI</string>
          <string name="Source"><![CDATA[--[[
	AgeUI
	The Age XP bar at the top of the screen:

	        AGE 13  [████████░░░░]  AGE 14
	              Teen Brady

	...and the "BRADY AGED UP!" celebration that plays when the server says
	Brady reached a new age (bigger when he enters a whole new stage).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = ReplicatedStorage:WaitForChild("Client")
local Modules = ReplicatedStorage:WaitForChild("Modules")
local State = require(Client:WaitForChild("ClientState"))
local UI = require(Client:WaitForChild("UI"))
local AgeSystem = require(Modules:WaitForChild("AgeSystem"))
local Util = require(Modules:WaitForChild("Util"))

local gui = script.Parent
local C = UI.Colors

State.wait()

----------------------------------------------------------------------
-- Age bar
----------------------------------------------------------------------
local holder = UI.box(gui, { Name = "AgeBar", Size = UDim2.fromOffset(560, 100), Position = UDim2.new(0.5, 0, 0, 6), AnchorPoint = Vector2.new(0.5, 0) })
UI.autoScale(holder, "hud")

local row = UI.frame(holder, { Name = "Row", Size = UDim2.fromOffset(460, 34), Position = UDim2.fromOffset(50, 52), Color = C.bg, Corner = 17, Stroke = 3, StrokeColor = C.dark })
local leftLabel = UI.label(row, "AGE 1", { Name = "Current", Size = UDim2.fromOffset(84, 34), TextSize = 18, Color = C.goo, Outline = 2 })
local rightLabel = UI.label(row, "AGE 2", { Name = "Next", Size = UDim2.fromOffset(84, 34), Position = UDim2.new(1, -84, 0, 0), TextSize = 18, Color = C.gold, Outline = 2 })
local bar = UI.bar(row, { Name = "XP", Size = UDim2.new(1, -176, 0, 20), Position = UDim2.fromOffset(88, 7), Color = C.goo, Corner = 10, TextSize = 12 })
local stageLabel = UI.label(holder, "", { Name = "Stage", Size = UDim2.fromOffset(460, 18), Position = UDim2.fromOffset(50, 86), TextSize = 14, Color = C.text, Outline = 2 })

local function refresh()
	local data = State.data
	local age, into, needed = AgeSystem.ageFromXP(data.ageXP)
	local stage = AgeSystem.getStage(age)
	leftLabel.Text = "AGE " .. age
	local stars = data.rebirths > 0 and ("  " .. string.rep("★", math.min(data.rebirths, 5))) or ""
	stageLabel.Text = stage.name .. stars
	if age >= AgeSystem.MaxAge then
		rightLabel.Text = "MAX"
		bar.set(1, "LEGENDARY", C.gold)
	else
		rightLabel.Text = "AGE " .. (age + 1)
		bar.set(into / needed, Util.commas(into) .. " / " .. Util.commas(needed) .. " XP", C.goo)
	end
end

State.on("ageXP", refresh)
State.on("age", refresh)
State.on("rebirths", refresh)

----------------------------------------------------------------------
-- "BRADY AGED UP!" celebration
----------------------------------------------------------------------
local overlay = UI.frame(gui, { Name = "AgeUp", Color = C.dark, Transparency = 1, Corner = false, Visible = false, ZIndex = 30 })
local card = UI.box(overlay, { Name = "Card", Size = UDim2.fromOffset(820, 420), Position = UDim2.fromScale(0.5, 0.46), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 31 })
UI.autoScale(card, "window")
local headline = UI.label(card, "BRADY AGED UP!", { Name = "Headline", Size = UDim2.new(1, 0, 0, 90), Font = UI.LoudFont, TextSize = 76, Color = C.gold, Outline = 6, ZIndex = 32 })
local ageLine = UI.label(card, "", { Name = "Age", Size = UDim2.new(1, 0, 0, 52), Position = UDim2.fromOffset(0, 92), TextSize = 42, Color = C.goo, Outline = 4, ZIndex = 32 })
local blurb = UI.label(card, "", { Name = "Blurb", Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 146), TextSize = 20, Font = UI.BodyFont, Color = C.text, Outline = 3, ZIndex = 32 })
local lines = UI.box(card, { Name = "Unlocks", Size = UDim2.new(1, 0, 0, 220), Position = UDim2.fromOffset(0, 186), ZIndex = 32 })
UI.list(lines, { pad = 4, alignX = Enum.HorizontalAlignment.Center })

local queue = {}
local playing = false

local function play(payload)
	playing = true
	UI.clear(lines)
	overlay.Visible = true
	overlay.BackgroundTransparency = 1
	UI.tween(overlay, 0.25, { BackgroundTransparency = payload.stageChanged and 0.35 or 0.6 })
	headline.Text = payload.stageChanged and "NEW ERA UNLOCKED!" or "BRADY AGED UP!"
	headline.TextColor3 = payload.stageChanged and C.pink or C.gold
	ageLine.Text = payload.stageChanged and (payload.stageName .. "  •  AGE " .. payload.age) or ("AGE " .. payload.age)
	blurb.Text = payload.stageChanged and (payload.blurb or "") or ""
	UI.pop(card, 0.3)
	-- a celebration fanfare plus a goofy voice crack
	State.sound("ageUp")
	task.delay(0.35, State.sound, "ageUpGoofy")

	for index, text in ipairs(payload.lines or {}) do
		if index > 8 then
			break
		end
		task.wait(payload.stageChanged and 0.22 or 0.1)
		local pill = UI.frame(lines, { Name = "Line", Size = UDim2.fromOffset(520, 24), Color = C.bg, Corner = 12, LayoutOrder = index, ZIndex = 32 })
		UI.label(pill, text, { TextSize = 15, Font = UI.BodyFont, Color = index == 1 and C.goo or C.text, ZIndex = 33 })
		UI.pop(pill, 0.7)
		State.sound("coin")
	end

	task.wait(payload.stageChanged and 3.2 or 1.3)
	UI.tween(overlay, 0.25, { BackgroundTransparency = 1 })
	task.wait(0.25)
	overlay.Visible = false
	playing = false
	local nextPayload = table.remove(queue, 1)
	if nextPayload then
		play(nextPayload)
	end
end

State.listen("AgeUp", function(payload)
	if type(payload) ~= "table" then
		return
	end
	if playing then
		-- Several age-ups at once: keep stage changes, drop older plain ones.
		if #queue >= 3 then
			for index, queued in ipairs(queue) do
				if not queued.stageChanged then
					table.remove(queue, index)
					break
				end
			end
		end
		table.insert(queue, payload)
	else
		task.spawn(play, payload)
	end
end)
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="ScreenGui" referent="63">
      <Properties>
        <string name="Name">BradyUI</string>
        <int name="DisplayOrder">5</int>
        <bool name="ResetOnSpawn">false</bool>
        <token name="ZIndexBehavior">1</token>
      </Properties>
      <Item class="LocalScript" referent="64">
        <Properties>
          <string name="Name">BradyUI</string>
          <string name="Source"><![CDATA[--[[
	BradyUI
	Two windows:
	  "Brady" - his status (age, mood, the four meters) and every care action
	  "Feed"  - the pantry: pick a food to feed him, or buy more

	Buttons only send requests. The server decides whether Brady is asleep,
	busy, full, out of food... and the HUD shows its answer.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = ReplicatedStorage:WaitForChild("Client")
local Modules = ReplicatedStorage:WaitForChild("Modules")
local State = require(Client:WaitForChild("ClientState"))
local UI = require(Client:WaitForChild("UI"))
local Preview = require(Client:WaitForChild("Preview"))
local AgeSystem = require(Modules:WaitForChild("AgeSystem"))
local Config = require(Modules:WaitForChild("Config"))
local FoodSystem = require(Modules:WaitForChild("FoodSystem"))

local gui = script.Parent
local C = UI.Colors

State.wait()

----------------------------------------------------------------------
-- BRADY WINDOW
----------------------------------------------------------------------
local window = UI.window(gui, { name = "Brady", title = "🧒 Brady Goo", width = 780, height = 470 })
local body = window.body

local left = UI.box(body, { Name = "Left", Size = UDim2.new(0, 250, 1, 0) })
local preview = Preview.new(left, { Size = UDim2.new(1, 0, 0, 250) })
local nameLabel = UI.label(left, "", { Name = "Stage", Size = UDim2.new(1, 0, 0, 28), Position = UDim2.fromOffset(0, 256), TextSize = 22, Color = C.goo, Outline = 2 })
local blurbLabel = UI.label(left, "", { Name = "Blurb", Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromOffset(0, 284), TextSize = 13, Font = UI.BodyFont, Color = C.sub })
local moodLabel = UI.label(left, "", { Name = "Mood", Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 326), TextSize = 16, Color = C.gold })
local rebirthButton = UI.button(left, "⭐ REBIRTH", { Name = "Rebirth", Size = UDim2.new(1, 0, 0, 38), Position = UDim2.fromOffset(0, 356), Color = C.pink, TextSize = 18 }, function()
	State.open("Rebirth")
end)

local right = UI.box(body, { Name = "Right", Size = UDim2.new(1, -266, 1, 0), Position = UDim2.fromOffset(266, 0) })

local METERS = {
	{ key = "hunger", name = "🍔 Hunger", color = C.gold },
	{ key = "clean", name = "🫧 Clean", color = C.blue },
	{ key = "energy", name = "⚡ Energy", color = C.goo },
	{ key = "fun", name = "🎮 Fun", color = C.pink },
}
local bars = {}
for index, meter in ipairs(METERS) do
	local y = (index - 1) * 32
	UI.label(right, meter.name, { Size = UDim2.fromOffset(110, 26), Position = UDim2.fromOffset(0, y), TextSize = 16, AlignX = Enum.TextXAlignment.Left })
	bars[meter.key] = UI.bar(right, { Size = UDim2.new(1, -118, 0, 22), Position = UDim2.fromOffset(116, y + 2), Color = meter.color, TextSize = 13 })
end

local actions = UI.box(right, { Name = "Actions", Size = UDim2.new(1, 0, 1, -140), Position = UDim2.fromOffset(0, 138) })
UI.grid(actions, 160, 62, 8)

local function action(order, text, color, callback)
	return UI.button(actions, text, { Name = "Action" .. order, Size = UDim2.fromOffset(160, 62), Color = color, TextSize = 17, LayoutOrder = order }, callback)
end

action(1, "🍔 Feed", C.gold, function()
	State.open("Feed")
end)
action(2, "🚿 Shower", C.blue, function()
	State.send("Care", "Shower")
end)
action(3, "💇 Brush Hair", C.blue, function()
	State.send("Care", "BrushHair")
end)
action(4, "👟 Clean Shoes", C.blue, function()
	State.send("Care", "CleanShoes")
end)
local sleepButton = action(5, "🛏️ Sleep", C.purple, function()
	State.send("Care", State.session.sleeping and "Wake" or "Sleep")
end)
action(6, "🎮 Play", C.pink, function()
	State.open("Minigame")
end)
local followButton = action(7, "🚶 Follow me", C.goo, function()
	State.send("Care", "Follow", not State.session.following)
end)
action(8, "📣 Call Brady", C.goo, function()
	State.send("Care", "Call")
end)
action(9, "🏠 Go Home", C.sub, function()
	State.send("Visit", "Home")
	State.close()
end)

local function refreshStatus()
	local data = State.data
	local stage = AgeSystem.getStage(data.age)
	nameLabel.Text = stage.name .. "  •  Age " .. data.age
	blurbLabel.Text = stage.blurb
	local mood, face = AgeSystem.moodName(data.meters)
	moodLabel.Text = string.format("%s %s  (XP x%.2f)", face, mood, AgeSystem.moodMultiplier(data.meters))
	for _, meter in ipairs(METERS) do
		local value = data.meters[meter.key]
		bars[meter.key].set(value / 100, math.floor(value + 0.5) .. " / 100", value < 20 and C.red or meter.color)
	end
	rebirthButton.Visible = data.age >= AgeSystem.MaxAge
	sleepButton.Text = State.session.sleeping and "⏰ Wake Up" or "🛏️ Sleep"
	if data.age < Config.FollowMinAge then
		followButton.Text = "🔒 Outside at age " .. Config.FollowMinAge
	else
		followButton.Text = State.session.following and "🏠 Stay home" or "🚶 Follow me"
	end
end

local function refreshPreview()
	if window.visible then
		preview.set({ age = State.data.age, equipped = State.data.equipped })
	end
end

window.onShow(function()
	refreshStatus()
	refreshPreview()
end)
State.on("meters", function()
	if window.visible then
		refreshStatus()
	end
end)
State.on("age", function()
	refreshStatus()
	refreshPreview()
end)
State.on("equipped", refreshPreview)
State.onSession("sleeping", refreshStatus)
State.onSession("following", refreshStatus)

----------------------------------------------------------------------
-- REBIRTH CONFIRMATION (a tiny window of its own)
----------------------------------------------------------------------
local rebirth = UI.window(gui, { name = "Rebirth", title = "⭐ Rebirth Brady?", width = 520, height = 330 })
UI.label(rebirth.body, "Brady goes back to being a baby.\n\nYou KEEP: every clothing item, furniture, Goo Coins, collections and gifts.\nYou LOSE: his age (and the house shrinks until he grows again).\n\nReward: +" .. math.floor(Config.RebirthBonus * 100) .. "% Goo Coins and Age XP forever, and a ★ on his nameplate.", {
	Size = UDim2.new(1, 0, 1, -64),
	TextSize = 16,
	Font = UI.BodyFont,
	Color = C.text,
})
UI.button(rebirth.body, "DO IT", { Size = UDim2.fromOffset(200, 50), Position = UDim2.new(0.5, -210, 1, -54), Color = C.pink, TextSize = 24 }, function()
	State.send("Rebirth")
	State.close()
end)
UI.button(rebirth.body, "not yet", { Size = UDim2.fromOffset(200, 50), Position = UDim2.new(0.5, 10, 1, -54), Color = C.sub, TextSize = 20 }, function()
	State.open("Brady")
end)

----------------------------------------------------------------------
-- FEED WINDOW
----------------------------------------------------------------------
local feed = UI.window(gui, { name = "Feed", title = "🍔 Feed Brady", width = 600, height = 470 })
local hungerBar = UI.bar(feed.body, { Size = UDim2.new(1, 0, 0, 22), Color = C.gold, TextSize = 13 })
local foodList = UI.scroll(feed.body, { Size = UDim2.new(1, 0, 1, -30), Position = UDim2.fromOffset(0, 30) })
UI.list(foodList, { pad = 6 })

local function refreshFeed()
	if not feed.visible then
		return
	end
	local data = State.data
	hungerBar.set(data.meters.hunger / 100, "Hunger " .. math.floor(data.meters.hunger + 0.5) .. " / 100")
	UI.clear(foodList)
	for index, food in ipairs(FoodSystem.List) do
		local owned = data.food[food.id] or 0
		local locked = data.age < (food.minAge or 1)
		local row = UI.row(foodList, { Name = "Food_" .. food.id, Size = UDim2.new(1, -12, 0, 62), LayoutOrder = index })
		UI.label(row, food.icon, { Size = UDim2.fromOffset(54, 62), TextSize = 36 })
		UI.label(row, food.name .. (food.free and "  (free)" or "  x" .. owned), { Size = UDim2.new(1, -330, 0, 26), Position = UDim2.fromOffset(58, 6), TextSize = 18, AlignX = Enum.TextXAlignment.Left })
		local stats = food.mystery and "+40 hunger, ??? XP" or ("+" .. food.hunger .. " hunger, +" .. food.xp .. " XP")
		UI.label(row, stats .. "  •  " .. food.desc, { Size = UDim2.new(1, -330, 0, 26), Position = UDim2.fromOffset(58, 32), TextSize = 12, Font = UI.BodyFont, Color = C.sub, AlignX = Enum.TextXAlignment.Left })
		if locked then
			UI.label(row, "🔒 Age " .. food.minAge, { Size = UDim2.fromOffset(250, 62), Position = UDim2.new(1, -258, 0, 0), TextSize = 18, Color = C.sub })
		else
			local canFeed = food.free or owned > 0
			local feedButton = UI.button(row, "FEED", { Size = UDim2.fromOffset(110, 44), Position = UDim2.new(1, -252, 0, 9), Color = C.goo, TextSize = 18 }, function()
				if food.free or (State.data.food[food.id] or 0) > 0 then
					State.send("Care", "Feed", food.id)
				else
					State.toast("you're out of " .. food.name .. " - buy some!", "bad")
				end
			end)
			UI.setEnabled(feedButton, canFeed)
			if not food.free then
				UI.button(row, "BUY " .. food.price, { Size = UDim2.fromOffset(124, 44), Position = UDim2.new(1, -134, 0, 9), Color = C.gold, TextSize = 16 }, function()
					local result = State.invoke("Buy", "food", food.id, 1)
					if not result.ok then
						State.toast(result.reason or "could not buy that", "bad")
					end
				end)
			end
		end
	end
end

feed.onShow(refreshFeed)
State.on("food", refreshFeed)
State.on("meters", function(meters)
	if feed.visible then
		hungerBar.set(meters.hunger / 100, "Hunger " .. math.floor(meters.hunger + 0.5) .. " / 100")
	end
end)

]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="ScreenGui" referent="65">
      <Properties>
        <string name="Name">CollectionUI</string>
        <int name="DisplayOrder">5</int>
        <bool name="ResetOnSpawn">false</bool>
        <token name="ZIndexBehavior">1</token>
      </Properties>
      <Item class="LocalScript" referent="66">
        <Properties>
          <string name="Name">CollectionUI</string>
          <string name="Source"><![CDATA[--[[
	CollectionUI
	The collection book, in four tabs:
	  * Collections   - "ARCHIVE COLLECTION 17 / 50 ITEMS" with completion
	                    percentage and a reward to claim when finished
	  * Achievements  - progress + the Goo Coins each one paid
	  * Daily Tasks   - today's three tasks
	  * Daily Reward  - the 7 day login track

	All claims are requests. The server re-checks that the collection / task
	is really complete and that it has not been claimed before.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = ReplicatedStorage:WaitForChild("Client")
local Modules = ReplicatedStorage:WaitForChild("Modules")
local State = require(Client:WaitForChild("ClientState"))
local UI = require(Client:WaitForChild("UI"))
local AchievementSystem = require(Modules:WaitForChild("AchievementSystem"))
local AgeSystem = require(Modules:WaitForChild("AgeSystem"))
local CollectionSystem = require(Modules:WaitForChild("CollectionSystem"))
local DailySystem = require(Modules:WaitForChild("DailySystem"))
local Util = require(Modules:WaitForChild("Util"))

local gui = script.Parent
local C = UI.Colors

State.wait()

local window = UI.window(gui, { name = "Collection", title = "📖 Collection Book", width = 820, height = 490 })
local body = window.body

local current = "Collections"
local refresh
local tabs = UI.tabs(body, {
	{ id = "Collections", text = "📖 Collections" },
	{ id = "Achievements", text = "🏅 Achievements" },
	{ id = "Tasks", text = "✅ Daily Tasks" },
	{ id = "Daily", text = "🎁 Daily Reward" },
}, function(id)
	current = id
	refresh()
end, { Width = 796, TextSize = 15 })

local header = UI.label(body, "", { Name = "Summary", Size = UDim2.new(1, 0, 0, 28), Position = UDim2.fromOffset(0, 44), TextSize = 17, Color = C.gold })
local list = UI.scroll(body, { Name = "List", Size = UDim2.new(1, 0, 1, -78), Position = UDim2.fromOffset(0, 76) })
local layout

local function setLayout(kind)
	if layout then
		layout:Destroy()
	end
	if kind == "grid" then
		layout = UI.grid(list, 104, 140, 8)
	else
		layout = UI.list(list, { pad = 6 })
	end
end

----------------------------------------------------------------------
local function showCollections()
	setLayout("list")
	local data = State.data
	header.Text = "TOTAL COMPLETION: " .. CollectionSystem.totalPercent(data) .. "%"
	for index, collection in ipairs(CollectionSystem.List) do
		local owned, total = CollectionSystem.progress(data, collection)
		local complete = owned >= total
		local claimed = data.collectionsClaimed[collection.id] == true
		local row = UI.row(list, { Name = "Collection_" .. collection.id, Size = UDim2.new(1, -12, 0, 70), LayoutOrder = index, StrokeColor = complete and C.goo or nil })
		UI.label(row, collection.icon, { Size = UDim2.fromOffset(56, 70), TextSize = 34 })
		UI.label(row, string.upper(collection.name), { Size = UDim2.new(1, -250, 0, 24), Position = UDim2.fromOffset(60, 5), TextSize = 17, AlignX = Enum.TextXAlignment.Left })
		local bar = UI.bar(row, { Size = UDim2.new(1, -250, 0, 18), Position = UDim2.fromOffset(60, 30), Color = complete and C.goo or C.blue, TextSize = 12 })
		bar.set(owned / math.max(1, total), string.format("%d / %d ITEMS  (%d%%)", owned, total, math.floor(owned / math.max(1, total) * 100)))
		local rewardText = "Reward: " .. Util.commas(collection.coins) .. " Goo Coins" .. (collection.title and ("  +  title \"" .. collection.title .. "\"") or "")
		UI.label(row, rewardText, { Size = UDim2.new(1, -250, 0, 18), Position = UDim2.fromOffset(60, 50), TextSize = 11, Font = UI.BodyFont, Color = C.sub, AlignX = Enum.TextXAlignment.Left })
		local button = UI.button(row, claimed and "CLAIMED ✓" or "CLAIM", { Name = "Claim", Size = UDim2.fromOffset(160, 46), Position = UDim2.new(1, -170, 0, 12), TextSize = 18 }, function()
			if complete and not claimed then
				State.send("ClaimCollection", collection.id)
			elseif not complete then
				State.toast(string.format("collect %d more to finish this", total - owned), "info")
			end
		end)
		UI.setEnabled(button, complete and not claimed)
	end
end

local function showAchievements()
	setLayout("list")
	local data = State.data
	local done = Util.count(data.achievements)
	header.Text = string.format("ACHIEVEMENTS: %d / %d", done, #AchievementSystem.List)
	-- unlocked ones first
	local sorted = table.clone(AchievementSystem.List)
	table.sort(sorted, function(a, b)
		local da, db = data.achievements[a.id] == true, data.achievements[b.id] == true
		if da ~= db then
			return db -- locked first, so the next goals are on top
		end
		return a.coins < b.coins
	end)
	for index, def in ipairs(sorted) do
		local unlocked = data.achievements[def.id] == true
		local value = math.min(AchievementSystem.value(def, data), def.goal)
		local row = UI.row(list, { Name = "Achievement_" .. def.id, Size = UDim2.new(1, -12, 0, 54), LayoutOrder = index, StrokeColor = unlocked and C.gold or nil })
		UI.label(row, unlocked and "🏅" or "🔒", { Size = UDim2.fromOffset(50, 54), TextSize = 28 })
		UI.label(row, def.name, { Size = UDim2.new(1, -330, 0, 24), Position = UDim2.fromOffset(54, 4), TextSize = 16, Color = unlocked and C.gold or C.text, AlignX = Enum.TextXAlignment.Left })
		UI.label(row, def.desc, { Size = UDim2.new(1, -330, 0, 20), Position = UDim2.fromOffset(54, 28), TextSize = 12, Font = UI.BodyFont, Color = C.sub, AlignX = Enum.TextXAlignment.Left })
		local bar = UI.bar(row, { Size = UDim2.fromOffset(150, 18), Position = UDim2.new(1, -270, 0, 18), Color = unlocked and C.gold or C.blue, TextSize = 11 })
		bar.set(value / def.goal, Util.short(value) .. " / " .. Util.short(def.goal))
		UI.label(row, "+" .. Util.short(def.coins), { Size = UDim2.fromOffset(100, 54), Position = UDim2.new(1, -108, 0, 0), TextSize = 16, Color = C.goo })
	end
end

local function showTasks()
	setLayout("list")
	local data = State.data
	header.Text = "TODAY'S TASKS  (new ones every day)"
	local multiplier = AgeSystem.rewardMultiplier(data.age, data.rebirths)
	for index, task_ in ipairs(data.daily.tasks) do
		local def = DailySystem.TaskById[task_.id]
		if def then
			local complete = task_.progress >= def.goal
			local row = UI.row(list, { Name = "Task" .. index, Size = UDim2.new(1, -12, 0, 76), LayoutOrder = index, StrokeColor = complete and C.goo or nil })
			UI.label(row, complete and "✅" or "📝", { Size = UDim2.fromOffset(56, 76), TextSize = 32 })
			UI.label(row, DailySystem.taskText(def), { Size = UDim2.new(1, -250, 0, 26), Position = UDim2.fromOffset(60, 8), TextSize = 18, AlignX = Enum.TextXAlignment.Left })
			local bar = UI.bar(row, { Size = UDim2.new(1, -250, 0, 20), Position = UDim2.fromOffset(60, 40), Color = complete and C.goo or C.blue, TextSize = 12 })
			bar.set(task_.progress / def.goal, Util.short(task_.progress) .. " / " .. Util.short(def.goal))
			local button = UI.button(row, task_.claimed and "CLAIMED ✓" or ("CLAIM\n+" .. math.floor(def.coins * multiplier + 0.5)), { Name = "Claim", Size = UDim2.fromOffset(160, 52), Position = UDim2.new(1, -170, 0, 12), TextSize = 16 }, function()
				if complete and not task_.claimed then
					State.send("ClaimTask", index)
				end
			end)
			UI.setEnabled(button, complete and not task_.claimed)
		end
	end
	if #data.daily.tasks == 0 then
		UI.label(list, "tasks are loading...", { Size = UDim2.new(1, -12, 0, 60), TextSize = 16, Font = UI.BodyFont, Color = C.sub })
	end
end

local function showDaily()
	setLayout("grid")
	local data = State.data
	local today = State.session.day or 0
	local canClaim = DailySystem.canClaim(data.daily, today)
	local nextIndex = DailySystem.nextIndex(data.daily, today)
	local streak = data.daily.streak
	if data.daily.lastClaimDay < today - 1 then
		streak = 0
	end
	header.Text = canClaim and ("DAY " .. nextIndex .. " IS READY!   streak: " .. streak) or ("come back tomorrow!   streak: " .. streak)
	for index, reward in ipairs(DailySystem.Rewards) do
		local claimedToday = not canClaim and ((streak - 1) % 7 + 1) >= index
		local isNext = canClaim and index == nextIndex
		local past = canClaim and index < nextIndex
		local tile = UI.frame(list, { Name = "Day" .. index, Size = UDim2.fromOffset(104, 140), Color = isNext and C.gold or C.panel, Corner = 14, LayoutOrder = index })
		UI.stroke(tile, 3, isNext and C.goo or C.dark)
		UI.label(tile, "DAY " .. index, { Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 6), TextSize = 16, Color = isNext and C.dark or C.sub })
		UI.label(tile, reward.icon, { Size = UDim2.new(1, 0, 0, 50), Position = UDim2.fromOffset(0, 32), TextSize = 40 })
		UI.label(tile, reward.label, { Size = UDim2.new(1, -8, 0, 36), Position = UDim2.fromOffset(4, 84), TextSize = 12, Font = UI.BodyFont, Color = isNext and C.dark or C.text })
		if claimedToday or past then
			local shade = UI.frame(tile, { Name = "Done", Color = C.dark, Transparency = 0.45, Corner = 14, ZIndex = 3 })
			UI.label(shade, "✓", { TextSize = 46, Color = C.goo, ZIndex = 4 })
		end
	end
	local button = UI.button(list, canClaim and "CLAIM!" or "tomorrow", { Name = "ClaimDaily", Size = UDim2.fromOffset(104, 140), Color = C.goo, TextSize = 22, LayoutOrder = 8 }, function()
		if DailySystem.canClaim(State.data.daily, State.session.day or 0) then
			State.send("ClaimDaily")
		else
			State.toast("you already claimed today's reward", "info")
		end
	end)
	UI.setEnabled(button, canClaim)
end

function refresh()
	if not window.visible then
		return
	end
	UI.clear(list)
	if current == "Achievements" then
		showAchievements()
	elseif current == "Tasks" then
		showTasks()
	elseif current == "Daily" then
		showDaily()
	else
		showCollections()
	end
end

window.onShow(function(arg)
	if type(arg) == "string" and tabs.buttons[arg] then
		current = arg
	end
	tabs.select(current, true)
	refresh()
end)
State.on("inventory", refresh)
State.on("achievements", refresh)
State.on("collectionsClaimed", refresh)
State.on("daily", refresh)
State.on("furniture", function()
	if current == "Collections" then
		refresh()
	end
end)
State.onSession("day", refresh)
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="ScreenGui" referent="67">
      <Properties>
        <string name="Name">DailyUI</string>
        <int name="DisplayOrder">8</int>
        <bool name="ResetOnSpawn">false</bool>
        <token name="ZIndexBehavior">1</token>
      </Properties>
      <Item class="LocalScript" referent="68">
        <Properties>
          <string name="Name">DailyUI</string>
          <string name="Source"><![CDATA[--[[
	DailyUI
	Pops the Daily Reward page open when a reward is waiting: shortly after
	joining, and again if the day rolls over while the player is online.
	(New players finish the tutorial first.)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = ReplicatedStorage:WaitForChild("Client")
local Modules = ReplicatedStorage:WaitForChild("Modules")
local State = require(Client:WaitForChild("ClientState"))
local DailySystem = require(Modules:WaitForChild("DailySystem"))

State.wait()

local offeredDay = nil

local function offer()
	local data = State.data
	local today = State.session.day
	if not today or offeredDay == today or not data.tutorialDone then
		return
	end
	if DailySystem.canClaim(data.daily, today) and State.current == nil then
		offeredDay = today
		State.open("Collection", "Daily")
		State.toast("your daily reward is ready!", "good")
	end
end

task.delay(4, offer)
State.onSession("day", function()
	task.delay(2, offer)
end)
State.on("tutorialDone", function(done)
	if done then
		task.delay(6, offer)
	end
end)
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="ScreenGui" referent="69">
      <Properties>
        <string name="Name">FashionUI</string>
        <int name="DisplayOrder">5</int>
        <bool name="ResetOnSpawn">false</bool>
        <token name="ZIndexBehavior">1</token>
      </Properties>
      <Item class="LocalScript" referent="70">
        <Properties>
          <string name="Name">FashionUI</string>
          <string name="Source"><![CDATA[--[[
	FashionUI
	The Fashion Show window. It mirrors whatever phase the server's show is
	in: countdown to the next show, sign-ups, the runway, voting and results.

	Entering and voting are requests - FashionServer enforces the age limit,
	one vote per player and "you cannot vote for your own Brady".
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Client = ReplicatedStorage:WaitForChild("Client")
local Modules = ReplicatedStorage:WaitForChild("Modules")
local State = require(Client:WaitForChild("ClientState"))
local UI = require(Client:WaitForChild("UI"))
local Config = require(Modules:WaitForChild("Config"))
local FashionSystem = require(Modules:WaitForChild("FashionSystem"))
local Util = require(Modules:WaitForChild("Util"))

local gui = script.Parent
local C = UI.Colors
local localPlayer = Players.LocalPlayer

State.wait()

local window = UI.window(gui, { name = "Fashion", title = "🌟 Fashion Show", width = 720, height = 470 })
local body = window.body

local phaseLabel = UI.label(body, "", { Name = "Phase", Size = UDim2.new(1, 0, 0, 36), TextSize = 28, Color = C.pink, Outline = 3 })
local infoLabel = UI.label(body, "", { Name = "Info", Size = UDim2.new(1, 0, 0, 44), Position = UDim2.fromOffset(0, 38), TextSize = 15, Font = UI.BodyFont, Color = C.sub })
local timerLabel = UI.label(body, "", { Name = "Timer", Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 82), TextSize = 22, Color = C.gold })
local list = UI.scroll(body, { Name = "List", Size = UDim2.new(1, 0, 1, -176), Position = UDim2.fromOffset(0, 116) })
UI.list(list, { pad = 5 })
local actions = UI.box(body, { Name = "Actions", Size = UDim2.new(1, 0, 0, 50), Position = UDim2.new(0, 0, 1, -52) })
UI.list(actions, { horizontal = true, pad = 10, alignX = Enum.HorizontalAlignment.Center })

local votedFor = nil
local lastPhase = nil

local function mine(state)
	for _, contestant in ipairs(state.contestants) do
		if contestant.userId == localPlayer.UserId then
			return contestant
		end
	end
	return nil
end

local function actionButton(text, color, callback)
	return UI.button(actions, text, { Size = UDim2.fromOffset(210, 48), Color = color, TextSize = 18 }, callback)
end

local function contestantRow(index, contestant, right, color)
	local row = UI.row(list, { Name = "Contestant" .. index, Size = UDim2.new(1, -12, 0, 44), LayoutOrder = index, StrokeColor = contestant.userId == localPlayer.UserId and C.goo or nil })
	UI.label(row, (contestant.isBot and "🤖 " or "🧒 ") .. contestant.name .. (contestant.userId == localPlayer.UserId and "  (you)" or ""), { Size = UDim2.new(1, -230, 1, 0), Position = UDim2.fromOffset(12, 0), TextSize = 17, AlignX = Enum.TextXAlignment.Left })
	if right then
		UI.label(row, right, { Size = UDim2.fromOffset(210, 44), Position = UDim2.new(1, -216, 0, 0), TextSize = 15, Font = UI.BodyFont, Color = color or C.sub, AlignX = Enum.TextXAlignment.Right })
	end
	return row
end

local function refresh()
	if not window.visible then
		return
	end
	local state = State.fashion
	UI.clear(list)
	UI.clear(actions)
	if not state then
		phaseLabel.Text = "loading..."
		infoLabel.Text = ""
		return
	end
	if state.phase ~= lastPhase then
		lastPhase = state.phase
		if state.phase == "Signup" then
			votedFor = nil
		end
	end
	local data = State.data
	local me = mine(state)

	if state.phase == "Signup" then
		phaseLabel.Text = "SIGN-UPS OPEN: " .. string.upper(state.category.name)
		infoLabel.Text = "Tip: " .. state.category.hint .. ".  Winner gets " .. Config.FashionWinCoins .. "+ Goo Coins and the title \"" .. state.category.title .. "\"."
		for index, contestant in ipairs(state.contestants) do
			contestantRow(index, contestant, "entered")
		end
		if #state.contestants == 0 then
			UI.label(list, "nobody has entered yet - be the first!", { Size = UDim2.new(1, -12, 0, 44), TextSize = 15, Font = UI.BodyFont, Color = C.sub })
		end
		if me then
			actionButton("Leave show", C.red, function()
				State.send("Fashion", "Leave")
			end).TextColor3 = C.text
		elseif data.age < Config.FashionMinAge then
			UI.setEnabled(actionButton("🔒 Age " .. Config.FashionMinAge .. " to enter", C.sub), false)
		else
			actionButton("ENTER BRADY!", C.goo, function()
				State.send("Fashion", "Join")
			end)
		end
		actionButton("Go to runway", C.blue, function()
			State.send("Visit", "Runway")
		end).TextColor3 = C.text
	elseif state.phase == "Runway" then
		phaseLabel.Text = "ON THE RUNWAY"
		infoLabel.Text = "Category: " .. state.category.name .. ".  Voting opens when everyone has walked."
		for index, contestant in ipairs(state.contestants) do
			local status = index < state.current and "walked" or (index == state.current and "WALKING NOW" or "waiting backstage")
			contestantRow(index, contestant, status, index == state.current and C.gold or C.sub)
		end
		actionButton("Watch at the runway", C.blue, function()
			State.send("Visit", "Runway")
			State.close()
		end).TextColor3 = C.text
	elseif state.phase == "Voting" then
		phaseLabel.Text = "VOTE: " .. string.upper(state.category.name)
		infoLabel.Text = "Pick the best fit. You get one vote and you can't vote for your own Brady."
		for index, contestant in ipairs(state.contestants) do
			local row = contestantRow(index, contestant)
			if contestant.userId ~= localPlayer.UserId then
				local chosen = votedFor == contestant.id
				UI.button(row, chosen and "VOTED ✓" or "VOTE", { Name = "Vote", Size = UDim2.fromOffset(130, 34), Position = UDim2.new(1, -138, 0, 5), Color = chosen and C.goo or C.pink, TextSize = 16, Corner = 10 }, function()
					votedFor = contestant.id
					State.send("Fashion", "Vote", contestant.id)
					refresh()
				end)
			end
		end
	elseif state.phase == "Results" then
		phaseLabel.Text = "RESULTS: " .. string.upper(state.category.name)
		local winner = state.results and state.results[1]
		infoLabel.Text = winner and ("🏆 " .. winner.name .. " wins and earns the title \"" .. state.category.title .. "\"!") or ""
		for index, result in ipairs(state.results or {}) do
			local mineResult = me ~= nil and result.id == me.id
			local row = UI.row(list, { Name = "Result" .. index, Size = UDim2.new(1, -12, 0, 44), LayoutOrder = index, StrokeColor = index == 1 and C.gold or (mineResult and C.goo or nil) })
			UI.label(row, (index == 1 and "🏆" or ("#" .. result.place)) .. "  " .. result.name .. (mineResult and "  (you)" or ""), { Size = UDim2.new(1, -260, 1, 0), Position = UDim2.fromOffset(12, 0), TextSize = 17, Color = index == 1 and C.gold or C.text, AlignX = Enum.TextXAlignment.Left })
			UI.label(row, string.format("score %d   •   %d vote%s", result.score, result.votes, result.votes == 1 and "" or "s"), { Size = UDim2.fromOffset(240, 44), Position = UDim2.new(1, -248, 0, 0), TextSize = 14, Font = UI.BodyFont, Color = C.sub, AlignX = Enum.TextXAlignment.Right })
		end
	else
		phaseLabel.Text = "NEXT SHOW SOON"
		infoLabel.Text = "Every few minutes a show starts with a random category. Dress Brady for it, enter, walk the runway and get votes!"
		for index, category in ipairs(FashionSystem.Categories) do
			local row = UI.row(list, { Name = "Category" .. index, Size = UDim2.new(1, -12, 0, 40), LayoutOrder = index })
			UI.label(row, category.name, { Size = UDim2.fromOffset(190, 40), Position = UDim2.fromOffset(12, 0), TextSize = 16, Color = FashionSystem.TitleColors[category.title], AlignX = Enum.TextXAlignment.Left })
			UI.label(row, category.hint .. "   •   title: " .. category.title, { Size = UDim2.new(1, -220, 1, 0), Position = UDim2.fromOffset(206, 0), TextSize = 12, Font = UI.BodyFont, Color = C.sub, AlignX = Enum.TextXAlignment.Left })
		end
		actionButton("Go to runway", C.blue, function()
			State.send("Visit", "Runway")
			State.close()
		end).TextColor3 = C.text
		actionButton("Change outfit", C.pink, function()
			State.open("Wardrobe")
		end)
	end
end

window.onShow(refresh)
State.fashionChanged:Connect(refresh)
State.on("age", refresh)

-- countdown while the window is open
task.spawn(function()
	while true do
		task.wait(0.5)
		local state = State.fashion
		if window.visible and state then
			local now = Workspace:GetServerTimeNow()
			if state.phase == "Idle" then
				timerLabel.Text = "next show in " .. Util.clock(math.max(0, (state.nextAt or 0) - now))
			else
				timerLabel.Text = Util.clock(math.max(0, (state.endsAt or 0) - now))
			end
		end
	end
end)
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="ScreenGui" referent="71">
      <Properties>
        <string name="Name">InventoryUI</string>
        <int name="DisplayOrder">5</int>
        <bool name="ResetOnSpawn">false</bool>
        <token name="ZIndexBehavior">1</token>
      </Properties>
      <Item class="LocalScript" referent="72">
        <Properties>
          <string name="Name">InventoryUI</string>
          <string name="Source"><![CDATA[--[[
	InventoryUI
	Every piece of clothing the player owns, organised into the categories
	Shirts / Pants / Shoes / Jackets / Accessories / Hats / Glasses /
	Full Outfits / Hairstyles, coloured by rarity.

	Selecting an item shows its name, rarity, required age, description and
	whether it is equipped, with an Equip / Unequip button. The button only
	sends a request: ClothingServer checks ownership and the age rule.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = ReplicatedStorage:WaitForChild("Client")
local Modules = ReplicatedStorage:WaitForChild("Modules")
local State = require(Client:WaitForChild("ClientState"))
local UI = require(Client:WaitForChild("UI"))
local ClothingSystem = require(Modules:WaitForChild("ClothingSystem"))
local InventorySystem = require(Modules:WaitForChild("InventorySystem"))

local gui = script.Parent
local C = UI.Colors

State.wait()

local window = UI.window(gui, { name = "Inventory", title = "🎒 Inventory", width = 840, height = 490 })
local body = window.body

local TABS = {
	{ id = "All", text = "All" },
	{ id = "Shirt", text = "👕 Shirts" },
	{ id = "Pants", text = "👖 Pants" },
	{ id = "Shoes", text = "👟 Shoes" },
	{ id = "Jacket", text = "🧥 Jackets" },
	{ id = "Accessory", text = "📿 Acc." },
	{ id = "Hat", text = "🧢 Hats" },
	{ id = "Glasses", text = "🕶️ Glasses" },
	{ id = "Outfit", text = "✨ Outfits" },
	{ id = "Hair", text = "💇 Hair" },
}

local currentSlot = "All"
local selectedId = nil
local refresh -- forward declaration

local tabs = UI.tabs(body, TABS, function(id)
	currentSlot = id
	refresh()
end, { Width = 816, TextSize = 12, TabHeight = 34 })

local grid = UI.scroll(body, { Name = "Grid", Size = UDim2.new(1, -262, 1, -72), Position = UDim2.fromOffset(0, 44) })
UI.grid(grid, 104, 122, 8)
UI.pad(grid, 4, 4, 12, 4)
local countLabel = UI.label(body, "", { Name = "Count", Size = UDim2.new(1, -262, 0, 22), Position = UDim2.new(0, 0, 1, -24), TextSize = 14, Font = UI.BodyFont, Color = C.sub, AlignX = Enum.TextXAlignment.Left })

-- DETAIL PANEL -----------------------------------------------------------
local detail = UI.frame(body, { Name = "Detail", Size = UDim2.new(0, 252, 1, -44), Position = UDim2.new(1, -252, 0, 44), Color = C.panel, Corner = 14 })
local swatch = UI.frame(detail, { Name = "Swatch", Size = UDim2.new(1, -24, 0, 90), Position = UDim2.fromOffset(12, 12), Color = C.panel2, Corner = 12 })
local swatchIcon = UI.label(swatch, "", { TextSize = 52 })
local swatchStroke = UI.stroke(swatch, 4, C.sub)
local nameLabel = UI.label(detail, "pick an item", { Name = "ItemName", Size = UDim2.new(1, -16, 0, 44), Position = UDim2.fromOffset(8, 106), TextSize = 19 })
local rarityLabel = UI.label(detail, "", { Name = "Rarity", Size = UDim2.new(1, -16, 0, 22), Position = UDim2.fromOffset(8, 150), TextSize = 17 })
local ageLabel = UI.label(detail, "", { Name = "Age", Size = UDim2.new(1, -16, 0, 20), Position = UDim2.fromOffset(8, 174), TextSize = 14, Font = UI.BodyFont, Color = C.sub })
local descLabel = UI.label(detail, "", { Name = "Description", Size = UDim2.new(1, -24, 0, 70), Position = UDim2.fromOffset(12, 198), TextSize = 14, Font = UI.BodyFont, Color = C.text, AlignY = Enum.TextYAlignment.Top })
local sourceLabel = UI.label(detail, "", { Name = "Source", Size = UDim2.new(1, -16, 0, 18), Position = UDim2.fromOffset(8, 270), TextSize = 12, Font = UI.BodyFont, Color = C.sub })
local statusLabel = UI.label(detail, "", { Name = "Status", Size = UDim2.new(1, -16, 0, 22), Position = UDim2.new(0, 8, 1, -84), TextSize = 15, Color = C.goo })
local equipButton = UI.button(detail, "EQUIP", { Name = "Equip", Size = UDim2.new(1, -24, 0, 46), Position = UDim2.new(0, 12, 1, -58), TextSize = 22 }, function()
	local item = selectedId and ClothingSystem.get(selectedId)
	if not item then
		return
	end
	if State.data.equipped[item.slot] == item.id then
		State.send("Unequip", item.slot)
	else
		local ok, reason = InventorySystem.canEquip(State.data, item.id)
		if ok then
			State.send("Equip", item.id)
		else
			State.toast(reason, "bad")
		end
	end
end)

local function showDetail()
	local data = State.data
	local item = selectedId and ClothingSystem.get(selectedId)
	if not item or not data.inventory[item.id] then
		selectedId = nil
		nameLabel.Text = "pick an item"
		rarityLabel.Text, ageLabel.Text, descLabel.Text, sourceLabel.Text, statusLabel.Text = "", "", "", "", ""
		swatchIcon.Text = "👆"
		swatch.BackgroundColor3 = C.panel2
		swatchStroke.Color = C.sub
		equipButton.Visible = false
		return
	end
	local color = ClothingSystem.rarityColor(item.rarity)
	swatch.BackgroundColor3 = ClothingSystem.swatch(item)
	swatchStroke.Color = color
	swatchIcon.Text = ClothingSystem.SlotInfo[item.slot].icon
	nameLabel.Text = item.name
	rarityLabel.Text = "Rarity: " .. item.rarity
	rarityLabel.TextColor3 = color
	ageLabel.Text = "Required Age: " .. item.age
	descLabel.Text = "\"" .. item.desc .. "\""
	sourceLabel.Text = "From: " .. item.source
	local equipped = data.equipped[item.slot] == item.id
	local ok, reason = InventorySystem.canEquip(data, item.id)
	equipButton.Visible = true
	if equipped then
		statusLabel.Text = "✓ EQUIPPED"
		statusLabel.TextColor3 = C.goo
		equipButton.Text = "UNEQUIP"
		UI.setEnabled(equipButton, true, C.red)
	elseif ok then
		statusLabel.Text = "not equipped"
		statusLabel.TextColor3 = C.sub
		equipButton.Text = "EQUIP"
		UI.setEnabled(equipButton, true, C.goo)
	else
		statusLabel.Text = "🔒 " .. reason
		statusLabel.TextColor3 = C.red
		equipButton.Text = "LOCKED"
		UI.setEnabled(equipButton, false)
	end
end

function refresh()
	if not window.visible then
		return
	end
	local data = State.data
	UI.clear(grid)
	local items = InventorySystem.ownedItems(data, currentSlot ~= "All" and currentSlot or nil)
	for index, item in ipairs(items) do
		local locked = nil
		if not InventorySystem.canEquip(data, item.id) then
			locked = "Age " .. math.max(item.age, 1)
		end
		UI.itemCard(grid, item, {
			LayoutOrder = index,
			equipped = data.equipped[item.slot] == item.id,
			locked = locked,
		}, function()
			selectedId = item.id
			showDetail()
		end)
	end
	local owned = InventorySystem.countOwned(data)
	countLabel.Text = string.format("%d shown  •  %d / %d items owned", #items, owned, #ClothingSystem.List)
	showDetail()
end

window.onShow(function(arg)
	if type(arg) == "string" and tabs.buttons[arg] then
		currentSlot = arg
	end
	tabs.select(currentSlot, true)
	refresh()
end)
State.on("inventory", refresh)
State.on("equipped", refresh)
State.on("age", refresh)
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="ScreenGui" referent="73">
      <Properties>
        <string name="Name">MainUI</string>
        <int name="DisplayOrder">1</int>
        <bool name="ResetOnSpawn">false</bool>
        <token name="ZIndexBehavior">1</token>
      </Properties>
      <Item class="LocalScript" referent="74">
        <Properties>
          <string name="Name">MainUI</string>
          <string name="Source"><![CDATA[--[[
	MainUI
	The always-on HUD:
	  * Goo Coins + Brady's four meters at the top of the screen
	  * the eight big menu buttons
	  * centre-screen announcements ("BRADY AGED UP!", "ARCHIVE ITEM FOUND!")
	  * small toasts and floating reward text
	  * the random-event banner and the fashion show ticker

	It never decides anything: every number shown comes from ClientState,
	which is a copy of what the server sent.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Client = ReplicatedStorage:WaitForChild("Client")
local Modules = ReplicatedStorage:WaitForChild("Modules")
local State = require(Client:WaitForChild("ClientState"))
local UI = require(Client:WaitForChild("UI"))
local ClothingSystem = require(Modules:WaitForChild("ClothingSystem"))
local FurnitureSystem = require(Modules:WaitForChild("FurnitureSystem"))
local Util = require(Modules:WaitForChild("Util"))

local gui = script.Parent
local C = UI.Colors

local data = State.wait()

----------------------------------------------------------------------
-- TOP: coins + meters
----------------------------------------------------------------------
local top = UI.box(gui, { Name = "Top", Size = UDim2.fromOffset(560, 46), Position = UDim2.new(0.5, 0, 0, 6), AnchorPoint = Vector2.new(0.5, 0) })
UI.autoScale(top, "hud")

local coinPill = UI.frame(top, { Name = "Coins", Size = UDim2.fromOffset(190, 44), Color = C.bg, Corner = 22, Stroke = 3, StrokeColor = C.goo })
local coinIcon = UI.frame(coinPill, { Name = "Icon", Size = UDim2.fromOffset(34, 34), Position = UDim2.fromOffset(5, 5), Color = C.goo, Corner = 17 })
UI.stroke(coinIcon, 2, C.gooDark)
UI.label(coinIcon, "G", { TextSize = 22, Color = C.dark })
local coinLabel = UI.label(coinPill, "0", { Name = "Amount", Size = UDim2.new(1, -52, 1, 0), Position = UDim2.fromOffset(46, 0), TextSize = 24, AlignX = Enum.TextXAlignment.Left, Outline = 2 })

local shownCoins = data.coins
State.on("coins", function(coins)
	local from = shownCoins
	shownCoins = coins
	if coins > from then
		State.sound("coin")
		UI.pop(coinPill, 1.12)
	end
	-- quick count-up so gains feel good
	task.spawn(function()
		for step = 1, 8 do
			if shownCoins ~= coins then
				return
			end
			coinLabel.Text = Util.short(from + (coins - from) * step / 8)
			task.wait(0.03)
		end
		coinLabel.Text = Util.short(coins)
	end)
end)

local METERS = {
	{ key = "hunger", icon = "🍔", color = C.gold },
	{ key = "clean", icon = "🫧", color = C.blue },
	{ key = "energy", icon = "⚡", color = C.goo },
	{ key = "fun", icon = "🎮", color = C.pink },
}
local meterBars = {}
for index, meter in ipairs(METERS) do
	local chip = UI.new("TextButton", {
		Name = "Meter_" .. meter.key,
		Size = UDim2.fromOffset(84, 44),
		Position = UDim2.fromOffset(198 + (index - 1) * 90, 0),
		BackgroundColor3 = C.bg,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
		Parent = top,
	})
	UI.corner(chip, 14)
	UI.stroke(chip, 3, C.dark)
	UI.label(chip, meter.icon, { Size = UDim2.fromOffset(30, 44), Position = UDim2.fromOffset(2, 0), TextSize = 22 })
	local bar = UI.bar(chip, { Size = UDim2.fromOffset(44, 16), Position = UDim2.fromOffset(34, 14), Color = meter.color, Corner = 6, TextSize = 11 })
	meterBars[meter.key] = bar
	chip.Activated:Connect(function()
		State.sound("click")
		State.toggle("Brady")
	end)
end

State.on("meters", function(meters)
	for _, meter in ipairs(METERS) do
		local value = meters[meter.key]
		meterBars[meter.key].set(value / 100, tostring(math.floor(value + 0.5)), value < 20 and C.red or meter.color)
	end
end)

----------------------------------------------------------------------
-- MAIN BUTTONS
----------------------------------------------------------------------
local BUTTONS = {
	{ panel = "Brady", icon = "🧒", text = "Brady", color = C.goo },
	{ panel = "Wardrobe", icon = "👕", text = "Wardrobe", color = C.pink },
	{ panel = "Inventory", icon = "🎒", text = "Inventory", color = C.blue },
	{ panel = "Shop", icon = "🛒", text = "Shop", color = C.gold },
	{ panel = "Room", icon = "🏠", text = "Room", color = C.purple },
	{ panel = "Collection", icon = "📖", text = "Collection", color = C.red },
	{ panel = "Fashion", icon = "🌟", text = "Fashion Show", color = C.pink },
	{ panel = "Settings", icon = "⚙️", text = "Settings", color = C.sub },
}

local menu = UI.box(gui, { Name = "Menu", Size = UDim2.fromOffset(158, 316), Position = UDim2.new(0, 8, 0.5, 10), AnchorPoint = Vector2.new(0, 0.5) })
UI.autoScale(menu, "hud")
UI.grid(menu, 74, 74, 5)
local menuButtons = {}
for index, def in ipairs(BUTTONS) do
	local button = UI.button(menu, "", { Name = def.panel, Size = UDim2.fromOffset(74, 74), Color = def.color, LayoutOrder = index, Corner = 16 }, function()
		State.toggle(def.panel)
	end)
	UI.label(button, def.icon, { Size = UDim2.new(1, 0, 0, 44), Position = UDim2.fromOffset(0, 4), TextSize = 32 })
	UI.label(button, def.text, { Size = UDim2.new(1, -4, 0, 24), Position = UDim2.new(0, 2, 1, -26), TextSize = 12, Color = C.dark })
	menuButtons[def.panel] = button
end

-- A red dot on a menu button when something is waiting there.
local function setBadge(panel, visible)
	local button = menuButtons[panel]
	local badge = button:FindFirstChild("Badge")
	if visible and not badge then
		badge = UI.frame(button, { Name = "Badge", Size = UDim2.fromOffset(20, 20), Position = UDim2.new(1, -2, 0, 2), AnchorPoint = Vector2.new(1, 0), Color = C.red, Corner = 10, ZIndex = 5 })
		UI.stroke(badge, 2, C.dark)
		UI.label(badge, "!", { TextSize = 14, ZIndex = 6 })
	elseif not visible and badge then
		badge:Destroy()
	end
end

----------------------------------------------------------------------
-- CENTRE ANNOUNCEMENTS
----------------------------------------------------------------------
local KIND_COLORS = {
	good = C.goo,
	bad = C.red,
	rare = C.blue,
	archive = ClothingSystem.rarityColor("Archive"),
	grail = ClothingSystem.rarityColor("Grail"),
	event = C.gold,
	info = C.text,
	legendary = ClothingSystem.rarityColor("Legendary"),
}

local center = UI.box(gui, { Name = "Announcements", Size = UDim2.fromOffset(900, 150), Position = UDim2.fromScale(0.5, 0.26), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 20 })
UI.autoScale(center, "hud")
local bigText = UI.label(center, "", { Name = "Big", Size = UDim2.new(1, 0, 0, 84), Font = UI.LoudFont, TextSize = 60, Outline = 5, ZIndex = 21 })
local subText = UI.label(center, "", { Name = "Sub", Size = UDim2.new(1, 0, 0, 44), Position = UDim2.fromOffset(0, 88), Font = UI.BodyFont, TextSize = 24, Outline = 3, ZIndex = 21 })
bigText.Visible, subText.Visible = false, false

local queue = {}
local showing = false

local function showNext()
	if showing then
		return
	end
	local payload = table.remove(queue, 1)
	if not payload then
		return
	end
	showing = true
	bigText.Text = payload.text or ""
	bigText.TextColor3 = KIND_COLORS[payload.kind] or C.text
	bigText.TextSize = payload.big and 68 or 54
	subText.Text = payload.sub or ""
	bigText.Visible, subText.Visible = true, true
	bigText.TextTransparency, subText.TextTransparency = 0, 0
	UI.pop(center, 0.4)
	State.sound(payload.sound or "notify")
	task.delay(payload.big and 3.2 or 2.4, function()
		UI.tween(bigText, 0.3, { TextTransparency = 1 })
		UI.tween(subText, 0.3, { TextTransparency = 1 })
		task.wait(0.32)
		bigText.Visible, subText.Visible = false, false
		showing = false
		showNext()
	end)
end

local function announce(payload)
	if #queue >= 6 then
		table.remove(queue, 1) -- never let a backlog build up
	end
	table.insert(queue, payload)
	showNext()
end

----------------------------------------------------------------------
-- TOASTS + floating reward text
----------------------------------------------------------------------
local toasts = UI.box(gui, { Name = "Toasts", Size = UDim2.fromOffset(600, 150), Position = UDim2.new(0.5, 0, 1, -110), AnchorPoint = Vector2.new(0.5, 1) })
UI.autoScale(toasts, "hud")
UI.list(toasts, { pad = 6, alignX = Enum.HorizontalAlignment.Center, alignY = Enum.VerticalAlignment.Bottom })
local toastOrder = 0

local function toast(text, kind)
	toastOrder += 1
	local existing = {}
	for _, child in ipairs(toasts:GetChildren()) do
		if child:IsA("Frame") then
			table.insert(existing, child)
		end
	end
	if #existing >= 3 then
		table.sort(existing, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		existing[1]:Destroy()
	end
	local pill = UI.frame(toasts, { Name = "Toast", Size = UDim2.fromOffset(math.clamp(#text * 11 + 50, 220, 600), 40), Color = C.bg, Corner = 20, Stroke = 3, StrokeColor = KIND_COLORS[kind] or C.sub, LayoutOrder = toastOrder })
	UI.label(pill, text, { TextSize = 17, Font = UI.BodyFont, Color = KIND_COLORS[kind] or C.text })
	UI.pop(pill, 0.8)
	if kind == "bad" then
		State.sound("error")
	end
	task.delay(2.6, function()
		if pill.Parent then
			pill:Destroy()
		end
	end)
end

local rewards = UI.box(gui, { Name = "Rewards", Size = UDim2.fromOffset(500, 60), Position = UDim2.fromScale(0.5, 0.62), AnchorPoint = Vector2.new(0.5, 0.5) })
UI.autoScale(rewards, "hud")

local function floatReward(payload)
	local parts = {}
	if payload.text then
		table.insert(parts, payload.text)
	end
	if payload.xp and payload.xp > 0 then
		table.insert(parts, "+" .. payload.xp .. " XP")
	end
	if payload.coins and payload.coins > 0 then
		table.insert(parts, "+" .. payload.coins .. " coins")
	end
	if #parts == 0 then
		return
	end
	local label = UI.label(rewards, table.concat(parts, "   "), { Name = "Reward", TextSize = 30, Color = C.goo, Outline = 4 })
	label.Position = UDim2.fromOffset(math.random(-40, 40), 0)
	UI.tween(label, 1.3, { Position = UDim2.fromOffset(label.Position.X.Offset, -90), TextTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	task.delay(1.35, function()
		label:Destroy()
	end)
end

-- Turns an item grant into the right announcement.
local function announceItem(payload)
	if payload.kind == "furniture" then
		local def = FurnitureSystem.get(payload.id)
		toast("New room item: " .. (def and def.name or payload.id), "good")
		return
	end
	local item = ClothingSystem.get(payload.id or payload.item)
	if not item then
		return
	end
	if payload.isNew == false then
		toast("Duplicate " .. item.name .. "  ->  +" .. tostring(payload.refund or 0) .. " Goo Coins", "info")
		return
	end
	local sub = item.name .. "  •  " .. item.rarity
	if item.rarity == "Grail" then
		announce({ text = "GRAIL FOUND!", sub = sub, kind = "grail", sound = "grail", big = true })
	elseif item.rarity == "Archive" then
		announce({ text = "ARCHIVE ITEM FOUND!", sub = sub, kind = "archive", sound = "rare", big = true })
	elseif item.rarity == "Legendary" then
		announce({ text = "LEGENDARY PIECE!", sub = sub, kind = "legendary", sound = "rare" })
	else
		announce({ text = "NEW FIT UNLOCKED!", sub = sub, kind = "good", sound = "item" })
	end
end

State.notified:Connect(function(payload)
	if type(payload) ~= "table" then
		return
	end
	if payload.item then
		announceItem(payload)
	elseif payload.toast then
		toast(tostring(payload.text or ""), payload.kind)
	else
		announce(payload)
	end
end)

State.listen("ItemGranted", announceItem)
State.listen("Effect", function(kind, payload)
	if kind == "Reward" and type(payload) == "table" then
		floatReward(payload)
	elseif kind == "Sound" and type(payload) == "table" then
		State.sound(payload.name)
	end
end)

----------------------------------------------------------------------
-- STATUS STRIP: fashion show ticker + random event banner + obby timer
----------------------------------------------------------------------
local strip = UI.box(gui, { Name = "Status", Size = UDim2.fromOffset(560, 190), Position = UDim2.new(0.5, 0, 0, 6), AnchorPoint = Vector2.new(0.5, 0) })
UI.autoScale(strip, "hud")

local ticker = UI.button(strip, "", { Name = "FashionTicker", Size = UDim2.fromOffset(360, 30), Position = UDim2.fromOffset(100, 100), Color = C.bg, TextColor = C.text, TextSize = 15, Corner = 15, Font = UI.BodyFont }, function()
	State.open("Fashion")
end)

local banner = UI.frame(strip, { Name = "EventBanner", Size = UDim2.fromOffset(560, 100), Position = UDim2.fromOffset(0, 136), Color = C.bg, Corner = 16, Stroke = 4, StrokeColor = C.gold, Visible = false })
local bannerTitle = UI.label(banner, "", { Name = "Title", Size = UDim2.new(1, -150, 0, 30), Position = UDim2.fromOffset(12, 6), TextSize = 22, Color = C.gold, AlignX = Enum.TextXAlignment.Left, Outline = 2 })
local bannerDesc = UI.label(banner, "", { Name = "Desc", Size = UDim2.new(1, -150, 0, 36), Position = UDim2.fromOffset(12, 36), TextSize = 14, Font = UI.BodyFont, Color = C.sub, AlignX = Enum.TextXAlignment.Left })
local bannerTimer = UI.bar(banner, { Name = "Timer", Size = UDim2.new(1, -24, 0, 14), Position = UDim2.new(0, 12, 1, -22), Color = C.gold, Corner = 6, TextSize = 11 })
local bannerButtons = UI.box(banner, { Name = "Buttons", Size = UDim2.fromOffset(134, 62), Position = UDim2.new(1, -142, 0, 8) })
UI.list(bannerButtons, { pad = 4 })

local eventTotal = 60

local function eventButton(text, color, callback)
	return UI.button(bannerButtons, text, { Size = UDim2.fromOffset(134, 29), TextSize = 15, Color = color or C.goo, Corner = 10 }, callback)
end

local function refreshEvent(event)
	UI.clear(bannerButtons)
	if not event then
		banner.Visible = false
		return
	end
	local wasVisible = banner.Visible
	banner.Visible = true
	bannerTitle.Text = event.title
	bannerDesc.Text = event.desc
	eventTotal = math.max(1, event.endsAt - Workspace:GetServerTimeNow())
	if not wasVisible then
		UI.pop(banner, 0.8)
	end
	if event.task == "hype" then
		local button = eventButton("HYPE! " .. event.progress .. "/" .. event.goal, C.pink, function(self)
			UI.pop(self, 1.15)
			State.sound("hype")
			State.send("EventAction", "Hype")
		end)
		button.Size = UDim2.fromOffset(134, 60)
		button.TextSize = 20
	elseif event.task == "haircut" and not event.choice then
		eventButton("KEEP IT", C.goo, function()
			State.send("EventAction", "Keep")
		end)
		eventButton("FIX IT", C.red, function()
			State.send("EventAction", "Fix")
		end)
	elseif event.task == "haircut" then
		eventButton("Brush Hair", C.blue, function()
			State.send("Care", "BrushHair")
		end)
	elseif event.task == "changeFit" then
		eventButton("Wardrobe (" .. event.progress .. "/" .. event.goal .. ")", C.pink, function()
			State.open("Wardrobe")
		end).Size = UDim2.fromOffset(134, 60)
	elseif event.task == "feed" then
		eventButton("Feed him!", C.gold, function()
			State.open("Feed")
		end).Size = UDim2.fromOffset(134, 60)
	elseif event.task == "goPark" then
		eventButton("Where's the park?", C.goo, function()
			State.toast("the park is north-east of the plaza - follow the signs!", "info")
		end).Size = UDim2.fromOffset(134, 60)
	else
		eventButton("Go Home", C.goo, function()
			State.send("Visit", "Home")
		end).Size = UDim2.fromOffset(134, 60)
	end
end
State.eventChanged:Connect(refreshEvent)

-- Obby timer pill
local obbyPill = UI.frame(strip, { Name = "Obby", Size = UDim2.fromOffset(220, 34), Position = UDim2.fromOffset(170, 100), Color = C.goo, Corner = 17, Stroke = 3, Visible = false })
local obbyLabel = UI.label(obbyPill, "", { TextSize = 18, Color = C.dark })
local obbyStart

State.listen("ObbyState", function(state)
	if state.running then
		if state.startedAt then
			obbyStart = state.startedAt
		end
		obbyPill.Visible = true
		ticker.Visible = false
		if state.checkpoint then
			toast("Checkpoint " .. state.checkpoint .. "/" .. (state.total or 2) .. "!", "good")
			State.sound("good")
		end
	else
		obbyPill.Visible = false
		ticker.Visible = true
		obbyStart = nil
		if state.result then
			announce({ text = "OBBY COMPLETE!", sub = string.format("%.1fs   +%d Goo Coins   +%d XP", state.result.time, state.result.coins, state.result.xp), kind = "good", sound = "rare" })
		elseif state.timeout then
			toast("obby timed out - step on START to try again", "bad")
		end
	end
end)

local function fashionText(state, now)
	if not state then
		return "🌟 Fashion Show"
	end
	local remaining = Util.clock(math.max(0, (state.endsAt or 0) - now))
	if state.phase == "Signup" then
		return "🌟 SIGN-UPS OPEN • " .. state.category.name .. " • " .. remaining .. " • tap to enter"
	elseif state.phase == "Runway" then
		local current = state.contestants[state.current]
		return "🌟 On the runway: " .. (current and current.name or "...")
	elseif state.phase == "Voting" then
		return "🗳️ VOTE NOW • " .. state.category.name .. " • " .. remaining
	elseif state.phase == "Results" then
		local winner = state.results and state.results[1]
		return "🏆 Winner: " .. (winner and winner.name or "?")
	end
	return "🌟 Next fashion show in " .. Util.clock(math.max(0, (state.nextAt or 0) - now))
end

State.fashionChanged:Connect(function(state)
	local live = state.phase == "Signup" or state.phase == "Voting"
	ticker.BackgroundColor3 = live and C.gold or C.bg
	ticker.TextColor3 = live and C.dark or C.text
	setBadge("Fashion", live)
	if state.phase == "Voting" then
		State.open("Fashion")
	end
end)

-- One light loop drives every on-screen countdown.
task.spawn(function()
	while true do
		local now = Workspace:GetServerTimeNow()
		ticker.Text = fashionText(State.fashion, now)
		local event = State.event
		if event and banner.Visible then
			local remaining = math.max(0, event.endsAt - now)
			bannerTimer.set(remaining / eventTotal, Util.clock(remaining), remaining < 10 and C.red or C.gold)
		end
		if obbyStart then
			obbyLabel.Text = string.format("🏃 %.1fs", now - obbyStart)
		end
		task.wait(obbyStart and 0.1 or 0.5)
	end
end)

----------------------------------------------------------------------
-- Badges: things waiting for the player
----------------------------------------------------------------------
local DailySystem = require(Modules:WaitForChild("DailySystem"))

local function refreshBadges()
	local daily = State.data.daily
	local today = State.session.day or 0
	local waiting = DailySystem.canClaim(daily, today)
	for _, task_ in ipairs(daily.tasks) do
		local def = DailySystem.TaskById[task_.id]
		if def and not task_.claimed and task_.progress >= def.goal then
			waiting = true
		end
	end
	setBadge("Collection", waiting)
end
State.on("daily", refreshBadges)
State.onSession("day", refreshBadges)

State.on("meters", function(meters)
	setBadge("Brady", meters.hunger < 20 or meters.clean < 20 or meters.energy < 20 or meters.fun < 20)
end)
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="ScreenGui" referent="75">
      <Properties>
        <string name="Name">MinigameUI</string>
        <int name="DisplayOrder">20</int>
        <bool name="ResetOnSpawn">false</bool>
        <token name="ZIndexBehavior">1</token>
      </Properties>
      <Item class="LocalScript" referent="76">
        <Properties>
          <string name="Name">MinigameUI</string>
          <string name="Source"><![CDATA[--[[
	MinigameUI
	"Play with Brady": the game picker plus five little UI mini-games.

	    Catch the Ball   drag Brady left/right, catch balls, dodge socks
	    Click the Target tap targets before they vanish
	    Reaction Test    wait for green, tap fast (5 rounds)
	    Goo Soccer       time 5 penalty kicks past the goalie
	    Dance Battle     hit the falling arrows on the line

	(The sixth game, the Goo Obby, is a physical course in the mini-game area.)

	A round is started and finished through the server. The score computed
	here is only a claim: MinigameServer clamps it, checks the round lasted a
	believable time and works out the reward itself.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Client = ReplicatedStorage:WaitForChild("Client")
local Modules = ReplicatedStorage:WaitForChild("Modules")
local State = require(Client:WaitForChild("ClientState"))
local UI = require(Client:WaitForChild("UI"))
local Config = require(Modules:WaitForChild("Config"))
local MinigameSystem = require(Modules:WaitForChild("MinigameSystem"))

local gui = script.Parent
local C = UI.Colors

State.wait()

----------------------------------------------------------------------
-- Picker window
----------------------------------------------------------------------
local window = UI.window(gui, { name = "Minigame", title = "🎮 Play with Brady", width = 700, height = 470 })
local energyBar = UI.bar(window.body, { Size = UDim2.new(1, 0, 0, 22), Color = C.goo, TextSize = 13 })
local picker = UI.scroll(window.body, { Name = "Games", Size = UDim2.new(1, 0, 1, -30), Position = UDim2.fromOffset(0, 30) })
UI.list(picker, { pad = 6 })

----------------------------------------------------------------------
-- Game overlay
----------------------------------------------------------------------
local overlay = UI.frame(gui, { Name = "GameOverlay", Color = C.dark, Transparency = 0.25, Corner = false, Visible = false, ZIndex = 10 })
overlay.Active = true
local stage = UI.frame(overlay, { Name = "Stage", Size = UDim2.fromOffset(680, 470), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Color = C.bg, Corner = 22, ZIndex = 11 })
UI.stroke(stage, 4, C.pink)
UI.autoScale(stage, "window")
local gameTitle = UI.label(stage, "", { Name = "Title", Size = UDim2.new(1, -260, 0, 34), Position = UDim2.fromOffset(16, 6), TextSize = 22, AlignX = Enum.TextXAlignment.Left, ZIndex = 12 })
local scoreLabel = UI.label(stage, "0", { Name = "Score", Size = UDim2.fromOffset(150, 34), Position = UDim2.new(1, -250, 0, 6), TextSize = 22, Color = C.gold, ZIndex = 12 })
local timeBar = UI.bar(stage, { Name = "Time", Size = UDim2.new(1, -32, 0, 10), Position = UDim2.fromOffset(16, 44), Color = C.pink, Corner = 5 })
local arena = UI.frame(stage, { Name = "Arena", Size = UDim2.new(1, -32, 1, -76), Position = UDim2.fromOffset(16, 60), Color = C.panel, Corner = 16, Clips = true, ZIndex = 12 })
local message = UI.label(stage, "", { Name = "Message", Size = UDim2.new(1, 0, 0, 70), Position = UDim2.new(0, 0, 0.5, -35), Font = UI.LoudFont, TextSize = 52, Outline = 5, ZIndex = 30 })
message.Visible = false

local playing = false
local cancelled = false

UI.button(stage, "Quit", { Name = "Quit", Size = UDim2.fromOffset(84, 32), Position = UDim2.new(1, -94, 0, 7), Color = C.red, TextColor = C.text, TextSize = 15, Corner = 10, ZIndex = 13 }, function()
	cancelled = true
end)

local results = UI.frame(stage, { Name = "Results", Size = UDim2.fromOffset(420, 280), Position = UDim2.fromScale(0.5, 0.52), AnchorPoint = Vector2.new(0.5, 0.5), Color = C.bg, Corner = 20, Visible = false, ZIndex = 40 })
UI.stroke(results, 4, C.gold)
local resultTitle = UI.label(results, "", { Name = "Title", Size = UDim2.new(1, 0, 0, 56), Position = UDim2.fromOffset(0, 10), Font = UI.LoudFont, TextSize = 40, Color = C.gold, Outline = 4, ZIndex = 41 })
local resultScore = UI.label(results, "", { Name = "Score", Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 72), TextSize = 22, ZIndex = 41 })
local resultReward = UI.label(results, "", { Name = "Reward", Size = UDim2.new(1, 0, 0, 56), Position = UDim2.fromOffset(0, 106), TextSize = 20, Color = C.goo, ZIndex = 41 })
local resultButtons = UI.box(results, { Name = "Buttons", Size = UDim2.new(1, -24, 0, 50), Position = UDim2.new(0, 12, 1, -62), ZIndex = 41 })
UI.list(resultButtons, { horizontal = true, pad = 10, alignX = Enum.HorizontalAlignment.Center })

local function flashMessage(text, color, seconds)
	message.Text = text
	message.TextColor3 = color or C.text
	message.Visible = true
	UI.pop(message, 0.5)
	task.delay(seconds or 0.6, function()
		if message.Text == text then
			message.Visible = false
		end
	end)
end

-- Runs fn(dt, elapsed) every frame for `duration` seconds (or until it
-- returns true / the player quits).
local function frames(duration, fn)
	local elapsed = 0
	while elapsed < duration and not cancelled do
		local dt = math.min(RunService.RenderStepped:Wait(), 0.1)
		elapsed += dt
		timeBar.set(1 - elapsed / duration)
		if fn(dt, elapsed) then
			break
		end
	end
end

local function setScore(score, max)
	scoreLabel.Text = "score " .. math.floor(score) .. (max and (" / " .. max) or "")
end

-- Horizontal pointer position inside the arena, 0..1.
local function pointerX(input)
	local left = arena.AbsolutePosition.X
	local width = math.max(1, arena.AbsoluteSize.X)
	return math.clamp((input.Position.X - left) / width, 0, 1)
end

local function piece(text, size, zindex)
	local label = UI.label(arena, text, { Size = UDim2.fromOffset(size, size), AnchorPoint = Vector2.new(0.5, 0.5), TextSize = math.floor(size * 0.8), ZIndex = zindex or 14 })
	return label
end

----------------------------------------------------------------------
-- THE GAMES: each returns the final score
----------------------------------------------------------------------
local GAMES = {}

function GAMES.catch(def)
	local x = 0.5
	local basket = piece("🧒", 72, 16)
	local connections = {
		UserInputService.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
				x = pointerX(input)
			end
		end),
		UserInputService.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
				x = pointerX(input)
			end
		end),
	}
	local items = {}
	local score, spawnIn = 0, 0.4
	frames(def.duration, function(dt, elapsed)
		spawnIn -= dt
		if spawnIn <= 0 then
			spawnIn = math.max(0.5, 0.9 - elapsed * 0.02)
			local good = math.random() < 0.8
			table.insert(items, { label = piece(good and "⚾" or "🧦", 44), x = 0.08 + math.random() * 0.84, y = -0.06, speed = 0.5 + elapsed * 0.02, good = good })
		end
		basket.Position = UDim2.new(x, 0, 0.9, 0)
		for index = #items, 1, -1 do
			local item = items[index]
			item.y += item.speed * dt
			item.label.Position = UDim2.fromScale(item.x, item.y)
			local caught = item.y > 0.8 and item.y < 0.97 and math.abs(item.x - x) < 0.09
			if caught or item.y > 1.08 then
				if caught then
					score = math.max(0, score + (item.good and 1 or -1))
					State.sound(item.good and "good" or "bad")
					UI.pop(basket, item.good and 1.25 or 0.7)
				end
				item.label:Destroy()
				table.remove(items, index)
			end
		end
		setScore(score, def.maxScore)
	end)
	for _, connection in ipairs(connections) do
		connection:Disconnect()
	end
	return math.min(score, def.maxScore)
end

function GAMES.target(def)
	local score, spawnIn = 0, 0.3
	frames(def.duration, function(dt, elapsed)
		spawnIn -= dt
		if spawnIn <= 0 then
			spawnIn = math.max(0.45, 0.78 - elapsed * 0.012)
			local size = math.floor(math.max(54, 76 - elapsed))
			local target = UI.new("TextButton", {
				Name = "Target",
				Size = UDim2.fromOffset(size, size),
				Position = UDim2.fromScale(0.1 + math.random() * 0.8, 0.14 + math.random() * 0.72),
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundTransparency = 1,
				Text = "🎯",
				TextSize = math.floor(size * 0.85),
				ZIndex = 15,
				Parent = arena,
			})
			local alive = true
			target.Activated:Connect(function()
				if alive then
					alive = false
					score += 1
					State.sound("good")
					setScore(score, def.maxScore)
					target:Destroy()
				end
			end)
			task.delay(math.max(0.8, 1.2 - elapsed * 0.015), function()
				if alive then
					alive = false
					target:Destroy()
				end
			end)
		end
		setScore(score, def.maxScore)
	end)
	return math.min(score, def.maxScore)
end

function GAMES.reaction(def)
	local pad = UI.new("TextButton", {
		Name = "Pad",
		Size = UDim2.new(1, -40, 1, -40),
		Position = UDim2.fromOffset(20, 20),
		BackgroundColor3 = C.red,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Font = UI.LoudFont,
		Text = "WAIT...",
		TextSize = 60,
		TextColor3 = C.text,
		ZIndex = 15,
		Parent = arena,
	})
	UI.corner(pad, 18)
	local rounds, total = 5, 0
	for round = 1, rounds do
		if cancelled then
			break
		end
		pad.BackgroundColor3 = C.red
		pad.Text = "WAIT...  (" .. round .. "/" .. rounds .. ")"
		local phase, tappedAt, early = "wait", nil, false
		local connection = pad.Activated:Connect(function()
			if phase == "wait" then
				early = true
			elseif phase == "go" and not tappedAt then
				tappedAt = os.clock()
			end
		end)
		local waitFor = 1 + math.random() * 2.2
		local start = os.clock()
		while os.clock() - start < waitFor and not early and not cancelled do
			RunService.RenderStepped:Wait()
		end
		local roundScore = 0
		if early then
			pad.Text = "TOO EARLY! 😬"
			State.sound("bad")
		elseif not cancelled then
			phase = "go"
			pad.BackgroundColor3 = C.goo
			pad.Text = "TAP!!!"
			State.sound("notify")
			local goAt = os.clock()
			while not tappedAt and os.clock() - goAt < 2 and not cancelled do
				RunService.RenderStepped:Wait()
			end
			local ms = tappedAt and (tappedAt - goAt) * 1000 or 2000
			-- 180 ms or faster = 100 points, 600 ms = 0 points
			roundScore = math.clamp(100 - (ms - 180) / 4.2, 0, 100)
			pad.Text = tappedAt and string.format("%d ms", ms) or "too slow!"
		end
		connection:Disconnect()
		total += roundScore
		setScore(total / round, def.maxScore)
		timeBar.set(1 - round / rounds)
		local pause = os.clock()
		while os.clock() - pause < 0.8 and not cancelled do
			RunService.RenderStepped:Wait()
		end
	end
	return math.floor(total / rounds)
end

function GAMES.soccer(def)
	local goal = UI.frame(arena, { Name = "Goal", Size = UDim2.fromScale(0.86, 0.42), Position = UDim2.fromScale(0.07, 0.06), Color = C.panel2, Corner = 10, ZIndex = 13 })
	UI.stroke(goal, 5, C.text)
	local goalie = piece("🧤", 70, 16)
	local ball = piece("⚽", 50, 17)
	local shoot = UI.button(arena, "SHOOT!", { Name = "Shoot", Size = UDim2.fromOffset(240, 60), Position = UDim2.new(0.5, -120, 1, -72), Color = C.goo, TextSize = 28, ZIndex = 18 })
	local score = 0
	for shot = 1, def.maxScore do
		if cancelled then
			break
		end
		local taken = false
		local connection = shoot.Activated:Connect(function()
			taken = true
		end)
		local t, phase = 0, math.random() * 6
		local goalieX, aimX = 0.5, 0.5
		while not taken and t < 6 and not cancelled do
			local dt = math.min(RunService.RenderStepped:Wait(), 0.1)
			t += dt
			goalieX = 0.5 + 0.33 * math.sin(t * (1.7 + shot * 0.35) + phase)
			aimX = 0.5 + 0.38 * math.sin(t * (2.4 + shot * 0.3))
			goalie.Position = UDim2.fromScale(goalieX, 0.3)
			ball.Position = UDim2.fromScale(aimX, 0.7)
			timeBar.set(1 - (shot - 1 + t / 6) / def.maxScore)
		end
		connection:Disconnect()
		if cancelled then
			break
		end
		local saved = math.abs(aimX - goalieX) < 0.14
		UI.tween(ball, 0.3, { Position = UDim2.fromScale(aimX, 0.28) })
		State.sound("jump")
		task.wait(0.32)
		if taken and not saved then
			score += 1
			flashMessage("GOAL!", C.goo)
			State.sound("good")
		else
			flashMessage(taken and "SAVED!" or "TOO SLOW!", C.red)
			State.sound("bad")
		end
		setScore(score, def.maxScore)
		task.wait(0.7)
	end
	return score
end

function GAMES.dance(def)
	local LANES = { "←", "↓", "↑", "→" }
	local KEYS = {
		[Enum.KeyCode.Left] = 1, [Enum.KeyCode.Down] = 2, [Enum.KeyCode.Up] = 3, [Enum.KeyCode.Right] = 4,
		[Enum.KeyCode.A] = 1, [Enum.KeyCode.S] = 2, [Enum.KeyCode.W] = 3, [Enum.KeyCode.D] = 4,
	}
	local HIT_Y = 0.74
	local laneColors = { C.pink, C.blue, C.goo, C.gold }
	UI.frame(arena, { Name = "HitLine", Size = UDim2.new(1, 0, 0, 6), Position = UDim2.fromScale(0, HIT_Y), Color = C.text, Corner = false, ZIndex = 13 })
	local arrows = {}
	local score = 0
	local function press(lane)
		local best, bestIndex
		for index, arrow in ipairs(arrows) do
			if arrow.lane == lane and math.abs(arrow.y - HIT_Y) < 0.1 and (not best or math.abs(arrow.y - HIT_Y) < math.abs(best.y - HIT_Y)) then
				best, bestIndex = arrow, index
			end
		end
		if best then
			score += 1
			best.label:Destroy()
			table.remove(arrows, bestIndex)
			State.sound("good")
			flashMessage("NICE!", laneColors[lane], 0.25)
		else
			State.sound("bad")
		end
		setScore(score, def.maxScore)
	end
	for lane = 1, 4 do
		UI.button(arena, LANES[lane], { Name = "Lane" .. lane, Size = UDim2.new(0.25, -8, 0, 64), Position = UDim2.new((lane - 1) * 0.25, 4, 1, -70), Color = laneColors[lane], TextSize = 36, ZIndex = 18, Silent = true }, function()
			press(lane)
		end)
	end
	local connection = UserInputService.InputBegan:Connect(function(input)
		local lane = KEYS[input.KeyCode]
		if lane then
			press(lane)
		end
	end)
	local spawned, spawnIn = 0, 0.6
	frames(def.duration, function(dt)
		spawnIn -= dt
		if spawnIn <= 0 and spawned < def.maxScore then
			spawnIn = 0.72
			spawned += 1
			local lane = math.random(1, 4)
			local label = piece(LANES[lane], 54, 15)
			label.TextColor3 = laneColors[lane]
			table.insert(arrows, { lane = lane, y = -0.06, label = label })
		end
		for index = #arrows, 1, -1 do
			local arrow = arrows[index]
			arrow.y += 0.52 * dt
			arrow.label.Position = UDim2.fromScale((arrow.lane - 0.5) * 0.25, arrow.y)
			if arrow.y > 0.92 then
				arrow.label:Destroy()
				table.remove(arrows, index)
			end
		end
	end)
	connection:Disconnect()
	return math.min(score, def.maxScore)
end

----------------------------------------------------------------------
-- Running a round
----------------------------------------------------------------------
local play

local function showResults(def, score, result)
	UI.clear(resultButtons)
	results.Visible = true
	UI.pop(results, 0.7)
	local ratio = result.ok and result.ratio or 0
	resultTitle.Text = ratio >= 0.95 and "PERFECT!" or (ratio >= 0.6 and "NICE!" or "GOOD TRY")
	resultScore.Text = def.name .. ": " .. math.floor(score) .. " / " .. def.maxScore
	if result.ok then
		resultReward.Text = string.format("+%d Goo Coins    +%d Age XP%s", result.coins, result.xp, (result.bonus or 1) > 1 and "\n(arcade bonus!)" or "")
		State.sound(ratio >= 0.6 and "rare" or "notify")
	else
		resultReward.Text = result.reason or "no reward this time"
	end
	UI.button(resultButtons, "Play again", { Size = UDim2.fromOffset(180, 48), Color = C.goo, TextSize = 20 }, function()
		results.Visible = false
		overlay.Visible = false
		task.spawn(play, def.id)
	end)
	UI.button(resultButtons, "Done", { Size = UDim2.fromOffset(180, 48), Color = C.sub, TextSize = 20 }, function()
		results.Visible = false
		overlay.Visible = false
	end)
end

function play(id)
	local def = MinigameSystem.get(id)
	if not def or playing then
		return
	end
	if def.world then
		State.toast("the Goo Obby is a real course - go to Room > Travel > Mini-Games and step on START", "info")
		return
	end
	playing = true
	local started = State.invoke("MinigameStart", id)
	if not started.ok then
		playing = false
		State.toast(started.reason or "can't play right now", "bad")
		return
	end
	State.close()
	cancelled = false
	results.Visible = false
	UI.clear(arena)
	overlay.Visible = true
	gameTitle.Text = def.icon .. " " .. def.name
	setScore(0, def.maxScore)
	timeBar.set(1)
	flashMessage("READY?", C.gold, 0.7)
	task.wait(0.75)

	local ok, score = pcall(GAMES[id], def)
	if not ok then
		warn("[MinigameUI] " .. tostring(score))
		score = 0
	end
	UI.clear(arena)
	message.Visible = false
	local result = State.invoke("MinigameFinish", started.token, score)
	playing = false
	showResults(def, score, result)
end

----------------------------------------------------------------------
-- Picker contents
----------------------------------------------------------------------
local function refresh()
	if not window.visible then
		return
	end
	local data = State.data
	energyBar.set(data.meters.energy / 100, string.format("⚡ Energy %d / 100   (each game costs %d)", math.floor(data.meters.energy + 0.5), Config.MinigameEnergyCost))
	UI.clear(picker)
	for index, def in ipairs(MinigameSystem.List) do
		local locked = data.age < def.minAge
		local row = UI.row(picker, { Name = "Game_" .. def.id, Size = UDim2.new(1, -12, 0, 62), LayoutOrder = index })
		UI.label(row, def.icon, { Size = UDim2.fromOffset(56, 62), TextSize = 34 })
		UI.label(row, def.name, { Size = UDim2.new(1, -240, 0, 26), Position = UDim2.fromOffset(60, 6), TextSize = 18, AlignX = Enum.TextXAlignment.Left })
		UI.label(row, def.desc, { Size = UDim2.new(1, -240, 0, 26), Position = UDim2.fromOffset(60, 32), TextSize = 12, Font = UI.BodyFont, Color = C.sub, AlignX = Enum.TextXAlignment.Left })
		local text = locked and ("🔒 Age " .. def.minAge) or (def.world and "at the arcade" or "PLAY")
		local button = UI.button(row, text, { Name = "Play", Size = UDim2.fromOffset(160, 44), Position = UDim2.new(1, -168, 0, 9), Color = C.pink, TextSize = 18 }, function()
			if not locked then
				task.spawn(play, def.id)
			end
		end)
		UI.setEnabled(button, not locked, C.pink)
	end
	UI.label(picker, "💡 playing at the Goo Arcade machines gives +25% rewards", { Size = UDim2.new(1, -12, 0, 26), TextSize = 12, Font = UI.BodyFont, Color = C.sub, LayoutOrder = 99 })
end

window.onShow(function(arg)
	refresh()
	-- arcade machines open this window with a game id: start it straight away
	if type(arg) == "string" and MinigameSystem.get(arg) then
		task.spawn(play, arg)
	end
end)
State.on("meters", refresh)
State.on("age", refresh)
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="ScreenGui" referent="77">
      <Properties>
        <string name="Name">MirrorUI</string>
        <int name="DisplayOrder">6</int>
        <bool name="ResetOnSpawn">false</bool>
        <token name="ZIndexBehavior">1</token>
      </Properties>
      <Item class="LocalScript" referent="78">
        <Properties>
          <string name="Name">MirrorUI</string>
          <string name="Source"><![CDATA[--[[
	MirrorUI
	Mirror mode. Using the mirror in the room makes Brady stand in front of it
	and strike a pose while the camera glides in close. From here the player
	can cycle through unlocked poses, change his outfit, or take a screenshot.

	The server opens this (OpenPanel "Mirror", spot) after it has moved Brady
	to the mirror; leaving sends Mirror(false) so he goes back to normal.
]]

local CaptureService = game:GetService("CaptureService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Client = ReplicatedStorage:WaitForChild("Client")
local Modules = ReplicatedStorage:WaitForChild("Modules")
local State = require(Client:WaitForChild("ClientState"))
local UI = require(Client:WaitForChild("UI"))
local InventorySystem = require(Modules:WaitForChild("InventorySystem"))
local BradyBuilder = require(Modules:WaitForChild("Builders"):WaitForChild("BradyBuilder"))

local gui = script.Parent
local C = UI.Colors
local localPlayer = Players.LocalPlayer

State.wait()

local active = false
local spot = nil -- CFrame where Brady stands (he faces away from the mirror)
local savedCameraType = Enum.CameraType.Custom

local bar = UI.frame(gui, { Name = "MirrorBar", Size = UDim2.fromOffset(760, 132), Position = UDim2.new(0.5, 0, 1, -16), AnchorPoint = Vector2.new(0.5, 1), Color = C.bg, Corner = 18, Stroke = 4, StrokeColor = C.pink, Visible = false })
UI.autoScale(bar, "hud")
UI.label(bar, "🪞 MIRROR MODE - pick a pose", { Name = "Title", Size = UDim2.new(1, -420, 0, 28), Position = UDim2.fromOffset(14, 6), TextSize = 18, Color = C.pink, AlignX = Enum.TextXAlignment.Left })
local poses = UI.new("ScrollingFrame", {
	Name = "Poses",
	Size = UDim2.new(1, -24, 0, 54),
	Position = UDim2.fromOffset(12, 68),
	BackgroundTransparency = 1,
	BorderSizePixel = 0,
	ScrollBarThickness = 6,
	ScrollBarImageColor3 = C.pink,
	CanvasSize = UDim2.new(),
	AutomaticCanvasSize = Enum.AutomaticSize.X,
	ScrollingDirection = Enum.ScrollingDirection.X,
	Parent = bar,
})
UI.list(poses, { horizontal = true, pad = 6 })
local buttons = UI.box(bar, { Name = "Buttons", Size = UDim2.fromOffset(410, 36), Position = UDim2.new(1, -420, 0, 6) })
UI.list(buttons, { horizontal = true, pad = 6, alignX = Enum.HorizontalAlignment.Right })

local flash = UI.frame(gui, { Name = "Flash", Color = Color3.new(1, 1, 1), Transparency = 1, Corner = false, ZIndex = 50 })
flash.Visible = false

----------------------------------------------------------------------
-- Camera
----------------------------------------------------------------------
local function cameraGoal()
	local height = BradyBuilder.heightFor(State.data.age)
	local focus = spot.Position + Vector3.new(0, height * 0.55, 0)
	-- stand in front of Brady (he looks along spot.LookVector), slightly to one side
	local eye = focus + spot.LookVector * (height * 1.5 + 5) + spot.RightVector * 1.5 + Vector3.new(0, height * 0.1, 0)
	return CFrame.lookAt(eye, focus)
end

local function enterCamera()
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	savedCameraType = camera.CameraType
	camera.CameraType = Enum.CameraType.Scriptable
	TweenService:Create(camera, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = cameraGoal() }):Play()
end

local function exitCamera()
	local camera = Workspace.CurrentCamera
	if camera then
		camera.CameraType = savedCameraType == Enum.CameraType.Scriptable and Enum.CameraType.Custom or savedCameraType
	end
end

----------------------------------------------------------------------
-- Poses + buttons
----------------------------------------------------------------------
local function refreshPoses()
	UI.clear(poses)
	local unlocked = InventorySystem.unlockedPoses(State.data, State.passes())
	for index, pose in ipairs(unlocked) do
		UI.button(poses, pose.name, { Name = "Pose_" .. pose.id, Size = UDim2.fromOffset(120, 42), Color = C.pink, TextSize = 14, Corner = 10, LayoutOrder = index }, function()
			State.send("SetPose", pose.id)
		end)
	end
end

local function leave()
	if not active then
		return
	end
	active = false
	bar.Visible = false
	exitCamera()
	State.send("Mirror", false)
end

local function screenshot()
	-- Hide every menu, snap, then bring them back.
	local playerGui = localPlayer:FindFirstChild("PlayerGui")
	local hidden = {}
	if playerGui then
		for _, child in ipairs(playerGui:GetChildren()) do
			if child:IsA("ScreenGui") and child.Enabled and child ~= gui then
				child.Enabled = false
				table.insert(hidden, child)
			end
		end
	end
	bar.Visible = false
	State.sound("camera")
	task.wait(0.15)
	local finished = false
	local function restore(message, kind)
		if finished then
			return
		end
		finished = true
		for _, child in ipairs(hidden) do
			child.Enabled = true
		end
		bar.Visible = active
		flash.Visible = true
		flash.BackgroundTransparency = 0.2
		UI.tween(flash, 0.5, { BackgroundTransparency = 1 })
		task.delay(0.5, function()
			flash.Visible = false
		end)
		State.toast(message, kind)
	end
	local ok = pcall(function()
		CaptureService:CaptureScreenshot(function(contentId)
			restore("📸 fit pic saved to your Roblox captures!", "good")
			State.send("Tutorial", "Photo")
			pcall(function()
				CaptureService:PromptSaveCapturesToGallery({ contentId }, function() end)
			end)
		end)
	end)
	if not ok then
		restore("screenshots aren't supported on this device - use your device's own screenshot button", "info")
	end
	-- never leave the menus hidden if the capture callback does not arrive
	task.delay(4, function()
		restore("📸 done!", "info")
	end)
end

UI.button(buttons, "👕 Outfit", { Name = "Outfit", Size = UDim2.fromOffset(120, 34), Color = C.blue, TextColor = C.text, TextSize = 15, Corner = 10, LayoutOrder = 1 }, function()
	State.open("Wardrobe")
end)
UI.button(buttons, "📸 Photo", { Name = "Photo", Size = UDim2.fromOffset(120, 34), Color = C.gold, TextSize = 15, Corner = 10, LayoutOrder = 2 }, function()
	task.spawn(screenshot)
end)
UI.button(buttons, "✖ Exit", { Name = "Exit", Size = UDim2.fromOffset(120, 34), Color = C.red, TextColor = C.text, TextSize = 15, Corner = 10, LayoutOrder = 3 }, function()
	leave()
	State.close()
end)

----------------------------------------------------------------------
-- Opening / closing
----------------------------------------------------------------------
State.panelChanged:Connect(function(name, arg)
	if name == "Mirror" then
		if typeof(arg) == "CFrame" then
			spot = arg
		end
		if not spot then
			return
		end
		if not active then
			active = true
			enterCamera()
		end
		refreshPoses()
		bar.Visible = true
		UI.pop(bar, 0.85)
	elseif name == "Wardrobe" and active then
		-- changing his outfit from the mirror: keep the close-up camera
		bar.Visible = false
	elseif name == nil and active then
		-- closed the wardrobe: back to the pose bar
		bar.Visible = true
	elseif active then
		leave()
	end
end)

State.on("age", function()
	if active then
		refreshPoses()
	end
end)
State.on("inventory", function()
	if active then
		refreshPoses()
	end
end)

-- If he falls asleep or the player walks off, drop out of mirror mode.
State.onSession("sleeping", function(sleeping)
	if sleeping and active then
		leave()
	end
end)
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="ScreenGui" referent="79">
      <Properties>
        <string name="Name">RoomUI</string>
        <int name="DisplayOrder">5</int>
        <bool name="ResetOnSpawn">false</bool>
        <token name="ZIndexBehavior">1</token>
      </Properties>
      <Item class="LocalScript" referent="80">
        <Properties>
          <string name="Name">RoomUI</string>
          <string name="Source"><![CDATA[--[[
	RoomUI
	Decorating the player's room + travelling around.

	PLACING FURNITURE (grid based)
	Picking a piece shows a translucent ghost that follows the mouse / finger
	across the room floor, snapped to the 2-stud grid. It turns green where
	the piece fits and red where it does not, using the very same
	FurnitureSystem.canPlace() rule the server enforces - so what looks valid
	on screen is valid on the server.

	    PC:      move mouse, click to place, R = rotate, Q = cancel
	    Touch:   drag to move, then tap the PLACE button

	REMOVE MODE: tap any of your furniture to put it back into storage.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Client = ReplicatedStorage:WaitForChild("Client")
local Modules = ReplicatedStorage:WaitForChild("Modules")
local State = require(Client:WaitForChild("ClientState"))
local UI = require(Client:WaitForChild("UI"))
local AgeSystem = require(Modules:WaitForChild("AgeSystem"))
local Config = require(Modules:WaitForChild("Config"))
local FurnitureSystem = require(Modules:WaitForChild("FurnitureSystem"))
local HouseSystem = require(Modules:WaitForChild("HouseSystem"))
local FurnitureBuilder = require(Modules:WaitForChild("Builders"):WaitForChild("FurnitureBuilder"))

local gui = script.Parent
local C = UI.Colors
local localPlayer = Players.LocalPlayer

State.wait()

local window = UI.window(gui, { name = "Room", title = "🏠 Room", width = 760, height = 480 })
local body = window.body

local mode = "Decorate"
local refresh
local tabs = UI.tabs(body, { { id = "Decorate", text = "🛋️ Decorate" }, { id = "Travel", text = "🧭 Travel & Visit" } }, function(id)
	mode = id
	refresh()
end, { Width = 736, TextSize = 16 })

local header = UI.label(body, "", { Name = "Summary", Size = UDim2.new(1, -230, 0, 30), Position = UDim2.fromOffset(0, 46), TextSize = 14, Font = UI.BodyFont, Color = C.sub, AlignX = Enum.TextXAlignment.Left })
local list = UI.scroll(body, { Name = "List", Size = UDim2.new(1, 0, 1, -84), Position = UDim2.fromOffset(0, 82) })
UI.list(list, { pad = 6 })

----------------------------------------------------------------------
-- Where is my room?
----------------------------------------------------------------------
-- Returns the room-local origin CFrame (centre of the floor) and room size.
local function myRoom()
	local houses = Workspace:FindFirstChild("Houses")
	local house = houses and houses:FindFirstChild("House_" .. localPlayer.UserId)
	local floor = house and house:FindFirstChild("Floor")
	if not floor then
		return nil
	end
	return floor.CFrame * CFrame.new(0, floor.Size.Y / 2, 0), house:GetAttribute("Size") or AgeSystem.houseSize(State.data.age), house
end

local function insideMyRoom()
	local origin, size = myRoom()
	local character = localPlayer.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not origin or not hrp then
		return false
	end
	return HouseSystem.isInside(size, origin:PointToObjectSpace(hrp.CFrame.Position), 6)
end

----------------------------------------------------------------------
-- Placement mode
----------------------------------------------------------------------
local placing = nil -- { id, r, x, z, ghost, valid }
local removing = false
local connections = {}

local bar = UI.frame(gui, { Name = "PlacementBar", Size = UDim2.fromOffset(560, 104), Position = UDim2.new(0.5, 0, 1, -120), AnchorPoint = Vector2.new(0.5, 1), Color = C.bg, Corner = 18, Stroke = 4, StrokeColor = C.goo, Visible = false })
UI.autoScale(bar, "hud")
local barText = UI.label(bar, "", { Name = "Hint", Size = UDim2.new(1, -16, 0, 34), Position = UDim2.fromOffset(8, 4), TextSize = 15, Font = UI.BodyFont })
local barButtons = UI.box(bar, { Name = "Buttons", Size = UDim2.new(1, -16, 0, 52), Position = UDim2.fromOffset(8, 44) })
UI.list(barButtons, { horizontal = true, pad = 8, alignX = Enum.HorizontalAlignment.Center })

local function disconnectAll()
	for _, connection in ipairs(connections) do
		connection:Disconnect()
	end
	connections = {}
end

local function stopPlacement()
	if placing and placing.ghost then
		placing.ghost:Destroy()
	end
	placing = nil
	removing = false
	disconnectAll()
	bar.Visible = false
end

-- Converts a screen point into a room-local floor position.
local function floorPoint(screenPosition)
	local origin = myRoom()
	local camera = Workspace.CurrentCamera
	if not origin or not camera then
		return nil
	end
	local ray = camera:ViewportPointToRay(screenPosition.X, screenPosition.Y)
	local floorY = origin.Position.Y
	if ray.Direction.Y >= -0.01 then
		return nil -- looking at the sky
	end
	local t = (floorY - ray.Origin.Y) / ray.Direction.Y
	if t < 0 or t > 500 then
		return nil
	end
	return origin:PointToObjectSpace(ray.Origin + ray.Direction * t)
end

local function updateGhost()
	if not placing then
		return
	end
	local origin, size = myRoom()
	if not origin then
		return
	end
	local placement = { id = placing.id, x = placing.x, z = placing.z, r = placing.r }
	placing.ghost:PivotTo(origin * FurnitureSystem.localCFrame(placement))
	local ok, reason = FurnitureSystem.canPlace(State.data.furniture.placed, placing.id, placing.x, placing.z, placing.r, size)
	placing.valid = ok
	local base = placing.ghost.PrimaryPart
	if base then
		base.Color = ok and C.goo or C.red
	end
	local def = FurnitureSystem.get(placing.id)
	barText.Text = ok and ("Placing " .. def.name .. " - tap PLACE (or click) to put it down") or ("✖ " .. (reason or "can't go there"))
	barText.TextColor3 = ok and C.text or C.red
end

local function moveGhostTo(screenPosition)
	if not placing then
		return
	end
	local point = floorPoint(screenPosition)
	if point then
		placing.x, placing.z = FurnitureSystem.snap(placing.id, point.X, point.Z, placing.r)
		updateGhost()
	end
end

local function spareCount(id)
	local furniture = State.data.furniture
	return (furniture.owned[id] or 0) - FurnitureSystem.placedCount(furniture.placed, id)
end

local function confirmPlacement()
	if not placing then
		return
	end
	if not placing.valid then
		State.toast("it doesn't fit there", "bad")
		return
	end
	local id = placing.id
	State.send("PlaceFurniture", id, placing.x, placing.z, placing.r)
	-- The Faster Room Customizing pass keeps you placing the same piece.
	if State.hasPass("FastDecorating") and spareCount(id) > 1 then
		task.delay(0.3, updateGhost)
	else
		stopPlacement()
	end
end

local function rotateGhost()
	if placing then
		placing.r = (placing.r + 1) % 4
		-- keep the piece under the pointer after its footprint swaps
		local rect = FurnitureSystem.rectOf({ id = placing.id, x = placing.x, z = placing.z, r = (placing.r + 3) % 4 })
		placing.x, placing.z = FurnitureSystem.snap(placing.id, (rect.minX + rect.maxX) / 2, (rect.minZ + rect.maxZ) / 2, placing.r)
		updateGhost()
	end
end

local function barButton(text, color, callback)
	return UI.button(barButtons, text, { Size = UDim2.fromOffset(160, 50), Color = color, TextSize = 20 }, callback)
end

local function startPlacement(id)
	stopPlacement()
	local origin = myRoom()
	if not origin then
		State.toast("your house isn't ready yet", "bad")
		return
	end
	if not insideMyRoom() then
		State.toast("go inside your house to decorate (Travel > Home)", "bad")
		return
	end
	local ghost = FurnitureBuilder.build(id)
	if not ghost then
		return
	end
	FurnitureBuilder.makeGhost(ghost)
	ghost.Name = "PlacementGhost"
	ghost.Parent = Workspace
	local x, z = FurnitureSystem.snap(id, 0, 0, 0)
	placing = { id = id, r = 0, x = x, z = z, ghost = ghost, valid = false }
	State.close()

	UI.clear(barButtons)
	barButton("↻ Rotate", C.blue, rotateGhost).TextColor3 = C.text
	barButton("✔ PLACE", C.goo, confirmPlacement)
	barButton("✖ Cancel", C.red, stopPlacement).TextColor3 = C.text
	bar.Visible = true
	updateGhost()

	table.insert(connections, UserInputService.InputChanged:Connect(function(input, processed)
		if input.UserInputType == Enum.UserInputType.MouseMovement or (input.UserInputType == Enum.UserInputType.Touch and not processed) then
			moveGhostTo(input.Position)
		end
	end))
	table.insert(connections, UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			moveGhostTo(input.Position)
			confirmPlacement()
		elseif input.UserInputType == Enum.UserInputType.Touch then
			moveGhostTo(input.Position)
		elseif input.KeyCode == Enum.KeyCode.R then
			rotateGhost()
		elseif input.KeyCode == Enum.KeyCode.Q or input.KeyCode == Enum.KeyCode.Backspace then
			stopPlacement()
		end
	end))
end

----------------------------------------------------------------------
-- Remove mode
----------------------------------------------------------------------
-- Finds which saved placement a floor position belongs to.
local function placementAt(localPoint)
	local placed = State.data.furniture.placed
	-- prefer normal furniture over the rug underneath it
	for pass = 1, 2 do
		for index = #placed, 1, -1 do
			local def = FurnitureSystem.get(placed[index].id)
			-- (small margin so a tap exactly on a grid line still counts)
			if def and ((def.layer == "rug") == (pass == 2)) and HouseSystem.pointInRect(localPoint.X, localPoint.Z, FurnitureSystem.rectOf(placed[index]), 0.05) then
				return index
			end
		end
	end
	return nil
end

local function startRemoving()
	stopPlacement()
	if not insideMyRoom() then
		State.toast("go inside your house first (Travel > Home)", "bad")
		return
	end
	removing = true
	State.close()
	UI.clear(barButtons)
	barButton("✔ Done", C.goo, stopPlacement)
	barText.Text = "REMOVE MODE: tap a piece of furniture to put it back in storage"
	barText.TextColor3 = C.text
	bar.Visible = true
	table.insert(connections, UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not removing then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			local point = floorPoint(input.Position)
			local index = point and placementAt(point)
			if index then
				State.send("RemoveFurniture", index)
			end
		elseif input.KeyCode == Enum.KeyCode.Q then
			stopPlacement()
		end
	end))
end

-- Leaving the room or opening another window ends placement.
State.panelChanged:Connect(function(name)
	if name ~= nil and (placing or removing) then
		stopPlacement()
	end
end)

----------------------------------------------------------------------
-- Window contents
----------------------------------------------------------------------
local removeButton = UI.button(body, "🗑️ Remove mode", { Name = "RemoveMode", Size = UDim2.fromOffset(220, 32), Position = UDim2.new(1, -220, 0, 46), Color = C.red, TextColor = C.text, TextSize = 15, Corner = 10 }, startRemoving)

local function showDecorate()
	local data = State.data
	local furniture = data.furniture
	local limit = State.hasPass("ExtraStorage") and Config.MaxPlacedFurnitureWithPass or Config.MaxPlacedFurniture
	local size = AgeSystem.houseSize(data.age)
	header.Text = string.format("%s  •  %dx%d studs  •  %d / %d placed", AgeSystem.HouseNames[AgeSystem.houseTier(data.age)], size, size, #furniture.placed, limit)
	removeButton.Visible = true
	local ids = {}
	for id, owned in pairs(furniture.owned) do
		if owned > 0 and FurnitureSystem.get(id) then
			table.insert(ids, id)
		end
	end
	table.sort(ids, function(a, b)
		return FurnitureSystem.get(a).name < FurnitureSystem.get(b).name
	end)
	for index, id in ipairs(ids) do
		local def = FurnitureSystem.get(id)
		local spare = spareCount(id)
		local row = UI.row(list, { Name = "Furniture_" .. id, Size = UDim2.new(1, -12, 0, 56), LayoutOrder = index })
		local swatch = UI.frame(row, { Size = UDim2.fromOffset(44, 44), Position = UDim2.fromOffset(6, 6), Color = def.color, Corner = 10 })
		UI.label(swatch, def.toy and "🧸" or (def.category == "Decor" and "🪴" or "🛋️"), { TextSize = 24 })
		UI.label(row, def.name, { Size = UDim2.new(1, -230, 0, 24), Position = UDim2.fromOffset(58, 5), TextSize = 17, AlignX = Enum.TextXAlignment.Left })
		UI.label(row, string.format("%d in storage  •  %d placed  •  %dx%d studs", spare, furniture.owned[id] - spare, def.w, def.d), { Size = UDim2.new(1, -230, 0, 22), Position = UDim2.fromOffset(58, 29), TextSize = 12, Font = UI.BodyFont, Color = C.sub, AlignX = Enum.TextXAlignment.Left })
		local button = UI.button(row, spare > 0 and "PLACE" or "all placed", { Name = "Place", Size = UDim2.fromOffset(150, 40), Position = UDim2.new(1, -158, 0, 8), TextSize = 17 }, function()
			if spareCount(id) > 0 then
				startPlacement(id)
			end
		end)
		UI.setEnabled(button, spare > 0)
	end
	if #ids == 0 then
		UI.label(list, "no furniture yet - buy some in the Shop!", { Size = UDim2.new(1, -12, 0, 60), TextSize = 16, Font = UI.BodyFont, Color = C.sub })
	end
	UI.button(list, "🛒 Buy furniture", { Name = "ShopLink", Size = UDim2.new(1, -12, 0, 40), Color = C.gold, TextSize = 17, LayoutOrder = 999 }, function()
		State.open("Shop", "Furniture")
	end)
end

local PLACES = {
	{ "Home", "🏠 My House" }, { "Plaza", "⛲ Plaza" }, { "Shop", "👕 Clothing Store" }, { "Runway", "🌟 Fashion Runway" },
	{ "Arcade", "🎮 Mini-Games" }, { "Park", "🌳 Park" }, { "Food", "🍔 Food Court" },
}

local function showTravel()
	header.Text = "teleport around the map, or visit another player's house"
	removeButton.Visible = false
	local places = UI.box(list, { Name = "Places", Size = UDim2.new(1, -12, 0, 100), LayoutOrder = 1 })
	UI.grid(places, 170, 44, 8)
	for index, place in ipairs(PLACES) do
		UI.button(places, place[2], { Name = "Go_" .. place[1], Size = UDim2.fromOffset(170, 44), Color = C.goo, TextSize = 15, LayoutOrder = index }, function()
			State.send("Visit", place[1])
			State.close()
		end)
	end
	UI.label(list, "PLAYERS IN THIS SERVER", { Size = UDim2.new(1, -12, 0, 24), TextSize = 14, Color = C.sub, LayoutOrder = 2 })
	local shown = 0
	for index, player in ipairs(Players:GetPlayers()) do
		if player ~= localPlayer then
			shown += 1
			local row = UI.row(list, { Name = "Player_" .. player.UserId, Size = UDim2.new(1, -12, 0, 50), LayoutOrder = 2 + index })
			UI.label(row, "🧍 " .. player.DisplayName, { Size = UDim2.new(1, -330, 1, 0), Position = UDim2.fromOffset(12, 0), TextSize = 17, AlignX = Enum.TextXAlignment.Left })
			UI.button(row, "Visit house", { Name = "Visit", Size = UDim2.fromOffset(150, 36), Position = UDim2.new(1, -316, 0, 7), Color = C.goo, TextSize = 15 }, function()
				State.send("Visit", player.UserId)
				State.close()
			end)
			UI.button(row, "Inspect Brady", { Name = "Inspect", Size = UDim2.fromOffset(150, 36), Position = UDim2.new(1, -158, 0, 7), Color = C.pink, TextSize = 15 }, function()
				State.open("Inspect", player.UserId)
			end)
		end
	end
	if shown == 0 then
		UI.label(list, "nobody else is here right now", { Size = UDim2.new(1, -12, 0, 40), TextSize = 15, Font = UI.BodyFont, Color = C.sub, LayoutOrder = 3 })
	end
end

function refresh()
	if not window.visible then
		return
	end
	UI.clear(list)
	if mode == "Travel" then
		showTravel()
	else
		showDecorate()
	end
end

window.onShow(function(arg)
	if arg == "Travel" then
		mode = "Travel"
	elseif arg == "Decorate" then
		mode = "Decorate"
	end
	tabs.select(mode, true)
	refresh()
end)
State.on("furniture", function()
	refresh()
	if placing then
		if spareCount(placing.id) <= 0 then
			stopPlacement()
		else
			updateGhost()
		end
	end
end)
State.on("age", refresh)
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="ScreenGui" referent="81">
      <Properties>
        <string name="Name">SettingsUI</string>
        <int name="DisplayOrder">5</int>
        <bool name="ResetOnSpawn">false</bool>
        <token name="ZIndexBehavior">1</token>
      </Properties>
      <Item class="LocalScript" referent="82">
        <Properties>
          <string name="Name">SettingsUI</string>
          <string name="Source"><![CDATA[--[[
	SettingsUI
	Music / sound effects / low graphics / Brady chatter toggles, the cosmetic
	aura picker (Cosmetic Effects pass) and a "replay tutorial" button.
	Settings are saved with the player's profile.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = ReplicatedStorage:WaitForChild("Client")
local Modules = ReplicatedStorage:WaitForChild("Modules")
local State = require(Client:WaitForChild("ClientState"))
local UI = require(Client:WaitForChild("UI"))
local Monetization = require(Modules:WaitForChild("Monetization"))
local Sounds = require(Modules:WaitForChild("Sounds"))

local gui = script.Parent
local C = UI.Colors

State.wait()

local window = UI.window(gui, { name = "Settings", title = "⚙️ Settings", width = 560, height = 470 })
local list = UI.scroll(window.body, { Name = "List" })
UI.list(list, { pad = 8 })

local TOGGLES = {
	{ key = "sfx", name = "🔊 Sound effects", desc = "clicks, coins and Brady noises" },
	{ key = "music", name = "🎵 Music", desc = Sounds.Music == "" and "no music track is set up for this game yet" or "background music" },
	{ key = "chatter", name = "💬 Brady chatter", desc = "random speech bubbles when he is idle" },
	{ key = "lowGfx", name = "⚡ Low graphics", desc = "fewer particles and animations for slower devices" },
}

local toggleButtons = {}

for index, toggle in ipairs(TOGGLES) do
	local row = UI.row(list, { Name = "Setting_" .. toggle.key, Size = UDim2.new(1, -12, 0, 60), LayoutOrder = index })
	UI.label(row, toggle.name, { Size = UDim2.new(1, -150, 0, 26), Position = UDim2.fromOffset(14, 6), TextSize = 18, AlignX = Enum.TextXAlignment.Left })
	UI.label(row, toggle.desc, { Size = UDim2.new(1, -150, 0, 22), Position = UDim2.fromOffset(14, 32), TextSize = 12, Font = UI.BodyFont, Color = C.sub, AlignX = Enum.TextXAlignment.Left })
	toggleButtons[toggle.key] = UI.button(row, "ON", { Name = "Toggle", Size = UDim2.fromOffset(110, 40), Position = UDim2.new(1, -120, 0, 10), TextSize = 18 }, function()
		State.send("Setting", toggle.key, not State.data.settings[toggle.key])
	end)
end

-- Aura picker (purely cosmetic gamepass feature)
local auraRow = UI.row(list, { Name = "Aura", Size = UDim2.new(1, -12, 0, 92), LayoutOrder = 10 })
UI.label(auraRow, "🌈 Brady's aura", { Size = UDim2.new(1, -20, 0, 24), Position = UDim2.fromOffset(14, 6), TextSize = 18, AlignX = Enum.TextXAlignment.Left })
local auraNote = UI.label(auraRow, "", { Size = UDim2.new(1, -20, 0, 18), Position = UDim2.fromOffset(14, 30), TextSize = 12, Font = UI.BodyFont, Color = C.sub, AlignX = Enum.TextXAlignment.Left })
local auraButtons = UI.box(auraRow, { Size = UDim2.new(1, -20, 0, 34), Position = UDim2.fromOffset(10, 52) })
UI.list(auraButtons, { horizontal = true, pad = 6 })
local auraChoices = {}
for index, aura in ipairs(Monetization.Auras) do
	auraChoices[aura] = UI.button(auraButtons, aura, { Name = "Aura_" .. aura, Size = UDim2.fromOffset(94, 32), Color = C.panel2, TextColor = C.text, TextSize = 14, Corner = 10, LayoutOrder = index }, function()
		if aura ~= "none" and not State.hasPass("CosmeticEffects") then
			State.toast("auras come with the Cosmetic Effects pass (Shop > Passes)", "info")
			return
		end
		State.send("Setting", "aura", aura)
	end)
end

UI.button(list, "📘 Replay the tutorial", { Name = "Replay", Size = UDim2.new(1, -12, 0, 44), Color = C.blue, TextColor = C.text, TextSize = 18, LayoutOrder = 20 }, function()
	State.send("Tutorial", "Replay")
	State.close()
end)
UI.button(list, "🏠 Take me home", { Name = "Home", Size = UDim2.new(1, -12, 0, 44), Color = C.goo, TextSize = 18, LayoutOrder = 21 }, function()
	State.send("Visit", "Home")
	State.close()
end)
UI.label(list, "Raise Brady Goo  •  progress saves automatically", { Size = UDim2.new(1, -12, 0, 26), TextSize = 12, Font = UI.BodyFont, Color = C.sub, LayoutOrder = 30 })

local function refresh()
	local settings = State.data.settings
	for key, button in pairs(toggleButtons) do
		local on = settings[key] == true
		button.Text = on and "ON" or "OFF"
		button.BackgroundColor3 = on and C.goo or C.grey
	end
	local hasPass = State.hasPass("CosmeticEffects")
	auraNote.Text = hasPass and "pick a trail effect - looks only" or "🔒 needs the Cosmetic Effects pass - looks only, no gameplay bonus"
	for aura, button in pairs(auraChoices) do
		local selected = settings.aura == aura
		button.BackgroundColor3 = selected and C.goo or C.panel2
		button.TextColor3 = selected and C.dark or C.text
	end
end

window.onShow(refresh)
State.on("settings", refresh)
State.onSession("passes", refresh)
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="ScreenGui" referent="83">
      <Properties>
        <string name="Name">ShopUI</string>
        <int name="DisplayOrder">5</int>
        <bool name="ResetOnSpawn">false</bool>
        <token name="ZIndexBehavior">1</token>
      </Properties>
      <Item class="LocalScript" referent="84">
        <Properties>
          <string name="Name">ShopUI</string>
          <string name="Source"><![CDATA[--[[
	ShopUI
	Spend Goo Coins: clothing, hairstyles, food, furniture, decorations, toys,
	crates (with their odds shown) and the optional gamepasses.

	The shop only ASKS the server to buy something. Prices, age locks and
	the crate roll all happen in ShopServer.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = ReplicatedStorage:WaitForChild("Client")
local Modules = ReplicatedStorage:WaitForChild("Modules")
local State = require(Client:WaitForChild("ClientState"))
local UI = require(Client:WaitForChild("UI"))
local ClothingSystem = require(Modules:WaitForChild("ClothingSystem"))
local FoodSystem = require(Modules:WaitForChild("FoodSystem"))
local FurnitureSystem = require(Modules:WaitForChild("FurnitureSystem"))
local Monetization = require(Modules:WaitForChild("Monetization"))
local ShopSystem = require(Modules:WaitForChild("ShopSystem"))
local Util = require(Modules:WaitForChild("Util"))

local gui = script.Parent
local C = UI.Colors
local localPlayer = Players.LocalPlayer

State.wait()

local window = UI.window(gui, { name = "Shop", title = "🛒 Shop", width = 850, height = 500 })
local body = window.body

local TABS = {
	{ id = "Clothing", text = "👕 Clothing" },
	{ id = "Hair", text = "💇 Hair" },
	{ id = "Food", text = "🍔 Food" },
	{ id = "Furniture", text = "🛋️ Furniture" },
	{ id = "Decor", text = "🪴 Decor" },
	{ id = "Toys", text = "🧸 Toys" },
	{ id = "Crates", text = "🎁 Crates" },
	{ id = "Passes", text = "💎 Passes" },
}

local current = "Clothing"
local selected = nil -- clothing item selected for the detail panel
local busy = false
local refresh

local tabs = UI.tabs(body, TABS, function(id)
	current = id
	selected = nil
	refresh()
end, { Width = 826, TextSize = 13 })

local list = UI.scroll(body, { Name = "List", Size = UDim2.new(1, 0, 1, -48), Position = UDim2.fromOffset(0, 46) })
local layout

-- Clothing detail / buy panel (only visible on the clothing + hair tabs)
local detail = UI.frame(body, { Name = "Detail", Size = UDim2.new(0, 240, 1, -48), Position = UDim2.new(1, -240, 0, 46), Color = C.panel, Corner = 14, Visible = false })
local detailName = UI.label(detail, "", { Name = "ItemName", Size = UDim2.new(1, -16, 0, 48), Position = UDim2.fromOffset(8, 10), TextSize = 19 })
local detailRarity = UI.label(detail, "", { Name = "Rarity", Size = UDim2.new(1, -16, 0, 22), Position = UDim2.fromOffset(8, 60), TextSize = 17 })
local detailAge = UI.label(detail, "", { Name = "Age", Size = UDim2.new(1, -16, 0, 20), Position = UDim2.fromOffset(8, 84), TextSize = 14, Font = UI.BodyFont, Color = C.sub })
local detailDesc = UI.label(detail, "", { Name = "Description", Size = UDim2.new(1, -24, 0, 110), Position = UDim2.fromOffset(12, 110), TextSize = 14, Font = UI.BodyFont, AlignY = Enum.TextYAlignment.Top })
local detailPrice = UI.label(detail, "", { Name = "Price", Size = UDim2.new(1, -16, 0, 26), Position = UDim2.new(0, 8, 1, -92), TextSize = 20, Color = C.gold })
local buyButton

local function request(kind, id, quantity)
	if busy then
		return
	end
	busy = true
	local result = State.invoke("Buy", kind, id, quantity)
	busy = false
	if result.ok then
		State.sound("coin")
	else
		State.toast(result.reason or "could not buy that", "bad")
	end
end

buyButton = UI.button(detail, "BUY", { Name = "Buy", Size = UDim2.new(1, -24, 0, 50), Position = UDim2.new(0, 12, 1, -62), TextSize = 24 }, function()
	if selected then
		request("clothing", selected.id)
	end
end)

local function showDetail()
	local item = selected
	if not item then
		detailName.Text = "tap a piece to see it"
		detailRarity.Text, detailAge.Text, detailDesc.Text, detailPrice.Text = "", "", "", ""
		buyButton.Visible = false
		return
	end
	local data = State.data
	detailName.Text = item.name
	detailRarity.Text = item.rarity
	detailRarity.TextColor3 = ClothingSystem.rarityColor(item.rarity)
	detailAge.Text = "Required Age: " .. item.age
	detailDesc.Text = "\"" .. item.desc .. "\""
	detailPrice.Text = Util.commas(item.price) .. " Goo Coins"
	buyButton.Visible = true
	if data.inventory[item.id] then
		buyButton.Text = "OWNED"
		UI.setEnabled(buyButton, false)
	elseif data.age < item.age then
		buyButton.Text = "🔒 AGE " .. item.age
		UI.setEnabled(buyButton, false)
	elseif data.coins < item.price then
		buyButton.Text = "NEED COINS"
		UI.setEnabled(buyButton, false)
	else
		buyButton.Text = "BUY"
		UI.setEnabled(buyButton, true)
	end
end

local function setLayout(kind)
	if layout then
		layout:Destroy()
	end
	if kind == "grid" then
		layout = UI.grid(list, 104, 122, 8)
	else
		layout = UI.list(list, { pad = 6 })
	end
end

local function showClothing(hair)
	setLayout("grid")
	list.Size = UDim2.new(1, -250, 1, -48)
	detail.Visible = true
	local data = State.data
	local items = {}
	for _, item in ipairs(ClothingSystem.List) do
		if item.price and (item.slot == "Hair") == hair then
			table.insert(items, item)
		end
	end
	-- cheapest first so there is always a "next thing to buy"
	table.sort(items, function(a, b)
		if a.age ~= b.age then
			return a.age < b.age
		end
		return a.price < b.price
	end)
	for index, item in ipairs(items) do
		local owned = data.inventory[item.id]
		UI.itemCard(list, item, {
			LayoutOrder = index,
			footer = owned and "OWNED" or (Util.short(item.price) .. " coins"),
			equipped = owned,
			locked = (not owned and data.age < item.age) and ("Age " .. item.age) or nil,
		}, function()
			selected = item
			showDetail()
		end)
	end
	showDetail()
end

local function shopRow(index, icon, title, subtitle, buttonText, enabled, callback)
	local row = UI.row(list, { Name = "Row" .. index, Size = UDim2.new(1, -12, 0, 62), LayoutOrder = index })
	UI.label(row, icon, { Size = UDim2.fromOffset(56, 62), TextSize = 34 })
	UI.label(row, title, { Name = "Title", Size = UDim2.new(1, -240, 0, 26), Position = UDim2.fromOffset(60, 6), TextSize = 18, AlignX = Enum.TextXAlignment.Left })
	UI.label(row, subtitle, { Name = "Sub", Size = UDim2.new(1, -240, 0, 26), Position = UDim2.fromOffset(60, 32), TextSize = 12, Font = UI.BodyFont, Color = C.sub, AlignX = Enum.TextXAlignment.Left })
	local button = UI.button(row, buttonText, { Name = "Buy", Size = UDim2.fromOffset(160, 44), Position = UDim2.new(1, -168, 0, 9), Color = C.gold, TextSize = 16 }, callback)
	UI.setEnabled(button, enabled, C.gold)
	return row
end

local function showFood()
	setLayout("list")
	local data = State.data
	local index = 0
	for _, food in ipairs(FoodSystem.List) do
		if not food.free then
			index += 1
			local locked = data.age < (food.minAge or 1)
			local stats = food.mystery and "+40 hunger, 5 to 120 XP" or ("+" .. food.hunger .. " hunger, +" .. food.xp .. " XP")
			shopRow(index, food.icon, food.name .. "   (you have " .. (data.food[food.id] or 0) .. ")", stats .. "  •  " .. food.desc,
				locked and ("🔒 Age " .. food.minAge) or (food.price .. " coins"), not locked, function()
					request("food", food.id, 1)
				end)
		end
	end
end

local FURNITURE_ICONS = { Furniture = "🛋️", Decor = "🪴", Toys = "🧸" }

local function showFurniture(category)
	setLayout("list")
	local data = State.data
	local index = 0
	for _, def in ipairs(FurnitureSystem.List) do
		if def.category == category and def.price then
			index += 1
			local locked = data.age < (def.minAge or 1)
			local needsPass = def.vip and not State.hasPass("VIPDecor")
			local label = Util.short(def.price) .. " coins"
			if needsPass then
				label = "💎 VIP pass"
			elseif locked then
				label = "🔒 Age " .. def.minAge
			end
			local owned = data.furniture.owned[def.id] or 0
			shopRow(index, def.vip and "💎" or FURNITURE_ICONS[category], def.name .. "   (owned " .. owned .. ")", string.format("%dx%d studs  •  %s", def.w, def.d, def.desc),
				label, not locked and not needsPass, function()
					request("furniture", def.id)
				end)
		end
	end
end

----------------------------------------------------------------------
-- Crates
----------------------------------------------------------------------
local reveal = UI.frame(gui, { Name = "CrateReveal", Color = C.dark, Transparency = 0.3, Corner = false, Visible = false, ZIndex = 40 })
reveal.Active = true
local revealCard = UI.frame(reveal, { Name = "Card", Size = UDim2.fromOffset(420, 300), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Color = C.bg, Corner = 24, ZIndex = 41 })
UI.autoScale(revealCard, "window")
local revealStroke = UI.stroke(revealCard, 6, C.sub)
local revealIcon = UI.label(revealCard, "🎁", { Name = "Icon", Size = UDim2.new(1, 0, 0, 110), Position = UDim2.fromOffset(0, 14), TextSize = 90, ZIndex = 42 })
local revealName = UI.label(revealCard, "", { Name = "ItemName", Size = UDim2.new(1, -20, 0, 50), Position = UDim2.fromOffset(10, 128), TextSize = 26, Outline = 3, ZIndex = 42 })
local revealRarity = UI.label(revealCard, "", { Name = "Rarity", Size = UDim2.new(1, 0, 0, 32), Position = UDim2.fromOffset(0, 180), TextSize = 24, Outline = 3, ZIndex = 42 })
local revealNote = UI.label(revealCard, "", { Name = "Note", Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 214), TextSize = 16, Font = UI.BodyFont, Color = C.sub, ZIndex = 42 })
local revealClose = UI.button(revealCard, "NICE", { Name = "Close", Size = UDim2.fromOffset(180, 44), Position = UDim2.new(0.5, -90, 1, -54), TextSize = 22, ZIndex = 42 }, function()
	reveal.Visible = false
end)

local function openCrate(crate)
	if busy then
		return
	end
	busy = true
	local result = State.invoke("OpenCrate", crate.id)
	if not result.ok then
		busy = false
		State.toast(result.reason or "could not open that", "bad")
		return
	end
	local item = ClothingSystem.get(result.itemId)
	reveal.Visible = true
	revealClose.Visible = false
	revealNote.Text = ""
	revealRarity.Text = ""
	revealIcon.Text = crate.icon
	revealStroke.Color = C.sub
	-- shuffle through random pieces before landing on the real one
	local pool = ClothingSystem.List
	for step = 1, 14 do
		local fake = pool[math.random(1, #pool)]
		revealName.Text = fake.name
		revealName.TextColor3 = ClothingSystem.rarityColor(fake.rarity)
		State.sound("crate")
		task.wait(0.05 + step * 0.012)
	end
	local color = ClothingSystem.rarityColor(item.rarity)
	revealIcon.Text = ClothingSystem.SlotInfo[item.slot].icon
	revealName.Text = item.name
	revealName.TextColor3 = color
	revealRarity.Text = string.upper(item.rarity)
	revealRarity.TextColor3 = color
	revealStroke.Color = color
	revealNote.Text = result.isNew and "NEW!  added to your inventory" or ("duplicate  ->  +" .. tostring(result.refund) .. " Goo Coins")
	UI.pop(revealCard, 0.8)
	revealClose.Visible = true
	busy = false
	-- the HUD plays "ARCHIVE ITEM FOUND!" / "GRAIL FOUND!" etc.
	State.announce({ item = item.id, isNew = result.isNew, refund = result.refund })
end

local function showCrates()
	setLayout("list")
	local data = State.data
	for index, crate in ipairs(ShopSystem.Crates) do
		local locked = data.age < crate.minAge
		local row = UI.row(list, { Name = "Crate_" .. crate.id, Size = UDim2.new(1, -12, 0, 92), LayoutOrder = index, StrokeColor = crate.color })
		UI.label(row, crate.icon, { Size = UDim2.fromOffset(70, 92), TextSize = 46 })
		UI.label(row, crate.name, { Size = UDim2.new(1, -260, 0, 26), Position = UDim2.fromOffset(74, 6), TextSize = 20, Color = crate.color, AlignX = Enum.TextXAlignment.Left })
		UI.label(row, crate.desc, { Size = UDim2.new(1, -260, 0, 20), Position = UDim2.fromOffset(74, 32), TextSize = 12, Font = UI.BodyFont, Color = C.sub, AlignX = Enum.TextXAlignment.Left })
		-- Odds are always shown, even though crates only cost earnable coins.
		local odds = UI.box(row, { Name = "Odds", Size = UDim2.new(1, -260, 0, 30), Position = UDim2.fromOffset(74, 56) })
		UI.list(odds, { horizontal = true, pad = 8, alignY = Enum.VerticalAlignment.Center })
		for order, entry in ipairs(ShopSystem.oddsList(crate)) do
			local text = string.format(entry.percent < 1 and "%s %.1f%%" or "%s %.0f%%", entry.rarity, entry.percent)
			UI.label(odds, text, { Size = UDim2.fromOffset(#text * 7 + 6, 26), TextSize = 12, Font = UI.BodyFont, Color = ClothingSystem.rarityColor(entry.rarity), LayoutOrder = order, Wrapped = false })
		end
		local button = UI.button(row, locked and ("🔒 Age " .. crate.minAge) or ("OPEN\n" .. Util.commas(crate.price)), { Name = "Open", Size = UDim2.fromOffset(160, 64), Position = UDim2.new(1, -170, 0, 14), Color = crate.color, TextSize = 18 }, function()
			if not locked then
				task.spawn(openCrate, crate)
			end
		end)
		UI.setEnabled(button, not locked and data.coins >= crate.price, crate.color)
	end
end

----------------------------------------------------------------------
-- Passes (optional, cosmetic / convenience only)
----------------------------------------------------------------------
local function showPasses()
	setLayout("list")
	UI.label(list, "Every pass is optional. None of them sell Goo Coins, XP or clothing - you can finish the whole game for free.", { Size = UDim2.new(1, -12, 0, 36), TextSize = 13, Font = UI.BodyFont, Color = C.sub, LayoutOrder = 0 })
	for index, pass in ipairs(Monetization.Passes) do
		local owned = State.hasPass(pass.key)
		shopRow(index, pass.icon, pass.name, pass.desc, owned and "OWNED" or (pass.id > 0 and "BUY" or "coming soon"), not owned and pass.id > 0, function()
			if owned then
				return
			end
			if pass.id > 0 then
				MarketplaceService:PromptGamePassPurchase(localPlayer, pass.id)
			else
				State.toast("that pass isn't on sale yet", "info")
			end
		end)
	end
end

function refresh()
	if not window.visible then
		return
	end
	UI.clear(list)
	detail.Visible = false
	list.Size = UDim2.new(1, 0, 1, -48)
	if current == "Clothing" then
		showClothing(false)
	elseif current == "Hair" then
		showClothing(true)
	elseif current == "Food" then
		showFood()
	elseif current == "Crates" then
		showCrates()
	elseif current == "Passes" then
		showPasses()
	else
		showFurniture(current)
	end
end

window.onShow(function(arg)
	if type(arg) == "string" and tabs.buttons[arg] then
		current = arg
		selected = nil
	end
	tabs.select(current, true)
	refresh()
end)
State.on("inventory", refresh)
State.on("furniture", refresh)
State.on("food", refresh)
State.on("age", refresh)
State.onSession("passes", refresh)
-- coins change constantly: only the buy buttons need to react
State.on("coins", function()
	if window.visible and (current == "Clothing" or current == "Hair") then
		showDetail()
	elseif window.visible and current == "Crates" and not busy then
		refresh()
	end
end)
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="ScreenGui" referent="85">
      <Properties>
        <string name="Name">SocialUI</string>
        <int name="DisplayOrder">5</int>
        <bool name="ResetOnSpawn">false</bool>
        <token name="ZIndexBehavior">1</token>
      </Properties>
      <Item class="LocalScript" referent="86">
        <Properties>
          <string name="Name">SocialUI</string>
          <string name="Source"><![CDATA[--[[
	SocialUI
	The "Inspect" window: look at another player's Brady - his age, what he
	is wearing (with rarity colours), drip score, rare pieces owned and how
	complete their collection is. You can hype the fit or visit their house.

	It is read-only: the server sends a public summary and nothing here can
	change or take the other player's items.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = ReplicatedStorage:WaitForChild("Client")
local Modules = ReplicatedStorage:WaitForChild("Modules")
local State = require(Client:WaitForChild("ClientState"))
local UI = require(Client:WaitForChild("UI"))
local Preview = require(Client:WaitForChild("Preview"))
local ClothingSystem = require(Modules:WaitForChild("ClothingSystem"))
local FashionSystem = require(Modules:WaitForChild("FashionSystem"))

local gui = script.Parent
local C = UI.Colors

State.wait()

local window = UI.window(gui, { name = "Inspect", title = "🔍 Inspect", width = 720, height = 470 })
local body = window.body

local left = UI.box(body, { Name = "Left", Size = UDim2.new(0, 240, 1, 0) })
local preview = Preview.new(left, { Size = UDim2.new(1, 0, 0, 250) })
local titleLabel = UI.label(left, "", { Name = "Title", Size = UDim2.new(1, 0, 0, 22), Position = UDim2.fromOffset(0, 254), TextSize = 15, Color = C.gold })
local stageLabel = UI.label(left, "", { Name = "Stage", Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 276), TextSize = 17, Color = C.goo })
local hypeButton = UI.button(left, "🔥 HYPE THE FIT", { Name = "Hype", Size = UDim2.new(1, 0, 0, 42), Position = UDim2.fromOffset(0, 306), Color = C.pink, TextSize = 18 })
local visitButton = UI.button(left, "🏠 Visit house", { Name = "Visit", Size = UDim2.new(1, 0, 0, 38), Position = UDim2.fromOffset(0, 354), Color = C.goo, TextSize = 16 })

local right = UI.box(body, { Name = "Right", Size = UDim2.new(1, -252, 1, 0), Position = UDim2.fromOffset(252, 0) })
local stats = UI.box(right, { Name = "Stats", Size = UDim2.new(1, 0, 0, 96) })
UI.grid(stats, 142, 44, 6)
local fitList = UI.scroll(right, { Name = "Fit", Size = UDim2.new(1, 0, 1, -104), Position = UDim2.fromOffset(0, 102) })
UI.list(fitList, { pad = 4 })

local currentUserId = nil

hypeButton.Activated:Connect(function()
	if currentUserId then
		State.send("Hype", currentUserId)
	end
end)
visitButton.Activated:Connect(function()
	if currentUserId then
		State.send("Visit", currentUserId)
		State.close()
	end
end)

local function stat(order, value, name, color)
	local tile = UI.frame(stats, { Name = "Stat" .. order, Size = UDim2.fromOffset(142, 44), Color = C.panel, Corner = 10, LayoutOrder = order })
	UI.label(tile, tostring(value), { Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 2), TextSize = 19, Color = color or C.text })
	UI.label(tile, name, { Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 26), TextSize = 11, Font = UI.BodyFont, Color = C.sub })
end

local function show(userId)
	currentUserId = nil
	window.setTitle("🔍 Inspect")
	UI.clear(stats)
	UI.clear(fitList)
	titleLabel.Text = ""
	stageLabel.Text = "loading..."
	if type(userId) ~= "number" then
		stageLabel.Text = "nobody selected"
		return
	end
	local profile = State.invoke("GetProfile", userId)
	if not window.visible then
		return
	end
	if not profile.ok then
		stageLabel.Text = profile.reason or "that player left"
		return
	end
	currentUserId = userId
	window.setTitle("🔍 " .. profile.name .. "'s Brady")
	preview.set({ age = profile.age, equipped = profile.equipped })
	titleLabel.Text = profile.title and ("« " .. profile.title .. " »") or ""
	titleLabel.TextColor3 = profile.title and FashionSystem.TitleColors[profile.title] or C.gold
	stageLabel.Text = profile.stageName .. "  •  Age " .. profile.age .. (profile.rebirths > 0 and ("  " .. string.rep("★", math.min(profile.rebirths, 5))) or "")

	stat(1, profile.drip, "drip score", C.gold)
	stat(2, profile.collection .. "%", "collection", C.goo)
	stat(3, profile.items, "items owned")
	stat(4, profile.archive, "Archive pieces", ClothingSystem.rarityColor("Archive"))
	stat(5, profile.grail, "Grail pieces", ClothingSystem.rarityColor("Grail"))
	stat(6, profile.wins, "show wins", C.pink)

	local order = 0
	for _, slot in ipairs(ClothingSystem.Slots) do
		local item = profile.equipped[slot] and ClothingSystem.get(profile.equipped[slot])
		if item then
			order += 1
			local color = ClothingSystem.rarityColor(item.rarity)
			local row = UI.row(fitList, { Name = "Worn_" .. slot, Size = UDim2.new(1, -12, 0, 40), LayoutOrder = order, StrokeColor = color })
			UI.label(row, ClothingSystem.SlotInfo[slot].icon, { Size = UDim2.fromOffset(40, 40), TextSize = 22 })
			UI.label(row, item.name, { Size = UDim2.new(1, -170, 1, 0), Position = UDim2.fromOffset(44, 0), TextSize = 15, AlignX = Enum.TextXAlignment.Left })
			UI.label(row, item.rarity, { Size = UDim2.fromOffset(110, 40), Position = UDim2.new(1, -118, 0, 0), TextSize = 14, Color = color, AlignX = Enum.TextXAlignment.Right })
		end
	end
	if order == 0 then
		UI.label(fitList, "this Brady is wearing... nothing special. yet.", { Size = UDim2.new(1, -12, 0, 40), TextSize = 14, Font = UI.BodyFont, Color = C.sub })
	end
end

window.onShow(show)
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="ScreenGui" referent="87">
      <Properties>
        <string name="Name">TutorialUI</string>
        <int name="DisplayOrder">30</int>
        <bool name="ResetOnSpawn">false</bool>
        <token name="ZIndexBehavior">1</token>
      </Properties>
      <Item class="LocalScript" referent="88">
        <Properties>
          <string name="Name">TutorialUI</string>
          <string name="Source"><![CDATA[--[[
	TutorialUI
	The first-time player experience (under a minute):

	  1. six short intro lines ("welcome to raise brady goo" ...)
	  2. guided steps that wait for the player to really do each thing:
	     feed Brady -> play with him -> earn Goo Coins -> open the wardrobe
	     -> equip clothing -> how ageing up works

	Each step watches the player's real data, so it advances the moment the
	action succeeds. Every step can be skipped, and the whole tutorial can be
	skipped. Finishing (or skipping) tells the server, which pays a one-time
	bonus and starts the random events.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = ReplicatedStorage:WaitForChild("Client")
local State = require(Client:WaitForChild("ClientState"))
local UI = require(Client:WaitForChild("UI"))

local gui = script.Parent
local C = UI.Colors

State.wait()

local INTRO = {
	"welcome to raise brady goo",
	"this is brady",
	"take care of him",
	"help him grow",
	"and eventually...",
	"make him the most archive person on roblox",
}

-- done(snapshot) returns true once the player has completed the step.
local STEPS = {
	{
		title = "1. FEED BRADY",
		text = "tap 🧒 Brady on the left, then 🍔 Feed, then FEED. (or use the kitchen in his room!)",
		done = function(start)
			return State.data.stats.feeds > start.feeds
		end,
	},
	{
		title = "2. PLAY WITH BRADY",
		text = "tap 🧒 Brady, then 🎮 Play, and pick a mini-game. playing gives Age XP and Goo Coins.",
		done = function(start)
			return State.data.stats.minigames > start.minigames
		end,
	},
	{
		title = "3. YOU EARNED GOO COINS!",
		text = "your coins are at the top of the screen. spend them in the 🛒 Shop on clothes, food and furniture.",
		auto = 5,
	},
	{
		title = "4. OPEN THE WARDROBE",
		text = "tap 👕 Wardrobe on the left.",
		done = function()
			return State.current == "Wardrobe"
		end,
	},
	{
		title = "5. EQUIP CLOTHING",
		text = "tap Change next to Shirts and pick the Plain White Tee. he really needs a shirt.",
		done = function(start)
			return State.data.equipped.Shirt ~= nil and State.data.equipped.Shirt ~= start.shirt or State.data.equipped.Pants ~= start.pants
		end,
	},
	{
		title = "6. AGE HIM UP",
		text = "everything you do fills the AGE bar at the top. fill it and Brady grows up: new looks, new clothes, a bigger house. go make him archive.",
		final = true,
	},
}

----------------------------------------------------------------------
-- UI
----------------------------------------------------------------------
local dim = UI.frame(gui, { Name = "Dim", Color = C.dark, Transparency = 0.25, Corner = false, Visible = false, ZIndex = 1 })
dim.Active = true
local introLabel = UI.label(dim, "", { Name = "Intro", Size = UDim2.new(0.86, 0, 0, 160), Position = UDim2.fromScale(0.5, 0.42), AnchorPoint = Vector2.new(0.5, 0.5), Font = UI.LoudFont, TextSize = 58, Color = C.goo, Outline = 5, ZIndex = 2 })
UI.autoScale(introLabel, "hud")
local skipAll = UI.button(dim, "skip tutorial", { Name = "SkipAll", Size = UDim2.fromOffset(200, 44), Position = UDim2.new(0.5, -100, 1, -70), Color = C.sub, TextSize = 18, ZIndex = 3 })

local card = UI.frame(gui, { Name = "Step", Size = UDim2.fromOffset(470, 150), Position = UDim2.new(1, -16, 1, -150), AnchorPoint = Vector2.new(1, 1), Color = C.bg, Corner = 18, Stroke = 4, StrokeColor = C.gold, Visible = false, ZIndex = 5 })
UI.autoScale(card, "hud")
local stepTitle = UI.label(card, "", { Name = "Title", Size = UDim2.new(1, -24, 0, 30), Position = UDim2.fromOffset(12, 8), TextSize = 22, Color = C.gold, AlignX = Enum.TextXAlignment.Left, Outline = 2, ZIndex = 6 })
local stepText = UI.label(card, "", { Name = "Text", Size = UDim2.new(1, -24, 0, 62), Position = UDim2.fromOffset(12, 40), TextSize = 15, Font = UI.BodyFont, AlignX = Enum.TextXAlignment.Left, AlignY = Enum.TextYAlignment.Top, ZIndex = 6 })
local stepButton = UI.button(card, "skip step", { Name = "Next", Size = UDim2.fromOffset(150, 34), Position = UDim2.new(1, -162, 1, -42), Color = C.sub, TextSize = 15, Corner = 10, ZIndex = 6 })
local stepSkipAll = UI.button(card, "skip all", { Name = "SkipAll", Size = UDim2.fromOffset(110, 34), Position = UDim2.new(0, 12, 1, -42), Color = C.panel2, TextColor = C.sub, TextSize = 14, Corner = 10, ZIndex = 6 })
local arrow = UI.label(gui, "👈", { Name = "Arrow", Size = UDim2.fromOffset(70, 70), Position = UDim2.new(0, 190, 0.5, -30), TextSize = 56, ZIndex = 5 })
UI.autoScale(arrow, "hud")
arrow.Visible = false

local running = false
local skipRequested = false
local stepRequested = false

skipAll.Activated:Connect(function()
	skipRequested = true
end)
stepSkipAll.Activated:Connect(function()
	skipRequested = true
end)
stepButton.Activated:Connect(function()
	State.sound("click")
	stepRequested = true
end)

local function finish()
	dim.Visible = false
	card.Visible = false
	arrow.Visible = false
	running = false
	State.send("Tutorial", "Done")
end

local function run()
	if running then
		return
	end
	running = true
	skipRequested = false
	State.close()

	-- 1. intro lines
	dim.Visible = true
	for _, line in ipairs(INTRO) do
		if skipRequested then
			break
		end
		introLabel.Text = line
		UI.pop(introLabel, 0.6)
		State.sound("notify")
		local waited = 0
		while waited < 1.7 and not skipRequested do
			waited += task.wait(0.1)
		end
	end
	dim.Visible = false
	if skipRequested then
		finish()
		return
	end

	-- 2. guided steps
	card.Visible = true
	for _, step in ipairs(STEPS) do
		if skipRequested then
			break
		end
		stepRequested = false
		stepTitle.Text = step.title
		stepText.Text = step.text
		stepButton.Text = step.final and "LET'S GO!" or (step.auto and "got it" or "skip step")
		stepButton.BackgroundColor3 = (step.final or step.auto) and C.goo or C.sub
		arrow.Visible = step.done ~= nil
		UI.pop(card, 0.85)
		local start = {
			feeds = State.data.stats.feeds,
			minigames = State.data.stats.minigames,
			shirt = State.data.equipped.Shirt,
			pants = State.data.equipped.Pants,
		}
		local elapsed = 0
		while not skipRequested and not stepRequested do
			elapsed += task.wait(0.2)
			if step.done and step.done(start) then
				State.sound("good")
				break
			end
			if step.auto and elapsed >= step.auto then
				break
			end
			-- nudge the arrow so the player notices the menu buttons
			if arrow.Visible then
				arrow.Rotation = math.sin(elapsed * 6) * 12
			end
		end
	end
	finish()
end

-- Start for brand new players, and again if "Replay tutorial" is pressed.
State.on("tutorialDone", function(done)
	if done == false and not running then
		task.delay(1.5, function()
			if State.data.tutorialDone == false then
				run()
			end
		end)
	end
end)

]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="ScreenGui" referent="89">
      <Properties>
        <string name="Name">WardrobeUI</string>
        <int name="DisplayOrder">5</int>
        <bool name="ResetOnSpawn">false</bool>
        <token name="ZIndexBehavior">1</token>
      </Properties>
      <Item class="LocalScript" referent="90">
        <Properties>
          <string name="Name">WardrobeUI</string>
          <string name="Source"><![CDATA[--[[
	WardrobeUI
	Dress Brady with a live 3D preview.
	  * "Brady's Fit" - one row per clothing slot; tap a slot to pick a piece
	  * saved outfit slots (3 free, 8 with the optional gamepass)
	  * "My Style" - the wearable gifts Brady has given the PLAYER's avatar

	The preview is built locally with BradyBuilder from the server's data, so
	it always matches the real Brady everyone else sees.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = ReplicatedStorage:WaitForChild("Client")
local Modules = ReplicatedStorage:WaitForChild("Modules")
local State = require(Client:WaitForChild("ClientState"))
local UI = require(Client:WaitForChild("UI"))
local Preview = require(Client:WaitForChild("Preview"))
local AgeSystem = require(Modules:WaitForChild("AgeSystem"))
local ClothingSystem = require(Modules:WaitForChild("ClothingSystem"))
local Config = require(Modules:WaitForChild("Config"))
local GiftSystem = require(Modules:WaitForChild("GiftSystem"))
local InventorySystem = require(Modules:WaitForChild("InventorySystem"))

local gui = script.Parent
local C = UI.Colors

State.wait()

local window = UI.window(gui, { name = "Wardrobe", title = "👕 Wardrobe", width = 850, height = 500 })
local body = window.body

----------------------------------------------------------------------
-- LEFT: preview + outfits
----------------------------------------------------------------------
local left = UI.box(body, { Name = "Left", Size = UDim2.new(0, 250, 1, 0) })
local preview = Preview.new(left, { Size = UDim2.new(1, 0, 0, 236) })
local dripLabel = UI.label(left, "", { Name = "Drip", Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 240), TextSize = 17, Color = C.gold, Outline = 2 })
UI.label(left, "SAVED OUTFITS", { Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 268), TextSize = 13, Color = C.sub })
local outfitList = UI.scroll(left, { Name = "Outfits", Size = UDim2.new(1, 0, 1, -290), Position = UDim2.fromOffset(0, 288) })
UI.list(outfitList, { pad = 4 })

local function refreshOutfits()
	UI.clear(outfitList)
	local slots = State.hasPass("ExtraOutfits") and Config.OutfitSlotsWithPass or Config.OutfitSlots
	for index = 1, slots do
		local saved = State.data.outfits[tostring(index)]
		local row = UI.box(outfitList, { Name = "Outfit" .. index, Size = UDim2.new(1, -10, 0, 34), LayoutOrder = index })
		local wear = UI.button(row, saved and ("Wear #" .. index) or ("#" .. index .. " empty"), { Size = UDim2.new(0.58, -3, 1, 0), Color = C.goo, TextSize = 15, Corner = 10 }, function()
			if State.data.outfits[tostring(index)] then
				State.send("LoadOutfit", index)
			else
				State.toast("save an outfit in this slot first", "bad")
			end
		end)
		UI.setEnabled(wear, saved ~= nil)
		UI.button(row, "Save", { Size = UDim2.new(0.42, -3, 1, 0), Position = UDim2.new(0.58, 3, 0, 0), Color = C.blue, TextColor = C.text, TextSize = 15, Corner = 10 }, function()
			State.send("SaveOutfit", index)
		end)
	end
	if slots == Config.OutfitSlots then
		UI.label(outfitList, "+5 slots with the Extra Outfit Slots pass", { Size = UDim2.new(1, -10, 0, 30), TextSize = 11, Font = UI.BodyFont, Color = C.sub, LayoutOrder = 99 })
	end
end

----------------------------------------------------------------------
-- RIGHT: tabs
----------------------------------------------------------------------
local right = UI.box(body, { Name = "Right", Size = UDim2.new(1, -262, 1, 0), Position = UDim2.fromOffset(262, 0) })
local mode = "Fit" -- "Fit" | "Style"
local pickingSlot = nil
local refresh

local tabs = UI.tabs(right, { { id = "Fit", text = "🧒 Brady's Fit" }, { id = "Style", text = "🧍 My Style (gifts)" } }, function(id)
	mode = id
	pickingSlot = nil
	refresh()
end, { Width = 560, TextSize = 15 })

local content = UI.scroll(right, { Name = "Content", Size = UDim2.new(1, 0, 1, -48), Position = UDim2.fromOffset(0, 46) })
local contentLayout

local function setLayout(kind)
	if contentLayout then
		contentLayout:Destroy()
	end
	if kind == "grid" then
		contentLayout = UI.grid(content, 104, 122, 8)
	else
		contentLayout = UI.list(content, { pad = 5 })
	end
end

-- Slot overview: one row per clothing slot.
local function showSlots()
	setLayout("list")
	local data = State.data
	for index, slot in ipairs(ClothingSystem.Slots) do
		local info = ClothingSystem.SlotInfo[slot]
		local item = data.equipped[slot] and ClothingSystem.get(data.equipped[slot])
		local unlocked = AgeSystem.isSlotUnlocked(slot, data.age)
		local row = UI.row(content, { Name = "Slot_" .. slot, Size = UDim2.new(1, -12, 0, 42), LayoutOrder = index, StrokeColor = item and ClothingSystem.rarityColor(item.rarity) or nil })
		UI.label(row, info.icon, { Size = UDim2.fromOffset(40, 42), TextSize = 24 })
		UI.label(row, info.plural, { Size = UDim2.fromOffset(110, 42), Position = UDim2.fromOffset(42, 0), TextSize = 15, AlignX = Enum.TextXAlignment.Left })
		local text, color = "nothing", C.sub
		if not unlocked then
			text = "🔒 unlocks at age " .. AgeSystem.slotUnlockAge(slot)
		elseif item then
			text, color = item.name, ClothingSystem.rarityColor(item.rarity)
		elseif slot == "Hair" then
			text = "stage default"
		end
		UI.label(row, text, { Size = UDim2.new(1, -330, 1, 0), Position = UDim2.fromOffset(152, 0), TextSize = 14, Font = UI.BodyFont, Color = color, AlignX = Enum.TextXAlignment.Left })
		if unlocked then
			UI.button(row, "Change", { Name = "Change", Size = UDim2.fromOffset(100, 32), Position = UDim2.new(1, -150, 0, 5), Color = C.pink, TextSize = 15, Corner = 10 }, function()
				pickingSlot = slot
				refresh()
			end)
			if item then
				UI.button(row, "X", { Name = "Remove", Size = UDim2.fromOffset(36, 32), Position = UDim2.new(1, -44, 0, 5), Color = C.red, TextColor = C.text, TextSize = 16, Corner = 10 }, function()
					State.send("Unequip", slot)
				end)
			end
		end
	end
end

-- Picker: every owned piece for one slot.
local function showPicker(slot)
	setLayout("grid")
	local data = State.data
	local back = UI.button(content, "< Back", { Name = "Back", Size = UDim2.fromOffset(104, 122), Color = C.panel2, TextColor = C.text, TextSize = 18, LayoutOrder = 0 }, function()
		pickingSlot = nil
		refresh()
	end)
	back.Name = "Back"
	local items = InventorySystem.ownedItems(data, slot)
	for index, item in ipairs(items) do
		local ok, reason = InventorySystem.canEquip(data, item.id)
		UI.itemCard(content, item, {
			LayoutOrder = index,
			equipped = data.equipped[slot] == item.id,
			locked = not ok and ("Age " .. item.age) or nil,
		}, function()
			if not ok then
				State.toast(reason, "bad")
			elseif State.data.equipped[slot] == item.id then
				State.send("Unequip", slot)
			else
				State.send("Equip", item.id)
			end
		end)
	end
	if #items == 0 then
		UI.label(content, "no " .. ClothingSystem.SlotInfo[slot].plural .. " yet - check the Shop!", { Size = UDim2.fromOffset(104, 122), TextSize = 13, Font = UI.BodyFont, Color = C.sub, LayoutOrder = 1 })
	end
end

-- Gifts for the player's own avatar.
local function showGifts()
	setLayout("list")
	local data = State.data
	for index, gift in ipairs(GiftSystem.List) do
		local owned = data.gifts.owned[gift.id] == true
		local equipped = data.gifts.equipped[gift.slot] == gift.id
		local row = UI.row(content, { Name = "Gift_" .. gift.id, Size = UDim2.new(1, -12, 0, 56), LayoutOrder = index, StrokeColor = equipped and C.goo or nil })
		local swatch = UI.frame(row, { Size = UDim2.fromOffset(44, 44), Position = UDim2.fromOffset(6, 6), Color = gift.color, Corner = 10 })
		UI.label(swatch, owned and "🎁" or "🔒", { TextSize = 24 })
		UI.label(row, gift.name .. "  (" .. gift.slot .. ")", { Size = UDim2.new(1, -200, 0, 24), Position = UDim2.fromOffset(58, 5), TextSize = 16, AlignX = Enum.TextXAlignment.Left })
		UI.label(row, owned and gift.desc or ("Brady gifts you this when he turns " .. gift.age), { Size = UDim2.new(1, -200, 0, 22), Position = UDim2.fromOffset(58, 29), TextSize = 12, Font = UI.BodyFont, Color = C.sub, AlignX = Enum.TextXAlignment.Left })
		if owned then
			UI.button(row, equipped and "Take off" or "Wear", { Name = "Wear", Size = UDim2.fromOffset(120, 38), Position = UDim2.new(1, -128, 0, 9), Color = equipped and C.red or C.goo, TextColor = equipped and C.text or C.dark, TextSize = 16, Corner = 10 }, function()
				if equipped then
					State.send("UnequipGift", gift.slot)
				else
					State.send("EquipGift", gift.id)
				end
			end)
		end
	end
end

function refresh()
	if not window.visible then
		return
	end
	local data = State.data
	preview.set({ age = data.age, equipped = data.equipped })
	local drip = InventorySystem.dripScore(data.equipped)
	local verdict = InventorySystem.isBadFit(data.equipped) and "the fit is NOT it" or (drip >= 40 and "ARCHIVE LEVEL DRIP" or drip >= 24 and "dripped out" or drip >= 10 and "getting there" or "kinda basic")
	dripLabel.Text = string.format("Drip %d  •  %s", math.floor(drip), verdict)
	UI.clear(content)
	if mode == "Style" then
		showGifts()
	elseif pickingSlot then
		showPicker(pickingSlot)
	else
		showSlots()
	end
	refreshOutfits()
end

window.onShow(function(arg)
	pickingSlot = nil
	if arg == "Style" then
		mode = "Style"
	else
		mode = "Fit"
	end
	tabs.select(mode, true)
	refresh()
end)
State.on("equipped", refresh)
State.on("inventory", refresh)
State.on("outfits", refresh)
State.on("gifts", refresh)
State.on("age", refresh)
State.onSession("passes", refresh)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="91">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="92">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="93">
        <Properties>
          <string name="Name">BradyClient</string>
          <string name="Source"><![CDATA[--[[
	BradyClient
	Everything visual about Bradys that only needs to exist on each player's
	screen: the procedural animation, speech bubbles, emote pop-ups, confetti
	and the low-graphics switch.
]]

local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Client = ReplicatedStorage:WaitForChild("Client")
local State = require(Client:WaitForChild("ClientState"))
local Animator = require(Client:WaitForChild("BradyAnimator"))

local localPlayer = Players.LocalPlayer
local TAG = "BradyGoo"
local FX_TAG = "BradyFx"

local rgb = Color3.fromRGB

Animator.start()

local function isMine(model)
	return model:GetAttribute("OwnerUserId") == localPlayer.UserId
end

----------------------------------------------------------------------
-- Billboards: speech bubbles + emoji emotes
----------------------------------------------------------------------
local function headOf(model)
	return model:FindFirstChild("Head")
end

local function showBubble(model)
	local head = headOf(model)
	local text = model:GetAttribute("SayText")
	if not head or type(text) ~= "string" or text == "" then
		return
	end
	-- Idle chatter can be switched off in Settings.
	if model:GetAttribute("SayIdle") and State.setting("chatter") == false then
		return
	end
	local old = head:FindFirstChild("Bubble")
	if old then
		old:Destroy()
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "Bubble"
	gui.Size = UDim2.fromScale(9, 1.9)
	gui.StudsOffsetWorldSpace = Vector3.new(0, head.Size.Y / 2 + 4.6, 0)
	gui.MaxDistance = 60
	gui.LightInfluence = 0
	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = Color3.new(1, 1, 1)
	frame.BorderSizePixel = 0
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.4, 0)
	corner.Parent = frame
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = rgb(30, 27, 48)
	stroke.Parent = frame
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(0.92, 0.8)
	label.Position = UDim2.fromScale(0.04, 0.1)
	label.Font = Enum.Font.FredokaOne
	label.Text = text
	label.TextScaled = true
	label.TextColor3 = rgb(30, 27, 48)
	label.Parent = frame
	frame.Parent = gui
	gui.Parent = head
	Debris:AddItem(gui, 3.4)
end

-- A big emoji that floats up from his head.
local function emote(model, text, seconds)
	local head = headOf(model)
	if not head then
		return nil
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "Emote"
	gui.Size = UDim2.fromScale(3, 3)
	gui.StudsOffsetWorldSpace = Vector3.new(1.6, head.Size.Y / 2 + 1, 0)
	gui.MaxDistance = 70
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.Text = text
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.3
	label.Parent = gui
	gui.Parent = head
	TweenService:Create(gui, TweenInfo.new(seconds, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
		StudsOffsetWorldSpace = Vector3.new(1.6, head.Size.Y / 2 + 3.4, 0),
	}):Play()
	Debris:AddItem(gui, seconds)
	return gui
end

local function confetti(model)
	local root = model.PrimaryPart
	if not root or State.setting("lowGfx") then
		return
	end
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "Confetti"
	emitter.Rate = 0
	emitter.Lifetime = NumberRange.new(1.4, 2.4)
	emitter.Speed = NumberRange.new(22, 38)
	emitter.SpreadAngle = Vector2.new(38, 38)
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.Acceleration = Vector3.new(0, -42, 0)
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-260, 260)
	emitter.Size = NumberSequence.new(0.45, 0.25)
	emitter.LightEmission = 0.4
	emitter.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, rgb(255, 90, 90)),
		ColorSequenceKeypoint.new(0.3, rgb(255, 220, 80)),
		ColorSequenceKeypoint.new(0.6, rgb(126, 232, 74)),
		ColorSequenceKeypoint.new(1, rgb(100, 200, 255)),
	})
	emitter.Parent = root
	emitter:Emit(70)
	Debris:AddItem(emitter, 3)
end

----------------------------------------------------------------------
-- Reactions to state changes (the animator tells us when a state starts)
----------------------------------------------------------------------
local EMOTES = {
	Sleep = { "💤", 30 },
	Dance = { "🎵", 3 },
	Embarrassed = { "💦", 2.5 },
	Shower = { "🫧", 4 },
	Brush = { "✨", 2.5 },
	ShoeClean = { "✨", 2.5 },
	Play = { "⭐", 3 },
	Mirror = { "😎", 2.5 },
	Excited = { "❗", 2 },
}

Animator.onStateChanged(function(model, state, old)
	local head = headOf(model)
	if head and old then
		local previous = head:FindFirstChild("Emote")
		if previous and (old == "Sleep" or state == "Idle") then
			previous:Destroy()
		end
	end
	local mine = isMine(model)
	if state == "Eat" then
		emote(model, model:GetAttribute("EatIcon") or "🍽️", 3)
		if mine then
			State.sound("eat")
		end
	elseif state == "Celebrate" then
		confetti(model)
	elseif state == "Trip" then
		emote(model, "💥", 1.2)
		if mine then
			State.sound("trip")
		end
	elseif state == "GrailSpawn" then
		emote(model, "🏆", 2.6)
		confetti(model)
		if mine then
			State.sound("grail")
		end
	elseif state == "Shower" and mine then
		State.sound("splash")
	end
	local def = EMOTES[state]
	if def then
		emote(model, def[1], def[2])
	end
end)

----------------------------------------------------------------------
-- Per-model hooks
----------------------------------------------------------------------
local hooked = {}

local function hook(model)
	if hooked[model] then
		return
	end
	hooked[model] = true
	model:GetAttributeChangedSignal("SaySeq"):Connect(function()
		showBubble(model)
	end)
	model.Destroying:Connect(function()
		hooked[model] = nil
	end)
end

for _, model in ipairs(CollectionService:GetTagged(TAG)) do
	hook(model)
end
CollectionService:GetInstanceAddedSignal(TAG):Connect(hook)

-- Server-triggered world effects.
State.listen("Effect", function(kind, payload)
	if kind == "Confetti" and type(payload) == "table" then
		for _, model in ipairs(CollectionService:GetTagged(TAG)) do
			if model:GetAttribute("OwnerUserId") == payload.userId then
				confetti(model)
			end
		end
	end
end)

----------------------------------------------------------------------
-- Low graphics mode: fewer animated Bradys, no clothing particles
----------------------------------------------------------------------
local function applyFx(instance, low)
	if instance:IsA("ParticleEmitter") or instance:IsA("PointLight") then
		instance.Enabled = not low
	end
end

local function applyLowGraphics(low)
	Animator.setLowGraphics(low == true)
	for _, instance in ipairs(CollectionService:GetTagged(FX_TAG)) do
		applyFx(instance, low == true)
	end
end

CollectionService:GetInstanceAddedSignal(FX_TAG):Connect(function(instance)
	applyFx(instance, State.setting("lowGfx") == true)
end)

State.on("settings", function(settings)
	applyLowGraphics(settings and settings.lowGfx)
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="94">
        <Properties>
          <string name="Name">WorldClient</string>
          <string name="Source"><![CDATA[--[[
	WorldClient
	Small per-player world behaviours:
	  * roofs fade away while you are standing under them (so you can see
	    inside houses, the store, the arcade and the cave)
	  * prompts that belong to another player's house are hidden
	  * prompts that open a menu (shop counter, arcade machines, a Brady) do so
	  * hidden goo blobs you already collected today disappear for you only
	  * optional background music
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Client = ReplicatedStorage:WaitForChild("Client")
local Modules = ReplicatedStorage:WaitForChild("Modules")
local State = require(Client:WaitForChild("ClientState"))
local Sounds = require(Modules:WaitForChild("Sounds"))

local localPlayer = Players.LocalPlayer

----------------------------------------------------------------------
-- Roofs
----------------------------------------------------------------------
local ROOF_TAG = "HouseRoof"
local roofHidden = {} -- [part] = true while faded out

local function setRoof(part, hidden)
	if roofHidden[part] == hidden then
		return
	end
	roofHidden[part] = hidden
	TweenService:Create(part, TweenInfo.new(0.3), { LocalTransparencyModifier = hidden and 1 or 0 }):Play()
end

task.spawn(function()
	while true do
		task.wait(0.25)
		local character = localPlayer.Character
		local hrp = character and character:FindFirstChild("HumanoidRootPart")
		if hrp then
			local position = hrp.CFrame.Position
			for _, roof in ipairs(CollectionService:GetTagged(ROOF_TAG)) do
				local localPosition = roof.CFrame:PointToObjectSpace(position)
				local half = roof.Size / 2
				local under = math.abs(localPosition.X) <= half.X and math.abs(localPosition.Z) <= half.Z and localPosition.Y < 0 and localPosition.Y > -60
				setRoof(roof, under)
			end
		end
	end
end)

----------------------------------------------------------------------
-- Prompts
----------------------------------------------------------------------
local OWNER_TAG = "OwnerPrompt"

local function filterPrompt(prompt)
	if prompt:IsA("ProximityPrompt") then
		prompt.Enabled = prompt:GetAttribute("OwnerUserId") == localPlayer.UserId
	end
end

for _, prompt in ipairs(CollectionService:GetTagged(OWNER_TAG)) do
	filterPrompt(prompt)
end
CollectionService:GetInstanceAddedSignal(OWNER_TAG):Connect(filterPrompt)

ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
	if player ~= localPlayer then
		return
	end
	local panel = prompt:GetAttribute("Panel")
	if panel then
		-- shop counters, crate machines, food stalls, arcade machines
		State.open(panel, prompt:GetAttribute("PanelArg"))
	elseif prompt.Name == "InspectPrompt" then
		local owner = prompt:GetAttribute("OwnerUserId")
		if owner == localPlayer.UserId then
			State.open("Brady")
		elseif owner and owner ~= 0 then
			State.open("Inspect", owner)
		end
	end
end)

----------------------------------------------------------------------
-- Hidden goo blobs (per-player visibility)
----------------------------------------------------------------------
local HIDDEN_TAG = "HiddenGoo"

local function setBlobVisible(blob, visible)
	blob.LocalTransparencyModifier = visible and 0 or 1
end

local function refreshBlobs()
	local data = State.data
	if not data then
		return
	end
	local today = State.session.day
	local found = data.daily.hiddenDay == today and data.daily.hidden or {}
	for _, blob in ipairs(CollectionService:GetTagged(HIDDEN_TAG)) do
		setBlobVisible(blob, not found[tostring(blob:GetAttribute("Index"))])
	end
end

State.on("daily", refreshBlobs)
State.onSession("day", refreshBlobs)
CollectionService:GetInstanceAddedSignal(HIDDEN_TAG):Connect(function()
	task.defer(refreshBlobs)
end)
State.listen("HiddenFound", function(index)
	for _, blob in ipairs(CollectionService:GetTagged(HIDDEN_TAG)) do
		if blob:GetAttribute("Index") == index then
			setBlobVisible(blob, false)
		end
	end
	State.sound("coin")
end)

----------------------------------------------------------------------
-- Background music (off unless Sounds.Music is set to an asset id)
----------------------------------------------------------------------
if Sounds.Music ~= "" then
	local music = Instance.new("Sound")
	music.Name = "Music"
	music.SoundId = Sounds.Music
	music.Volume = Sounds.MusicVolume
	music.Looped = true
	music.Parent = SoundService
	State.on("settings", function(settings)
		if settings and settings.music == false then
			music:Stop()
		elseif not music.IsPlaying then
			music:Play()
		end
	end)
end
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="95">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
    <Item class="Part" referent="96">
      <Properties>
        <string name="Name">SafetyFloor</string>
        <bool name="Anchored">true</bool>
        <CoordinateFrame name="CFrame">
          <X>0</X>
          <Y>-8</Y>
          <Z>150</Z>
          <R00>1</R00>
          <R01>0</R01>
          <R02>0</R02>
          <R10>0</R10>
          <R11>1</R11>
          <R12>0</R12>
          <R20>0</R20>
          <R21>0</R21>
          <R22>1</R22>
        </CoordinateFrame>
        <bool name="CanCollide">true</bool>
        <bool name="CastShadow">false</bool>
        <Vector3 name="size">
          <X>700</X>
          <Y>1</Y>
          <Z>960</Z>
        </Vector3>
        <float name="Transparency">1</float>
      </Properties>
    </Item>
  </Item>
</roblox>