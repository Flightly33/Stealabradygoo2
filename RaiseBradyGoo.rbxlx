add({ id = "hair_slick", name = "Slick Back", slot = "Hair", rarity = "Rare", age = 16, drop = false, source = "Age 16 reward", desc = "aerodynamic.", vis = { style = "slick" } })
add({ id = "hair_layers", name = "Archive Layers", slot = "Hair", rarity = "Epic", age = 18, drop = false, source = "Age 18 reward", desc = "messy on purpose. took two hours.", vis = { style = "layers" } })
add({ id = "hair_shag", name = "Vintage Shag", slot = "Hair", rarity = "Epic", age = 21, drop = false, source = "Age 21 reward", desc = "business in the front. archive in the back.", vis = { style = "shag" } })
add({ id = "hair_legend", name = "Legendary Flow", slot = "Hair", rarity = "Legendary", age = 25, drop = false, source = "Age 25 reward", fx = "gold", desc = "golden tips. godly flow.", vis = { style = "legend", color2 = GOLD } })
-- Shop hairstyles
add({ id = "hair_buzz", name = "Buzz Cut", slot = "Hair", rarity = "Common", age = 5, price = 100, desc = "low maintenance king.", vis = { style = "buzz" } })
add({ id = "hair_mohawk", name = "Goo Mohawk", slot = "Hair", rarity = "Uncommon", age = 5, price = 300, tags = { "funny", "street" }, desc = "punk's not dead. it's just sticky.", vis = { style = "mohawk" } })
add({ id = "hair_puff", name = "Goo Puff", slot = "Hair", rarity = "Rare", age = 8, price = 800, desc = "big. round. glorious.", vis = { style = "puff" } })
add({ id = "hair_buns", name = "Space Buns", slot = "Hair", rarity = "Rare", age = 10, price = 900, tags = { "funny" }, desc = "two buns. double the antenna reception.", vis = { style = "buns" } })
add({ id = "hair_rockstar", name = "Rockstar Long Hair", slot = "Hair", rarity = "Epic", age = 13, price = 2200, tags = { "vintage" }, desc = "has never touched a guitar.", vis = { style = "long" } })
add({ id = "hair_bleach", name = "Bleached Tips", slot = "Hair", rarity = "Epic", age = 16, price = 2800, tags = { "vintage", "street" }, desc = "the year is 1999 forever.", vis = { style = "spiky", color2 = rgb(250, 240, 180) } })
add({ id = "hair_flame", name = "Flame Hair", slot = "Hair", rarity = "Legendary", age = 16, tags = { "funny" }, fx = "flame", desc = "his head is on fire. he's fine with it.", vis = { style = "mohawk", color = rgb(255, 120, 30), color2 = rgb(255, 220, 60) } })

-- SECRET ITEMS (hidden around the map - cosmetic collectibles) -------------
add({ id = "mystery_jacket", name = "Mystery Jacket", slot = "Jacket", rarity = "Archive", age = 1, drop = false, secret = true, source = "Secret: the Goo Cave", tags = { "vintage", "luxury" }, fx = "void",
	desc = "nobody knows who made it. nobody knows why it hums.", vis = { color = rgb(40, 20, 70), sleeve = rgb(20, 10, 40), trim = rgb(170, 90, 255), bulk = 0.28, length = 0.8, hood = true, material = "Fabric" } })
add({ id = "invisible_shoes", name = "Invisible Shoes", slot = "Shoes", rarity = "Legendary", age = 1, drop = false, secret = true, source = "Secret: rare world spawn", tags = { "funny" },
	desc = "trust me. they're there. they're fire.", vis = { color = WHITE, sole = WHITE, invisible = true } })
add({ id = "ancient_goo_hat", name = "Ancient Goo Hat", slot = "Hat", rarity = "Archive", age = 1, drop = false, secret = true, source = "Secret: rare world spawn", tags = { "vintage", "funny" }, fx = "goo",
	desc = "worn by the first brady. ten thousand years ago.", vis = { kind = "ancient", color = rgb(96, 132, 70), color2 = GOLD } })
add({ id = "golden_shopping_bag", name = "Golden Shopping Bag", slot = "Accessory", rarity = "Archive", age = 1, drop = false, secret = true, source = "Secret: rare world spawn", tags = { "luxury" }, fx = "gold",
	desc = "the bag costs more than what's inside.", vis = { kind = "tote", color = GOLD, color2 = WHITE, shiny = true } })
add({ id = "giant_goo_chain", name = "Giant Goo Chain", slot = "Accessory", rarity = "Legendary", age = 1, drop = false, secret = true, source = "Secret: rare world spawn", tags = { "funny", "street" }, fx = "goo",
	desc = "weighs 40 pounds. his neck is fine. probably.", vis = { kind = "chain", color = GOLD, color2 = GOO, size = 2.6 } })
add({ id = "golden_goo", name = "Golden Goo", slot = "Accessory", rarity = "Grail", age = 1, drop = false, secret = true, source = "Secret: ultra rare world spawn", tags = { "luxury", "funny" }, fx = "gold", nameplate = "Grail", pose = "GrailFloat",
	desc = "a blob of pure golden goo. it follows him around.", vis = { kind = "orb", color = GOLD, color2 = rgb(255, 240, 160) } })

----------------------------------------------------------------------
-- LOOKUPS
----------------------------------------------------------------------
ClothingSystem.BySlot = {}
ClothingSystem.ByRarity = {}
ClothingSystem.SecretIds = {}
for _, slot in ipairs(ClothingSystem.Slots) do
	ClothingSystem.BySlot[slot] = {}
end
for _, rarity in ipairs(ClothingSystem.RarityOrder) do
	ClothingSystem.ByRarity[rarity] = {}
end
for _, item in ipairs(ClothingSystem.List) do
	table.insert(ClothingSystem.BySlot[item.slot], item)
	table.insert(ClothingSystem.ByRarity[item.rarity], item)
	if item.secret then
		table.insert(ClothingSystem.SecretIds, item.id)
	end
end

function ClothingSystem.get(id)
	return ClothingSystem.Items[id]
end

function ClothingSystem.rarityColor(rarity)
	local info = ClothingSystem.Rarities[rarity]
	return info and info.color or Color3.new(1, 1, 1)
end

function ClothingSystem.rarityOrder(rarity)
	local info = ClothingSystem.Rarities[rarity]
	return info and info.order or 0
end

-- Sort helper: rarest first, then by age requirement, then name.
function ClothingSystem.sortItems(list)
	table.sort(list, function(a, b)
		local ra, rb = ClothingSystem.rarityOrder(a.rarity), ClothingSystem.rarityOrder(b.rarity)
		if ra ~= rb then
			return ra > rb
		end
		if a.age ~= b.age then
			return a.age < b.age
		end
		return a.name < b.name
	end)
	return list
end

-- The colour used for an item's inventory tile.
function ClothingSystem.swatch(item)
	local vis = item.vis
	if item.slot == "Outfit" then
		return (vis.jacket and vis.jacket.color) or vis.shirt.color
	elseif item.slot == "Hair" then
		return vis.color or GOO
	end
	return vis.color or GOO
end

return ClothingSystem
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">CollectionSystem</string>
          <string name="Source"><![CDATA[--[[
	CollectionSystem
	The collection book: groups of things to collect, how complete each group
	is, and the reward for finishing one. Rewards are claimed through
	Services/CollectionServer, which re-checks completion on the server.
]]

local Modules = script.Parent
local ClothingSystem = require(Modules.ClothingSystem)
local FurnitureSystem = require(Modules.FurnitureSystem)
local AchievementSystem = require(Modules.AchievementSystem)

local CollectionSystem = {}

local function clothingIds(predicate)
	local ids = {}
	for _, item in ipairs(ClothingSystem.List) do
		if predicate(item) then
			table.insert(ids, item.id)
		end
	end
	return ids
end

local function slotSet(slots)
	return function(item)
		return not item.secret and table.find(slots, item.slot) ~= nil
	end
end

local furnitureIds = {}
for _, def in ipairs(FurnitureSystem.List) do
	if not def.vip then
		table.insert(furnitureIds, def.id)
	end
end

local achievementIds = {}
for _, def in ipairs(AchievementSystem.List) do
	table.insert(achievementIds, def.id)
end

-- kind: "clothing" (data.inventory), "furniture" (data.furniture.owned),
--       "achievement" (data.achievements)
CollectionSystem.List = {
	{ id = "basics", name = "Tops & Bottoms", icon = "👕", kind = "clothing", coins = 2500,
		ids = clothingIds(slotSet({ "Shirt", "Pants", "Jacket" })) },
	{ id = "shoes", name = "Shoe Collection", icon = "👟", kind = "clothing", coins = 3000,
		ids = clothingIds(slotSet({ "Shoes" })) },
	{ id = "accessories", name = "Accessory Collection", icon = "📿", kind = "clothing", coins = 4000,
		ids = clothingIds(slotSet({ "Accessory", "Hat", "Glasses" })) },
	{ id = "outfits", name = "Outfit Collection", icon = "✨", kind = "clothing", coins = 6000,
		ids = clothingIds(slotSet({ "Outfit" })) },
	{ id = "hair", name = "Hairstyle Collection", icon = "💇", kind = "clothing", coins = 2500,
		ids = clothingIds(slotSet({ "Hair" })) },
	{ id = "archive", name = "Archive Collection", icon = "🗄️", kind = "clothing", coins = 15000,
		ids = clothingIds(function(item)
			return item.rarity == "Archive"
		end) },
	{ id = "grail", name = "Grail Collection", icon = "🏆", kind = "clothing", coins = 100000, title = "Collection Master",
		ids = clothingIds(function(item)
			return item.rarity == "Grail"
		end) },
	{ id = "rare", name = "Secret Items", icon = "❓", kind = "clothing", coins = 20000, title = "Collection Master",
		ids = clothingIds(function(item)
			return item.secret == true
		end) },
	{ id = "furniture", name = "Furniture Collection", icon = "🛋️", kind = "furniture", coins = 5000, ids = furnitureIds },
	{ id = "achievements", name = "Achievements", icon = "🏅", kind = "achievement", coins = 10000, ids = achievementIds },
}

CollectionSystem.ById = {}
for _, collection in ipairs(CollectionSystem.List) do
	CollectionSystem.ById[collection.id] = collection
end

function CollectionSystem.has(data, collection, id)
	if collection.kind == "clothing" then
		return data.inventory[id] == true
	elseif collection.kind == "furniture" then
		return (data.furniture.owned[id] or 0) > 0
	end
	return data.achievements[id] == true
end

-- Returns owned, total.
function CollectionSystem.progress(data, collection)
	local owned = 0
	for _, id in ipairs(collection.ids) do
		if CollectionSystem.has(data, collection, id) then
			owned += 1
		end
	end
	return owned, #collection.ids
end

function CollectionSystem.isComplete(data, collection)
	local owned, total = CollectionSystem.progress(data, collection)
	return total > 0 and owned >= total
end

-- Overall completion across every collection, 0-100.
function CollectionSystem.totalPercent(data)
	local owned, total = 0, 0
	for _, collection in ipairs(CollectionSystem.List) do
		local o, t = CollectionSystem.progress(data, collection)
		owned += o
		total += t
	end
	if total == 0 then
		return 0
	end
	return math.floor(owned / total * 100 + 0.5)
end

return CollectionSystem
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--[[
	Config
	Every tuning number for Raise Brady Goo lives here so the game can be
	balanced without hunting through the systems.
]]

local Config = {}

Config.GameName = "Raise Brady Goo"

-- DataStore -----------------------------------------------------------
-- Change the name to wipe everybody's progress (useful while testing).
Config.DataStoreName = "RaiseBradyGoo_v1"
Config.AutosaveInterval = 120 -- seconds between autosaves
Config.SessionLockTimeout = 300 -- a lock older than this is treated as dead

-- New player ----------------------------------------------------------
Config.StartCoins = 150

-- Brady's needs (0-100). Decay is "points lost per second" while online.
Config.MeterDecay = { hunger = 1 / 11, clean = 1 / 16, energy = 1 / 24, fun = 1 / 13 }
Config.MeterTick = 5 -- how often decay is applied / synced
Config.SleepTick = 2 -- seconds between sleep ticks
Config.SleepEnergyPerTick = 5
Config.SleepXPPerTick = 3

-- Rebirth (prestige) --------------------------------------------------
Config.RebirthBonus = 0.25 -- +25% coins and XP per rebirth

-- Mini-games ----------------------------------------------------------
Config.MinigameEnergyCost = 8
Config.MinigameCooldown = 4
Config.ArcadeBonus = 1.25 -- reward multiplier when played at the arcade

-- Random events -------------------------------------------------------
Config.EventFirstDelay = { 100, 150 }
Config.EventDelay = { 150, 260 }

-- Fashion show --------------------------------------------------------
Config.FashionInterval = 240 -- seconds between shows
Config.FashionSignup = 40
Config.FashionWalkTime = 9
Config.FashionVoting = 20
Config.FashionResults = 10
Config.FashionMinAge = 5
Config.FashionWinCoins = 350
Config.FashionJoinCoins = 80
Config.TitleDuration = 15 * 60

-- Hidden collectibles -------------------------------------------------
Config.HiddenCoins = { 30, 70 }
Config.SecretSpawnInterval = 210 -- how often the server rolls for a secret item
Config.SecretSpawnChance = 0.4
Config.SecretLifetime = 120

-- Room ----------------------------------------------------------------
Config.GridSize = 2 -- studs per furniture grid cell
Config.MaxPlacedFurniture = 45
Config.MaxPlacedFurnitureWithPass = 100
Config.MaxFoodStack = 25
Config.MaxFoodStackWithPass = 99
Config.OutfitSlots = 3
Config.OutfitSlotsWithPass = 8

-- Plots ---------------------------------------------------------------
Config.PlotCount = 12
Config.PlotSize = 72

-- Follow / wander -----------------------------------------------------
Config.FollowMinAge = 3
Config.WanderInterval = { 4, 9 }
Config.BradyWalkSpeed = 7
Config.BradyFollowSpeed = 19

-- Testing -------------------------------------------------------------
-- When true, everyone is treated as owning every gamepass inside Studio.
Config.StudioOwnsAllPasses = false

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">CurrencySystem</string>
          <string name="Source"><![CDATA[--[[
	CurrencySystem
	Shared facts about Goo Coins: the reward table and formatting.
	The actual wallet changes happen in Services/CurrencyServer (server only).
]]

local Modules = script.Parent
local Util = require(Modules.Util)
local ClothingSystem = require(Modules.ClothingSystem)

local CurrencySystem = {}

CurrencySystem.Name = "Goo Coins"
CurrencySystem.Icon = "🟢"

-- Base coin rewards. Most are multiplied by AgeSystem.rewardMultiplier().
CurrencySystem.Rewards = {
	Feed = 5,
	Shower = 14,
	BrushHair = 7,
	CleanShoes = 7,
	ChangeClothes = 6,
	PlayToy = 6,
	TutorialDone = 100,
	Hidden = 40,
}

-- Coins for reaching a new age. Milestone stages add their own bonus on top.
function CurrencySystem.ageUpReward(age)
	return 40 + age * 25
end

-- Duplicate crate items are converted into coins.
function CurrencySystem.sellValue(rarity)
	local info = ClothingSystem.Rarities[rarity]
	return info and info.sell or 0
end

function CurrencySystem.canAfford(data, price)
	return Util.isNumber(price) and price >= 0 and data.coins >= price
end

function CurrencySystem.format(amount)
	return Util.short(amount)
end

return CurrencySystem
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">DailySystem</string>
          <string name="Source"><![CDATA[--[[
	DailySystem
	The 7-day login reward track and the pool of daily tasks.
	"Days" are UTC day numbers (os.time() // 86400) decided by the SERVER, so
	changing the clock on a device does nothing.
]]

local DailySystem = {}

-- kind: coins | food | clothing (random unowned of a rarity) | furniture | box
DailySystem.Rewards = {
	{ day = 1, kind = "coins", amount = 100, icon = "🟢", label = "100 Goo Coins" },
	{ day = 2, kind = "food", id = "pizza", amount = 3, icon = "🍕", label = "3 Pizza Slices" },
	{ day = 3, kind = "clothing", rarity = "Common", icon = "👕", label = "Common Clothing", fallback = 200 },
	{ day = 4, kind = "coins", amount = 500, icon = "🟢", label = "500 Goo Coins" },
	{ day = 5, kind = "clothing", rarity = "Rare", slots = { "Accessory", "Hat", "Glasses" }, icon = "📿", label = "Rare Accessory", fallback = 800 },
	{ day = 6, kind = "furniture", id = "trophy_lamp", icon = "🏆", label = "Golden Trophy Lamp" },
	{ day = 7, kind = "box", icon = "🎁", label = "Random Fashion Item", fallback = 1500 },
}

-- Can the player claim today?  `daily` = data.daily
function DailySystem.canClaim(daily, today)
	return daily.lastClaimDay < today
end

-- Which of the 7 tiles the next claim will be (1-7).
function DailySystem.nextIndex(daily, today)
	local streak = daily.streak
	if daily.lastClaimDay < today - 1 then
		streak = 0 -- missed a day: the streak resets
	end
	return streak % 7 + 1
end

-- Coin rewards grow a little every completed week (capped at 3x).
function DailySystem.weekMultiplier(streak)
	return math.min(3, 1 + math.floor(streak / 7) * 0.5)
end

----------------------------------------------------------------------
-- DAILY TASKS: three are picked per player per day.
-- `stat` is the stats counter that advances the task.
----------------------------------------------------------------------
DailySystem.Tasks = {
	{ id = "feed", text = "Feed Brady %d times", stat = "feeds", goal = 5, coins = 120 },
	{ id = "clean", text = "Clean Brady %d times", stat = "cleans", goal = 3, coins = 120 },
	{ id = "sleep", text = "Put Brady to bed", stat = "sleeps", goal = 1, coins = 100 },
	{ id = "games", text = "Play %d mini-games", stat = "minigames", goal = 4, coins = 180 },
	{ id = "hidden", text = "Find %d hidden goo blobs", stat = "hidden", goal = 3, coins = 200 },
	{ id = "event", text = "Complete a random event", stat = "events", goal = 1, coins = 150 },
	{ id = "crate", text = "Open a crate", stat = "crates", goal = 1, coins = 150 },
	{ id = "coins", text = "Earn %d Goo Coins", stat = "coinsEarned", goal = 600, coins = 150 },
	{ id = "show", text = "Enter a fashion show", stat = "showsJoined", goal = 1, coins = 220, minAge = 5 },
}

DailySystem.TaskById = {}
for _, task in ipairs(DailySystem.Tasks) do
	DailySystem.TaskById[task.id] = task
end

-- Deterministic pick: the same player gets the same 3 tasks all day.
function DailySystem.pickTasks(userId, day, age)
	local rng = Random.new((userId % 100000) * 31 + day)
	local candidates = {}
	for _, task in ipairs(DailySystem.Tasks) do
		if age >= (task.minAge or 1) then
			table.insert(candidates, task)
		end
	end
	local picked = {}
	for _ = 1, 3 do
		if #candidates == 0 then
			break
		end
		local index = rng:NextInteger(1, #candidates)
		table.insert(picked, { id = candidates[index].id, progress = 0, claimed = false })
		table.remove(candidates, index)
	end
	return picked
end

function DailySystem.taskText(task)
	if string.find(task.text, "%%d") then
		return string.format(task.text, task.goal)
	end
	return task.text
end

return DailySystem
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">DataManager</string>
          <string name="Source"><![CDATA[--[[
	DataManager
	The save-data SCHEMA: the default profile for a new player and the
	reconcile() function that repairs anything loaded from the DataStore.

	Why this lives in ReplicatedStorage: it is only the shape of the data, so
	the client can read it too. The part that actually talks to DataStores
	(loading, saving, session locking) is server-only and lives in
	ServerScriptService/Services/DataServer - clients can never reach it.

	reconcile() is the "basic data corruption" protection. Whatever comes out
	of the DataStore is rebuilt field by field: wrong types are replaced with
	defaults, numbers are clamped, items that no longer exist are dropped and
	equipped items must actually be owned. Age is always re-derived from Age XP
	so the two can never disagree.

	DataStore rules respected here: dictionaries only use string keys, arrays
	have no holes, and there are no NaN / infinite numbers.
]]

local Modules = script.Parent
local Config = require(Modules.Config)
local Util = require(Modules.Util)
local AgeSystem = require(Modules.AgeSystem)
local ClothingSystem = require(Modules.ClothingSystem)
local FurnitureSystem = require(Modules.FurnitureSystem)
local FoodSystem = require(Modules.FoodSystem)
local GiftSystem = require(Modules.GiftSystem)
local AchievementSystem = require(Modules.AchievementSystem)
local CollectionSystem = require(Modules.CollectionSystem)

local DataManager = {}

DataManager.Version = 1

DataManager.StatKeys = {
	"feeds", "cleans", "sleeps", "minigames", "perfectGames", "events", "showsJoined", "showsWon",
	"hidden", "crates", "coinsEarned", "placed", "hypes", "photos", "ageUps",
}

DataManager.SettingDefaults = { music = true, sfx = true, lowGfx = false, chatter = true, aura = "none" }

local function newStats()
	local stats = {}
	for _, key in ipairs(DataManager.StatKeys) do
		stats[key] = 0
	end
	return stats
end

-- A brand new player's profile.
function DataManager.new()
	return {
		version = DataManager.Version,
		coins = Config.StartCoins,
		ageXP = 0,
		age = 1,
		rebirths = 0,
		meters = { hunger = 55, clean = 70, energy = 90, fun = 55 },
		inventory = { hair_baby = true, plain_tee = true, basic_jeans = true },
		equipped = { Hair = "hair_baby" },
		outfits = {}, -- ["1"] = { Shirt = id, ... }
		food = { fruit = 2, pizza = 1 },
		furniture = { owned = { rug_goo = 1 }, placed = {} },
		gifts = { owned = {}, equipped = {} },
		achievements = {},
		stats = newStats(),
		collectionsClaimed = {},
		stageRewards = { ["1"] = true }, -- stage 1 rewards are the starter kit above
		daily = { lastClaimDay = 0, streak = 0, taskDay = 0, tasks = {}, hiddenDay = 0, hidden = {} },
		title = { name = "", expires = 0 },
		settings = Util.deepCopy(DataManager.SettingDefaults),
		tutorialDone = false,
		createdAt = os.time(),
		lastSeen = os.time(),
	}
end

----------------------------------------------------------------------
-- small sanitising helpers
----------------------------------------------------------------------
local function num(value, default, min, max)
	if not Util.isNumber(value) then
		return default
	end
	return math.clamp(value, min or -math.huge, max or math.huge)
end

local function int(value, default, min, max)
	return math.floor(num(value, default, min, max))
end

local function tbl(value)
	return type(value) == "table" and value or {}
end

-- Keeps only `true` flags whose key passes isValid.
local function flagSet(value, isValid)
	local result = {}
	for key, flag in pairs(tbl(value)) do
		if type(key) == "string" and flag == true and (isValid == nil or isValid(key)) then
			result[key] = true
		end
	end
	return result
end

----------------------------------------------------------------------
-- reconcile(raw) -> clean data table
----------------------------------------------------------------------
function DataManager.reconcile(raw)
	local fresh = DataManager.new()
	if type(raw) ~= "table" then
		return fresh
	end
	local data = {}

	data.version = DataManager.Version
	data.coins = int(raw.coins, fresh.coins, 0, 1e12)
	data.ageXP = int(raw.ageXP, 0, 0, AgeSystem.MaxXP)
	data.age = AgeSystem.ageFromXP(data.ageXP)
	data.rebirths = int(raw.rebirths, 0, 0, 1000)

	local meters = tbl(raw.meters)
	data.meters = {
		hunger = num(meters.hunger, fresh.meters.hunger, 0, 100),
		clean = num(meters.clean, fresh.meters.clean, 0, 100),
		energy = num(meters.energy, fresh.meters.energy, 0, 100),
		fun = num(meters.fun, fresh.meters.fun, 0, 100),
	}

	-- Inventory: only item ids that still exist in the catalog.
	data.inventory = flagSet(raw.inventory, function(id)
		return ClothingSystem.Items[id] ~= nil
	end)
	for id in pairs(fresh.inventory) do
		data.inventory[id] = true -- nobody can lose the starter kit
	end

	-- Equipped: must be owned and sitting in the right slot.
	data.equipped = {}
	for slot, id in pairs(tbl(raw.equipped)) do
		local item = type(id) == "string" and ClothingSystem.Items[id]
		if item and item.slot == slot and data.inventory[id] then
			data.equipped[slot] = id
		end
	end

	-- Saved outfits.
	data.outfits = {}
	for key, outfit in pairs(tbl(raw.outfits)) do
		local index = tonumber(key)
		if index and index >= 1 and index <= Config.OutfitSlotsWithPass and type(outfit) == "table" then
			local clean = {}
			for slot, id in pairs(outfit) do
				local item = type(id) == "string" and ClothingSystem.Items[id]
				if item and item.slot == slot and data.inventory[id] then
					clean[slot] = id
				end
			end
			data.outfits[tostring(math.floor(index))] = clean
		end
	end

	data.food = {}
	for id, amount in pairs(tbl(raw.food)) do
		if type(id) == "string" and FoodSystem.ById[id] then
			data.food[id] = int(amount, 0, 0, Config.MaxFoodStackWithPass)
		end
	end

	-- Furniture: owned counts, then placements (never more placed than owned).
	local furniture = tbl(raw.furniture)
	data.furniture = { owned = {}, placed = {} }
	for id, amount in pairs(tbl(furniture.owned)) do
		if type(id) == "string" and FurnitureSystem.ById[id] then
			local count = int(amount, 0, 0, 999)
			if count > 0 then
				data.furniture.owned[id] = count
			end
		end
	end
	local placedCounts = {}
	for _, placement in ipairs(tbl(furniture.placed)) do
		if type(placement) == "table" and type(placement.id) == "string" and FurnitureSystem.ById[placement.id] then
			local id = placement.id
			local used = placedCounts[id] or 0
			if used < (data.furniture.owned[id] or 0) and #data.furniture.placed < Config.MaxPlacedFurnitureWithPass then
				placedCounts[id] = used + 1
				table.insert(data.furniture.placed, {
					id = id,
					x = int(placement.x, 0, -200, 200),
					z = int(placement.z, 0, -200, 200),
					r = int(placement.r, 0, 0, 3),
				})
			end
		end
	end

	local gifts = tbl(raw.gifts)
	data.gifts = { owned = flagSet(gifts.owned, function(id)
		return GiftSystem.ById[id] ~= nil
	end), equipped = {} }
	for slot, id in pairs(tbl(gifts.equipped)) do
		local gift = type(id) == "string" and GiftSystem.ById[id]
		if gift and gift.slot == slot and data.gifts.owned[id] then
			data.gifts.equipped[slot] = id
		end
	end

	data.achievements = flagSet(raw.achievements, function(id)
		return AchievementSystem.ById[id] ~= nil
	end)
	data.collectionsClaimed = flagSet(raw.collectionsClaimed, function(id)
		return CollectionSystem.ById[id] ~= nil
	end)
	data.stageRewards = flagSet(raw.stageRewards, function(key)
		return tonumber(key) ~= nil
	end)
	data.stageRewards["1"] = true

	data.stats = newStats()
	for _, key in ipairs(DataManager.StatKeys) do
		data.stats[key] = int(tbl(raw.stats)[key], 0, 0, 1e12)
	end

	local daily = tbl(raw.daily)
	data.daily = {
		lastClaimDay = int(daily.lastClaimDay, 0, 0, 1e7),
		streak = int(daily.streak, 0, 0, 1e6),
		taskDay = int(daily.taskDay, 0, 0, 1e7),
		tasks = {},
		hiddenDay = int(daily.hiddenDay, 0, 0, 1e7),
		hidden = flagSet(daily.hidden, function(key)
			return tonumber(key) ~= nil
		end),
	}
	for _, task in ipairs(tbl(daily.tasks)) do
		if type(task) == "table" and type(task.id) == "string" and #data.daily.tasks < 3 then
			table.insert(data.daily.tasks, {
				id = task.id,
				progress = int(task.progress, 0, 0, 1e9),
				claimed = task.claimed == true,
			})
		end
	end

	local title = tbl(raw.title)
	data.title = {
		name = type(title.name) == "string" and string.sub(title.name, 1, 40) or "",
		expires = int(title.expires, 0, 0, 1e11),
	}

	data.settings = {}
	local settings = tbl(raw.settings)
	for key, default in pairs(DataManager.SettingDefaults) do
		if type(settings[key]) == type(default) then
			data.settings[key] = settings[key]
		else
			data.settings[key] = default
		end
	end

	data.tutorialDone = raw.tutorialDone == true
	data.createdAt = int(raw.createdAt, os.time(), 0, 1e11)
	data.lastSeen = int(raw.lastSeen, os.time(), 0, 1e11)

	return data
end

return DataManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Dialogue</string>
          <string name="Source"><![CDATA[--[[
	Dialogue
	Every short, meme-y thing Brady says. Keep lines tiny: they show in a
	speech bubble over his head for a few seconds.
]]

local Dialogue = {}

Dialogue.Lines = {
	-- random idle chatter, by stage id
	Baby = { "goo goo", "ga ga (fashionably)", "*drools*", "ba ba", "bib is mid", "*judging you*" },
	Little = { "why", "why?", "but why", "i can walk now", "shoes are cool", "watch this" },
	Kid = { "look at my hat", "i'm basically grown", "can we get snacks", "bro", "hats are my thing now" },
	Drippy = { "do you see the drip", "it's called fashion", "lowkey dripped out", "first drip. real drip." },
	Trendy = { "this is trending", "nah this is crazy", "outfit check", "everyone's wearing this" },
	Teen = { "mid.", "whatever", "you wouldn't get it", "it's not a phase", "literally me" },
	Fashion = { "this hallway is a runway", "serving looks", "the silhouette. look at it.", "brady is locked in" },
	Archive = { "archive era", "it's a piece, not a jacket", "this is from '98", "you wouldn't know the designer" },
	Vintage = { "they don't make them like this anymore", "this is vintage. so am i.", "true vintage only" },
	Legendary = { "i am the archive", "most archive person on roblox", "legendary.", "goo forever" },

	-- needs
	hungry = { "i'm starving", "feed me bro", "snack time??", "my stomach is yelling" },
	dirty = { "i stink", "bro i need a shower", "the fit is dirty", "something smells. it's me." },
	tired = { "so sleepy", "need. bed.", "*yawn*", "running on 1%" },
	bored = { "i'm bored", "play with me", "do something", "boooored" },

	-- reactions
	fed = { "YUMMY", "bussin", "10/10 would eat again", "*happy chewing*", "chef's kiss" },
	mysteryGood = { "WHAT WAS THAT. AGAIN.", "i can taste colors" },
	mysteryBad = { "that was a mistake", "why was it crunchy" },
	clean = { "squeaky clean", "fresh", "i smell like victory" },
	brushed = { "hair is laid", "not a strand out of place" },
	shoes = { "kicks are crispy", "no creases" },
	sleep = { "goodnight", "zzz", "five more minutes" },
	wake = { "i'm up i'm up", "what year is it", "best nap ever" },
	notTired = { "i'm not tired", "no bed. only vibes." },
	full = { "i'm full bro", "no more. please." },
	alreadyClean = { "i'm already clean", "you calling me dirty?" },
	play = { "LET'S GO", "again again", "that was fun" },
	win = { "TOO EASY", "we're so good at this", "W" },
	lose = { "we'll get 'em next time", "that was practice", "L (small)" },
	trip = { "i meant to do that", "who put that there", "ow" },
	pose = { "strike a pose", "*poses*", "camera ready" },
	mirror = { "looking good", "who's that? oh. me.", "mirror check" },

	-- fashion
	newItem = { "new piece!", "adding to the closet", "W pickup" },
	rareItem = { "NO WAY", "RARE PIECE", "let's GOOO" },
	archiveItem = { "ARCHIVE PIECE", "archive era", "this belongs in a museum" },
	grailItem = { "GRAIL FOUND", "GRAIL. GRAIL. GRAIL.", "i'm shaking" },
	badFit = { "bro what is this fit", "the fit is NOT it", "where are my pants", "i can't go out like this" },
	goodFit = { "the fit is insane", "brady is dripped out", "nah this is crazy", "certified" },
	ageUp = { "I'M OLDER", "leveling up", "new era", "growing up fr" },
	stageUp = { "NEW ERA UNLOCKED", "i feel different", "character development" },
	outside = { "touching grass", "fresh air hits different", "outside is cool" },
	follow = { "wait for me", "i'm coming", "road trip" },
	home = { "home sweet home", "back to the crib" },
	runway = { "runway time", "watch the walk", "this is my moment" },
	showWin = { "FASHION ICON", "best dressed, obviously", "the judges have taste" },
	showLose = { "robbed.", "the judges don't get it", "ahead of my time" },
	rebirth = { "we go again", "born again. drippier." },
}

function Dialogue.pick(key, rng)
	local lines = Dialogue.Lines[key]
	if not lines or #lines == 0 then
		return nil
	end
	local index = rng and rng:NextInteger(1, #lines) or math.random(1, #lines)
	return lines[index]
end

return Dialogue
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">EventSystem</string>
          <string name="Source"><![CDATA[--[[
	EventSystem
	Definitions for the random events that pop up every few minutes.
	Each one is a short interactive task; Services/EventServer runs them.

	task kinds
	  findObject  a prop spawns near the house, the owner grabs it
	  feed        feed Brady
	  openBox     open the mystery box that appeared in the room
	  goPark      walk to the park with Brady following
	  hype        mash the HYPE button
	  haircut     choose KEEP or FIX (fix = brush his hair)
	  changeFit   change pieces of his outfit
]]

local EventSystem = {}

EventSystem.List = {
	{ id = "LostShoes", title = "BRADY LOST HIS SHOES", task = "findObject", duration = 80, weight = 10, minAge = 3,
		desc = "his shoes are somewhere around the house. go grab them!", coins = 60, xp = 50,
		say = "bro where are my shoes", win = "SHOES SECURED" },
	{ id = "Hungry", title = "BRADY IS HUNGRY", task = "feed", duration = 60, weight = 12, minAge = 1,
		desc = "feed him before he gets hangry!", coins = 40, xp = 40,
		say = "i'm literally starving", win = "CRISIS AVERTED" },
	{ id = "FoundGrail", title = "BRADY FOUND A GRAIL", task = "openBox", duration = 90, weight = 6, minAge = 5,
		desc = "a mystery box appeared in his room. open it!", coins = 30, xp = 60,
		say = "GRAIL FOUND", win = "BOX OPENED" },
	{ id = "GoOutside", title = "BRADY WANTS TO GO OUTSIDE", task = "goPark", duration = 150, weight = 9, minAge = 3,
		desc = "take Brady to the park. he will follow you!", coins = 90, xp = 90,
		say = "i need to touch grass", win = "GRASS TOUCHED" },
	{ id = "InsaneFit", title = "BRADY'S FIT IS INSANE", task = "hype", duration = 20, weight = 9, minAge = 1, goal = 15,
		desc = "hype him up! smash the HYPE button 15 times!", coins = 50, xp = 45,
		say = "nah this is crazy", win = "HYPE DELIVERED" },
	{ id = "NewHaircut", title = "BRADY GOT A NEW HAIRCUT", task = "haircut", duration = 45, weight = 8, minAge = 3,
		desc = "keep it... or brush it back to normal?", coins = 45, xp = 45,
		say = "do you like it? be honest", win = "HAIR HANDLED" },
	{ id = "FashionCrisis", title = "BRADY IS HAVING A FASHION CRISIS", task = "changeFit", duration = 75, weight = 9, minAge = 1, goal = 2,
		desc = "open the wardrobe and change 2 pieces of his fit!", coins = 60, xp = 60,
		say = "the fit is NOT it", win = "FIT FIXED" },
}

EventSystem.ById = {}
for _, def in ipairs(EventSystem.List) do
	EventSystem.ById[def.id] = def
end

function EventSystem.get(id)
	return EventSystem.ById[id]
end

-- Events available for a given Brady age.
function EventSystem.eligible(age)
	local list = {}
	for _, def in ipairs(EventSystem.List) do
		if age >= def.minAge then
			table.insert(list, def)
		end
	end
	return list
end

return EventSystem
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">FashionSystem</string>
          <string name="Source"><![CDATA[--[[
	FashionSystem
	Fashion show categories, the titles winners receive, and the "judge score"
	formula. The judges exist so a show still works with one player online:
	real player votes are simply added on top of the judges' opinion.
]]

local Modules = script.Parent
local ClothingSystem = require(Modules.ClothingSystem)
local InventorySystem = require(Modules.InventorySystem)

local FashionSystem = {}

local rgb = Color3.fromRGB

FashionSystem.Categories = {
	{ id = "Streetwear", name = "Best Streetwear", title = "Goo Stylist", hint = "street pieces score big" },
	{ id = "Archive", name = "Most Archive", title = "Archive Collector", hint = "Archive + Grail pieces and anything vintage" },
	{ id = "Funniest", name = "Funniest Fit", title = "Fit Comedian", hint = "the goofier the better" },
	{ id = "Shoes", name = "Best Shoes", title = "Sole Legend", hint = "it's all about the kicks" },
	{ id = "Overall", name = "Best Overall", title = "Goo Fashion Icon", hint = "the best total fit wins" },
	{ id = "Drippy", name = "Most Drippy", title = "Certified Drip", hint = "rare pieces and glowing effects" },
}

FashionSystem.CategoryById = {}
for _, category in ipairs(FashionSystem.Categories) do
	FashionSystem.CategoryById[category.id] = category
end

-- Title colours for nameplates.
FashionSystem.TitleColors = {
	["Goo Stylist"] = rgb(90, 200, 255),
	["Archive Collector"] = rgb(232, 66, 78),
	["Fit Comedian"] = rgb(255, 170, 60),
	["Sole Legend"] = rgb(120, 255, 170),
	["Goo Fashion Icon"] = rgb(255, 205, 60),
	["Certified Drip"] = rgb(120, 220, 255),
	["Collection Master"] = rgb(255, 110, 225),
}

local function hasTag(item, tag)
	return table.find(item.tags, tag) ~= nil
end

-- What the judges think of a fit for a category. Higher = better.
-- `equipped` is a { slot = itemId } table. `rng` is optional.
function FashionSystem.judgeScore(categoryId, equipped, rng)
	local items = InventorySystem.equippedItems(equipped)
	local score = 0
	local rarities = {}
	for _, item in ipairs(items) do
		local points = ClothingSystem.Rarities[item.rarity].points
		if item.slot == "Outfit" then
			points *= 3
		end
		rarities[item.rarity] = true
		if categoryId == "Streetwear" then
			score += hasTag(item, "street") and points * 2 or points * 0.3
		elseif categoryId == "Archive" then
			if item.rarity == "Archive" or item.rarity == "Grail" then
				score += points * 2.5
			elseif hasTag(item, "vintage") then
				score += points * 1.5
			else
				score += points * 0.2
			end
		elseif categoryId == "Funniest" then
			score += hasTag(item, "funny") and (8 + points) or points * 0.2
		elseif categoryId == "Shoes" then
			score += item.slot == "Shoes" and points * 5 or points * 0.15
			if item.slot == "Outfit" then
				score += points -- outfits come with shoes
			end
		elseif categoryId == "Drippy" then
			score += points + (item.fx and 6 or 0)
		else -- Overall
			score += points * 1.2
		end
	end
	if categoryId == "Funniest" then
		-- Chaos bonus: lots of different rarities, or forgetting pants entirely.
		local distinct = 0
		for _ in pairs(rarities) do
			distinct += 1
		end
		score += distinct * 3
		if InventorySystem.isBadFit(equipped) then
			score += 10
		end
	end
	-- Judges are a little unpredictable (+/- 15%).
	local roll = rng and rng:NextNumber() or math.random()
	return math.max(1, score) * (0.85 + roll * 0.3)
end

-- Final score = judges + a big bonus per real vote.
function FashionSystem.finalScore(judgeScore, votes, bestJudgeScore)
	return judgeScore + votes * math.max(8, bestJudgeScore * 0.35)
end

return FashionSystem
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">FoodSystem</string>
          <string name="Source"><![CDATA[--[[
	FoodSystem
	Everything Brady can eat. Cereal is free and unlimited so nobody can get
	stuck with a starving Brady and zero coins.
]]

local FoodSystem = {}

local rgb = Color3.fromRGB

FoodSystem.List = {
	{ id = "cereal", name = "Soggy Cereal", icon = "🥣", price = 0, free = true, hunger = 16, xp = 6, color = rgb(240, 220, 150),
		desc = "free. unlimited. slightly sad." },
	{ id = "fruit", name = "Fruit Bowl", icon = "🍎", price = 25, hunger = 24, xp = 14, color = rgb(230, 70, 60),
		desc = "healthy. he is suspicious of it." },
	{ id = "pizza", name = "Pizza Slice", icon = "🍕", price = 45, hunger = 36, xp = 22, color = rgb(245, 180, 70),
		desc = "the food pyramid is a triangle. so is pizza." },
	{ id = "burger", name = "Goo Burger", icon = "🍔", price = 70, hunger = 50, xp = 32, color = rgb(170, 110, 60),
		desc = "the green stuff is 'special sauce'." },
	{ id = "mystery", name = "Goofy Mystery Food", icon = "🧪", price = 110, hunger = 40, xp = 0, mystery = true, color = rgb(170, 90, 255),
		desc = "could be amazing. could be a mistake. 5 to 120 XP." },
	{ id = "cake", name = "Birthday Cake", icon = "🎂", price = 240, hunger = 70, xp = 90, minAge = 8, color = rgb(255, 170, 200),
		desc = "it is always somebody's birthday." },
	{ id = "sushi", name = "Fancy Sushi", icon = "🍣", price = 420, hunger = 60, xp = 170, minAge = 16, color = rgb(250, 140, 110),
		desc = "archive bradys only eat tiny expensive food." },
}

FoodSystem.ById = {}
for _, food in ipairs(FoodSystem.List) do
	FoodSystem.ById[food.id] = food
end

function FoodSystem.get(id)
	return FoodSystem.ById[id]
end

return FoodSystem
]]></string>
